@{
    ViewData["Title"] = "Guardadas";
}

<div class="container seccion">
    <div class="encabezado">
        <div>
            <h1 class="titulo">Guardadas</h1>
            <p class="texto-suave">Las ofertas que guardaste para ver después o postularte más tarde.</p>
        </div>
        <a class="btn-solid theme-primary boton" asp-controller="Empleos" asp-action="Index">Buscar trabajo</a>
    </div>

    @if (ViewBag.Guardadas.Count == 0)
    {
        <div class="vacio">
            <h2>Todavía no guardaste ofertas</h2>
            <p>En Buscar trabajo, abrí una oferta y tocá "Guardar" para tenerla acá.</p>
        </div>
    }
    else
    {
        <ul class="list-group lista">
            @foreach (Oferta oferta in ViewBag.Guardadas)
            {
                <li class="list-group-item fila-lista">
                    <partial name="_LogoEmpresa" model='new LogoEmpresa(oferta.Logo, oferta.Empresa, "logo-empresa-md")' />
                    <div class="fila-lista-datos">
                        <h2 class="tarjeta-titulo"><a href="@oferta.Enlace">@oferta.Titulo</a></h2>
                        <p class="texto-suave">@oferta.Resumen</p>
                        <div class="etiquetas">
                            <partial name="_SelloOficial" model="oferta" />
                            @if (!string.IsNullOrEmpty(oferta.Modalidad)) { <span class="badge etiqueta etiqueta-borde">@oferta.Modalidad</span> }
                            <span class="badge etiqueta @(oferta.EsExterna ? "" : "etiqueta-principal")">@(oferta.EsExterna ? "Vía " + oferta.Fuente : "En Workly")</span>
                            @if (oferta.YaPostulado) { <span class="badge etiqueta etiqueta-exito">✓ Ya te postulaste</span> }
                            @if (oferta.NoDisponible) { <span class="badge etiqueta etiqueta-error">Ya no recibe postulaciones</span> }
                        </div>
                        @if (oferta.Fecha_Guardado.HasValue)
                        {
                            <p class="texto-suave">Guardada el @Vistas.Fecha(oferta.Fecha_Guardado)</p>
                        }
                    </div>
                    <div class="fila-lista-acciones">
                        <a class="btn-solid theme-primary boton btn-sm" href="@oferta.Enlace">Ver oferta</a>
                        <form asp-controller="Guardadas" asp-action="Quitar" asp-route-id="@oferta.ID" asp-route-externa="@(oferta.EsExterna ? "true" : "false")" asp-route-volver="@Url.Action("Index", "Guardadas")" method="post">
                            <button class="boton-link" type="submit">Quitar</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</div>
