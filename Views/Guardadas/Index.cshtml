@{
    ViewData["Title"] = "Guardadas";
}

<div class="container espacio-abajo">
    <header class="bloque-titulo">
        <div class="fila-titulo">
            <div>
                <h1 class="titulo">Guardadas</h1>
                <p class="subtitulo">Las ofertas que guardaste para ver después o postularte más tarde.</p>
            </div>
            <div class="acciones">
                <a class="btn btn-primary" href="/Empleos"><icono nombre="search" />Buscar trabajo</a>
            </div>
        </div>
    </header>

    @if (ViewBag.Guardadas.Count == 0)
    {
        <div class="recuadro-punteado">
            <span class="caja-icono-lg"><icono nombre="bookmark" /></span>
            <h2 class="recuadro-punteado-titulo">Todavía no guardaste ofertas</h2>
            <p>En Buscar trabajo, abrí una oferta y tocá "Guardar" para tenerla acá.</p>
            <a class="btn btn-primary" href="/Empleos"><icono nombre="search" />Buscar trabajo</a>
        </div>
    }
    else
    {
        <ul class="lista-tarjetas-junta" role="list">
            @foreach (Oferta oferta in ViewBag.Guardadas)
            {
                <li class="tarjeta-larga">
                    <span class="cuadro-md" aria-hidden="true"><partial name="_LogoEmpresa" model="oferta" /></span>
                    <div class="tarjeta-larga-textos">
                        <h2 class="titulo-chico"><a href="@oferta.Enlace">@oferta.Titulo</a></h2>
                        <p class="tarjeta-larga-texto">@oferta.Resumen</p>
                        <div class="fila-chapitas">
                            <partial name="_SelloOficial" model="oferta" />
                            @if (!string.IsNullOrEmpty(oferta.Modalidad)) { <span class="badge chapita-borde">@oferta.Modalidad</span> }
                            <span class="badge @(oferta.EsExterna ? "chapita" : "chapita-principal")">@(oferta.EsExterna ? "Vía " + oferta.Fuente : "En Workly")</span>
                            @if (oferta.YaPostulado) { <span class="badge badge-exito"><icono nombre="circle-check" tamano="16" />Ya te postulaste</span> }
                            @if (oferta.NoDisponible) { <span class="badge badge-error">Ya no recibe postulaciones</span> }
                        </div>
                        @if (oferta.Fecha_Guardado.HasValue)
                        {
                            <p class="small text-body-secondary">Guardada el @Vistas.Fecha(oferta.Fecha_Guardado)</p>
                        }
                    </div>
                    <div class="tarjeta-larga-acciones">
                        <a class="btn btn-sm" href="@oferta.Enlace">Ver oferta</a>
                        <form action="/Guardadas/Quitar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@oferta.ID" />
                            <input type="hidden" name="externa" value="@(oferta.EsExterna ? "true" : "false")" />
                            <input type="hidden" name="volver" value="/Guardadas" />
                            <button class="btn btn-link-sm" type="submit"><icono nombre="trash-full" />Quitar</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</div>
