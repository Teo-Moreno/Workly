@{
    ViewData["Title"] = "Inicio";
}

<div class="container espacio-abajo">
    <header class="bloque-titulo-ancho">
        <div>
            <p class="texto-turquesa">@Vistas.Hoy</p>
            <h1 class="titulo">Hola, @ViewBag.Perfil.Usuario.Nombre</h1>
            <p class="subtitulo">
                @(ViewBag.Perfil.TotalPostulaciones == 0
                    ? "Todavía no te postulaste a ninguna búsqueda."
                    : $"Tenés {ViewBag.Perfil.TotalPostulaciones} {(ViewBag.Perfil.TotalPostulaciones == 1 ? "postulación" : "postulaciones")} en tu tablero.")
            </p>
        </div>
        <form class="fila-flexible" action="/Empleos" method="get" role="search">
            <div class="control-con-icono">
                <icono nombre="search" />
                <label class="visually-hidden" for="panel-busqueda">Buscar trabajo</label>
                <input class="form-control" id="panel-busqueda" type="search" name="Q" maxlength="100" placeholder="¿Qué trabajo buscás?" />
            </div>
            <button class="btn btn-primary" type="submit">Buscar</button>
        </form>
    </header>

    @if (ViewBag.Perfil.SiguientePaso != null)
    {
        <a class="aviso-amarillo" href="/Perfil/Completar">
            <span class="caja-icono-sm"><icono nombre="user-square" /></span>
            <span class="aviso-amarillo-texto"><strong>Tu perfil está al @ViewBag.Perfil.PorcentajeCompleto%.</strong> Te falta: @ViewBag.Perfil.SiguientePaso.Texto.ToLower(Vistas.Cultura). Quienes publican búsquedas lo ven cuando te postulás.</span>
            <span class="btn btn-sm">Completar perfil</span>
        </a>
    }

    <div class="grilla-lateral-derecha">
        <div class="columna-ancha">
            <section class="card" aria-labelledby="panel-para-vos">
                <div class="card-header">
                    <h2 class="card-title" id="panel-para-vos">@(string.IsNullOrWhiteSpace(ViewBag.Puesto) ? "Ofertas para vos" : $"Ofertas de {ViewBag.Puesto}")</h2>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Puesto))
                    {
                        <a class="resaltado" href="@ViewBag.UrlVerTodas">Ver todas →</a>
                    }
                </div>
                @if (string.IsNullOrWhiteSpace(ViewBag.Puesto))
                {
                    <div class="recuadro-punteado-chico">
                        <p>Contanos qué puesto buscás y acá te mostramos las ofertas de Workly y de otros sitios que coinciden.</p>
                        <a class="btn btn-outline-sm" href="/Perfil/Configuracion?pestana=busqueda"><icono nombre="plus" />Completar qué busco</a>
                    </div>
                }
                else
                {
                    <div data-buscando aria-busy="true" data-resultados-url="/Panel/ParaVos">
                        <partial name="_CargandoResultados" />
                        <div data-resultados-contenido></div>
                    </div>
                }
            </section>
        </div>

        <aside class="columna-ancha">
            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">Tus postulaciones</h2>
                    @if (ViewBag.Perfil.TotalPostulaciones > 0)
                    {
                        <a class="resaltado" href="/Postulaciones">Ir al tablero →</a>
                    }
                </div>
                @if (ViewBag.Perfil.TotalPostulaciones == 0)
                {
                    <p class="recuadro-punteado-mini">Cuando te postules, vas a poder seguir cada proceso desde tu tablero.</p>
                }
                else
                {
                    <ul class="grilla-bordes" role="list">
                        @foreach (var etapa in Catalogos.EstadosPostulacion)
                        {
                            <li class="borde-izquierdo-@etapa.Color">
                                <strong>@ViewBag.Perfil.CantidadEnEstado(etapa.Estado)</strong><span>@etapa.Estado</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="card">
                @if (ViewBag.Publicadas.Count == 0)
                {
                    <h2 class="card-title">¿Buscás a alguien?</h2>
                    <p class="text-body-secondary">También podés publicar una búsqueda. La revisamos antes de publicarla.</p>
                    <a class="btn btn-outline-block" href="/Publicaciones/Nueva"><icono nombre="plus" />Publicar búsqueda</a>
                }
                else
                {
                    <div class="card-header">
                        <h2 class="card-title">Tus búsquedas</h2>
                        <a class="resaltado" href="/Publicaciones">Ver todas →</a>
                    </div>
                    <ul class="lista-lineas" role="list">
                        @foreach (Oferta oferta in ViewBag.Publicadas)
                        {
                            <li class="linea">
                                <div class="linea-textos">
                                    <a class="linea-titulo" href="/Publicaciones/Detalle/@oferta.ID">@oferta.Titulo</a>
                                    <span class="texto-chico">@oferta.CantidadPostulantes @(oferta.CantidadPostulantes == 1 ? "postulante" : "postulantes")</span>
                                </div>
                                <span class="badge badge-@oferta.EstadoColor">@oferta.EstadoTexto</span>
                            </li>
                        }
                    </ul>
                    <a class="btn btn-outline-block" href="/Publicaciones/Nueva"><icono nombre="plus" />Publicar otra búsqueda</a>
                }
            </section>
        </aside>
    </div>
</div>
