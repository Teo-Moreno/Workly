@{
    ViewData["Title"] = "Inicio";
}

<div class="container seccion">
    <div class="encabezado">
        <div>
            <p class="texto-suave">@Vistas.Hoy</p>
            <h1 class="titulo">Hola, @ViewBag.Perfil.Usuario.Nombre</h1>
            <p class="texto-suave">
                @(ViewBag.Perfil.TotalPostulaciones == 0
                    ? "Todavía no te postulaste a ninguna búsqueda."
                    : $"Tenés {ViewBag.Perfil.TotalPostulaciones} {(ViewBag.Perfil.TotalPostulaciones == 1 ? "postulación" : "postulaciones")} en tu tablero.")
            </p>
        </div>
        <form class="buscador" asp-controller="Empleos" asp-action="Index" method="get">
            <label class="visually-hidden" for="panel-busqueda">Buscar trabajo</label>
            <input class="form-control" id="panel-busqueda" type="text" name="Q" placeholder="¿Qué trabajo buscás?">
            <button class="btn-solid theme-primary boton" type="submit">Buscar</button>
        </form>
    </div>

    @if (ViewBag.Perfil.SiguientePaso != null)
    {
        <p class="mensaje mensaje-info">
            <span class="negrita">Tu perfil está al @ViewBag.Perfil.PorcentajeCompleto%.</span>
            Te falta: @ViewBag.Perfil.SiguientePaso.Texto.ToLower(Vistas.Cultura). Quienes publican búsquedas lo ven cuando te postulás.
            <a asp-controller="Perfil" asp-action="Completar">Completar perfil →</a>
        </p>
    }

    <div class="row g-4">
        <div class="lg:col-7">
            <section class="card tarjeta">
                <div class="tarjeta-cabecera">
                    <h2 class="card-title">@(string.IsNullOrWhiteSpace(ViewBag.Puesto) ? "Ofertas para vos" : $"Ofertas de {ViewBag.Puesto}")</h2>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Puesto))
                    {
                        <a asp-controller="Empleos" asp-action="Index" asp-route-Q="@ViewBag.Puesto">Ver todas →</a>
                    }
                </div>
                @if (string.IsNullOrWhiteSpace(ViewBag.Puesto))
                {
                    <div class="vacio">
                        <p>Contanos qué puesto buscás y acá te mostramos las ofertas de Workly y de otros sitios que coinciden.</p>
                        <a class="btn-outline theme-primary boton btn-sm" asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda">+ Completar qué busco</a>
                    </div>
                }
                else if (ViewBag.ParaVos.Count == 0)
                {
                    <div class="vacio">
                        <p>No encontramos ningún puesto de "@ViewBag.Puesto" nuevo para vos. Probá buscar con otras palabras.</p>
                        <a class="btn-outline theme-primary boton btn-sm" asp-controller="Empleos" asp-action="Index">Buscar trabajo</a>
                    </div>
                }
                else
                {
                    <div class="lista-ofertas">
                        @foreach (Oferta oferta in ViewBag.ParaVos)
                        {
                            <partial name="_OfertaTarjeta" model="oferta" />
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="lg:col-5">
            <section class="card tarjeta">
                <div class="tarjeta-cabecera">
                    <h2 class="card-title">Tus postulaciones</h2>
                    @if (ViewBag.Perfil.TotalPostulaciones > 0)
                    {
                        <a asp-controller="Postulaciones" asp-action="Index">Ir al tablero →</a>
                    }
                </div>
                @if (ViewBag.Perfil.TotalPostulaciones == 0)
                {
                    <p class="texto-suave">Cuando te postules, vas a poder seguir cada proceso desde tu tablero.</p>
                }
                else
                {
                    <partial name="_Estados" model="ViewBag.Perfil" />
                }
            </section>

            <section class="card tarjeta">
                <h2 class="card-title">¿Buscás a alguien?</h2>
                <p class="texto-suave">También podés publicar una búsqueda. La revisamos antes de publicarla.</p>
                <a class="btn-outline theme-primary boton w-100" asp-controller="Publicaciones" asp-action="Nueva">+ Publicar búsqueda</a>
            </section>
        </aside>
    </div>
</div>
