@{
    ViewData["Title"] = "Inicio";
}

<div class="contenedor seccion-app">
    <header class="panel-saludo">
        <div>
            <p class="panel-saludo-fecha">@Vistas.Hoy</p>
            <h1 class="encabezado-pagina-titulo">Hola, @ViewBag.Perfil.Usuario.Nombre</h1>
            <p class="encabezado-pagina-bajada">
                @(ViewBag.Perfil.TotalPostulaciones == 0
                    ? "Todavía no te postulaste a ninguna búsqueda."
                    : $"Tenés {ViewBag.Perfil.TotalPostulaciones} {(ViewBag.Perfil.TotalPostulaciones == 1 ? "postulación" : "postulaciones")} en tu tablero.")
            </p>
        </div>
        <form class="panel-saludo-buscador" asp-controller="Empleos" asp-action="Index" method="get" role="search">
            <div class="control-con-icono">
                <icono nombre="search" />
                <label class="solo-lectores" for="panel-busqueda">Buscar trabajo</label>
                <input class="campo-control" id="panel-busqueda" type="search" name="Q" maxlength="100" placeholder="¿Qué trabajo buscás?" />
            </div>
            <button class="boton" type="submit">Buscar</button>
        </form>
    </header>

    @if (ViewBag.Perfil.SiguientePaso != null)
    {
        <a class="aviso-perfil" asp-controller="Perfil" asp-action="Completar">
            <span class="caja-icono caja-icono-sm"><icono nombre="user-square" /></span>
            <span class="aviso-perfil-texto"><strong>Tu perfil está al @ViewBag.Perfil.PorcentajeCompleto%.</strong> Te falta: @ViewBag.Perfil.SiguientePaso.Texto.ToLower(Vistas.Cultura). Quienes publican búsquedas lo ven cuando te postulás.</span>
            <span class="boton boton-sm">Completar perfil</span>
        </a>
    }

    <div class="panel-grilla">
        <div class="panel-grilla-principal">
            <section class="tarjeta" aria-labelledby="panel-para-vos">
                <div class="tarjeta-encabezado">
                    <h2 class="tarjeta-titulo" id="panel-para-vos">@(string.IsNullOrWhiteSpace(ViewBag.Puesto) ? "Ofertas para vos" : $"Ofertas de {ViewBag.Puesto}")</h2>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Puesto))
                    {
                        <a class="enlace" asp-controller="Empleos" asp-action="Index" asp-route-Q="@ViewBag.Puesto">Ver todas →</a>
                    }
                </div>
                @if (string.IsNullOrWhiteSpace(ViewBag.Puesto))
                {
                    <div class="estado-vacio estado-vacio-chico">
                        <p>Contanos qué puesto buscás y acá te mostramos las ofertas de Workly y de otros sitios que coinciden.</p>
                        <a class="boton boton-contorno boton-sm" asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda"><icono nombre="plus" />Completar qué busco</a>
                    </div>
                }
                else
                {
                    @if (ViewBag.ErrorExternas)
                    {
                        <partial name="_AvisoExternas" />
                    }
                    @if (ViewBag.ParaVos.Count == 0)
                    {
                        <div class="estado-vacio estado-vacio-chico">
                            <p>No encontramos ningún puesto de "@ViewBag.Puesto" nuevo para vos. Probá buscar con otras palabras.</p>
                            <a class="boton boton-contorno boton-sm" asp-controller="Empleos" asp-action="Index"><icono nombre="search" />Buscar trabajo</a>
                        </div>
                    }
                    else
                    {
                        <div class="resultados-lista">
                            @foreach (Oferta oferta in ViewBag.ParaVos)
                            {
                                <partial name="_OfertaTarjeta" model="oferta" />
                            }
                        </div>
                    }
                }
            </section>
        </div>

        <aside class="panel-grilla-lateral">
            <section class="tarjeta">
                <div class="tarjeta-encabezado">
                    <h2 class="tarjeta-titulo">Tus postulaciones</h2>
                    @if (ViewBag.Perfil.TotalPostulaciones > 0)
                    {
                        <a class="enlace" asp-controller="Postulaciones" asp-action="Index">Ir al tablero →</a>
                    }
                </div>
                @if (ViewBag.Perfil.TotalPostulaciones == 0)
                {
                    <p class="perfil-vacio">Cuando te postules, vas a poder seguir cada proceso desde tu tablero.</p>
                }
                else
                {
                    <ul class="actividad-estados" role="list">
                        @foreach (var etapa in Catalogos.EstadosPostulacion)
                        {
                            <li class="actividad-estados-item actividad-estados-item-@etapa.Color">
                                <strong>@ViewBag.Perfil.CantidadEnEstado(etapa.Estado)</strong><span>@etapa.Estado</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="tarjeta">
                <h2 class="tarjeta-titulo">¿Buscás a alguien?</h2>
                <p class="texto-suave">También podés publicar una búsqueda. La revisamos antes de publicarla.</p>
                <a class="boton boton-contorno boton-bloque" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar búsqueda</a>
            </section>
        </aside>
    </div>
</div>
