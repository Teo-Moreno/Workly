@inject Captcha Generador
@{
    ViewData["Title"] = "Recuperar contraseña";
    var captcha = Generador.Nuevo();
}
@section Barra {
    <p>¿Te acordaste? <a asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a></p>
}

<h1 class="titulo">Creá una contraseña nueva</h1>
<p class="texto-suave">Escribí el email de tu cuenta y te mandamos un link para elegir una contraseña nueva. El link vence en 1 hora.</p>

<partial name="_ErroresFormulario" />

<form class="formulario" asp-controller="Cuenta" asp-action="RecuperarClave" asp-route-CaptchaToken="@captcha.Token" method="post">
    <div class="form-field @Html.ClaseError("Email")">
        <label class="form-label" for="Email">Email</label>
        <input class="form-control" id="Email" name="Email" value="@ViewBag.Formulario.Email" type="email" autocomplete="email" placeholder="tu@mail.com" required>
        <p class="error-texto">@Html.MensajeError("Email", "Ingresá un email válido")</p>
    </div>

    <partial name="_Captcha" model="captcha" />

    <button class="btn-solid theme-primary boton w-100" type="submit">Mandarme el link</button>
</form>
