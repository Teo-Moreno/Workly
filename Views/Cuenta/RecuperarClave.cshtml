@inject Captcha Generador
@{
    ViewData["Title"] = "Recuperar contraseña";
}
@section Barra {
    <p class="text-body-secondary">¿Te acordaste? <a class="enlace" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a></p>
}

<div class="cuenta-tarjeta">
    <h1 class="cuenta-tarjeta-titulo">Creá una contraseña nueva</h1>
    <p class="cuenta-tarjeta-bajada">Escribí el email de tu cuenta y te mandamos un link para elegir una contraseña nueva. El link vence en 1 hora.</p>

    <partial name="_ErroresFormulario" />

    <form class="formulario" asp-controller="Cuenta" asp-action="RecuperarClave" method="post" novalidate data-formulario-real>
        <div class="campo @Html.ClaseError("Email")">
            <label class="form-label" for="Email">Email</label>
            <div class="control-con-icono">
                <icono nombre="mail" />
                <input class="form-control" id="Email" name="Email" value="@ViewBag.Formulario.Email" type="email" autocomplete="email" placeholder="tu@mail.com" required autofocus />
            </div>
            <span class="invalid-feedback"><icono nombre="warning" />@Html.MensajeError("Email", "Ingresá un email válido")</span>
        </div>

        <partial name="_Captcha" model="Generador.Nuevo()" />

        <button class="btn btn-block-lg" type="submit"><icono nombre="send" />Mandarme el link</button>
    </form>
</div>
