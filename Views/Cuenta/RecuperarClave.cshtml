@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="columna-angosta">
    <h1 class="titulo-grande">Creá una contraseña nueva</h1>
    <p class="subtitulo-pegado">Escribí el email de tu cuenta y te mandamos un link para elegir una contraseña nueva. El link vence en 1 hora.</p>

    <partial name="_ErroresFormulario" />

    <form class="grilla-campos" action="/Cuenta/RecuperarClave" method="post" novalidate data-formulario-real>
        @Html.AntiForgeryToken()
        <div class="campo" aria-invalid="@(ViewBag.Errores.Tiene("Email") ? "true" : null)">
            <label class="form-label" for="Email">Email</label>
            <div class="control-con-icono" data-icono="mail">
                <input class="form-control" id="Email" name="Email" value="@ViewBag.Formulario.Email" type="email" autocomplete="email" placeholder="tu@mail.com" required autofocus />
            </div>
            <span class="invalid-feedback" data-icono="warning">@ViewBag.Errores.Mensaje("Email", "Ingresá un email válido")</span>
        </div>

        <partial name="_Captcha" model="ViewBag.Captcha" />

        <button class="btn btn-block-lg" type="submit" data-icono="send">Mandarme el link</button>
    </form>
</div>
