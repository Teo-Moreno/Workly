@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="cuenta-tarjeta">
    <span class="caja-icono caja-icono--acento cuenta-tarjeta__icono"><icono nombre="lock" /></span>
    <h1 class="cuenta-tarjeta__titulo">¿Olvidaste tu contraseña?</h1>
    <p class="cuenta-tarjeta__bajada">Escribí el email con el que te registraste y te mandamos un enlace para crear una nueva.</p>

    <form class="formulario" data-demo-form="Te enviamos un mail con el enlace para cambiar tu contraseña." data-redirigir="@Url.Action("IniciarSesion", "Cuenta")" novalidate>
        <div class="campo">
            <label class="campo__etiqueta" for="recuperar-email">Email</label>
            <div class="control-con-icono">
                <icono nombre="mail" />
                <input class="campo__control" id="recuperar-email" type="email" autocomplete="email" placeholder="tu@mail.com" required />
            </div>
            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />Ingresá un email válido</span>
        </div>
        <button class="boton boton--lg boton--bloque" type="submit"><icono nombre="send" />Enviar enlace</button>
    </form>

    <a class="enlace enlace--principal cuenta-tarjeta__volver" asp-controller="Cuenta" asp-action="IniciarSesion"><icono nombre="arrow-left" tamano="18" />Volver a iniciar sesión</a>
</div>
