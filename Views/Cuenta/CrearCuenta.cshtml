@model RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}
@section Barra {
    <p class="texto-suave">¿Ya tenés cuenta? <a class="enlace" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a></p>
}
@* Registro en 3 pasos (tablas Usuario, Perfil y CV). Usa la "Barra de progreso"
   de Figma › Guidelines › 08. Selectores y elementos. *@

<div class="cuenta-tarjeta cuenta-tarjeta--ancha">
    <h1 class="cuenta-tarjeta__titulo">Creá tu cuenta</h1>
    <p class="cuenta-tarjeta__bajada">Te lleva menos de 4 minutos. Paso <strong data-paso-actual>1</strong> de 3.</p>

    <ol class="pasos registro__pasos" aria-label="Progreso del registro">
        <li class="pasos__item esta-actual" data-paso-indicador>
            <span class="pasos__circulo"><span class="pasos__numero">1</span><icono nombre="check" /></span>
            Tus datos
        </li>
        <li class="pasos__item" data-paso-indicador>
            <span class="pasos__circulo"><span class="pasos__numero">2</span><icono nombre="check" /></span>
            Tu perfil
        </li>
        <li class="pasos__item" data-paso-indicador>
            <span class="pasos__circulo"><span class="pasos__numero">3</span><icono nombre="check" /></span>
            Tu CV
        </li>
    </ol>

    <partial name="_ErroresFormulario" />

    <form class="registro" asp-controller="Cuenta" asp-action="CrearCuenta" method="post" enctype="multipart/form-data" novalidate data-pasos-form data-formulario-real>
        @* ---------------- Paso 1 · Tus datos (Usuario) ---------------- *@
        <fieldset class="formulario registro__paso" data-paso>
            <legend class="solo-lectores">Paso 1: tus datos</legend>
            <div class="formulario__fila">
                <div class="campo @Html.ClaseError(nameof(Model.Nombre))">
                    <label class="campo__etiqueta" asp-for="Nombre">Nombre</label>
                    <input class="campo__control" asp-for="Nombre" autocomplete="given-name" placeholder="Escribí acá" maxlength="50" required />
                    <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.Nombre), "Completá tu nombre")</span>
                </div>
                <div class="campo @Html.ClaseError(nameof(Model.Apellido))">
                    <label class="campo__etiqueta" asp-for="Apellido">Apellido</label>
                    <input class="campo__control" asp-for="Apellido" autocomplete="family-name" placeholder="Escribí acá" maxlength="50" required />
                    <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.Apellido), "Completá tu apellido")</span>
                </div>
            </div>

            <div class="campo @Html.ClaseError(nameof(Model.Email))">
                <label class="campo__etiqueta" asp-for="Email">Email</label>
                <div class="control-con-icono">
                    <icono nombre="mail" />
                    <input class="campo__control" asp-for="Email" type="email" autocomplete="email" placeholder="tu@mail.com" maxlength="100" required />
                </div>
                <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.Email), "Ingresá un email válido")</span>
            </div>

            <div class="campo @Html.ClaseError(nameof(Model.Contrasena))">
                <label class="campo__etiqueta" asp-for="Contrasena">Contraseña</label>
                <div class="control-con-icono">
                    <icono nombre="lock" />
                    <input class="campo__control" asp-for="Contrasena" type="password" value="" autocomplete="new-password" placeholder="Mínimo 8 caracteres"
                           minlength="8" maxlength="100" pattern="(?=.*[A-Za-zÁÉÍÓÚÜÑáéíóúüñ])(?=.*\d).{8,}" required />
                    <button class="control-con-icono__boton" type="button" aria-label="Mostrar contraseña" aria-pressed="false" data-ver-clave><icono nombre="eye" /></button>
                </div>
                <span class="campo__ayuda">Al menos 8 caracteres, con letras y números.</span>
                <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.Contrasena), "Usá al menos 8 caracteres, con una letra y un número")</span>
            </div>

            <div class="campo @Html.ClaseError(nameof(Model.AceptaTerminos))">
                <label class="casilla casilla--sm">
                    <input asp-for="AceptaTerminos" type="checkbox" required />
                    <span class="casilla__caja"><icono nombre="check" /></span>
                    <span>Acepto los <a class="enlace" asp-controller="Home" asp-action="Terminos" target="_blank">Términos</a> y la <a class="enlace" asp-controller="Home" asp-action="Privacy" target="_blank">Política de privacidad</a></span>
                </label>
                <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.AceptaTerminos), "Tenés que aceptar los términos para continuar")</span>
            </div>

            <div class="registro__acciones">
                <span></span>
                <button class="boton boton--lg" type="button" data-paso-siguiente>Siguiente<icono nombre="arrow-right" /></button>
            </div>
        </fieldset>

        @* ---------------- Paso 2 · Tu perfil (Perfil) ---------------- *@
        <fieldset class="formulario registro__paso" data-paso hidden>
            <legend class="solo-lectores">Paso 2: tu perfil</legend>

            <div class="campo @Html.ClaseError(nameof(Model.Foto))">
                <span class="campo__etiqueta">Foto de perfil <span class="campo__opcional">(opcional)</span></span>
                <div class="subir-foto">
                    <span class="avatar avatar--xl subir-foto__vista" data-vista-foto aria-hidden="true"><icono nombre="user" tamano="40" /></span>
                    <div class="pila" style="--pila-espacio: 8px">
                        <label class="boton boton--contorno boton--sm boton--archivo">
                            <icono nombre="upload" />Elegir foto
                            <input asp-for="Foto" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-foto-entrada
                                   data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí una imagen JPG, PNG o WEBP" />
                        </label>
                        <span class="texto-chico texto-suave">JPG, PNG o WEBP de hasta 5 MB.</span>
                    </div>
                </div>
                <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.Foto), "Subí una imagen JPG, PNG o WEBP")</span>
            </div>

            <div class="formulario__fila">
                <div class="campo @Html.ClaseError(nameof(Model.Ubicacion))">
                    <label class="campo__etiqueta" asp-for="Ubicacion">¿Dónde vivís?</label>
                    <select class="campo__control" asp-for="Ubicacion" required>
                        <option value="">Elegí una opción</option>
                        @foreach (var ubicacion in RegistroViewModel.Ubicaciones)
                        {
                            <option value="@ubicacion">@ubicacion</option>
                        }
                    </select>
                    <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.Ubicacion), "Elegí dónde vivís")</span>
                </div>
                <div class="campo @Html.ClaseError(nameof(Model.Telefono))">
                    <label class="campo__etiqueta" asp-for="Telefono">Teléfono <span class="campo__opcional">(opcional)</span></label>
                    <input class="campo__control" asp-for="Telefono" type="tel" autocomplete="tel" placeholder="+54 11 5555-1234" maxlength="30" pattern="[0-9+\(\)\s\-]{6,30}" />
                    <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.Telefono), "Ingresá solo números, espacios y + ( ) -")</span>
                </div>
            </div>

            <div class="campo @Html.ClaseError(nameof(Model.Descripcion))">
                <label class="campo__etiqueta" asp-for="Descripcion">Contanos sobre vos <span class="campo__opcional">(opcional)</span></label>
                <textarea class="campo__control" asp-for="Descripcion" rows="4" maxlength="500" placeholder="Qué hacés, qué te gusta y qué tipo de trabajo estás buscando."></textarea>
                <span class="campo__ayuda">Aparece en la sección "Sobre mí" de tu perfil. Hasta 500 caracteres.</span>
                <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.Descripcion), "Usá hasta 500 caracteres")</span>
            </div>

            <div class="registro__acciones">
                <button class="boton boton--contorno boton--lg" type="button" data-paso-anterior><icono nombre="arrow-left" />Atrás</button>
                <button class="boton boton--lg" type="button" data-paso-siguiente>Siguiente<icono nombre="arrow-right" /></button>
            </div>
        </fieldset>

        @* ---------------- Paso 3 · Tu CV (CV) ---------------- *@
        <fieldset class="formulario registro__paso" data-paso hidden>
            <legend class="solo-lectores">Paso 3: tu CV</legend>

            <div class="campo @Html.ClaseError(nameof(Model.ArchivoCV))">
                <span class="campo__etiqueta">CV <span class="campo__opcional">(opcional, lo podés subir después)</span></span>
                <label class="zona-archivo" data-zona-archivo>
                    <span class="caja-icono"><icono nombre="upload" /></span>
                    <strong class="zona-archivo__nombre" data-zona-archivo-nombre>Arrastrá tu CV acá o hacé clic para subirlo</strong>
                    <span class="texto-chico">PDF, DOC o DOCX de hasta 5 MB</span>
                    <input asp-for="ArchivoCV" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                           data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí un archivo PDF, DOC o DOCX" />
                </label>
                <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.ArchivoCV), "Subí un archivo PDF, DOC o DOCX")</span>
            </div>

            <div class="campo @Html.ClaseError(nameof(Model.SitioWeb))">
                <label class="campo__etiqueta" asp-for="SitioWeb">Sitio web, portfolio o LinkedIn <span class="campo__opcional">(opcional)</span></label>
                <div class="control-con-icono">
                    <icono nombre="globe" />
                    <input class="campo__control" asp-for="SitioWeb" type="text" inputmode="url" autocomplete="url" placeholder="tusitio.com" maxlength="200" />
                </div>
                <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError(nameof(Model.SitioWeb), "Usá hasta 200 caracteres")</span>
            </div>

            @if (Model.Foto != null || Model.ArchivoCV != null)
            {
                <p class="texto-chico texto-suave">Por seguridad, si hubo un error tenés que volver a elegir la foto y el CV.</p>
            }

            <div class="registro__acciones">
                <button class="boton boton--contorno boton--lg" type="button" data-paso-anterior><icono nombre="arrow-left" />Atrás</button>
                <button class="boton boton--acento boton--lg" type="submit">Crear mi cuenta</button>
            </div>
        </fieldset>
    </form>
</div>
