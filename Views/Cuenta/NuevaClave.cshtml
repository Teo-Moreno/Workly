@{
    ViewData["Title"] = "Contraseña nueva";
}

<h1 class="titulo">Elegí tu contraseña nueva</h1>
<p class="texto-suave">Después vas a poder iniciar sesión con ella.</p>

<partial name="_ErroresFormulario" />

<form class="formulario" asp-controller="Cuenta" asp-action="NuevaClave" asp-route-Token="@ViewBag.Formulario.Token" method="post">
    <div class="form-field @Html.ClaseError("Nueva")">
        <label class="form-label" for="clave-nueva">Contraseña nueva</label>
        <input class="form-control" id="clave-nueva" name="Nueva" type="password" autocomplete="new-password" required>
        <p class="form-text">Al menos 8 caracteres, con letras y números.</p>
        <p class="error-texto">@Html.MensajeError("Nueva", "Usá al menos 8 caracteres, con una letra y un número")</p>
    </div>
    <div class="form-field @Html.ClaseError("Repetir")">
        <label class="form-label" for="clave-repetir">Repetí la contraseña nueva</label>
        <input class="form-control" id="clave-repetir" name="Repetir" type="password" autocomplete="new-password" required>
        <p class="error-texto">@Html.MensajeError("Repetir", "Las contraseñas no coinciden")</p>
    </div>
    <button class="btn-solid theme-primary boton w-100" type="submit">Guardar contraseña</button>
</form>
