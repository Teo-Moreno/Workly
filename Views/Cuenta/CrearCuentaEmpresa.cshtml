@{
    ViewData["Title"] = "Crear cuenta de empresa";
}
@section Barra {
    <p>¿Ya tenés cuenta? <a asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a></p>
}

<h1 class="titulo">Registrá tu empresa</h1>
<p class="texto-suave">Con la cuenta de empresa publicás búsquedas y ves quién se postula.</p>

<partial name="_TipoCuenta" model='"empresa"' />

<partial name="_ErroresFormulario" />

@if (!ViewBag.Formulario.EsExterno)
{
    <partial name="_BotonesExternos" model='new BotonesExternos("Registrarte", "empresa", null)' />
}

<form class="formulario" asp-controller="Cuenta" asp-action="CrearCuentaEmpresa" method="post" enctype="multipart/form-data">
    <h2 class="subtitulo">1. @RegistroEmpresaViewModel.Pasos[0]</h2>
    @if (ViewBag.Formulario.EsExterno)
    {
        <p class="mensaje mensaje-exito">Te vas a registrar con tu cuenta de @ViewBag.Formulario.ProveedorExterno. No necesitás contraseña.</p>
    }
    <div class="dos-columnas">
        <div class="form-field @Html.ClaseError("Nombre")">
            <label class="form-label" for="Nombre">Tu nombre</label>
            <input class="form-control" id="Nombre" name="Nombre" value="@ViewBag.Formulario.Nombre" type="text" autocomplete="given-name" placeholder="Escribí acá" required>
            <p class="error-texto">@Html.MensajeError("Nombre", "Completá tu nombre")</p>
        </div>
        <div class="form-field @Html.ClaseError("Apellido")">
            <label class="form-label" for="Apellido">Tu apellido</label>
            <input class="form-control" id="Apellido" name="Apellido" value="@ViewBag.Formulario.Apellido" type="text" autocomplete="family-name" placeholder="Escribí acá" required>
            <p class="error-texto">@Html.MensajeError("Apellido", "Completá tu apellido")</p>
        </div>
    </div>

    <div class="form-field @Html.ClaseError("Email")">
        <label class="form-label" for="Email">Email de la empresa</label>
        @if (ViewBag.Formulario.EsExterno)
        {
            <p class="form-control">@ViewBag.Formulario.Email</p>
        }
        else
        {
            <input class="form-control" id="Email" name="Email" value="@ViewBag.Formulario.Email" type="email" autocomplete="email" placeholder="nombre@tuempresa.com.ar" required>
        }
        <p class="form-text">Tiene que ser del mismo dominio que el sitio web de la empresa. No se aceptan Gmail, Hotmail, Outlook ni similares.</p>
        <p class="error-texto">@Html.MensajeError("Email", "Ingresá un email válido")</p>
    </div>

    @if (!ViewBag.Formulario.EsExterno)
    {
        <partial name="_CampoContrasena" />
    }

    <h2 class="subtitulo">2. @RegistroEmpresaViewModel.Pasos[1]</h2>
    <p class="texto-suave">Con estos datos comprobamos que la empresa existe: el CUIT tiene que ser válido y el email, del dominio de su sitio web.</p>

    <div class="dos-columnas">
        <div class="form-field @Html.ClaseError("NombreEmpresa")">
            <label class="form-label" for="NombreEmpresa">Nombre de la empresa</label>
            <input class="form-control" id="NombreEmpresa" name="NombreEmpresa" value="@ViewBag.Formulario.NombreEmpresa" type="text" autocomplete="organization" placeholder="Como la conoce la gente" required>
            <p class="error-texto">@Html.MensajeError("NombreEmpresa", "Completá el nombre de la empresa")</p>
        </div>
        <div class="form-field @Html.ClaseError("RazonSocial")">
            <label class="form-label" for="RazonSocial">Razón social</label>
            <input class="form-control" id="RazonSocial" name="RazonSocial" value="@ViewBag.Formulario.RazonSocial" type="text" placeholder="Ej.: Nombre S.A., Nombre S.R.L." required>
            <p class="error-texto">@Html.MensajeError("RazonSocial", "Completá la razón social")</p>
        </div>
        <div class="form-field @Html.ClaseError("CUIT")">
            <label class="form-label" for="CUIT">CUIT</label>
            <input class="form-control" id="CUIT" name="CUIT" value="@ViewBag.Formulario.CUIT" type="text" placeholder="30-12345678-9" required>
            <p class="form-text">11 números, con o sin guiones.</p>
            <p class="error-texto">@Html.MensajeError("CUIT", "Ingresá los 11 números del CUIT")</p>
        </div>
        <div class="form-field @Html.ClaseError("Rubro")">
            <label class="form-label" for="Rubro">Rubro</label>
            <select class="form-control" id="Rubro" name="Rubro" required>
                <partial name="_Opciones" model='new OpcionesSelect((string?)ViewBag.Formulario.Rubro, Catalogos.Rubros, "Elegí el rubro")' />
            </select>
            <p class="error-texto">@Html.MensajeError("Rubro", "Elegí el rubro")</p>
        </div>
    </div>

    <div class="form-field @Html.ClaseError("SitioWeb")">
        <label class="form-label" for="SitioWeb">Sitio web de la empresa</label>
        <input class="form-control" id="SitioWeb" name="SitioWeb" value="@ViewBag.Formulario.SitioWeb" type="text" autocomplete="url" placeholder="tuempresa.com.ar" required>
        <p class="error-texto">@Html.MensajeError("SitioWeb", "Ingresá el sitio web de la empresa")</p>
    </div>

    <partial name="_CampoUbicacion" model='new CampoUbicacion { Paises = ViewBag.Formulario.Paises, Provincias = ViewBag.Formulario.Provincias, IDPais = ViewBag.Formulario.IDPais, IDProvincia = ViewBag.Formulario.IDProvincia, EtiquetaProvincia = "Provincia de la sede" }' />

    <div class="dos-columnas">
        <div class="form-field @Html.ClaseError("Ubicacion")">
            <label class="form-label" for="Ubicacion">Localidad o dirección <span class="opcional">(opcional)</span></label>
            <input class="form-control" id="Ubicacion" name="Ubicacion" value="@ViewBag.Formulario.Ubicacion" type="text" placeholder="Ej.: Palermo, CABA">
            <p class="error-texto">@Html.MensajeError("Ubicacion", "Usá hasta 100 caracteres")</p>
        </div>
        <partial name="_CampoTelefono" model='new CampoTelefono { Valor = ViewBag.Formulario.Telefono, Prefijo = ViewBag.Formulario.PrefijoTelefono }' />
    </div>

    <div class="form-field @Html.ClaseError("Descripcion")">
        <label class="form-label" for="Descripcion">¿Qué hace la empresa?</label>
        <textarea class="form-control" id="Descripcion" name="Descripcion" rows="4" required placeholder="Contá en pocas líneas a qué se dedica la empresa.">@ViewBag.Formulario.Descripcion</textarea>
        <p class="form-text">Aparece en la página de la empresa. Hasta 500 caracteres.</p>
        <p class="error-texto">@Html.MensajeError("Descripcion", "Contá en pocas líneas qué hace la empresa")</p>
    </div>

    <div class="form-field @Html.ClaseError("Logo")">
        <label class="form-label" for="Logo">Logo <span class="opcional">(opcional, JPG, PNG o WEBP de hasta 5 MB)</span></label>
        <input class="form-control" id="Logo" name="Logo" type="file">
        @if (ViewBag.Formulario.Logo != null)
        {
            <p class="form-text">Por seguridad, si hubo un error tenés que volver a elegir el logo.</p>
        }
        <p class="error-texto">@Html.MensajeError("Logo", "Subí una imagen JPG, PNG o WEBP")</p>
    </div>

    <partial name="_AceptaTerminos" />

    <button class="btn-solid theme-primary boton boton-acento w-100" type="submit">Crear cuenta de empresa</button>
</form>
