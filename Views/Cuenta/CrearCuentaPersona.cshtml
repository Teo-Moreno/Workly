@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="columna-media">
    <h1 class="titulo-grande">Creá tu cuenta</h1>
    <p class="subtitulo-pegado">Solo te pedimos lo básico. El resto lo completás después desde tu perfil.</p>

    <partial name="_TipoCuenta" model="ViewBag.TipoCuenta" />

    <partial name="_ErroresFormulario" />

    @if (!ViewBag.Formulario.EsExterno)
    {
        <partial name="_BotonesExternos" model="ViewBag.BotonesExternos" />
    }

    <form class="sin-grilla" action="/Cuenta/CrearCuentaPersona" method="post" novalidate data-formulario-real>
        @Html.AntiForgeryToken()
        <fieldset class="paso-animado">
            <legend class="visually-hidden">Tus datos</legend>
            @if (ViewBag.Formulario.EsExterno)
            {
                <p class="nota-turquesa"><icono nombre="circle-check" />Te vas a registrar con tu cuenta de @ViewBag.Formulario.ProveedorExterno. No necesitás contraseña.</p>
            }
            <div class="columnas">
                <div class="campo" aria-invalid="@(ViewBag.Errores.Tiene("Nombre") ? "true" : null)">
                    <label class="form-label" for="Nombre">Nombre</label>
                    <input class="form-control" id="Nombre" name="Nombre" value="@ViewBag.Formulario.Nombre" autocomplete="given-name" placeholder="Escribí acá" maxlength="50" required />
                    <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Nombre", "Completá tu nombre")</span>
                </div>
                <div class="campo" aria-invalid="@(ViewBag.Errores.Tiene("Apellido") ? "true" : null)">
                    <label class="form-label" for="Apellido">Apellido</label>
                    <input class="form-control" id="Apellido" name="Apellido" value="@ViewBag.Formulario.Apellido" autocomplete="family-name" placeholder="Escribí acá" maxlength="50" required />
                    <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Apellido", "Completá tu apellido")</span>
                </div>
            </div>

            <div class="campo" aria-invalid="@(ViewBag.Errores.Tiene("Email") ? "true" : null)">
                <label class="form-label" for="Email">Email</label>
                <div class="control-con-icono">
                    <icono nombre="mail" />
                    <input class="form-control" id="Email" name="Email" value="@ViewBag.Formulario.Email" type="email" autocomplete="email" placeholder="tu@mail.com" maxlength="100" required readonly="@ViewBag.Formulario.EsExterno" />
                </div>
                <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Email", "Ingresá un email válido")</span>
            </div>

            @if (!ViewBag.Formulario.EsExterno)
            {
                <partial name="_CampoContrasena" />
            }

            <partial name="_AceptaTerminos" />

            <div class="acciones-entre">
                <span></span>
                <button class="btn btn-warning-lg" type="submit">Crear mi cuenta</button>
            </div>
        </fieldset>
    </form>
</div>
