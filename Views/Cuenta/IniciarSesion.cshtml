@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="columna-angosta">
    <h1 class="titulo-grande">Iniciá sesión</h1>
    <p class="subtitulo-pegado">Seguí tu búsqueda donde la dejaste.</p>

    <partial name="_ErroresFormulario" />

    <partial name="_BotonesExternos" model="ViewBag.BotonesExternos" />

    <form class="grilla-campos" action="/Cuenta/IniciarSesion" method="post" novalidate data-formulario-real>
        @Html.AntiForgeryToken()
        <input type="hidden" id="ReturnUrl" name="ReturnUrl" value="@ViewBag.Formulario.ReturnUrl" />

        <div class="campo @ViewBag.Errores.ClaseConGenerales("Email")">
            <label class="form-label" for="Email">Email</label>
            <div class="control-con-icono">
                <icono nombre="mail" />
                <input class="form-control" id="Email" name="Email" value="@ViewBag.Formulario.Email" type="text" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="tu@mail.com" required autofocus />
            </div>
            <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Email", "Ingresá un email válido")</span>
        </div>

        <div class="campo @ViewBag.Errores.ClaseConGenerales("Contrasena")">
            <label class="form-label" for="Contrasena">Contraseña</label>
            <div class="control-con-icono">
                <icono nombre="lock" />
                <input class="form-control" id="Contrasena" name="Contrasena" type="password" value="" autocomplete="current-password" placeholder="Tu contraseña" required />
                <button class="control-icono-derecha" type="button" aria-label="Mostrar contraseña" aria-pressed="false" data-ver-clave><icono nombre="eye" /></button>
            </div>
            <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Contrasena", "Ingresá tu contraseña")</span>
        </div>

        @if (ViewBag.PideCaptcha == true)
        {
            <partial name="_Captcha" model="ViewBag.Captcha" />
        }

        <div class="fila fila-entre">
            <label class="form-check">
                <input class="form-check-input" id="Recordarme" name="Recordarme" value="true" checked="@ViewBag.Formulario.Recordarme" type="checkbox" />
                <span class="form-check-label">Recordarme</span>
            </label>
            @if (ViewBag.MailConfigurado)
            {
                <a class="resaltado small" href="/Cuenta/RecuperarClave">¿Olvidaste tu contraseña?</a>
            }
        </div>

        <button class="btn btn-block-lg" type="submit">Iniciar sesión</button>
    </form>

    <div class="separador"><span>o</span></div>

    <a class="btn btn-outline-block" href="/Cuenta/CrearCuenta"><icono nombre="user" />Crear una cuenta nueva</a>

    <p class="nota-centrada">Al ingresar aceptás los <a class="resaltado" href="/Home/Terminos">Términos</a> y la <a class="resaltado" href="/Home/Privacy">Política de privacidad</a> de Workly.</p>
</div>
