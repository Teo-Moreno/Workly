@inject Correo Mail
@inject Captcha Generador
@{
    ViewData["Title"] = "Iniciar sesión";
    var captcha = ViewBag.PideCaptcha == true ? Generador.Nuevo() : null;
    var hayError = Html.ErroresGenerales().Any();
}
@section Barra {
    <p>¿No tenés cuenta? <a asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a></p>
}

<h1 class="titulo">Iniciá sesión</h1>
<p class="texto-suave">Seguí tu búsqueda donde la dejaste.</p>

<partial name="_ErroresFormulario" />

<partial name="_BotonesExternos" model='new BotonesExternos("Iniciar sesión", null, ViewBag.Formulario.ReturnUrl)' />

<form class="formulario" asp-controller="Cuenta" asp-action="IniciarSesion" asp-route-ReturnUrl="@ViewBag.Formulario.ReturnUrl" asp-route-CaptchaToken="@captcha?.Token" method="post">
    <div class="form-field @(hayError ? "" : Html.ClaseError("Email"))">
        <label class="form-label" for="Email">Email</label>
        <input class="form-control" id="Email" name="Email" value="@ViewBag.Formulario.Email" type="email" autocomplete="email" placeholder="tu@mail.com" required>
        <p class="error-texto">@Html.MensajeError("Email", "Ingresá un email válido")</p>
    </div>

    <div class="form-field @(hayError ? "" : Html.ClaseError("Contrasena"))">
        <label class="form-label" for="Contrasena">Contraseña</label>
        <input class="form-control" id="Contrasena" name="Contrasena" type="password" value="" autocomplete="current-password" placeholder="Tu contraseña" required>
        <p class="error-texto">@Html.MensajeError("Contrasena", "Ingresá tu contraseña")</p>
    </div>

    @if (captcha != null)
    {
        <partial name="_Captcha" model="captcha" />
    }

    <div class="d-flex justify-content-between align-items-center">
        <label class="casilla">
            <input id="Recordarme" name="Recordarme" value="true" checked="@ViewBag.Formulario.Recordarme" type="checkbox">
            Recordarme
        </label>
        @if (Mail.Configurado)
        {
            <a asp-controller="Cuenta" asp-action="RecuperarClave">¿Olvidaste tu contraseña?</a>
        }
    </div>

    <button class="btn-solid theme-primary boton w-100" type="submit">Iniciar sesión</button>
</form>

<p class="separador">o</p>

<a class="btn-outline theme-primary boton w-100" asp-controller="Cuenta" asp-action="CrearCuenta">Crear una cuenta nueva</a>

<p class="texto-suave">Al ingresar aceptás los <a asp-controller="Home" asp-action="Terminos">Términos</a> y la <a asp-controller="Home" asp-action="Privacy">Política de privacidad</a> de Workly.</p>
