@{
    ViewData["Title"] = "Verificá tu email";
}

<h1 class="titulo">Revisá tu email</h1>
<p class="texto-suave">Te mandamos un código de @VerificacionEmail.Digitos números a <span class="negrita">@ViewBag.Formulario.Email</span>. Escribilo acá para terminar de crear tu cuenta.</p>

<partial name="_ErroresFormulario" />

<form class="formulario" asp-controller="Cuenta" asp-action="VerificarEmail" asp-route-Token="@ViewBag.Formulario.Token" method="post">
    <div class="form-field @Html.ClaseError("Codigo")">
        <label class="form-label" for="Codigo">Código</label>
        <input class="form-control codigo" id="Codigo" name="Codigo" value="@ViewBag.Formulario.Codigo" type="text" autocomplete="one-time-code" placeholder="000000" required>
        <p class="form-text">Vence en @VerificacionEmail.Vigencia.TotalMinutes.ToString("0") minutos. Si no te llegó, revisá la carpeta de spam.</p>
        <p class="error-texto">@Html.MensajeError("Codigo", "El código tiene 6 números")</p>
    </div>
    <button class="btn-solid theme-primary boton boton-acento w-100" type="submit">Verificar y crear mi cuenta</button>
</form>

<form asp-controller="Cuenta" asp-action="ReenviarCodigo" asp-route-token="@ViewBag.Formulario.Token" method="post">
    <button class="btn-outline theme-primary boton w-100" type="submit">Mandarme otro código</button>
</form>
<p class="texto-suave">¿Escribiste mal el email? <a asp-controller="Cuenta" asp-action="CrearCuenta">Volvé al registro</a></p>
