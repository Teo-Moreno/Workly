@{
    ViewData["Title"] = "Asistente";
}

<div class="container seccion asistente">
    <div class="encabezado">
        <div>
            <h1 class="titulo">Asistente</h1>
            <p class="texto-suave">Contale qué trabajo buscás y dónde, y te recomendamos ofertas que están en Workly.</p>
        </div>
        @if (ViewBag.Mensajes.Count > 0)
        {
            <a class="btn-outline theme-primary boton" asp-controller="Asistente" asp-action="Index">Empezar de nuevo</a>
        }
    </div>

    @if (!ViewBag.Disponible)
    {
        <p class="mensaje mensaje-info">El asistente no está disponible en este momento. Mientras tanto, podés usar <a asp-controller="Empleos" asp-action="Index">Buscar trabajo</a>.</p>
    }
    else
    {
        <ol class="conversacion" aria-label="Conversación">
            @if (ViewBag.Mensajes.Count == 0)
            {
                <li class="mensaje-chat mensaje-chat-asistente">
                    <p>¡Hola! Decime qué tipo de trabajo buscás. Por ejemplo: "busco trabajo de vendedor en Córdoba, presencial" o "algo remoto de programación".</p>
                </li>
            }
            @foreach (MensajeAsistente m in ViewBag.Mensajes)
            {
                <li class="mensaje-chat @(m.EsDelUsuario ? "mensaje-chat-usuario" : "mensaje-chat-asistente")" id="@(m == ViewBag.Mensajes[ViewBag.Mensajes.Count - 1] ? "ultimo" : null)">
                    <span class="visually-hidden">@(m.EsDelUsuario ? "Vos:" : "Asistente:")</span>
                    <p>@m.Texto</p>
                    @if (m.Ofertas.Count > 0)
                    {
                        <ul class="list-group lista ofertas-chat">
                            @foreach (Oferta oferta in m.Ofertas)
                            {
                                <li class="list-group-item fila-lista">
                                    <partial name="_LogoEmpresa" model='new LogoEmpresa(oferta.Logo, oferta.Empresa, "logo-empresa-md")' />
                                    <div class="fila-lista-datos">
                                        <h2 class="tarjeta-titulo"><a href="@oferta.Enlace">@oferta.Titulo</a></h2>
                                        <p class="texto-suave">@oferta.Resumen</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ol>

        @if (ViewBag.Lleno)
        {
            <p class="mensaje mensaje-advertencia">Esta conversación ya es muy larga. <a asp-controller="Asistente" asp-action="Index">Empezá una nueva</a>.</p>
        }
        else
        {
            <form class="formulario card tarjeta" asp-controller="Asistente" asp-action="Enviar" method="post">
                <input type="hidden" name="c" value="@ViewBag.Conversacion">
                <div class="form-field">
                    <label class="form-label" for="asistente-mensaje">Tu mensaje</label>
                    <textarea class="form-control" id="asistente-mensaje" name="mensaje" rows="3" maxlength="@Asistente.LargoMaximo" required placeholder="Por ejemplo: busco trabajo de administrativo en Rosario"></textarea>
                </div>
                <button class="btn-solid theme-primary boton" type="submit">Enviar</button>
                <p class="texto-suave">Las respuestas las escribe una inteligencia artificial y pueden tener errores. Revisá cada oferta antes de postularte.</p>
            </form>
        }
    }
</div>
