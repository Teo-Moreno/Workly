@{
    ViewData["Title"] = "Asistente";
}

<div class="container espacio-abajo">
    <header class="bloque-titulo">
        <div class="fila-titulo">
            <div>
                <h1 class="titulo">Asistente</h1>
                <p class="subtitulo">Contale qué trabajo buscás y dónde, y te recomendamos ofertas que están en Workly.</p>
            </div>
            <div class="acciones" hidden="@(ViewBag.Mensajes.Count == 0)" data-asistente-reiniciar>
                <a class="btn btn-outline-primary" href="/Asistente"><icono nombre="plus" />Empezar de nuevo</a>
            </div>
        </div>
    </header>

    @if (!ViewBag.Disponible)
    {
        <p class="alert alert-info"><icono nombre="info" />El asistente no está disponible en este momento. Mientras tanto, podés usar <a class="resaltado" href="/Empleos">Buscar trabajo</a>.</p>
    }
    else
    {
        <section class="card columna-separada" aria-label="Conversación">
            <ol class="columna-burbujas" role="list" data-conversacion>
                @if (ViewBag.Mensajes.Count == 0)
                {
                    <li class="burbuja burbuja-gris">
                        <p>¡Hola! Decime qué tipo de trabajo buscás. Por ejemplo: "busco trabajo de vendedor en Córdoba, presencial" o "algo remoto de programación".</p>
                    </li>
                }
                @foreach (MensajeAsistente m in ViewBag.Mensajes)
                {
                    <partial name="_Mensaje" model="m" />
                }
            </ol>

            @if (ViewBag.Lleno)
            {
                <p class="alert alert-warning" id="ultimo"><icono nombre="warning-outline" />Esta conversación ya es muy larga. <a class="resaltado" href="/Asistente">Empezá una nueva</a>.</p>
            }
            else
            {
                <form class="columna-borde-arriba" id="ultimo" action="/Asistente/Enviar" method="post" data-asistente>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="c" value="@ViewBag.Conversacion" />
                    <label class="form-label" for="asistente-mensaje">Tu mensaje</label>
                    <textarea class="form-control" id="asistente-mensaje" name="mensaje" rows="3" maxlength="@Asistente.LargoMaximo" required placeholder="Por ejemplo: busco trabajo de administrativo en Rosario"></textarea>
                    <div class="fila-entre-media">
                        <p class="form-text">Enter envía el mensaje y Shift + Enter baja de renglón. Las respuestas las escribe una inteligencia artificial y pueden tener errores. Revisá cada oferta antes de postularte.</p>
                        <button class="btn btn-primary" type="submit"><icono nombre="send" />Enviar</button>
                    </div>
                </form>
            }
        </section>
    }
</div>
