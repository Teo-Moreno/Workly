@{
    ViewData["Title"] = ViewBag.Oferta.Titulo;
}

<div class="container seccion">
    <nav aria-label="Estás en">
        <ol class="migas">
            <li><a asp-controller="Publicaciones" asp-action="Index">Mis publicaciones</a></li>
            <li aria-current="page">@ViewBag.Oferta.Titulo</li>
        </ol>
    </nav>
    <h1 class="titulo">@ViewBag.Oferta.Titulo</h1>
    <p class="texto-suave">@ViewBag.Oferta.Empresa@(ViewBag.Oferta.UbicacionVisible != null ? " · " + ViewBag.Oferta.UbicacionVisible : "") · @ViewBag.Oferta.PublicadaTexto</p>

    <div class="acciones">
        <a class="btn-outline theme-primary boton" asp-controller="Empleos" asp-action="Detalle" asp-route-id="@ViewBag.Oferta.ID">Ver como la ven los demás</a>
        @if (ViewBag.Oferta.Estado_Publicacion == "Aprobada" && !ViewBag.Oferta.EstaCerrada)
        {
            <form asp-controller="Publicaciones" asp-action="Cerrar" asp-route-id="@ViewBag.Oferta.ID" method="post">
                <button class="btn-outline theme-primary boton" type="submit" title="Deja de aparecer y de recibir postulaciones">Cerrar búsqueda</button>
            </form>
        }
    </div>

    @if (ViewBag.Oferta.Estado_Publicacion == "Pendiente")
    {
        <p class="mensaje mensaje-advertencia">Está en revisión: todavía no la ve nadie más que vos. Cuando la revisemos, acá vas a ver si se publicó.</p>
    }
    else if (ViewBag.Oferta.Estado_Publicacion == "Rechazada")
    {
        <p class="mensaje mensaje-error">No la pudimos publicar. Motivo: @ViewBag.Oferta.Motivo_Rechazo</p>
    }
    else if (ViewBag.Oferta.EstaCerrada)
    {
        <p class="mensaje mensaje-info">Esta búsqueda está cerrada: ya no recibe postulaciones.</p>
    }

    <h2 class="subtitulo">Postulantes (@ViewBag.Postulantes.Count)</h2>
    @if (ViewBag.Postulantes.Count == 0)
    {
        <div class="vacio">
            <p>@(ViewBag.Oferta.Estado_Publicacion == "Aprobada" ? "Todavía no se postuló nadie. Cuando alguien se postule, lo vas a ver acá con su perfil y su CV." : "Cuando la búsqueda esté publicada, acá vas a ver a quienes se postulen.")</p>
        </div>
    }
    else
    {
        <ul class="list-group lista">
            @foreach (Postulante p in ViewBag.Postulantes)
            {
                <li class="list-group-item fila-lista">
                    <span class="foto-perfil" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(p.Foto)) { <img src="@p.Foto" alt=""> } else { @p.Iniciales }
                    </span>
                    <div class="fila-lista-datos">
                        <h3 class="tarjeta-titulo"><a asp-controller="Publicaciones" asp-action="Postulante" asp-route-id="@p.IDPostulacion">@p.NombreCompleto</a></h3>
                        <p class="texto-suave">@p.Resumen</p>
                        <p>
                            <a href="mailto:@p.Email">@p.Email</a>
                            @if (!string.IsNullOrEmpty(p.Telefono)) { <span>· <a href="tel:@p.TelefonoLink">@p.Telefono</a></span> }
                        </p>
                        <p class="texto-suave">Se postuló el @Vistas.Fecha(p.Fecha)</p>
                    </div>
                    <div class="fila-lista-acciones">
                        @if (p.TieneCV)
                        {
                            <a class="btn-outline theme-primary boton btn-sm" asp-controller="Publicaciones" asp-action="CV" asp-route-id="@p.IDPostulacion">Descargar CV</a>
                        }
                        <a class="btn-solid theme-primary boton btn-sm" asp-controller="Publicaciones" asp-action="Postulante" asp-route-id="@p.IDPostulacion">Ver perfil</a>
                    </div>
                </li>
            }
        </ul>
    }

    <details class="accordion-item agregar peligro">
        <summary class="accordion-header">Eliminar la búsqueda</summary>
        <form class="accordion-body" asp-controller="Publicaciones" asp-action="Eliminar" asp-route-id="@ViewBag.Oferta.ID" method="post">
            <p>Se borran la búsqueda y sus postulaciones. No se puede deshacer.</p>
            <button class="btn-solid theme-primary boton boton-peligro" type="submit">Sí, eliminar</button>
        </form>
    </details>
</div>
