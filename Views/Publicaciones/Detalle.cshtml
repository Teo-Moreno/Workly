@{
    ViewData["Title"] = ViewBag.Oferta.Titulo;
}

<div class="container seccion-app">
    <header class="encabezado-pagina">
        <nav aria-label="Estás en">
            <ol class="breadcrumb breadcrumb-chica">
                <li class="breadcrumb-item"><a asp-controller="Publicaciones" asp-action="Index">Mis publicaciones</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewBag.Oferta.Titulo</li>
            </ol>
        </nav>
        <div class="encabezado-pagina-fila">
            <div>
                <h1 class="encabezado-pagina-titulo">@ViewBag.Oferta.Titulo</h1>
                <p class="encabezado-pagina-bajada">@ViewBag.Oferta.Empresa@(ViewBag.Oferta.UbicacionVisible != null ? " · " + ViewBag.Oferta.UbicacionVisible : "") · @ViewBag.Oferta.PublicadaTexto</p>
            </div>
            <div class="encabezado-pagina-acciones">
                <a class="btn btn-outline-primary" asp-controller="Empleos" asp-action="Detalle" asp-route-id="@ViewBag.Oferta.ID"><icono nombre="eye" />Ver como la ven los demás</a>
                @if (ViewBag.Oferta.Estado_Publicacion == "Aprobada" && !ViewBag.Oferta.EstaCerrada)
                {
                    <form asp-controller="Publicaciones" asp-action="Cerrar" asp-route-id="@ViewBag.Oferta.ID" method="post" data-confirmar="¿Cerramos la búsqueda? Deja de aparecer y de recibir postulaciones.">
                        <button class="btn btn-outline-primary" type="submit">Cerrar búsqueda</button>
                    </form>
                }
                <form asp-controller="Publicaciones" asp-action="Eliminar" asp-route-id="@ViewBag.Oferta.ID" method="post" data-confirmar="¿Eliminamos la búsqueda y sus postulaciones? No se puede deshacer.">
                    <button class="btn btn-outline-danger" type="submit"><icono nombre="trash-full" />Eliminar</button>
                </form>
            </div>
        </div>
    </header>

    @if (ViewBag.Oferta.Estado_Publicacion == "Pendiente")
    {
        <p class="alert alert-warning"><icono nombre="warning-outline" />Está en revisión: todavía no la ve nadie más que vos. Cuando la revisemos, acá vas a ver si se publicó.</p>
    }
    else if (ViewBag.Oferta.Estado_Publicacion == "Rechazada")
    {
        <p class="alert alert-danger"><icono nombre="error-outline" />No la pudimos publicar. Motivo: @ViewBag.Oferta.Motivo_Rechazo</p>
    }
    else if (ViewBag.Oferta.EstaCerrada)
    {
        <p class="alert alert-info"><icono nombre="info" />Esta búsqueda está cerrada: ya no recibe postulaciones.</p>
    }

    <section aria-labelledby="postulantes-titulo">
        <h2 class="h4" id="postulantes-titulo">Postulantes (@ViewBag.Postulantes.Count)</h2>
        @if (ViewBag.Postulantes.Count == 0)
        {
            <div class="estado-vacio estado-vacio-chico">
                <p>@(ViewBag.Oferta.Estado_Publicacion == "Aprobada" ? "Todavía no se postuló nadie. Cuando alguien se postule, lo vas a ver acá con su perfil y su CV." : "Cuando la búsqueda esté publicada, acá vas a ver a quienes se postulen.")</p>
            </div>
        }
        else
        {
            <ul class="lista-postulantes" role="list">
                @foreach (Postulante p in ViewBag.Postulantes)
                {
                    <li class="postulante">
                        <span class="avatar-md" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(p.Foto)) { <img src="@p.Foto" alt="" /> } else { @p.Iniciales }
                        </span>
                        <div class="postulante-datos">
                            <h3 class="postulante-nombre"><a asp-controller="Publicaciones" asp-action="Postulante" asp-route-id="@p.IDPostulacion">@p.NombreCompleto</a></h3>
                            <p class="postulante-meta">@p.Resumen</p>
                            <p class="postulante-contacto">
                                <a class="enlace" href="mailto:@p.Email">@p.Email</a>
                                @if (!string.IsNullOrEmpty(p.Telefono)) { <span>· <a class="enlace" href="tel:@p.TelefonoLink">@p.Telefono</a></span> }
                            </p>
                        </div>
                        <span class="small text-body-secondary">Se postuló el @Vistas.Fecha(p.Fecha)</span>
                        <div class="fila">
                            @if (p.TieneCV)
                            {
                                <a class="btn btn-outline-sm" asp-controller="Publicaciones" asp-action="CV" asp-route-id="@p.IDPostulacion"><icono nombre="download" />CV</a>
                            }
                            <a class="btn btn-sm" asp-controller="Publicaciones" asp-action="Postulante" asp-route-id="@p.IDPostulacion">Ver perfil</a>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>
