@{
    ViewData["Title"] = ViewBag.Oferta.Titulo;
}

<div class="container espacio-abajo">
    <header class="bloque-titulo">
        <nav aria-label="Estás en">
            <ol class="breadcrumb breadcrumb-chica">
                <li class="breadcrumb-item"><a href="/Publicaciones">Mis publicaciones</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewBag.Oferta.Titulo</li>
            </ol>
        </nav>
        <div class="fila-titulo">
            <div>
                <h1 class="titulo">@ViewBag.Oferta.Titulo</h1>
                <p class="subtitulo">@ViewBag.Oferta.Empresa@(ViewBag.Oferta.UbicacionVisible != null ? " · " + ViewBag.Oferta.UbicacionVisible : "") · @ViewBag.Oferta.PublicadaTexto</p>
            </div>
            <div class="acciones">
                <a class="btn btn-outline-primary" href="/Empleos/Detalle/@ViewBag.Oferta.ID"><icono nombre="eye" />Ver como la ven los demás</a>
                @if (ViewBag.Oferta.Estado_Publicacion == "Aprobada" && !ViewBag.Oferta.EstaCerrada)
                {
                    <form action="/Publicaciones/Cerrar/@ViewBag.Oferta.ID" method="post" data-confirmar="¿Cerramos la búsqueda? Deja de aparecer y de recibir postulaciones.">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-primary" type="submit">Cerrar búsqueda</button>
                    </form>
                }
                <form action="/Publicaciones/Eliminar/@ViewBag.Oferta.ID" method="post" data-confirmar="¿Eliminamos la búsqueda y sus postulaciones? No se puede deshacer.">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger" type="submit"><icono nombre="trash-full" />Eliminar</button>
                </form>
            </div>
        </div>
    </header>

    @if (ViewBag.Oferta.Estado_Publicacion == "Pendiente")
    {
        <p class="alert alert-warning"><icono nombre="warning-outline" />Está en revisión: todavía no la ve nadie más que vos. Cuando la revisemos, acá vas a ver si se publicó.</p>
    }
    else if (ViewBag.Oferta.Estado_Publicacion == "Rechazada")
    {
        <p class="alert alert-danger"><icono nombre="error-outline" />No la pudimos publicar. Motivo: @ViewBag.Oferta.Motivo_Rechazo</p>
    }
    else if (ViewBag.Oferta.EstaCerrada)
    {
        <p class="alert alert-info"><icono nombre="info" />Esta búsqueda está cerrada: ya no recibe postulaciones.</p>
    }

    <section aria-labelledby="postulantes-titulo">
        <h2 class="h4" id="postulantes-titulo">Postulantes (@ViewBag.Postulantes.Count)</h2>
        @if (ViewBag.Postulantes.Count == 0)
        {
            <div class="recuadro-punteado recuadro-punteado-chico">
                <p>@(ViewBag.Oferta.Estado_Publicacion == "Aprobada" ? "Todavía no se postuló nadie. Cuando alguien se postule, lo vas a ver acá con su perfil y su CV." : "Cuando la búsqueda esté publicada, acá vas a ver a quienes se postulen.")</p>
            </div>
        }
        else
        {
            <p class="text-body-secondary">Dentro de cada grupo, primero aparece quien más coincide con lo que pediste: habilidades del rubro, puesto que busca, ubicación y modalidad.</p>
            @foreach (var (etapa, lista) in (List<(string Etapa, List<Postulante> Lista)>)ViewBag.Etapas)
            {
                <section class="grupo-separado" aria-labelledby="etapa-@Vistas.Clave(etapa)">
                    <h3 class="grupo-separado-titulo" id="etapa-@Vistas.Clave(etapa)">@etapa <span class="contador">@lista.Count</span></h3>
                    @if (lista.Count == 0)
                    {
                        <p class="grupo-separado-vacio">Nadie en este grupo.</p>
                    }
                    else
                    {
                        <ul class="lista-tarjetas" role="list">
                            @foreach (Postulante p in lista)
                            {
                                <li class="tarjeta-fila-sombra">
                                    <span class="circulo-md" aria-hidden="true">
                                        @if (!string.IsNullOrEmpty(p.Foto)) { <img src="@p.Foto" alt="" /> } else { @p.Iniciales }
                                    </span>
                                    <div class="flexible">
                                        <h4 class="titulo-chico"><a href="/Publicaciones/Postulante/@p.IDPostulacion">@p.NombreCompleto</a></h4>
                                        <p class="texto-chico-separado"><span class="badge @(p.Puntaje >= 60 ? "badge-exito" : p.Puntaje >= 30 ? "badge-advertencia" : "badge-neutra")">Coincide @p.Puntaje%</span>@(p.Motivos.Count > 0 ? " " + string.Join(" · ", p.Motivos) : "")</p>
                                        <p class="texto-chico-separado">@p.Resumen</p>
                                        <p class="texto-chico-separado">
                                            <a class="resaltado" href="mailto:@p.Email">@p.Email</a>
                                            @if (!string.IsNullOrEmpty(p.Telefono)) { <span>· <a class="resaltado" href="tel:@p.TelefonoLink">@p.Telefono</a></span> }
                                        </p>
                                        <span class="small text-body-secondary">Se postuló el @Vistas.Fecha(p.Fecha)</span>
                                    </div>
                                    <div class="fila acciones-envueltas">
                                        @foreach (var (otraEtapa, estado, boton) in Postulaciones.EtapasEmpresa)
                                        {
                                            if (otraEtapa != etapa)
                                            {
                                                <form action="/Publicaciones/CambiarEstado/@ViewBag.Oferta.ID" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idPostulacion" value="@p.IDPostulacion" />
                                                    <input type="hidden" name="estado" value="@estado" />
                                                    <button class="btn btn-outline-sm" type="submit">@boton</button>
                                                </form>
                                            }
                                        }
                                        @if (p.TieneCV)
                                        {
                                            <a class="btn btn-outline-sm" href="/Publicaciones/CV/@p.IDPostulacion"><icono nombre="download" />CV</a>
                                        }
                                        <a class="btn btn-sm" href="/Publicaciones/Postulante/@p.IDPostulacion">Ver perfil</a>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
        }
    </section>
</div>
