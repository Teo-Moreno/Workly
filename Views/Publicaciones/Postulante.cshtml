@{
    ViewData["Title"] = ViewBag.Perfil.Usuario.NombreCompleto;
}

<div class="container espacio-abajo">
    <nav aria-label="Estás en">
        <ol class="breadcrumb breadcrumb-chica">
            <li class="breadcrumb-item"><a href="/Publicaciones">Mis publicaciones</a></li>
            <li class="breadcrumb-item"><a href="/Publicaciones/Detalle/@ViewBag.Oferta.ID">@ViewBag.Oferta.Titulo</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewBag.Perfil.Usuario.NombreCompleto</li>
        </ol>
    </nav>

    <section class="recuadro-degradado" aria-label="Datos principales">
        <span class="circulo-xl" aria-hidden="true">
            @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto)) { <img src="@ViewBag.Perfil.Perfil.Foto" alt="" /> } else { @ViewBag.Perfil.Iniciales }
        </span>
        <div class="recuadro-degradado-textos">
            <h1 class="recuadro-degradado-titulo">@ViewBag.Perfil.Usuario.NombreCompleto</h1>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Preferencia.Puesto_Buscado)) { <p class="recuadro-degradado-subtitulo">Busca trabajo de @ViewBag.Perfil.Preferencia.Puesto_Buscado</p> }
            <ul class="recuadro-degradado-datos" role="list">
                @if (ViewBag.Perfil.Perfil.Ubicacion != null) { <li><icono nombre="near-me" tamano="18" />@ViewBag.Perfil.Perfil.Ubicacion</li> }
                <li><icono nombre="mail" tamano="18" /><a href="mailto:@ViewBag.Perfil.Usuario.Email">@ViewBag.Perfil.Usuario.Email</a></li>
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Telefono)) { <li><icono nombre="message-writing" tamano="18" /><a href="tel:@ViewBag.Perfil.Perfil.TelefonoLink">@ViewBag.Perfil.Perfil.Telefono</a></li> }
                @if (ViewBag.Perfil.EnlaceSitio != null) { <li><icono nombre="globe" tamano="18" /><a href="@ViewBag.Perfil.EnlaceSitio" target="_blank" rel="noopener noreferrer">@ViewBag.Perfil.CV.Sitio_Web</a></li> }
            </ul>
            @if (ViewBag.Perfil.Perfil.Estado_Busqueda != null) { <span class="badge badge-info">@ViewBag.Perfil.Perfil.Estado_Busqueda</span> }
        </div>
        <div class="recuadro-degradado-acciones">
            @if (ViewBag.Perfil.TieneCV)
            {
                <a class="btn btn-primary" href="/Publicaciones/CV/@ViewBag.IDPostulacion"><icono nombre="download" />Descargar CV</a>
            }
            else
            {
                <span class="text-body-secondary">No subió CV</span>
            }
        </div>
    </section>

    <div class="grilla-lateral-izquierda">
        <div class="columna-ancha">
            <section class="card">
                <h2 class="card-title">Qué busca</h2>
                @if (ViewBag.Perfil.Preferencia.TieneDatos)
                {
                    <dl class="lista-clave-valor-lineas">
                        @if (ViewBag.Perfil.Preferencia.ListaNiveles.Count > 0) { <div><dt>Nivel</dt><dd>@string.Join(", ", ViewBag.Perfil.Preferencia.ListaNiveles)</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.ListaModalidades.Count > 0) { <div><dt>Modalidad</dt><dd>@string.Join(", ", ViewBag.Perfil.Preferencia.ListaModalidades)</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Jornada != null) { <div><dt>Jornada</dt><dd>@ViewBag.Perfil.Preferencia.Jornada</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Contratacion != null) { <div><dt>Contratación</dt><dd>@ViewBag.Perfil.Preferencia.Contratacion</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Disponibilidad != null) { <div><dt>Disponibilidad</dt><dd>@ViewBag.Perfil.Preferencia.Disponibilidad</dd></div> }
                    </dl>
                }
                else
                {
                    <p class="recuadro-punteado-mini">No lo completó.</p>
                }
            </section>
            <section class="card">
                <h2 class="card-title">Habilidades</h2>
                @if (ViewBag.Perfil.Habilidades.Count == 0) { <p class="recuadro-punteado-mini">No cargó habilidades.</p> }
                else
                {
                    <ul class="fila-chapitas" role="list">@foreach (string h in ViewBag.Perfil.Habilidades) { <li class="badge chapita">@h</li> }</ul>
                }
            </section>
            <section class="card">
                <h2 class="card-title">Idiomas</h2>
                @if (ViewBag.Perfil.Idiomas.Count == 0) { <p class="recuadro-punteado-mini">No cargó idiomas.</p> }
                else
                {
                    <dl class="lista-clave-valor">@foreach (IdiomaElegido i in ViewBag.Perfil.Idiomas) { <div><dt>@i.Idioma</dt><dd>@i.Nivel</dd></div> }</dl>
                }
            </section>
        </div>
        <div class="columna-ancha">
            <section class="card">
                <h2 class="card-title">Sobre mí</h2>
                @if (string.IsNullOrWhiteSpace(ViewBag.Perfil.Perfil.Descripcion)) { <p class="recuadro-punteado-mini">No escribió nada.</p> }
                else { <p class="texto-gris">@ViewBag.Perfil.Perfil.Descripcion</p> }
            </section>
            <section class="card">
                <h2 class="card-title">Experiencia</h2>
                @if (ViewBag.Perfil.Experiencias.Count == 0) { <p class="recuadro-punteado-mini">No cargó experiencia laboral.</p> }
                else
                {
                    <ol class="linea-tiempo" role="list">
                        @foreach (ExperienciaItem e in ViewBag.Perfil.Experiencias)
                        {
                            <li class="linea-tiempo-item">
                                <span class="cuadro-md-principal" aria-hidden="true">@Textos.Iniciales(e.Empresa)</span>
                                <div class="linea-tiempo-contenido">
                                    <h3 class="linea-tiempo-titulo">@e.Puesto</h3>
                                    <p class="texto-fuerte">@e.Empresa</p>
                                    <p class="texto-chico">@e.Periodo</p>
                                    @if (!string.IsNullOrWhiteSpace(e.Descripcion)) { <p class="linea-tiempo-texto">@e.Descripcion</p> }
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
            <section class="card">
                <h2 class="card-title">Formación</h2>
                @if (ViewBag.Perfil.Formaciones.Count == 0) { <p class="recuadro-punteado-mini">No cargó formación.</p> }
                else
                {
                    <ol class="linea-tiempo" role="list">
                        @foreach (FormacionItem f in ViewBag.Perfil.Formaciones)
                        {
                            <li class="linea-tiempo-item">
                                <span class="cuadro-md" aria-hidden="true"><icono nombre="book" /></span>
                                <div class="linea-tiempo-contenido">
                                    <h3 class="linea-tiempo-titulo">@f.Titulo</h3>
                                    <p class="texto-fuerte">@f.Institucion</p>
                                    <p class="texto-chico">@f.Periodo</p>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>
    </div>
</div>
