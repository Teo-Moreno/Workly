@{
    ViewData["Title"] = ViewBag.Perfil.Usuario.NombreCompleto;
}

<div class="container seccion">
    <nav aria-label="Estás en">
        <ol class="migas">
            <li><a asp-controller="Publicaciones" asp-action="Index">Mis publicaciones</a></li>
            <li><a asp-controller="Publicaciones" asp-action="Detalle" asp-route-id="@ViewBag.Oferta.ID">@ViewBag.Oferta.Titulo</a></li>
            <li aria-current="page">@ViewBag.Perfil.Usuario.NombreCompleto</li>
        </ol>
    </nav>

    <div class="perfil-cabecera">
        <span class="foto-perfil foto-perfil-xl" aria-hidden="true">
            @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto)) { <img src="@ViewBag.Perfil.Perfil.Foto" alt=""> } else { @ViewBag.Perfil.Iniciales }
        </span>
        <div class="perfil-cabecera-datos">
            <h1 class="titulo">@ViewBag.Perfil.Usuario.NombreCompleto</h1>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Preferencia.Puesto_Buscado)) { <p>Busca trabajo de @ViewBag.Perfil.Preferencia.Puesto_Buscado</p> }
            <ul class="contacto">
                @if (ViewBag.Perfil.Perfil.Ubicacion != null) { <li>@ViewBag.Perfil.Perfil.Ubicacion</li> }
                <li><a href="mailto:@ViewBag.Perfil.Usuario.Email">@ViewBag.Perfil.Usuario.Email</a></li>
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Telefono)) { <li><a href="tel:@ViewBag.Perfil.Perfil.TelefonoLink">@ViewBag.Perfil.Perfil.Telefono</a></li> }
                @if (ViewBag.Perfil.EnlaceSitio != null) { <li><a href="@ViewBag.Perfil.EnlaceSitio" target="_blank" rel="noopener noreferrer">@ViewBag.Perfil.CV.Sitio_Web</a></li> }
            </ul>
            @if (ViewBag.Perfil.Perfil.Estado_Busqueda != null) { <span class="badge etiqueta etiqueta-info">@ViewBag.Perfil.Perfil.Estado_Busqueda</span> }
        </div>
        <div>
            @if (ViewBag.Perfil.TieneCV)
            {
                <a class="btn-solid theme-primary boton" asp-controller="Publicaciones" asp-action="CV" asp-route-id="@ViewBag.IDPostulacion">Descargar CV</a>
            }
            else
            {
                <span class="texto-suave">No subió CV</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="lg:col-5">
            <section class="card tarjeta">
                <h2 class="card-title">Qué busca</h2>
                @if (ViewBag.Perfil.Preferencia.TieneDatos)
                {
                    <partial name="_Preferencia" model="ViewBag.Perfil.Preferencia" />
                }
                else
                {
                    <p class="texto-suave">No lo completó.</p>
                }
            </section>
            <partial name="_PerfilDatos" model="ViewBag.Perfil" />
        </div>
        <div class="lg:col-7">
            <section class="card tarjeta">
                <h2 class="card-title">Sobre mí</h2>
                @if (string.IsNullOrWhiteSpace(ViewBag.Perfil.Perfil.Descripcion)) { <p class="texto-suave">No escribió nada.</p> }
                else { <p class="texto-con-saltos">@ViewBag.Perfil.Perfil.Descripcion</p> }
            </section>
            <section class="card tarjeta">
                <h2 class="card-title">Experiencia</h2>
                @if (ViewBag.Perfil.Experiencias.Count == 0) { <p class="texto-suave">No cargó experiencia laboral.</p> }
                else
                {
                    <ol class="list-group linea">
                        @foreach (ExperienciaItem e in ViewBag.Perfil.Experiencias)
                        {
                            <li class="list-group-item">
                                <h3 class="tarjeta-titulo">@e.Puesto</h3>
                                <p>@e.Empresa</p>
                                <p class="texto-suave">@e.Periodo</p>
                                @if (!string.IsNullOrWhiteSpace(e.Descripcion)) { <p class="texto-con-saltos">@e.Descripcion</p> }
                            </li>
                        }
                    </ol>
                }
            </section>
            <section class="card tarjeta">
                <h2 class="card-title">Formación</h2>
                @if (ViewBag.Perfil.Formaciones.Count == 0) { <p class="texto-suave">No cargó formación.</p> }
                else
                {
                    <ol class="list-group linea">
                        @foreach (FormacionItem f in ViewBag.Perfil.Formaciones)
                        {
                            <li class="list-group-item">
                                <h3 class="tarjeta-titulo">@f.Titulo</h3>
                                <p>@f.Institucion</p>
                                <p class="texto-suave">@f.Periodo</p>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>
    </div>
</div>
