@{
    ViewData["Title"] = ViewBag.Perfil.Usuario.NombreCompleto;
}

<div class="contenedor seccion-app">
    <nav class="migas migas-chica" aria-label="Estás en">
        <a asp-controller="Publicaciones" asp-action="Index">Mis publicaciones</a>
        <icono nombre="chevron-right" />
        <a asp-controller="Publicaciones" asp-action="Detalle" asp-route-id="@ViewBag.Oferta.ID">@ViewBag.Oferta.Titulo</a>
        <icono nombre="chevron-right" />
        <span aria-current="page">@ViewBag.Perfil.Usuario.NombreCompleto</span>
    </nav>

    <section class="perfil-cabecera" aria-label="Datos principales">
        <span class="avatar avatar-xl" aria-hidden="true">
            @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto)) { <img src="@ViewBag.Perfil.Perfil.Foto" alt="" /> } else { @ViewBag.Perfil.Iniciales }
        </span>
        <div class="perfil-cabecera-datos">
            <h1 class="perfil-cabecera-nombre">@ViewBag.Perfil.Usuario.NombreCompleto</h1>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Preferencia.Puesto_Buscado)) { <p class="perfil-cabecera-rol">Busca trabajo de @ViewBag.Perfil.Preferencia.Puesto_Buscado</p> }
            <ul class="perfil-cabecera-contacto" role="list">
                @if (ViewBag.Perfil.Perfil.Ubicacion != null) { <li><icono nombre="near-me" tamano="18" />@ViewBag.Perfil.Perfil.Ubicacion</li> }
                <li><icono nombre="mail" tamano="18" /><a href="mailto:@ViewBag.Perfil.Usuario.Email">@ViewBag.Perfil.Usuario.Email</a></li>
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Telefono)) { <li><icono nombre="message-writing" tamano="18" /><a href="tel:@ViewBag.Perfil.Perfil.TelefonoLink">@ViewBag.Perfil.Perfil.Telefono</a></li> }
                @if (ViewBag.Perfil.EnlaceSitio != null) { <li><icono nombre="globe" tamano="18" /><a href="@ViewBag.Perfil.EnlaceSitio" target="_blank" rel="noopener noreferrer">@ViewBag.Perfil.CV.Sitio_Web</a></li> }
            </ul>
            @if (ViewBag.Perfil.Perfil.Estado_Busqueda != null) { <span class="etiqueta etiqueta-info">@ViewBag.Perfil.Perfil.Estado_Busqueda</span> }
        </div>
        <div class="perfil-cabecera-acciones">
            @if (ViewBag.Perfil.TieneCV)
            {
                <a class="boton" asp-controller="Publicaciones" asp-action="CV" asp-route-id="@ViewBag.IDPostulacion"><icono nombre="download" />Descargar CV</a>
            }
            else
            {
                <span class="texto-suave">No subió CV</span>
            }
        </div>
    </section>

    <div class="perfil-cuerpo">
        <div class="perfil-columna">
            <section class="tarjeta">
                <h2 class="tarjeta-titulo">Qué busca</h2>
                @if (ViewBag.Perfil.Preferencia.TieneDatos)
                {
                    <dl class="lista-clave-valor lista-clave-valor-perfil">
                        @if (ViewBag.Perfil.Preferencia.ListaNiveles.Count > 0) { <div><dt>Nivel</dt><dd>@string.Join(", ", ViewBag.Perfil.Preferencia.ListaNiveles)</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.ListaModalidades.Count > 0) { <div><dt>Modalidad</dt><dd>@string.Join(", ", ViewBag.Perfil.Preferencia.ListaModalidades)</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Jornada != null) { <div><dt>Jornada</dt><dd>@ViewBag.Perfil.Preferencia.Jornada</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Contratacion != null) { <div><dt>Contratación</dt><dd>@ViewBag.Perfil.Preferencia.Contratacion</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Disponibilidad != null) { <div><dt>Disponibilidad</dt><dd>@ViewBag.Perfil.Preferencia.Disponibilidad</dd></div> }
                    </dl>
                }
                else
                {
                    <p class="perfil-vacio">No lo completó.</p>
                }
            </section>
            <section class="tarjeta">
                <h2 class="tarjeta-titulo">Habilidades</h2>
                @if (ViewBag.Perfil.Habilidades.Count == 0) { <p class="perfil-vacio">No cargó habilidades.</p> }
                else
                {
                    <ul class="lista-tags" role="list">@foreach (string h in ViewBag.Perfil.Habilidades) { <li class="tag">@h</li> }</ul>
                }
            </section>
            <section class="tarjeta">
                <h2 class="tarjeta-titulo">Idiomas</h2>
                @if (ViewBag.Perfil.Idiomas.Count == 0) { <p class="perfil-vacio">No cargó idiomas.</p> }
                else
                {
                    <dl class="lista-clave-valor">@foreach (IdiomaElegido i in ViewBag.Perfil.Idiomas) { <div><dt>@i.Idioma</dt><dd>@i.Nivel</dd></div> }</dl>
                }
            </section>
        </div>
        <div class="perfil-columna">
            <section class="tarjeta">
                <h2 class="tarjeta-titulo">Sobre mí</h2>
                @if (string.IsNullOrWhiteSpace(ViewBag.Perfil.Perfil.Descripcion)) { <p class="perfil-vacio">No escribió nada.</p> }
                else { <p class="perfil-texto">@ViewBag.Perfil.Perfil.Descripcion</p> }
            </section>
            <section class="tarjeta">
                <h2 class="tarjeta-titulo">Experiencia</h2>
                @if (ViewBag.Perfil.Experiencias.Count == 0) { <p class="perfil-vacio">No cargó experiencia laboral.</p> }
                else
                {
                    <ol class="linea-tiempo" role="list">
                        @foreach (ExperienciaItem e in ViewBag.Perfil.Experiencias)
                        {
                            <li class="linea-tiempo-item">
                                <span class="logo-empresa logo-empresa-md logo-empresa-principal" aria-hidden="true">@Textos.Iniciales(e.Empresa)</span>
                                <div class="linea-tiempo-contenido">
                                    <h3 class="linea-tiempo-titulo">@e.Puesto</h3>
                                    <p class="linea-tiempo-lugar">@e.Empresa</p>
                                    <p class="linea-tiempo-fecha">@e.Periodo</p>
                                    @if (!string.IsNullOrWhiteSpace(e.Descripcion)) { <p class="linea-tiempo-texto">@e.Descripcion</p> }
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
            <section class="tarjeta">
                <h2 class="tarjeta-titulo">Formación</h2>
                @if (ViewBag.Perfil.Formaciones.Count == 0) { <p class="perfil-vacio">No cargó formación.</p> }
                else
                {
                    <ol class="linea-tiempo" role="list">
                        @foreach (FormacionItem f in ViewBag.Perfil.Formaciones)
                        {
                            <li class="linea-tiempo-item">
                                <span class="logo-empresa logo-empresa-md" aria-hidden="true"><icono nombre="book" /></span>
                                <div class="linea-tiempo-contenido">
                                    <h3 class="linea-tiempo-titulo">@f.Titulo</h3>
                                    <p class="linea-tiempo-lugar">@f.Institucion</p>
                                    <p class="linea-tiempo-fecha">@f.Periodo</p>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>
    </div>
</div>
