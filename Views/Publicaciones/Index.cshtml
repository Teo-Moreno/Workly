@model PublicacionesViewModel
@{
    ViewData["Title"] = "Mis publicaciones";
}

<div class="contenedor seccion-app">
    <header class="encabezado-pagina">
        <div class="encabezado-pagina__fila">
            <div>
                <h1 class="encabezado-pagina__titulo">Mis publicaciones</h1>
                <p class="encabezado-pagina__bajada">
                    @(Model.EsEmpresa
                        ? "Las búsquedas de tu empresa y las personas que se postularon a cada una."
                        : "Las búsquedas que publicaste. Antes de salir las revisa el equipo de Workly.")
                </p>
            </div>
            <div class="encabezado-pagina__acciones">
                <a class="boton" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar búsqueda</a>
            </div>
        </div>
    </header>

    @if (Model.Ofertas.Count == 0)
    {
        <div class="estado-vacio">
            <span class="caja-icono caja-icono--lg"><icono nombre="briefcase" /></span>
            <h2 class="estado-vacio__titulo">Todavía no publicaste ninguna búsqueda</h2>
            <p>Contá qué puesto querés cubrir y en qué condiciones. Las personas se postulan con su perfil y su CV, y las ves acá.</p>
            <a class="boton" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar mi primera búsqueda</a>
        </div>
    }
    else
    {
        <ul class="lista-publicaciones" role="list">
            @foreach (var oferta in Model.Ofertas)
            {
                var (texto, color) = oferta.Estado_Publicacion switch
                {
                    "Pendiente" => ("En revisión", "advertencia"),
                    "Rechazada" => ("Rechazada", "error"),
                    _ when oferta.EstaCerrada => ("Cerrada", "gris"),
                    _ => ("Publicada", "exito")
                };
                <li class="publicacion">
                    <div class="publicacion__datos">
                        <h2 class="publicacion__titulo"><a asp-controller="Publicaciones" asp-action="Detalle" asp-route-id="@oferta.ID">@oferta.Titulo</a></h2>
                        <p class="publicacion__meta">@oferta.Empresa@(oferta.UbicacionVisible != null ? " · " + oferta.UbicacionVisible : "") · @oferta.PublicadaTexto</p>
                        @if (oferta.Estado_Publicacion == "Rechazada" && !string.IsNullOrEmpty(oferta.Motivo_Rechazo))
                        {
                            <p class="publicacion__motivo"><strong>Motivo:</strong> @oferta.Motivo_Rechazo</p>
                        }
                    </div>
                    <span class="etiqueta etiqueta--@color">@texto</span>
                    <a class="publicacion__postulantes" asp-controller="Publicaciones" asp-action="Detalle" asp-route-id="@oferta.ID">
                        <strong>@oferta.CantidadPostulantes</strong>
                        <span>@(oferta.CantidadPostulantes == 1 ? "postulante" : "postulantes")</span>
                    </a>
                </li>
            }
        </ul>
    }
</div>
