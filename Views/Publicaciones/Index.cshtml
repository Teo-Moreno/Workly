@{
    ViewData["Title"] = "Mis publicaciones";
}

<div class="container seccion">
    <div class="encabezado">
        <div>
            <h1 class="titulo">Mis publicaciones</h1>
            <p class="texto-suave">
                @(ViewBag.EsEmpresa
                    ? "Las búsquedas de tu empresa y las personas que se postularon a cada una."
                    : "Las búsquedas que publicaste. Antes de salir las revisa el equipo de Workly.")
            </p>
        </div>
        <a class="btn-solid theme-primary boton" asp-controller="Publicaciones" asp-action="Nueva">+ Publicar búsqueda</a>
    </div>

    @if (ViewBag.Ofertas.Count == 0)
    {
        <div class="vacio">
            <h2>Todavía no publicaste ninguna búsqueda</h2>
            <p>Contá qué puesto querés cubrir y en qué condiciones. Las personas se postulan con su perfil y su CV, y las ves acá.</p>
            <a class="btn-solid theme-primary boton" asp-controller="Publicaciones" asp-action="Nueva">+ Publicar mi primera búsqueda</a>
        </div>
    }
    else
    {
        <ul class="list-group lista">
            @foreach (Oferta oferta in ViewBag.Ofertas)
            {
                <li class="list-group-item fila-lista">
                    <div class="fila-lista-datos">
                        <h2 class="tarjeta-titulo"><a asp-controller="Publicaciones" asp-action="Detalle" asp-route-id="@oferta.ID">@oferta.Titulo</a></h2>
                        <p class="texto-suave">@oferta.Empresa@(oferta.UbicacionVisible != null ? " · " + oferta.UbicacionVisible : "") · @oferta.PublicadaTexto</p>
                        @if (oferta.Estado_Publicacion == "Rechazada" && !string.IsNullOrEmpty(oferta.Motivo_Rechazo))
                        {
                            <p><span class="negrita">Motivo:</span> @oferta.Motivo_Rechazo</p>
                        }
                    </div>
                    <span class="badge etiqueta etiqueta-@oferta.EstadoColor">@oferta.EstadoTexto</span>
                    <a class="cantidad" asp-controller="Publicaciones" asp-action="Detalle" asp-route-id="@oferta.ID">
                        <span class="cantidad-numero">@oferta.CantidadPostulantes</span>
                        @(oferta.CantidadPostulantes == 1 ? "postulante" : "postulantes")
                    </a>
                </li>
            }
        </ul>
    }
</div>
