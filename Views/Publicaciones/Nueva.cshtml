@{
    ViewData["Title"] = "Publicar búsqueda";
}

<div class="container espacio-abajo-angosto">
    <header class="bloque-titulo">
        <nav aria-label="Estás en">
            <ol class="breadcrumb breadcrumb-chica">
                <li class="breadcrumb-item"><a href="/Publicaciones">Mis publicaciones</a></li>
                <li class="breadcrumb-item active" aria-current="page">Publicar búsqueda</li>
            </ol>
        </nav>
        <h1 class="titulo">Publicar una búsqueda</h1>
        <p class="subtitulo">
            @(ViewBag.Formulario.EsEmpresa
                ? "Se publica al instante en Buscar trabajo y en la página de tu empresa."
                : "Antes de publicarla la revisa el equipo de Workly. Si no la podemos publicar, te contamos por qué.")
        </p>
    </header>

    <partial name="_ErroresFormulario" />

    <form class="grilla-campos card" action="/Publicaciones/Nueva" method="post" enctype="multipart/form-data" novalidate data-formulario-real>
        @Html.AntiForgeryToken()
        <div class="campo @ViewBag.Errores.Clase("Titulo")">
            <label class="form-label" for="Titulo">Título de la búsqueda</label>
            <input class="form-control" id="Titulo" name="Titulo" value="@ViewBag.Formulario.Titulo" maxlength="150" required placeholder="Ej.: Cajero/a para supermercado en Palermo" />
            <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Titulo", "Escribí el título de la búsqueda")</span>
        </div>

        <div class="columnas">
            <div class="campo @ViewBag.Errores.Clase("Puesto")">
                <label class="form-label" for="Puesto">Puesto</label>
                <input class="form-control" id="Puesto" name="Puesto" value="@ViewBag.Formulario.Puesto" maxlength="100" required placeholder="Ej.: Cajero/a" />
                <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Puesto", "Escribí el puesto")</span>
            </div>
            <div class="campo @ViewBag.Errores.Clase("IDSector")">
                <label class="form-label" for="IDSector">Sector</label>
                <select class="form-select" id="IDSector" name="IDSector" required data-seleccion>
                    <option value="">Elegí el sector</option>
                    @foreach (Sector sector in ViewBag.Formulario.Sectores)
                    {
                        <option value="@sector.ID" selected="@(sector.ID == ViewBag.Formulario.IDSector)">@sector.Nombre</option>
                    }
                </select>
                <span class="form-text">Lo usamos para comparar el puesto con las habilidades de quienes se postulan.</span>
                <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("IDSector", "Elegí el sector del puesto")</span>
            </div>
        </div>

        <div class="columnas">
            @if (ViewBag.Formulario.EsEmpresa)
            {
                <div class="campo">
                    <span class="form-label">Empresa</span>
                    <p class="form-control control-fijo">@ViewBag.Formulario.EmpresaFija</p>
                </div>
            }
            else
            {
                <div class="campo @ViewBag.Errores.Clase("EmpresaNombre")">
                    <label class="form-label" for="EmpresaNombre">Empresa o negocio que contrata</label>
                    <input class="form-control" id="EmpresaNombre" name="EmpresaNombre" value="@ViewBag.Formulario.EmpresaNombre" maxlength="100" required placeholder="Ej.: Almacén Don Pedro" />
                    <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("EmpresaNombre", "Escribí el nombre de la empresa o el negocio")</span>
                </div>
            }
        </div>

        <div class="campo @ViewBag.Errores.Clase("Imagen")">
            <div class="fila-gris-clara">
                <span class="cuadro-lg" data-vista-foto aria-hidden="true">
                    @if (!string.IsNullOrEmpty(ViewBag.Formulario.EmpresaLogo))
                    {
                        <img src="@ViewBag.Formulario.EmpresaLogo" alt="" />
                    }
                    else
                    {
                        <icono nombre="image" />
                    }
                </span>
                <div class="pila" style="--pila-espacio: 8px">
                    <strong>Imagen de la búsqueda <span class="text-body-secondary fw-normal">(opcional)</span></strong>
                    <span class="small text-body-secondary">El logo de la empresa o una foto del lugar. JPG, PNG o WEBP de hasta 5 MB. Si no subís ninguna, mostramos @(ViewBag.Formulario.EsEmpresa ? "el logo de tu empresa" : "las iniciales de la empresa").</span>
                    <label class="btn btn-archivo"><icono nombre="upload" />Elegir imagen
                        <input type="file" name="Imagen" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-foto-entrada
                               data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí una imagen JPG, PNG o WEBP" />
                    </label>
                </div>
            </div>
            <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Imagen", "Subí una imagen JPG, PNG o WEBP de hasta 5 MB")</span>
        </div>

        <div class="campo @ViewBag.Errores.Clase("Descripcion")">
            <label class="form-label" for="Descripcion">Descripción</label>
            <textarea class="form-control" id="Descripcion" name="Descripcion" rows="8" minlength="40" maxlength="2000" required
                      placeholder="Qué tareas tiene el puesto, qué pedís (experiencia, estudios, horarios) y qué ofrecés.">@ViewBag.Formulario.Descripcion</textarea>
            <span class="form-text">Entre 40 y 2000 caracteres.</span>
            <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Descripcion", "Usá entre 40 y 2000 caracteres")</span>
        </div>

        <div class="columnas">
            <div class="campo @ViewBag.Errores.Clase("Modalidad")">
                <label class="form-label" for="Modalidad">Modalidad</label>
                <select class="form-select" id="Modalidad" name="Modalidad" required>
                    <option value="">Elegí una opción</option>
                    @foreach (var modalidad in Catalogos.Modalidades)
                    {
                        <option selected="@(ViewBag.Formulario.Modalidad == modalidad)">@modalidad</option>
                    }
                </select>
                <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Modalidad", "Elegí la modalidad")</span>
            </div>
            <div class="campo @ViewBag.Errores.Clase("TipoEmpleo")">
                <label class="form-label" for="TipoEmpleo">Tipo de empleo</label>
                <select class="form-select" id="TipoEmpleo" name="TipoEmpleo" required>
                    <option value="">Elegí una opción</option>
                    @foreach (var (tipo, _) in Catalogos.TiposEmpleo)
                    {
                        <option selected="@(ViewBag.Formulario.TipoEmpleo == tipo)">@tipo</option>
                    }
                </select>
                <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("TipoEmpleo", "Elegí el tipo de empleo")</span>
            </div>
        </div>

        <partial name="_CampoUbicacion" model="ViewBag.Formulario.CampoUbicacion" />

        <div class="campo @ViewBag.Errores.Clase("Ubicacion")">
            <label class="form-label" for="Ubicacion">Localidad o barrio <span class="campo-opcional">(opcional)</span></label>
            <input class="form-control" id="Ubicacion" name="Ubicacion" value="@ViewBag.Formulario.Ubicacion" maxlength="100" placeholder="Ej.: Palermo" />
            <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Ubicacion", "Usá hasta 100 caracteres")</span>
        </div>

        <div class="columnas columnas-tres">
            <div class="campo @ViewBag.Errores.Clase("Salario")">
                <label class="form-label" for="Salario">Salario bruto por mes <span class="campo-opcional">(opcional)</span></label>
                <input class="form-control" id="Salario" name="Salario" value="@ViewBag.Formulario.Salario" type="number" min="0" step="1000" placeholder="En pesos" />
                <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("Salario", "Ingresá un monto válido")</span>
            </div>
            <div class="campo @ViewBag.Errores.Clase("CantidadPuestos")">
                <label class="form-label" for="CantidadPuestos">Vacantes</label>
                <input class="form-control" id="CantidadPuestos" name="CantidadPuestos" value="@ViewBag.Formulario.CantidadPuestos" type="number" min="1" max="999" required />
                <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("CantidadPuestos", "Ingresá entre 1 y 999")</span>
            </div>
            <div class="campo @ViewBag.Errores.Clase("FechaCierre")">
                <label class="form-label" for="FechaCierre">Recibe postulaciones hasta <span class="campo-opcional">(opcional)</span></label>
                <input class="form-control" id="FechaCierre" name="FechaCierre" value="@(ViewBag.Formulario.FechaCierre?.ToString("yyyy-MM-dd"))" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje("FechaCierre", "Elegí una fecha desde hoy")</span>
            </div>
        </div>

        <div class="acciones-derecha">
            <a class="btn btn-secondary" href="/Publicaciones">Cancelar</a>
            <button class="btn btn-warning" type="submit">@(ViewBag.Formulario.EsEmpresa ? "Publicar búsqueda" : "Enviar a revisión")</button>
        </div>
    </form>
</div>
