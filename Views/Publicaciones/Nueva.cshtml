@{
    ViewData["Title"] = "Publicar búsqueda";
}

<div class="container seccion angosto">
    <nav aria-label="Estás en">
        <ol class="migas">
            <li><a asp-controller="Publicaciones" asp-action="Index">Mis publicaciones</a></li>
            <li aria-current="page">Publicar búsqueda</li>
        </ol>
    </nav>
    <h1 class="titulo">Publicar una búsqueda</h1>
    <p class="texto-suave">
        @(ViewBag.Formulario.EsEmpresa
            ? "Se publica al instante en Buscar trabajo y en la página de tu empresa."
            : "Antes de publicarla la revisa el equipo de Workly. Si no la podemos publicar, te contamos por qué.")
    </p>

    <partial name="_ErroresFormulario" />

    <form class="card tarjeta formulario" asp-controller="Publicaciones" asp-action="Nueva" method="post">
        <div class="form-field @Html.ClaseError("Titulo")">
            <label class="form-label" for="Titulo">Título de la búsqueda</label>
            <input class="form-control" id="Titulo" name="Titulo" value="@ViewBag.Formulario.Titulo" type="text" required placeholder="Ej.: Cajero/a para supermercado en Palermo">
            <p class="error-texto">@Html.MensajeError("Titulo", "Escribí el título de la búsqueda")</p>
        </div>

        <div class="row g-4">
            <div class="md:col-6">
                <div class="form-field @Html.ClaseError("Puesto")">
                    <label class="form-label" for="Puesto">Puesto</label>
                    <input class="form-control" id="Puesto" name="Puesto" value="@ViewBag.Formulario.Puesto" type="text" required placeholder="Ej.: Cajero/a">
                    <p class="error-texto">@Html.MensajeError("Puesto", "Escribí el puesto")</p>
                </div>
            </div>
            <div class="md:col-6">
                <div class="form-field @Html.ClaseError("IDSector")">
                    <label class="form-label" for="IDSector">Sector</label>
                    <select class="form-control" id="IDSector" name="IDSector" required>
                        @foreach (Sector sector in ViewBag.Formulario.Sectores)
                        {
                            if (sector.ID == ViewBag.Formulario.IDSector)
                            {
                                <option value="@sector.ID">@sector.Nombre</option>
                            }
                        }
                        <option value="">Elegí el sector</option>
                        @foreach (Sector sector in ViewBag.Formulario.Sectores)
                        {
                            if (sector.ID != ViewBag.Formulario.IDSector)
                            {
                                <option value="@sector.ID">@sector.Nombre</option>
                            }
                        }
                    </select>
                    <p class="form-text">Lo usamos para comparar el puesto con las habilidades de quienes se postulan.</p>
                    <p class="error-texto">@Html.MensajeError("IDSector", "Elegí el sector del puesto")</p>
                </div>
            </div>
        </div>

        @if (ViewBag.Formulario.EsEmpresa)
        {
            <div class="form-field">
                <p class="form-label">Empresa</p>
                <p class="form-control">@ViewBag.Formulario.EmpresaFija</p>
            </div>
        }
        else
        {
            <div class="form-field @Html.ClaseError("EmpresaNombre")">
                <label class="form-label" for="EmpresaNombre">Empresa o negocio que contrata</label>
                <input class="form-control" id="EmpresaNombre" name="EmpresaNombre" value="@ViewBag.Formulario.EmpresaNombre" type="text" required placeholder="Ej.: Almacén Don Pedro">
                <p class="error-texto">@Html.MensajeError("EmpresaNombre", "Escribí el nombre de la empresa o el negocio")</p>
            </div>
        }

        <div class="form-field @Html.ClaseError("Descripcion")">
            <label class="form-label" for="Descripcion">Descripción</label>
            <textarea class="form-control" id="Descripcion" name="Descripcion" rows="8" required
                      placeholder="Qué tareas tiene el puesto, qué pedís (experiencia, estudios, horarios) y qué ofrecés.">@ViewBag.Formulario.Descripcion</textarea>
            <p class="form-text">Entre 40 y 2000 caracteres.</p>
            <p class="error-texto">@Html.MensajeError("Descripcion", "Usá entre 40 y 2000 caracteres")</p>
        </div>

        <div class="row g-4">
            <div class="md:col-6">
                <div class="form-field @Html.ClaseError("Modalidad")">
                    <label class="form-label" for="Modalidad">Modalidad</label>
                    <select class="form-control" id="Modalidad" name="Modalidad" required>
                        <partial name="_Opciones" model='new OpcionesSelect(ViewBag.Formulario.Modalidad, Catalogos.Modalidades, "Elegí una opción")' />
                    </select>
                    <p class="error-texto">@Html.MensajeError("Modalidad", "Elegí la modalidad")</p>
                </div>
            </div>
            <div class="md:col-6">
                <div class="form-field @Html.ClaseError("TipoEmpleo")">
                    <label class="form-label" for="TipoEmpleo">Tipo de empleo</label>
                    <select class="form-control" id="TipoEmpleo" name="TipoEmpleo" required>
                        <partial name="_Opciones" model='new OpcionesSelect(ViewBag.Formulario.TipoEmpleo, Catalogos.TiposEmpleo.Select(t => t.Nombre), "Elegí una opción")' />
                    </select>
                    <p class="error-texto">@Html.MensajeError("TipoEmpleo", "Elegí el tipo de empleo")</p>
                </div>
            </div>
        </div>

        <partial name="_CampoUbicacion" model='new CampoUbicacion { Paises = ViewBag.Formulario.Paises, Provincias = ViewBag.Formulario.Provincias, IDPais = ViewBag.Formulario.IDPais, IDProvincia = ViewBag.Formulario.IDProvincia, EtiquetaProvincia = "Provincia del trabajo" }' />

        <div class="form-field @Html.ClaseError("Ubicacion")">
            <label class="form-label" for="Ubicacion">Localidad o barrio <span class="opcional">(opcional)</span></label>
            <input class="form-control" id="Ubicacion" name="Ubicacion" value="@ViewBag.Formulario.Ubicacion" type="text" placeholder="Ej.: Palermo">
            <p class="error-texto">@Html.MensajeError("Ubicacion", "Usá hasta 100 caracteres")</p>
        </div>

        <div class="row g-4">
            <div class="col-12 md:col-6">
                <div class="form-field @Html.ClaseError("Salario")">
                    <label class="form-label" for="Salario">Salario bruto por mes <span class="opcional">(opcional)</span></label>
                    <input class="form-control" id="Salario" name="Salario" value="@ViewBag.Formulario.Salario" type="number" min="0" step="1000" placeholder="En pesos">
                    <p class="error-texto">@Html.MensajeError("Salario", "Ingresá un monto válido")</p>
                </div>
            </div>
            <div class="col-6 md:col-3">
                <div class="form-field @Html.ClaseError("CantidadPuestos")">
                    <label class="form-label" for="CantidadPuestos">Vacantes</label>
                    <input class="form-control" id="CantidadPuestos" name="CantidadPuestos" value="@ViewBag.Formulario.CantidadPuestos" type="number" min="1" max="999" required>
                    <p class="error-texto">@Html.MensajeError("CantidadPuestos", "Ingresá entre 1 y 999")</p>
                </div>
            </div>
            <div class="col-6 md:col-3">
                <div class="form-field @Html.ClaseError("FechaCierre")">
                    <label class="form-label" for="FechaCierre">Cierra el <span class="opcional">(opcional)</span></label>
                    <input class="form-control" id="FechaCierre" name="FechaCierre" value="@(ViewBag.Formulario.FechaCierre?.ToString("yyyy-MM-dd"))" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")">
                    <p class="error-texto">@Html.MensajeError("FechaCierre", "Elegí una fecha desde hoy")</p>
                </div>
            </div>
        </div>

        <div class="acciones">
            <a class="btn-outline theme-primary boton" asp-controller="Publicaciones" asp-action="Index">Cancelar</a>
            <button class="btn-solid theme-primary boton boton-acento" type="submit">@(ViewBag.Formulario.EsEmpresa ? "Publicar búsqueda" : "Enviar a revisión")</button>
        </div>
    </form>
</div>
