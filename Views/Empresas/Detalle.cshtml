@{
    ViewData["Title"] = ViewBag.Empresa.Nombre;
}

<div class="portada"></div>

<div class="container seccion">
    <div class="oferta-cabecera">
        <partial name="_LogoEmpresa" model='new LogoEmpresa(ViewBag.Empresa.Logo, ViewBag.Empresa.Nombre, "logo-empresa-xl")' />
        <div>
            <nav aria-label="Estás en">
                <ol class="migas">
                    <li><a asp-controller="Empresas" asp-action="Index">Empresas</a></li>
                    <li aria-current="page">@ViewBag.Empresa.Nombre</li>
                </ol>
            </nav>
            <h1 class="titulo">@ViewBag.Empresa.Nombre</h1>
            <p class="texto-suave">
                @if (ViewBag.Empresa.Rubro != null) { <span>@ViewBag.Empresa.Rubro</span> }
                @if (ViewBag.Empresa.UbicacionCompleta != null) { <span> · @ViewBag.Empresa.UbicacionCompleta</span> }
                @if (ViewBag.Empresa.EnlaceSitio != null) { <span> · <a href="@ViewBag.Empresa.EnlaceSitio" target="_blank" rel="noopener noreferrer">@ViewBag.Empresa.Sitio_Web</a></span> }
            </p>
        </div>
    </div>
    @if (ViewBag.EsPropia)
    {
        <div class="acciones">
            <a class="btn-outline theme-primary boton" asp-controller="Perfil" asp-action="Configuracion">Editar datos</a>
            <a class="btn-solid theme-primary boton" asp-controller="Publicaciones" asp-action="Nueva">+ Publicar búsqueda</a>
        </div>
    }

    <div class="row g-4">
        <div class="lg:col-5">
            <section class="card tarjeta">
                <h2 class="card-title">Sobre la empresa</h2>
                @if (string.IsNullOrWhiteSpace(ViewBag.Empresa.Descripcion))
                {
                    <p class="texto-suave">La empresa todavía no contó a qué se dedica.</p>
                }
                else
                {
                    <p class="texto-con-saltos">@ViewBag.Empresa.Descripcion</p>
                }
                @if (ViewBag.Empresa.TieneCuenta)
                {
                    <p class="verificada">✓ Registrada en Workly con su CUIT</p>
                }
            </section>
        </div>

        <section class="lg:col-7" id="ofertas">
            <h2 class="subtitulo">Búsquedas abiertas (@ViewBag.Abiertas.Count)</h2>
            @if (ViewBag.Abiertas.Count == 0)
            {
                <div class="vacio">
                    <p>@(ViewBag.EsPropia ? "Todavía no publicaste búsquedas." : "Esta empresa no tiene búsquedas abiertas en este momento.")</p>
                    @if (ViewBag.EsPropia)
                    {
                        <a class="btn-solid theme-primary boton" asp-controller="Publicaciones" asp-action="Nueva">+ Publicar mi primera búsqueda</a>
                    }
                </div>
            }
            else
            {
                <div class="lista-ofertas">
                    @foreach (Oferta oferta in ViewBag.Abiertas)
                    {
                        <partial name="_OfertaTarjeta" model="oferta" />
                    }
                </div>
            }
        </section>
    </div>
</div>
