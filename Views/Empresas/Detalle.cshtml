@model EmpresaDetalleViewModel
@{
    var empresa = Model.Empresa;
    ViewData["Title"] = empresa.Nombre;
    var abiertas = Model.Ofertas.Where(o => !o.EstaCerrada).ToList();
}

<div class="empresa-portada" aria-hidden="true"></div>

<div class="contenedor seccion-app">
    <header class="empresa-cabecera">
        <partial name="_LogoEmpresa" model='(empresa.Logo, empresa.Nombre, "logo-empresa--xl")' />
        <div class="empresa-cabecera__datos">
            <nav class="migas migas--chica" aria-label="Estás en">
                <a asp-controller="Empresas" asp-action="Index">Empresas</a>
                <icono nombre="chevron-right" />
                <span aria-current="page">@empresa.Nombre</span>
            </nav>
            <h1 class="empresa-cabecera__nombre">@empresa.Nombre</h1>
            <p class="empresa-cabecera__meta">
                @if (empresa.Rubro != null) { <span><icono nombre="building" tamano="18" />@empresa.Rubro</span> }
                @if (empresa.UbicacionCompleta != null) { <span><icono nombre="near-me" tamano="18" />@empresa.UbicacionCompleta</span> }
                @if (empresa.EnlaceSitio != null) { <span><icono nombre="globe" tamano="18" /><a class="enlace" href="@empresa.EnlaceSitio" target="_blank" rel="noopener noreferrer">@empresa.Sitio_Web</a></span> }
            </p>
        </div>
        @if (Model.EsPropia)
        {
            <div class="empresa-cabecera__acciones">
                <a class="boton boton--contorno" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="pen" />Editar datos</a>
                <a class="boton" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar búsqueda</a>
            </div>
        }
    </header>

    <div class="empresa-cuerpo">
        <section class="tarjeta">
            <h2 class="tarjeta__titulo">Sobre la empresa</h2>
            @if (string.IsNullOrWhiteSpace(empresa.Descripcion))
            {
                <p class="perfil-vacio">La empresa todavía no contó a qué se dedica.</p>
            }
            else
            {
                <p class="perfil-texto">@empresa.Descripcion</p>
            }
            @if (empresa.TieneCuenta)
            {
                <p class="texto-chico texto-suave empresa-verificada"><icono nombre="circle-check" tamano="16" />Registrada en Workly con su CUIT</p>
            }
        </section>

        <section class="empresa-ofertas" id="ofertas" aria-labelledby="ofertas-titulo">
            <h2 class="texto-titulo-4" id="ofertas-titulo">Búsquedas abiertas (@abiertas.Count)</h2>
            @if (abiertas.Count == 0)
            {
                <div class="estado-vacio estado-vacio--chico">
                    <p>@(Model.EsPropia ? "Todavía no publicaste búsquedas." : "Esta empresa no tiene búsquedas abiertas en este momento.")</p>
                    @if (Model.EsPropia)
                    {
                        <a class="boton" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar mi primera búsqueda</a>
                    }
                </div>
            }
            else
            {
                <div class="resultados__lista">
                    @foreach (var oferta in abiertas)
                    {
                        <partial name="_OfertaTarjeta" model="oferta" />
                    }
                </div>
            }
        </section>
    </div>
</div>
