@{
    ViewData["Title"] = ViewBag.Empresa.Nombre;
}

<div class="portada-degradado" aria-hidden="true"></div>

<div class="container espacio-abajo">
    <header class="fila-portada">
        <span class="cuadro-xl" aria-hidden="true"><partial name="_LogoEmpresa" model="ViewBag.Empresa" /></span>
        <div class="fila-portada-textos">
            <nav aria-label="Estás en">
                <ol class="breadcrumb breadcrumb-chica">
                    <li class="breadcrumb-item"><a href="/Empresas">Empresas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@ViewBag.Empresa.Nombre</li>
                </ol>
            </nav>
            <h1 class="fila-portada-titulo">@ViewBag.Empresa.Nombre</h1>
            <p class="fila-portada-datos">
                @if (ViewBag.Empresa.Rubro != null) { <span data-icono="building">@ViewBag.Empresa.Rubro</span> }
                @if (ViewBag.Empresa.UbicacionCompleta != null) { <span data-icono="near-me">@ViewBag.Empresa.UbicacionCompleta</span> }
                @if (ViewBag.Empresa.EnlaceSitio != null) { <span data-icono="globe"><a class="resaltado" href="@ViewBag.Empresa.EnlaceSitio" target="_blank" rel="noopener noreferrer">@ViewBag.Empresa.Sitio_Web</a></span> }
            </p>
        </div>
        @if (ViewBag.EsPropia)
        {
            <div class="fila-portada-acciones">
                <a class="btn btn-outline-primary" href="/Perfil/Configuracion" data-icono="pen">Editar datos</a>
                <a class="btn btn-primary" href="/Publicaciones/Nueva" data-icono="plus">Publicar búsqueda</a>
            </div>
        }
    </header>

    <div class="grilla-lateral-chica">
        <section class="card">
            <h2 class="card-title">Sobre la empresa</h2>
            @if (string.IsNullOrWhiteSpace(ViewBag.Empresa.Descripcion))
            {
                <p class="recuadro-punteado-mini">La empresa todavía no contó a qué se dedica.</p>
            }
            else
            {
                <p class="texto-gris">@ViewBag.Empresa.Descripcion</p>
            }
            @if (ViewBag.Empresa.TieneCuenta)
            {
                <p class="small texto-verde" data-icono="circle-check">Registrada en Workly con su CUIT</p>
            }
        </section>

        <section class="margen-scroll" id="ofertas" aria-labelledby="ofertas-titulo">
            <h2 id="ofertas-titulo">Búsquedas abiertas (@ViewBag.Abiertas.Count)</h2>
            @if (ViewBag.Abiertas.Count == 0)
            {
                <div class="recuadro-punteado-chico">
                    <p>@(ViewBag.EsPropia ? "Todavía no publicaste búsquedas." : "Esta empresa no tiene búsquedas abiertas en este momento.")</p>
                    @if (ViewBag.EsPropia)
                    {
                        <a class="btn btn-primary" href="/Publicaciones/Nueva" data-icono="plus">Publicar mi primera búsqueda</a>
                    }
                </div>
            }
            else
            {
                <div class="columna-espaciada">
                    @foreach (Oferta oferta in ViewBag.Abiertas)
                    {
                        <partial name="_OfertaTarjeta" model="oferta" />
                    }
                </div>
            }
        </section>
    </div>
</div>
