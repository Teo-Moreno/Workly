@{
    ViewData["Title"] = "Empresas";
}

<div class="container seccion">
    <h1 class="titulo">Empresas</h1>
    <p class="texto-suave">Conocé las empresas que buscan gente en Workly y mirá sus búsquedas abiertas.</p>

    <form class="buscador buscador-app" asp-controller="Empresas" asp-action="Index" method="get">
        <div class="form-field">
            <label class="form-label" for="buscar-empresa">Buscar empresa</label>
            <input class="form-control" id="buscar-empresa" type="text" name="Q" value="@ViewBag.Q" placeholder="Buscá por nombre o a qué se dedica">
        </div>
        <div class="form-field">
            <label class="form-label" for="empresas-provincia">Provincia</label>
            <select class="form-control" id="empresas-provincia" name="IDProvincia">
                @foreach (Provincia provincia in ViewBag.Provincias)
                {
                    if (provincia.ID == ViewBag.IDProvincia)
                    {
                        <option value="@provincia.ID">@provincia.Nombre</option>
                    }
                }
                <option value="">Todo el país</option>
                @foreach (Provincia provincia in ViewBag.Provincias)
                {
                    if (provincia.ID != ViewBag.IDProvincia)
                    {
                        <option value="@provincia.ID">@provincia.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="form-field">
            <label class="form-label" for="empresas-orden">Ordenar por</label>
            <select class="form-control" id="empresas-orden" name="Orden">
                @foreach (var (valor, texto) in Catalogos.Ordenes)
                {
                    if (ViewBag.Orden == valor)
                    {
                        <option value="@valor">@texto</option>
                    }
                }
                @foreach (var (valor, texto) in Catalogos.Ordenes)
                {
                    if (ViewBag.Orden != valor)
                    {
                        <option value="@valor">@texto</option>
                    }
                }
            </select>
        </div>
        <button class="btn-solid theme-primary boton" type="submit">Buscar</button>
    </form>

    <h2 class="subtitulo">@(ViewBag.Empresas.Count == 1 ? "1 empresa" : $"{ViewBag.Empresas.Count} empresas")</h2>

    @if (ViewBag.Empresas.Count == 0)
    {
        <div class="vacio">
            @if (ViewBag.Filtrando)
            {
                <h3>No encontramos empresas con esa búsqueda</h3>
                <p>Probá con otro nombre o buscá en todo el país.</p>
                <a class="btn-outline theme-primary boton" asp-controller="Empresas" asp-action="Index">Ver todo el país</a>
            }
            else
            {
                <h3>Todavía no hay empresas en Workly</h3>
                <p>Cuando una empresa cree su cuenta o publique una búsqueda, aparece acá.</p>
            }
            @if (!User.EstaLogueado())
            {
                <a class="btn-solid theme-primary boton" asp-controller="Cuenta" asp-action="CrearCuenta" asp-route-tipo="empresa">Registrar mi empresa</a>
            }
        </div>
    }
    else
    {
        <div class="grilla-ofertas">
            @foreach (Empresa empresa in ViewBag.Empresas)
            {
                <partial name="_EmpresaTarjeta" model="empresa" />
            }
        </div>
    }
</div>
