@{
    ViewData["Title"] = "";
}

<section class="hero">
    <div class="container">
        <h1 class="hero-titulo">Encontrá el trabajo que <mark class="resaltado">encaja</mark> con vos.</h1>
        <p class="hero-texto">
            Buscá en un solo lugar las ofertas publicadas en Workly y en otros sitios como LinkedIn o Bumeran,
            postulate y seguí cada proceso desde tu tablero.
        </p>
        <form class="buscador" asp-controller="Empleos" asp-action="Index" method="get">
            <label class="visually-hidden" for="buscar-inicio">Puesto o palabra clave</label>
            <input class="form-control" id="buscar-inicio" type="text" name="q" autocomplete="off" placeholder="¿Qué trabajo buscás? Ej.: @(ViewBag.Puestos.Count > 0 ? ViewBag.Puestos[0] : "Administrativo/a")">
            <button class="btn-solid theme-primary boton boton-acento" type="submit">Buscar trabajo</button>
        </form>
    </div>
</section>

<section class="seccion" id="como-funciona">
    <div class="container">
        <span class="badge etiqueta etiqueta-principal">Cómo funciona</span>
        <h2 class="titulo">Tres pasos para dejar de buscar a ciegas</h2>
        <div class="pasos">
                <div class="paso">
                    <span class="paso-numero">01</span>
                    <h3>Creá tu perfil laboral</h3>
                    <p>Cargá tu experiencia, estudios, habilidades, idiomas, tu CV y el tipo de trabajo que buscás.</p>
                </div>
                <div class="paso">
                    <span class="paso-numero">02</span>
                    <h3>Buscá en todos lados a la vez</h3>
                    <p>Juntamos las búsquedas de Workly con las de otros sitios, y en tu inicio te mostramos las que coinciden con lo que contaste que buscás.</p>
                </div>
                <div class="paso">
                    <span class="paso-numero">03</span>
                    <h3>Postulate y hacé seguimiento</h3>
                    <p>Postulate a las búsquedas de Workly con tu perfil y tu CV, y anotá en tu tablero cada proceso: enviada, en revisión, pasaste o no.</p>
                </div>
        </div>
    </div>
</section>

<section class="seccion seccion-oscura">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="lg:col-5">
                <span class="badge etiqueta etiqueta-acento">Por qué Workly</span>
                <h2 class="titulo">No es otra página de avisos.</h2>
                <p>Una sola búsqueda, un solo perfil y un solo tablero para toda tu búsqueda laboral.</p>
                <a class="btn-solid theme-primary boton boton-acento" asp-controller="Cuenta" asp-action="CrearCuenta">Crear mi perfil</a>
            </div>
            <div class="lg:col-7">
                <ul class="list-group diferenciales">
                    <li class="list-group-item"><h3>Más ofertas</h3><p>Las búsquedas que publican empresas y personas en Workly, junto con las de otros sitios.</p></li>
                    <li class="list-group-item"><h3>Búsquedas revisadas</h3><p>Las empresas se registran con su CUIT y las búsquedas que publican las personas se revisan antes de salir.</p></li>
                    <li class="list-group-item"><h3>A tu medida</h3><p>Filtrá por modalidad, tipo de empleo, fecha y provincia, y guardá qué estás buscando en tu perfil.</p></li>
                    <li class="list-group-item"><h3>Más organizado</h3><p>Todas tus postulaciones en un tablero que movés vos, sin planillas ni mails perdidos.</p></li>
                </ul>
            </div>
        </div>
    </div>
</section>

@if (ViewBag.Empresas.Count > 0)
{
    <section class="seccion">
        <div class="container">
            <h2 class="subtitulo">Empresas con búsquedas abiertas en Workly</h2>
            <ul class="empresas-inicio">
                @foreach (Empresa empresa in ViewBag.Empresas)
                {
                    <li>
                        <a asp-controller="Empresas" asp-action="Detalle" asp-route-id="@empresa.ID">
                            <partial name="_LogoEmpresa" model='new LogoEmpresa(empresa.Logo, empresa.Nombre, "logo-empresa-sm logo-empresa-principal")' />
                            @empresa.Nombre
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
}

<section class="container seccion" id="para-empresas">
    <div class="cta">
        <h2 class="titulo">Tu próximo trabajo no debería ser una <mark class="resaltado">aguja en un pajar.</mark></h2>
        <p>Creá tu perfil gratis. ¿Tenés una empresa? Registrala con su CUIT, publicá tus búsquedas y mirá quién se postula.</p>
        <a class="btn-solid theme-primary boton boton-acento" asp-controller="Cuenta" asp-action="CrearCuenta">Crear mi perfil gratis</a>
        <a class="btn-outline theme-inverse boton" asp-controller="Cuenta" asp-action="CrearCuenta" asp-route-tipo="empresa">Soy empresa</a>
    </div>
</section>
