@model LandingViewModel
@{
    ViewData["Title"] = "";
}

<section class="hero">
    <div class="contenedor hero__interior hero__interior--solo">
        <div class="hero__texto">
            <h1 class="hero__titulo texto-display">Encontrá el trabajo que <span class="texto-secundario">encaja</span> con vos.</h1>

            <p class="hero__bajada texto-bajada">
                Buscá en un solo lugar las ofertas publicadas en Workly y en otros sitios como LinkedIn o Bumeran,
                postulate y seguí cada proceso desde tu tablero.
            </p>

            <form class="buscador buscador--landing" asp-controller="Empleos" asp-action="Index" method="get" role="search">
                <label class="buscador__campo">
                    <icono nombre="search" />
                    <span class="buscador__textos">
                        <span class="buscador__etiqueta">Puesto o palabra clave</span>
                        <input class="buscador__input" type="search" name="q" autocomplete="off" placeholder="¿Qué trabajo buscás?"
                               data-animar-puestos="@string.Join("|", Model.Puestos)" />
                    </span>
                </label>
                <button class="boton boton--lg buscador__boton" type="submit">Buscar trabajo</button>
            </form>
        </div>
    </div>
</section>

<section class="como-funciona" id="como-funciona" aria-labelledby="como-funciona-titulo">
    <div class="contenedor">
        <header class="seccion-encabezado">
            <span class="etiqueta">Cómo funciona</span>
            <h2 class="texto-titulo-1" id="como-funciona-titulo">Tres pasos para dejar de buscar a ciegas</h2>
        </header>

        <ol class="pasos-landing" role="list">
            <li class="paso-landing">
                <div class="paso-landing__cabecera">
                    <span class="caja-icono caja-icono--principal paso-landing__icono"><icono nombre="user-square" /></span>
                    <span class="paso-landing__numero" aria-hidden="true">01</span>
                </div>
                <h3 class="paso-landing__titulo">Creá tu perfil laboral</h3>
                <p class="paso-landing__texto">Cargá tu experiencia, estudios, habilidades, idiomas, tu CV y el tipo de trabajo que buscás.</p>
            </li>
            <li class="paso-landing">
                <div class="paso-landing__cabecera">
                    <span class="caja-icono caja-icono--principal paso-landing__icono"><icono nombre="search" /></span>
                    <span class="paso-landing__numero" aria-hidden="true">02</span>
                </div>
                <h3 class="paso-landing__titulo">Buscá en todos lados a la vez</h3>
                <p class="paso-landing__texto">Juntamos las búsquedas de Workly con las de otros sitios, y en tu inicio te mostramos las que coinciden con lo que contaste que buscás.</p>
            </li>
            <li class="paso-landing">
                <div class="paso-landing__cabecera">
                    <span class="caja-icono caja-icono--principal paso-landing__icono"><icono nombre="circle-check" /></span>
                    <span class="paso-landing__numero" aria-hidden="true">03</span>
                </div>
                <h3 class="paso-landing__titulo">Postulate y hacé seguimiento</h3>
                <p class="paso-landing__texto">Postulate a las búsquedas de Workly con tu perfil y tu CV, y anotá en tu tablero cada proceso: enviada, en revisión, pasaste o no.</p>
            </li>
        </ol>
    </div>
</section>

<section class="diferenciales" aria-labelledby="diferenciales-titulo">
    <div class="contenedor diferenciales__interior">
        <div class="diferenciales__texto">
            <span class="etiqueta etiqueta--acento">Por qué Workly</span>
            <h2 class="diferenciales__titulo" id="diferenciales-titulo">No es otra página de avisos.</h2>
            <p class="diferenciales__bajada">Una sola búsqueda, un solo perfil y un solo tablero para toda tu búsqueda laboral.</p>
            <a class="boton boton--acento" asp-controller="Cuenta" asp-action="CrearCuenta">Crear mi perfil</a>
        </div>

        <ul class="diferenciales__grilla" role="list">
            <li class="diferencial">
                <span class="caja-icono caja-icono--secundario diferencial__icono"><icono nombre="search" /></span>
                <h3 class="diferencial__titulo">Más ofertas</h3>
                <p class="diferencial__texto">Las búsquedas que publican empresas y personas en Workly, junto con las de otros sitios.</p>
            </li>
            <li class="diferencial">
                <span class="caja-icono caja-icono--secundario diferencial__icono"><icono nombre="circle-check-outline" /></span>
                <h3 class="diferencial__titulo">Búsquedas revisadas</h3>
                <p class="diferencial__texto">Las empresas se registran con su CUIT y las búsquedas que publican las personas se revisan antes de salir.</p>
            </li>
            <li class="diferencial">
                <span class="caja-icono caja-icono--secundario diferencial__icono"><icono nombre="settings" /></span>
                <h3 class="diferencial__titulo">A tu medida</h3>
                <p class="diferencial__texto">Filtrá por modalidad, tipo de empleo, fecha y provincia, y guardá qué estás buscando en tu perfil.</p>
            </li>
            <li class="diferencial">
                <span class="caja-icono caja-icono--secundario diferencial__icono"><icono nombre="checkbox-checked" /></span>
                <h3 class="diferencial__titulo">Más organizado</h3>
                <p class="diferencial__texto">Todas tus postulaciones en un tablero que movés vos, sin planillas ni mails perdidos.</p>
            </li>
        </ul>
    </div>
</section>

@if (Model.Empresas.Count > 0)
{
    <section class="empresas-landing" aria-labelledby="empresas-landing-titulo">
        <div class="contenedor">
            <h2 class="empresas-landing__titulo" id="empresas-landing-titulo">Empresas con búsquedas abiertas en Workly</h2>
            <ul class="empresas-landing__lista" role="list">
                @foreach (var empresa in Model.Empresas)
                {
                    <li>
                        <a class="empresas-landing__item" asp-controller="Empresas" asp-action="Detalle" asp-route-id="@empresa.ID">
                            <partial name="_LogoEmpresa" model='(empresa.Logo, empresa.Nombre, "logo-empresa--sm logo-empresa--principal")' />
                            @empresa.Nombre
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
}

<section class="contenedor cta" id="para-empresas" aria-labelledby="cta-titulo">
    <div class="cta__tarjeta">
        <div class="cta__texto">
            <h2 class="cta__titulo" id="cta-titulo">Tu próximo trabajo no debería ser una <span class="texto-acento">aguja en un pajar.</span></h2>
            <p class="cta__bajada">Creá tu perfil gratis. ¿Tenés una empresa? Registrala con su CUIT, publicá tus búsquedas y mirá quién se postula.</p>
        </div>
        <div class="cta__acciones">
            <a class="boton boton--acento" asp-controller="Cuenta" asp-action="CrearCuenta">Crear mi perfil gratis</a>
            <a class="boton boton--contorno-blanco" asp-controller="Cuenta" asp-action="CrearCuenta" asp-route-tipo="empresa">Soy empresa</a>
        </div>
    </div>
</section>
