@{
    ViewData["Title"] = "UI Kit";
    var ofertas = (List<Oferta>)ViewBag.Ofertas;
    var marca = new[] { ("Principal", "#133461", true), ("Neutro oscuro", "#1A1A1A", true), ("Secundario", "#16AFBD", false), ("Acento", "#F2B84B", false), ("Neutro claro", "#F5F7FA", false) };
    var neutros = new[] { ("Black", "#000000", true), ("Gray 1", "#1F2937", true), ("Gray 2", "#374151", true), ("Gray 3", "#4B5563", true), ("Gray 4", "#6B7280", true), ("Gray 5", "#9CA3AF", true), ("Gray 6", "#D1D5DB", false), ("Gray 7", "#F3F4F6", false), ("White", "#FFFFFF", false) };
    var estados = new[] { ("Info", "#A0C3FF"), ("Success", "#76CA66"), ("Warning", "#FBC756"), ("Error", "#BA0000") };
    var estilosTexto = new[] { ("32px / Bold", 32, 36, true), ("24px / Bold", 24, 28, true), ("22px / Bold", 22, 26, true), ("20px / Bold", 20, 24, true), ("18px / Bold", 18, 22, true), ("18px / Regular", 18, 22, false), ("16px / Bold", 16, 20, true), ("16px / Regular", 16, 24, false), ("14px / Bold", 14, 20, true), ("14px / Regular", 14, 20, false), ("13px / Bold", 13, 20, true), ("13px / Regular", 13, 20, false) };
    var iconosContorno = new[] { "alarm", "calendar", "message-writing", "mail", "user-square", "warning-outline", "help-circle-outline", "error-outline", "trash-full", "filter-outline", "circle-check-outline", "settings", "checkbox-checked", "checkbox-square", "checkbox", "arrow", "check", "close-big", "home-alt-outline", "slider-03" };
    var iconosRellenos = new[] { "error", "checkbox-checked-fill", "near-me", "home-alt-fill", "warning", "circle-check", "settings-filled", "notification", "filter", "help-circle" };
    var iconosExtra = new[] { "search", "plus", "pen", "chevron-down", "chevron-right", "arrow-left", "arrow-right", "share", "bookmark", "bookmark-fill", "download", "upload", "link", "code", "briefcase", "building", "book", "log-out", "eye", "eye-off", "lock", "star", "star-fill", "menu", "dots-vertical", "external-link", "grid", "list", "image", "users", "user", "trending-up", "globe", "send", "archive", "video", "info", "drag", "notification-outline" };
    var niveles = new[] { "Básico", "Intermedio", "Avanzado", "Fluido", "Nativo" };
}
@* Guía visual: el UI Kit de Figma › Guidelines implementado con el CSS del proyecto *@

<section class="legal-encabezado">
    <div class="contenedor">
        <span class="etiqueta">Guía de estilos</span>
        <h1 class="texto-titulo-1">UI Kit de Workly</h1>
        <p class="texto-bajada">Los componentes de la página "Guidelines" del Figma, listos para usar en las vistas.</p>
        <nav class="kit-indice" aria-label="Secciones del kit">
            <a class="chip" href="#tipografia">01. Tipografía</a>
            <a class="chip" href="#colores">02. Colores</a>
            <a class="chip" href="#iconografia">03. Iconografía</a>
            <a class="chip" href="#campos">04. Campos de texto</a>
            <a class="chip" href="#botones">05. Botones</a>
            <a class="chip" href="#cargas">06. Cargas</a>
            <a class="chip" href="#notificaciones">07. Notificaciones</a>
            <a class="chip" href="#selectores">08. Selectores</a>
            <a class="chip" href="#tarjetas">Tarjetas</a>
        </nav>
    </div>
</section>

<div class="contenedor kit">
    @* 01 · Tipografía *@
    <section class="kit-seccion" id="tipografia">
        <h2 class="kit-seccion__titulo">01. <span>Tipografía</span></h2>
        <p class="kit-seccion__bajada">Fuentes de Workly: <strong>Cardo</strong> (lectura) · <strong>The Seasons</strong> (principal).</p>
        <div class="kit-pesos">
            <div><span style="font-weight: 400">Aa</span>Regular</div>
            <div><span style="font-style: italic">Aa</span>Italic</div>
            <div><span style="font-weight: 700">Aa</span>Bold</div>
        </div>
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr><th scope="col">Nombre</th><th scope="col">Tamaño</th><th scope="col">Altura de línea</th><th scope="col">Ejemplo</th></tr>
                </thead>
                <tbody>
                    @foreach (var (nombre, tamano, altura, negrita) in estilosTexto)
                    {
                        <tr>
                            <td>@nombre</td>
                            <td>@(tamano)px</td>
                            <td>@(altura)px</td>
                            <td style="font-size: @(tamano)px; line-height: @(altura)px; font-weight: @(negrita ? 700 : 400)">Encontrá el trabajo que encaja con vos</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @* 02 · Colores *@
    <section class="kit-seccion" id="colores">
        <h2 class="kit-seccion__titulo">02. <span>Colores</span></h2>
        <h3 class="kit-subtitulo">Colores de la marca</h3>
        <div class="kit-colores kit-colores--marca">
            @foreach (var (nombre, hex, oscuro) in marca)
            {
                <div class="kit-color" style="background: @hex; color: @(oscuro ? "#fff" : "#1a1a1a")"><strong>@nombre</strong><span>@hex</span></div>
            }
        </div>
        <h3 class="kit-subtitulo">Colores neutros</h3>
        <div class="kit-colores">
            @foreach (var (nombre, hex, oscuro) in neutros)
            {
                <div class="kit-color kit-color--chico" style="background: @hex; color: @(oscuro ? "#fff" : "#374151")"><strong>@nombre</strong><span>@hex</span></div>
            }
        </div>
        <h3 class="kit-subtitulo">Colores de estado</h3>
        <div class="kit-colores">
            @foreach (var (nombre, hex) in estados)
            {
                <div class="kit-color kit-color--chico" style="background: @hex; color: #fff"><strong>@nombre</strong><span>@hex</span></div>
            }
        </div>
    </section>

    @* 03 · Iconografía *@
    <section class="kit-seccion" id="iconografia">
        <h2 class="kit-seccion__titulo">03. <span>Iconografía</span></h2>
        <p class="kit-seccion__bajada">Íconos de 24 px de alto y ancho, con trazo de 2 px. Uso: <code>&lt;icono nombre="alarm" /&gt;</code></p>
        <h3 class="kit-subtitulo">Íconos de contorno</h3>
        <ul class="kit-iconos" role="list">
            @foreach (var nombre in iconosContorno)
            {
                <li><icono nombre="@nombre" /><span>@nombre</span></li>
            }
        </ul>
        <h3 class="kit-subtitulo">Íconos rellenos</h3>
        <ul class="kit-iconos" role="list">
            @foreach (var nombre in iconosRellenos)
            {
                <li><icono nombre="@nombre" /><span>@nombre</span></li>
            }
        </ul>
        <h3 class="kit-subtitulo">Íconos agregados para las vistas</h3>
        <ul class="kit-iconos" role="list">
            @foreach (var nombre in iconosExtra)
            {
                <li><icono nombre="@nombre" /><span>@nombre</span></li>
            }
        </ul>
    </section>

    @* 04 · Campos de texto *@
    <section class="kit-seccion" id="campos">
        <h2 class="kit-seccion__titulo">04. <span>Campos de texto</span></h2>
        <h3 class="kit-subtitulo">Tipos de campo</h3>
        <div class="kit-grilla">
            <div class="campo campo--horizontal">
                <label class="campo__etiqueta" for="kit-etiqueta">Etiqueta</label>
                <input class="campo__control" id="kit-etiqueta" placeholder="Escribí acá" />
            </div>
            <div class="campo">
                <div class="control-con-icono">
                    <icono nombre="user-square" />
                    <input class="campo__control" placeholder="Escribí acá" aria-label="Campo con ícono" />
                </div>
            </div>
            <div class="fila">
                <icono nombre="drag" class="texto-suave" />
                <input class="campo__control" placeholder="Escribí acá" aria-label="Campo con arrastrar y soltar" />
            </div>
            <div class="campo-agregar">
                <input class="campo__control" placeholder="Escribí acá" aria-label="Agregar" />
                <button class="boton boton--icono" type="button"><icono nombre="plus" etiqueta="Agregar" /></button>
            </div>
        </div>

        <h3 class="kit-subtitulo">Entrada de texto</h3>
        <div class="kit-grilla">
            <div class="campo"><span class="campo__etiqueta">Por defecto</span><input class="campo__control" placeholder="Escribí acá" aria-label="Por defecto" /></div>
            <div class="campo"><span class="campo__etiqueta">Completo</span><input class="campo__control" value="Frontend Developer" aria-label="Completo" /></div>
            <div class="campo campo--error"><span class="campo__etiqueta">Mensaje de error</span><input class="campo__control" value="error" aria-label="Con error" /><span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />Mensaje de error</span></div>
            <div class="campo campo--exito"><span class="campo__etiqueta">Mensaje de éxito</span><input class="campo__control" value="éxito" aria-label="Con éxito" /><span class="campo__mensaje campo__mensaje--exito"><icono nombre="circle-check" />Mensaje de éxito</span></div>
            <div class="campo"><span class="campo__etiqueta">Deshabilitado</span><input class="campo__control" placeholder="Escribí acá" disabled aria-label="Deshabilitado" /></div>
            <div class="campo"><span class="campo__etiqueta">Desplegable</span><select class="campo__control" aria-label="Desplegable"><option>Escribí acá</option><option>Opción de ejemplo</option></select></div>
            <div class="campo">
                <span class="campo__etiqueta">Confirmar / Eliminar</span>
                <div class="fila">
                    <input class="campo__control" value="Nueva habilidad" aria-label="Confirmar o eliminar" />
                    <button class="boton boton--icono boton--icono-contorno" type="button"><icono nombre="trash-full" etiqueta="Eliminar" class="texto-error" /></button>
                    <button class="boton boton--icono boton--icono-contorno" type="button"><icono nombre="check" etiqueta="Confirmar" /></button>
                </div>
            </div>
            <div class="campo">
                <span class="campo__etiqueta">Tooltip</span>
                <div class="fila">
                    <input class="campo__control" placeholder="Escribí acá" aria-label="Con ayuda" />
                    <span class="tooltip" tabindex="0">
                        <span class="tooltip__disparador"><icono nombre="error" etiqueta="Ayuda" /></span>
                        <span class="tooltip__contenido" role="tooltip">Este es un mensaje de ayuda.</span>
                    </span>
                </div>
            </div>
        </div>

        <h3 class="kit-subtitulo">Tipos de selector</h3>
        <div class="kit-grilla">
            <div class="campo"><span class="campo__etiqueta">Selector de hora</span><input class="campo__control" type="time" value="15:00" aria-label="Hora" /></div>
            <div class="campo"><span class="campo__etiqueta">Selector de calendario</span><input class="campo__control" type="date" value="2026-10-27" aria-label="Fecha" /></div>
            <div class="campo"><span class="campo__etiqueta">Zona de archivo</span>
                <label class="zona-archivo zona-archivo--fila" data-zona-archivo>
                    <span class="caja-icono caja-icono--sm"><icono nombre="upload" /></span>
                    <span class="zona-archivo__nombre" data-zona-archivo-nombre>Subí tu CV</span>
                    <input type="file" />
                </label>
            </div>
        </div>
    </section>

    @* 05 · Botones *@
    <section class="kit-seccion" id="botones">
        <h2 class="kit-seccion__titulo">05. <span>Botones</span></h2>
        <div class="snackbar aviso" role="note">
            <icono nombre="info" />
            <span class="snackbar__texto"><strong>Reglas de los botones:</strong> padding izquierda/derecha 1,5 × tamaño de fuente; padding arriba/abajo 1 × tamaño de fuente. Botón de ancho completo: <code>.boton--bloque</code>.</span>
        </div>
        <div class="kit-botones">
            <div><h3 class="kit-subtitulo">Color</h3>
                <div class="pila"><button class="boton">Postularme</button><button class="boton boton--secundario">Postularme</button><button class="boton boton--acento">Crear mi perfil</button><button class="boton boton--gris">Cancelar</button></div>
            </div>
            <div><h3 class="kit-subtitulo">Tamaño</h3>
                <div class="pila" style="align-items: flex-start"><button class="boton boton--sm">Pequeño</button><button class="boton">Normal</button><button class="boton boton--mediano">Mediano</button></div>
            </div>
            <div><h3 class="kit-subtitulo">Variantes</h3>
                <div class="kit-variantes">
                    <button class="boton">Botón</button>
                    <button class="boton"><icono nombre="pen" />Botón</button>
                    <button class="boton boton--contorno">Botón</button>
                    <button class="boton boton--etiqueta">Botón<icono nombre="close-big" /></button>
                    <button class="boton boton--texto">Botón</button>
                    <button class="boton boton--icono"><icono nombre="plus" etiqueta="Agregar" /></button>
                    <button class="boton boton--puntos"><icono nombre="dots-vertical" etiqueta="Más opciones" /></button>

                    <button class="boton" disabled>Botón</button>
                    <button class="boton" disabled><icono nombre="pen" />Botón</button>
                    <button class="boton boton--contorno" disabled>Botón</button>
                    <button class="boton boton--etiqueta" disabled>Botón<icono nombre="close-big" /></button>
                    <button class="boton boton--texto" disabled>Botón</button>
                    <button class="boton boton--icono" disabled><icono nombre="plus" etiqueta="Agregar" /></button>
                    <span></span>
                </div>
                <p class="texto-chico texto-suave">Fila superior: reposo (pasá el mouse para ver Hover y hacé clic para Presionado). Fila inferior: deshabilitado.</p>
            </div>
        </div>
    </section>

    @* 06 · Cargas *@
    <section class="kit-seccion" id="cargas">
        <h2 class="kit-seccion__titulo">06. <span>Loadings y barras de progreso</span></h2>
        <div class="kit-cargas">
            <div class="kit-carga kit-carga--principal"><span class="spinner spinner--claro"></span><span class="indicador-progreso" style="--indicador-color: #fff"></span></div>
            <div class="kit-carga kit-carga--oscura"><span class="spinner"></span><span class="indicador-progreso"></span></div>
            <div class="kit-carga kit-carga--gris"><span class="spinner" style="--spinner-color: var(--gris-4)"></span><span class="indicador-progreso" style="--indicador-color: var(--gris-4)"></span></div>
            <div class="kit-carga kit-carga--blanca">
                <div class="progreso" style="width: 100%"><span class="progreso__barra" style="--valor: 65%"></span></div>
                <div class="progreso progreso--principal" style="width: 100%"><span class="progreso__barra" style="--valor: 85%"></span></div>
                <div class="progreso progreso--acento progreso--fino" style="width: 100%"><span class="progreso__barra" style="--valor: 40%"></span></div>
            </div>
        </div>
    </section>

    @* 07 · Notificaciones *@
    <section class="kit-seccion" id="notificaciones">
        <h2 class="kit-seccion__titulo">07. <span>Notificaciones</span></h2>
        <div class="kit-notificaciones">
            <div>
                <h3 class="kit-subtitulo">Notificaciones</h3>
                <div class="panel-notificaciones kit-panel" data-pestanas>
                    <div class="panel-notificaciones__cabecera"><h4 class="panel-notificaciones__titulo">Notificaciones</h4><icono nombre="close-big" /></div>
                    <div class="panel-notificaciones__filtros">
                        <div class="segmentado" role="tablist"><button class="segmentado__boton esta-activa" role="tab" aria-selected="true" data-pestana="kit-todas">Todas</button><button class="segmentado__boton" role="tab" aria-selected="false" data-pestana="kit-leidas">Leídas</button></div>
                    </div>
                    <div class="panel-notificaciones__lista" data-panel="kit-todas">
                        <a class="notificacion es-no-leida" href="#"><span class="notificacion__titulo">Globant vio tu postulación a Frontend Developer React</span><span class="notificacion__texto">Te avisaremos cuando la empresa revise tu perfil.</span><span class="notificacion__fecha">Recién</span></a>
                        <a class="notificacion" href="#"><span class="notificacion__titulo">Actualizá tu perfil.</span><span class="notificacion__texto">Completá tu perfil para recibir mejores coincidencias.</span><span class="notificacion__fecha">Hace 1 día</span></a>
                    </div>
                    <div class="panel-notificaciones__lista" data-panel="kit-leidas" hidden>
                        <a class="notificacion" href="#"><span class="notificacion__titulo">Actualizá tu perfil.</span><span class="notificacion__texto">Completá tu perfil para recibir mejores coincidencias.</span><span class="notificacion__fecha">Hace 1 día</span></a>
                    </div>
                    <div class="panel-notificaciones__pie"><button class="boton boton--texto">Ver todas</button></div>
                </div>
            </div>
            <div class="pila" style="--pila-espacio: 20px">
                <h3 class="kit-subtitulo">Pop ups</h3>
                <div class="fila fila--envolver">
                    <button class="boton" type="button" data-modal-abrir="kit-modal">Abrir pop up</button>
                    <button class="boton boton--contorno" type="button" onclick="Workly.snackbar('¡Postulación enviada con éxito!', 'exito')">Mostrar snackbar</button>
                </div>
                <div class="modal kit-modal-estatico">
                    <div class="modal__contenido">
                        <div class="modal__cabecera"><h4 class="modal__titulo">Título</h4><icono nombre="close-big" /></div>
                        <p class="modal__descripcion">Descripción</p>
                        <div class="modal__acciones"><button class="boton boton--gris">Cancelar</button><button class="boton">Confirmar</button></div>
                    </div>
                </div>
                <h3 class="kit-subtitulo">Snackbar</h3>
                <div class="snackbar snackbar--advertencia"><span class="snackbar__texto">Tu perfil está incompleto.</span><button class="snackbar__cerrar" type="button" aria-label="Cerrar" data-cerrar-aviso><icono nombre="close-big" tamano="20" /></button></div>
                <div class="snackbar snackbar--error"><span class="snackbar__texto">No pudimos enviar tu postulación.</span><button class="snackbar__cerrar" type="button" aria-label="Cerrar" data-cerrar-aviso><icono nombre="close-big" tamano="20" /></button></div>
                <div class="snackbar snackbar--exito"><span class="snackbar__texto">¡Postulación enviada con éxito!</span><button class="snackbar__cerrar" type="button" aria-label="Cerrar" data-cerrar-aviso><icono nombre="close-big" tamano="20" /></button></div>
                <div class="snackbar"><span class="snackbar__texto">Hay 3 ofertas nuevas para vos.</span><button class="snackbar__cerrar" type="button" aria-label="Cerrar" data-cerrar-aviso><icono nombre="close-big" tamano="20" /></button></div>
            </div>
        </div>
    </section>

    @* 08 · Selectores y elementos *@
    <section class="kit-seccion" id="selectores">
        <h2 class="kit-seccion__titulo">08. <span>Selectores y elementos</span></h2>
        <div class="kit-selectores">
            <div>
                <h3 class="kit-subtitulo">Casilla</h3>
                <div class="pila">
                    <label class="casilla"><input type="checkbox" /><span class="casilla__caja"><icono nombre="check" /></span>Por defecto</label>
                    <label class="casilla"><input type="checkbox" checked /><span class="casilla__caja"><icono nombre="check" /></span>Marcado</label>
                    <label class="casilla"><input type="checkbox" checked disabled /><span class="casilla__caja"><icono nombre="check" /></span>Deshabilitado</label>
                </div>
            </div>
            <div>
                <h3 class="kit-subtitulo">Botón de opción</h3>
                <div class="pila">
                    <label class="opcion"><input type="radio" name="kit-opcion" /><span class="opcion__circulo"></span>Por defecto</label>
                    <label class="opcion"><input type="radio" name="kit-opcion" checked /><span class="opcion__circulo"></span>Marcado</label>
                    <label class="opcion"><input type="radio" name="kit-opcion-2" checked disabled /><span class="opcion__circulo"></span>Deshabilitado</label>
                </div>
            </div>
            <div>
                <h3 class="kit-subtitulo">Interruptor</h3>
                <div class="pila">
                    <label class="interruptor"><input type="checkbox" /><span class="interruptor__pista"></span>Por defecto</label>
                    <label class="interruptor"><input type="checkbox" checked /><span class="interruptor__pista"></span>Marcado</label>
                    <label class="interruptor"><input type="checkbox" disabled /><span class="interruptor__pista"></span>Deshabilitado</label>
                </div>
            </div>
            <div>
                <h3 class="kit-subtitulo">Ordenamiento</h3>
                <div class="desplegable" data-desplegable>
                    <button class="ordenar__boton" type="button" aria-expanded="false" data-desplegable-boton><span data-ordenar-valor>Ordenar por</span><icono nombre="chevron-down" /></button>
                    <div class="desplegable__panel desplegable__panel--izquierda" data-desplegable-panel>
                        <ul class="menu" role="list" data-ordenar>
                            <li><button class="menu__item" type="button">A-Z</button></li>
                            <li><button class="menu__item" type="button">Relevancia <icono nombre="arrow-up" /></button></li>
                            <li><button class="menu__item" type="button">Relevancia <icono nombre="arrow" /></button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="kit-selectores">
            <div>
                <h3 class="kit-subtitulo">Breadcrumbs</h3>
                <nav class="migas" aria-label="Ejemplo de migas">
                    <a class="migas__inicio" href="#"><icono nombre="home-alt-fill" etiqueta="Inicio" /></a>
                    <a href="#">Inicio</a><icono nombre="chevron-right" />
                    <a href="#">Detalle</a><icono nombre="chevron-right" />
                    <span aria-current="page">Ofertas</span>
                </nav>
            </div>
            <div data-pestanas>
                <h3 class="kit-subtitulo">Pestañas</h3>
                <div class="pestanas" role="tablist">
                    <button class="pestanas__boton esta-activa" role="tab" aria-selected="true" data-pestana="kit-ofertas">Ofertas</button>
                    <button class="pestanas__boton" role="tab" aria-selected="false" data-pestana="kit-postulaciones">Postulaciones</button>
                </div>
                <p class="texto-chico texto-suave" data-panel="kit-ofertas" style="margin-top: 10px">Contenido de Ofertas</p>
                <p class="texto-chico texto-suave" data-panel="kit-postulaciones" style="margin-top: 10px" hidden>Contenido de Postulaciones</p>
            </div>
            <div>
                <h3 class="kit-subtitulo">Paginación</h3>
                <nav class="paginacion" aria-label="Ejemplo de paginación">
                    <a class="paginacion__item" href="#"><icono nombre="chevron-left" etiqueta="Anterior" /></a>
                    <a class="paginacion__item" href="#">1</a>
                    <a class="paginacion__item" href="#" aria-current="page">2</a>
                    <a class="paginacion__item" href="#">3</a>
                    <a class="paginacion__item" href="#">4</a>
                    <span class="paginacion__item">…</span>
                    <a class="paginacion__item" href="#"><icono nombre="chevron-right" etiqueta="Siguiente" /></a>
                </nav>
            </div>
        </div>

        <div class="kit-selectores kit-selectores--dos">
            <div>
                <h3 class="kit-subtitulo">Barra de progreso</h3>
                @for (var paso = 1; paso <= 3; paso++)
                {
                    <ol class="pasos kit-pasos">
                        @for (var i = 1; i <= 3; i++)
                        {
                            <li class="pasos__item @(i < paso ? "esta-completo" : i == paso ? "esta-actual" : "")">
                                <span class="pasos__circulo"><span class="pasos__numero">@i</span><icono nombre="check" /></span>Paso @i
                            </li>
                        }
                    </ol>
                }
            </div>
            <div>
                <h3 class="kit-subtitulo">Barra de valoración</h3>
                <div class="kit-valoraciones">
                    @for (var nivel = 0; nivel < niveles.Length; nivel++)
                    {
                        <div class="kit-valoracion">
                            <span class="etiqueta etiqueta--principal">@niveles[nivel]</span>
                            <div class="valoracion" style="--nivel: @nivel">
                                @for (var i = 0; i < niveles.Length; i++)
                                {
                                    <span class="valoracion__punto @(i < nivel ? "esta-lleno" : "") @(i == nivel ? "esta-actual" : "")"></span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="kit-selectores kit-selectores--dos">
            <div>
                <h3 class="kit-subtitulo">Selector de fecha</h3>
                <div class="calendario">
                    <div class="calendario__cabecera"><span>Octubre<icono nombre="chevron-down" /></span><span>2026<icono nombre="chevron-down" /></span></div>
                    <div class="calendario__grilla">
                        @foreach (var dia in new[] { "Lu", "Ma", "Mi", "Ju", "Vi", "Sá", "Do" })
                        {
                            <span class="calendario__dia-semana">@dia</span>
                        }
                        @foreach (var dia in new[] { 28, 29, 30 })
                        {
                            <span class="es-otro-mes">@dia</span>
                        }
                        @for (var dia = 1; dia <= 31; dia++)
                        {
                            <span class="@(dia == 15 ? "es-hoy" : dia == 27 ? "es-seleccionado" : "")">@dia</span>
                        }
                        @foreach (var dia in new[] { 1 })
                        {
                            <span class="es-otro-mes">@dia</span>
                        }
                    </div>
                    <div class="calendario__acciones"><button class="boton boton--claro">Cancelar</button><button class="boton">Aceptar</button></div>
                </div>
            </div>
            <div>
                <h3 class="kit-subtitulo">Selector de hora</h3>
                <div class="calendario">
                    <div class="selector-hora">
                        <span class="calendario__cabecera">00:00<icono nombre="chevron-down" /></span>
                        <span>–</span>
                        <span class="calendario__cabecera">00:00<icono nombre="chevron-down" /></span>
                        <span class="etiqueta etiqueta--principal" style="background: var(--color-principal); color: #fff">AM</span>
                    </div>
                    <div class="calendario__acciones"><button class="boton boton--claro">Cancelar</button><button class="boton">Aceptar</button></div>
                </div>
                <h3 class="kit-subtitulo" style="margin-top: 32px">Tooltip</h3>
                <div class="pila kit-tooltips" style="--pila-espacio: 72px">
                    <span class="tooltip esta-visible"><span class="tooltip__disparador"><icono nombre="error" /></span><span class="tooltip__contenido">Este es un mensaje de ayuda.</span></span>
                    <span class="tooltip tooltip--error esta-visible"><span class="tooltip__disparador texto-error"><icono nombre="warning" /></span><span class="tooltip__contenido">Este es un mensaje de ayuda.</span></span>
                </div>
            </div>
        </div>
    </section>

    @* Tarjetas de la landing Alta *@
    <section class="kit-seccion" id="tarjetas">
        <h2 class="kit-seccion__titulo">Tarjetas <span>de la landing Alta</span></h2>
        <div class="kit-tarjetas">
            <div class="coincidencias">
                <div class="coincidencias__encabezado">
                    <h3 class="coincidencias__titulo"><icono nombre="notification" tamano="22" />Tus mejores coincidencias hoy</h3>
                    <span class="etiqueta etiqueta--acento">3 nuevas</span>
                </div>
                @foreach (var oferta in ofertas)
                {
                    <partial name="_OfertaCoincidencia" model="oferta" />
                }
            </div>
            <div class="pila" style="--pila-espacio: 16px">
                <div class="fila fila--envolver">
                    <span class="etiqueta">Cómo funciona</span>
                    <span class="etiqueta etiqueta--acento">Por qué Workly</span>
                    <span class="etiqueta etiqueta--exito">Oferta recibida</span>
                    <span class="etiqueta etiqueta--error">No seleccionado</span>
                    <span class="etiqueta etiqueta--info">CV visto por RR.HH.</span>
                    <span class="etiqueta etiqueta--advertencia">En revisión técnica</span>
                </div>
                <div class="fila fila--envolver">
                    <span class="chip">Data Analyst</span>
                    <span class="tag">React</span>
                    <span class="tag tag--borde">Híbrido</span>
                    <span class="tag tag--ok"><icono nombre="check" />CSS / BEM</span>
                    <span class="tag tag--falta"><icono nombre="warning-outline" />Te falta: Testing</span>
                    <span class="match"><icono nombre="circle-check" />94% match</span>
                </div>
                <div class="dato">
                    <span class="caja-icono"><icono nombre="home-alt-outline" /></span>
                    <p><strong class="dato__valor">12.400+</strong><span class="dato__texto">ofertas activas</span></p>
                </div>
            </div>
        </div>
    </section>
</div>

<dialog class="modal" id="kit-modal" aria-labelledby="kit-modal-titulo">
    <form class="modal__contenido" method="dialog">
        <div class="modal__cabecera">
            <h2 class="modal__titulo" id="kit-modal-titulo">Título</h2>
            <button class="modal__cerrar" value="cancelar" aria-label="Cerrar"><icono nombre="close-big" /></button>
        </div>
        <p class="modal__descripcion">Descripción</p>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="kit-modal-campo">Etiqueta</label>
            <select class="campo__control" id="kit-modal-campo"><option>Escribí acá</option></select>
        </div>
        <div class="modal__acciones">
            <button class="boton boton--gris" value="cancelar">Cancelar</button>
            <button class="boton" value="confirmar">Botón</button>
        </div>
    </form>
</dialog>
