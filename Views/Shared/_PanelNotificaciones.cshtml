@model List<Notificacion>
@* Panel de notificaciones (Figma › Guidelines › 07. Notificaciones) *@
<div class="panel-notificaciones__cabecera">
    <h2 class="panel-notificaciones__titulo">Notificaciones</h2>
    <button class="modal__cerrar" type="button" data-desplegable-cerrar>
        <icono nombre="close-big" etiqueta="Cerrar notificaciones" />
    </button>
</div>

<div data-pestanas>
    <div class="panel-notificaciones__filtros">
        <div class="segmentado" role="tablist" aria-label="Filtrar notificaciones">
            <button class="segmentado__boton esta-activa" type="button" role="tab" aria-selected="true" data-pestana="notif-todas">Todas</button>
            <button class="segmentado__boton" type="button" role="tab" aria-selected="false" data-pestana="notif-leidas">Leídas</button>
        </div>
    </div>

    <div class="panel-notificaciones__lista" role="tabpanel" data-panel="notif-todas">
        @foreach (var notificacion in Model)
        {
            <a class="notificacion @(notificacion.Leida ? "" : "es-no-leida")" href="@notificacion.Enlace" data-notificacion>
                <span class="notificacion__titulo">@notificacion.Titulo</span>
                <span class="notificacion__texto">@notificacion.Texto</span>
                <span class="notificacion__fecha">@notificacion.Fecha</span>
            </a>
        }
    </div>

    <div class="panel-notificaciones__lista" role="tabpanel" data-panel="notif-leidas" hidden>
        @foreach (var notificacion in Model.Where(n => n.Leida))
        {
            <a class="notificacion" href="@notificacion.Enlace">
                <span class="notificacion__titulo">@notificacion.Titulo</span>
                <span class="notificacion__texto">@notificacion.Texto</span>
                <span class="notificacion__fecha">@notificacion.Fecha</span>
            </a>
        }
    </div>
</div>

<div class="panel-notificaciones__pie">
    <a class="boton boton--texto" asp-controller="Notificaciones" asp-action="Index">Ver todas</a>
    <button class="boton boton--texto" type="button" data-marcar-leidas>Marcar todas como leídas</button>
</div>
