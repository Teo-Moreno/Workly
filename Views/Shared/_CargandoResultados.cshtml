<div class="carga" role="status" data-cargando-resultados data-texto="@Model">
    <span class="spinner-border carga-spinner" aria-hidden="true"></span>
    <p class="carga-titulo" data-cargando-titulo></p>
    <p class="carga-texto">Puede tardar unos segundos.</p>
</div>
<template data-cargando-error>
    <div class="recuadro-punteado" role="alert">
        <span class="caja-icono-lg"><icono nombre="warning-outline" /></span>
        <h3 class="recuadro-punteado-titulo">No pudimos cargar los resultados</h3>
        <p>Revisá tu conexión y probá de nuevo.</p>
        <button class="btn btn-outline-primary" type="button" data-recargar-resultados><icono nombre="refresh" />Probar de nuevo</button>
    </div>
</template>
