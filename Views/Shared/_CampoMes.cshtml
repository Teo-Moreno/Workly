<div class="form-field @(Model.Error != null ? "campo-error" : Html.ClaseError((string)Model.Nombre))">
    <label class="form-label" for="@Model.Id">@Model.Etiqueta</label>
    <input class="form-control" id="@Model.Id" name="@Model.Nombre" value="@Model.Valor" type="text" placeholder="MM/AAAA" autocomplete="off" required="@Model.Requerido">
    <p class="error-texto">@(Model.Error ?? Html.MensajeError((string)Model.Nombre, "Escribí el mes y el año (MM/AAAA)"))</p>
</div>
