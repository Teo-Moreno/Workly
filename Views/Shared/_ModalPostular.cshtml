@* Pop up de confirmación (Figma › Guidelines › 07. Notificaciones › Pop up) *@
<dialog class="modal" id="modal-postular" aria-labelledby="modal-postular-titulo">
    <form class="modal__contenido" method="dialog">
        <div class="modal__cabecera">
            <h2 class="modal__titulo" id="modal-postular-titulo">¿Confirmás tu postulación?</h2>
            <button class="modal__cerrar" value="cancelar" aria-label="Cerrar">
                <icono nombre="close-big" />
            </button>
        </div>
        <p class="modal__descripcion">
            Vas a postularte a <strong data-modal-puesto>este puesto</strong> en <strong data-modal-empresa>la empresa</strong>.
            Le vamos a compartir tu perfil y tu CV actualizado, y vas a poder seguir el proceso desde
            <a class="enlace" asp-controller="Postulaciones" asp-action="Index">Mis postulaciones</a>.
        </p>
        <label class="casilla casilla--sm">
            <input type="checkbox" checked />
            <span class="casilla__caja"><icono nombre="check" /></span>
            Avisarme por mail cuando la empresa vea mi postulación
        </label>
        <div class="modal__acciones">
            <button class="boton boton--gris" value="cancelar">Cancelar</button>
            <button class="boton" value="confirmar">Confirmar</button>
        </div>
    </form>
</dialog>
