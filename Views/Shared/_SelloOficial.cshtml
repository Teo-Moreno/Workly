@if (Model.EsOficial)
{
    <span class="badge etiqueta etiqueta-exito" title="@(Model.EsExterna ? "Publicada por la empresa en otro sitio" : "Publicada por una empresa registrada con su CUIT")">✓ Oficial</span>
}
else
{
    <span class="badge etiqueta" title="Publicada por una persona y revisada por Workly">No oficial</span>
}
