@model Preferencia
<table class="table datos">
    <tbody>
        @if (!string.IsNullOrWhiteSpace(Model.Puesto_Buscado)) { <tr><th scope="row">Puesto</th><td>@Model.Puesto_Buscado</td></tr> }
        @if (Model.ListaNiveles.Count > 0) { <tr><th scope="row">Nivel</th><td>@string.Join(", ", Model.ListaNiveles)</td></tr> }
        @if (Model.ListaModalidades.Count > 0) { <tr><th scope="row">Modalidad</th><td>@string.Join(", ", Model.ListaModalidades)</td></tr> }
        @if (Model.Jornada != null) { <tr><th scope="row">Jornada</th><td>@Model.Jornada</td></tr> }
        @if (Model.Contratacion != null) { <tr><th scope="row">Contratación</th><td>@Model.Contratacion</td></tr> }
        <tr><th scope="row">Dónde</th><td>@(Model.Provincia ?? "Todo el país")</td></tr>
        @if (Model.Salario_Minimo != null || Model.Salario_Maximo != null) { <tr><th scope="row">Salario bruto</th><td>@Model.SalarioTexto</td></tr> }
        @if (Model.Disponibilidad != null) { <tr><th scope="row">Disponibilidad</th><td>@Model.Disponibilidad</td></tr> }
    </tbody>
</table>
