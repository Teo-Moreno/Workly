<article class="tarjeta-chica" draggable="true" data-postulacion="@Model.ID" aria-label="@Model.Titulo en @Model.Empresa">
    <div class="tarjeta-chica-fila">
        <partial name="_LogoEmpresa" model='new LogoEmpresa(Model.Logo, Model.Empresa, "cuadro-sm")' />
        <div class="flexible">
            <h3 class="tarjeta-chica-titulo"><a href="@Model.Enlace">@Model.Titulo</a></h3>
            <p class="texto-mini">@Model.Empresa@(string.IsNullOrEmpty(Model.Ubicacion) ? "" : " · " + Model.Ubicacion)</p>
        </div>
        <span class="agarre" aria-hidden="true"><icono nombre="drag" tamano="18" /></span>
    </div>

    <span class="badge chapita">@Model.Fuente</span>

    <form class="ancho-completo" asp-controller="Postulaciones" asp-action="CambiarEstado" asp-route-id="@Model.ID" method="post" data-enviar-al-cambiar>
        <label class="visually-hidden" for="estado-@Model.ID">Etapa de @Model.Titulo</label>
        <select class="form-select form-select-sm" id="estado-@Model.ID" name="estado" data-estado-postulacion>
            @foreach (var etapa in Catalogos.EstadosPostulacion)
            {
                <option selected="@(etapa.Estado == Model.Estado)">@etapa.Estado</option>
            }
        </select>
        <noscript><button class="btn btn-sm" type="submit">Mover</button></noscript>
    </form>

    <div class="tarjeta-chica-fila-entre">
        <span>@Model.FechaTexto</span>
        <form asp-controller="Postulaciones" asp-action="Eliminar" asp-route-id="@Model.ID" method="post"
              data-confirmar="@(Model.EsExterna ? "¿La sacamos de tu tablero?" : "¿La sacamos de tu tablero? Quien publicó la búsqueda deja de verte entre sus postulantes.")">
            <button class="btn btn-link-sm" type="submit">Quitar</button>
        </form>
    </div>
</article>
