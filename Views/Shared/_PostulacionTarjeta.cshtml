@model PostulacionItem
@{
    var enlace = Model.EsExterna
        ? Url.Action("Externa", "Empleos", new { id = Model.IDOfertaExterna })
        : Url.Action("Detalle", "Empleos", new { id = Model.IDOfertaLaboral });
}
<article class="postulacion" draggable="true" data-postulacion="@Model.ID" aria-label="@Model.Titulo en @Model.Empresa">
    <div class="postulacion__cabecera">
        <partial name="_LogoEmpresa" model='((string?)null, Model.Empresa, "logo-empresa--sm")' />
        <div class="postulacion__datos">
            <h3 class="postulacion__puesto"><a href="@enlace">@Model.Titulo</a></h3>
            <p class="postulacion__empresa">@Model.Empresa@(string.IsNullOrEmpty(Model.Ubicacion) ? "" : " · " + Model.Ubicacion)</p>
        </div>
        <span class="postulacion__arrastre" aria-hidden="true"><icono nombre="drag" tamano="18" /></span>
    </div>

    <span class="tag">@(Model.EsExterna ? "Vía " + (string.IsNullOrWhiteSpace(Model.Publicador) ? "otro sitio" : Model.Publicador) : "En Workly")</span>

    <form class="postulacion__estado" asp-controller="Postulaciones" asp-action="CambiarEstado" asp-route-id="@Model.ID" method="post" data-enviar-al-cambiar>
        <label class="solo-lectores" for="estado-@Model.ID">Etapa de @Model.Titulo</label>
        <select class="campo__control campo__control--sm" id="estado-@Model.ID" name="estado" data-estado-postulacion>
            @foreach (var (estado, _, _) in Catalogos.EstadosPostulacion)
            {
                <option selected="@(estado == Model.Estado)">@estado</option>
            }
        </select>
        <noscript><button class="boton boton--sm" type="submit">Mover</button></noscript>
    </form>

    <div class="postulacion__pie">
        <span>@Model.FechaTexto</span>
        <form asp-controller="Postulaciones" asp-action="Eliminar" asp-route-id="@Model.ID" method="post"
              data-confirmar="@(Model.EsExterna ? "¿La sacamos de tu tablero?" : "¿La sacamos de tu tablero? Quien publicó la búsqueda deja de verte entre sus postulantes.")">
            <button class="boton boton--texto boton--sm" type="submit">Quitar</button>
        </form>
    </div>
</article>
