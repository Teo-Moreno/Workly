<li class="list-group-item postulacion">
    <h3 class="tarjeta-titulo"><a href="@Model.Enlace">@Model.Titulo</a></h3>
    <p class="texto-suave">@Model.Empresa@(string.IsNullOrEmpty(Model.Ubicacion) ? "" : " · " + Model.Ubicacion)</p>
    <span class="badge etiqueta">@Model.Fuente</span>

    <form class="postulacion-estado" asp-controller="Postulaciones" asp-action="CambiarEstado" asp-route-id="@Model.ID" method="post">
        <label class="visually-hidden" for="estado-@Model.ID">Etapa de @Model.Titulo</label>
        <select class="form-control" id="estado-@Model.ID" name="estado">
            <partial name="_Opciones" model="new OpcionesSelect((string)Model.Estado, Catalogos.EstadosPostulacion.Select(e => e.Estado))" />
        </select>
        <button class="btn-outline theme-primary boton btn-sm" type="submit">Mover</button>
    </form>

    <div class="tarjeta-pie">
        <span class="texto-suave">@Model.FechaTexto</span>
        <form asp-controller="Postulaciones" asp-action="Eliminar" asp-route-id="@Model.ID" method="post">
            <button class="boton-link" type="submit">Quitar</button>
        </form>
    </div>
</li>
