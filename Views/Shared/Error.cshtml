@{
    ViewData["Title"] = "Algo salió mal";
}

<section class="container centro-alto">
    <span class="caja-icono-acento"><icono nombre="warning-outline" /></span>
    <h1>Algo salió mal</h1>
    <p class="lead">No pudimos procesar tu pedido. Probá de nuevo en unos minutos o volvé al inicio.</p>

    @if (!string.IsNullOrEmpty(ViewBag.CodigoSolicitud))
    {
        <p class="small text-body-secondary">Código de la solicitud: <code>@ViewBag.CodigoSolicitud</code></p>
    }

    <div class="fila-envolver">
        <a class="btn btn-primary" href="/">Volver al inicio</a>
        <a class="btn btn-outline-primary" href="/Perfil/Ayuda">Ir a la ayuda</a>
    </div>
</section>
