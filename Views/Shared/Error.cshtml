@{
    ViewData["Title"] = "Algo salió mal";
}

<section class="container error-pagina">
    <span class="caja-icono-acento error-pagina-icono"><icono nombre="warning-outline" /></span>
    <h1 class="h1">Algo salió mal</h1>
    <p class="lead">No pudimos procesar tu pedido. Probá de nuevo en unos minutos o volvé al inicio.</p>

    @if (!string.IsNullOrEmpty(ViewBag.CodigoSolicitud))
    {
        <p class="small text-body-secondary">Código de la solicitud: <code>@ViewBag.CodigoSolicitud</code></p>
    }

    <div class="fila fila-envolver">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        <a class="btn btn-outline-primary" asp-controller="Perfil" asp-action="Ayuda">Ir a la ayuda</a>
    </div>
</section>
