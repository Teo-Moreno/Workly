@if (!User.EstaLogueado())
{
    <a class="@ViewBag.Menu.Clase("Empleos")" href="/Empleos">Buscar trabajo</a>
    <a class="@ViewBag.Menu.Clase("Asistente")" href="/Asistente">Asistente</a>
    <a class="@ViewBag.Menu.Clase("Empresas")" href="/Empresas">Empresas</a>
}
else if (User.EsEmpresa())
{
    <a class="@ViewBag.Menu.Clase("Publicaciones", "Index")" href="/Publicaciones">Mis búsquedas</a>
    <a class="@ViewBag.Menu.Clase("Publicaciones", "Nueva")" href="/Publicaciones/Nueva">Publicar búsqueda</a>
    <a class="@ViewBag.Menu.Clase("Empresas")" href="/Empresas">Empresas</a>
    <a class="@ViewBag.Menu.Clase("Perfil")" href="/Perfil">Perfil de la empresa</a>
}
else
{
    <a class="@ViewBag.Menu.Clase("Panel")" href="/Panel">Inicio</a>
    <a class="@ViewBag.Menu.Clase("Empleos")" href="/Empleos">Buscar trabajo</a>
    <a class="@ViewBag.Menu.Clase("Asistente")" href="/Asistente">Asistente</a>
    <a class="@ViewBag.Menu.Clase("Postulaciones")" href="/Postulaciones">Postulaciones</a>
    <a class="@ViewBag.Menu.Clase("Guardadas")" href="/Guardadas">Guardadas</a>
    <a class="@ViewBag.Menu.Clase("Empresas")" href="/Empresas">Empresas</a>
    <a class="@ViewBag.Menu.Clase("Perfil")" href="/Perfil">Perfil</a>
    @if (ViewBag.TienePublicaciones)
    {
        <a class="@ViewBag.Menu.Clase("Publicaciones")" href="/Publicaciones">Mis publicaciones</a>
    }
}
@if (User.EsModerador())
{
    <a class="@ViewBag.Menu.Clase("Moderacion")" href="/Moderacion">
        <span>Moderación</span>
        @if (ViewBag.OfertasPendientes > 0)
        {
            <span class="badge navbar-contador" aria-label="@ViewBag.OfertasPendientes por revisar">@ViewBag.OfertasPendientes</span>
        }
    </a>
}
