@model Oferta
@{
    var visible = ViewData["Visible"] is true;
}
@* Vista previa de la oferta (Figma › Media · WF 02 › Detalle de oferta) *@
<article class="detalle-panel" data-detalle-oferta="@Model.Id" hidden="@(!visible)" aria-labelledby="detalle-titulo-@Model.Id">
    <div class="detalle-panel__barra">
        <span class="logo-empresa logo-empresa--md" aria-hidden="true">@Model.Iniciales</span>
        <div class="fila">
            <button class="boton boton--contorno boton--sm" type="button" data-compartir>
                <icono nombre="share" />Compartir
            </button>
            <button class="boton boton--contorno boton--sm @(Model.Guardada ? "esta-activo" : "")" type="button" aria-pressed="@(Model.Guardada ? "true" : "false")" data-guardar>
                <icono nombre="@(Model.Guardada ? "bookmark-fill" : "bookmark")" /><span data-guardar-texto>@(Model.Guardada ? "Guardada" : "Guardar")</span>
            </button>
        </div>
    </div>

    <header class="detalle-panel__encabezado">
        <h2 class="detalle-panel__titulo" id="detalle-titulo-@Model.Id">@Model.Puesto</h2>
        <p class="detalle-panel__meta">@Model.Empresa · @Model.Ubicacion · @Model.PublicadoTexto</p>
        <div class="lista-tags">
            <span class="tag tag--borde tag--lg">@Model.ModalidadDetalle</span>
            <span class="tag tag--borde tag--lg">@Model.Nivel</span>
            <span class="tag tag--borde tag--lg">@Model.Contratacion</span>
            <span class="tag tag--borde tag--lg">@Model.Jornada</span>
        </div>
    </header>

    <div class="cajas-dato">
        <div class="caja-dato">
            <span class="caja-dato__etiqueta">Rango salarial</span>
            <strong class="caja-dato__valor">@Model.Salario</strong>
            <span class="caja-dato__detalle">bruto mensual</span>
        </div>
        <div class="caja-dato">
            <span class="caja-dato__etiqueta">Experiencia</span>
            <strong class="caja-dato__valor">@Model.Experiencia</strong>
            <span class="caja-dato__detalle">@Model.ExperienciaDetalle</span>
        </div>
    </div>

    <partial name="_Compatibilidad" model="Model" />

    <section class="detalle-panel__seccion">
        <h3 class="detalle-panel__subtitulo">Sobre el puesto</h3>
        <p>@Model.SobrePuesto</p>
    </section>

    <section class="detalle-panel__seccion">
        <h3 class="detalle-panel__subtitulo">Requisitos</h3>
        <ul class="lista-puntos" role="list">
            @foreach (var requisito in Model.Requisitos)
            {
                <li>@requisito</li>
            }
        </ul>
    </section>

    <section class="detalle-panel__seccion">
        <h3 class="detalle-panel__subtitulo">Habilidades</h3>
        <partial name="_HabilidadesOferta" model="Model" />
    </section>

    <div class="detalle-panel__acciones">
        <button class="boton boton--lg" type="button" data-postular data-puesto="@Model.Puesto" data-empresa="@Model.Empresa">Postularme ahora</button>
        <a class="boton boton--contorno boton--lg" asp-controller="Empleos" asp-action="Detalle" asp-route-id="@Model.Id">Ver oferta completa</a>
    </div>
</article>
