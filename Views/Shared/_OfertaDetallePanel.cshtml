@model Oferta
@{
    var visible = ViewData["Visible"] is true;
    var urlDetalle = Model.EsExterna ? Url.Action("Externa", "Empleos", new { id = Model.ID }) : Url.Action("Detalle", "Empleos", new { id = Model.ID });
}
@* Vista previa de la oferta (Figma › Media · WF 02 › Detalle de oferta) *@
<article class="detalle-panel" data-detalle-oferta="@Model.Clave" hidden="@(!visible)" aria-labelledby="detalle-titulo-@Model.Clave">
    <div class="detalle-panel__barra">
        <partial name="_LogoEmpresa" model='(Model.Logo, Model.Empresa, "logo-empresa--md")' />
        <span class="tag @(Model.EsExterna ? "" : "tag--principal")">@(Model.EsExterna ? "Publicada en " + Model.Fuente : "Publicada en Workly")</span>
    </div>

    <header class="detalle-panel__encabezado">
        <h2 class="detalle-panel__titulo" id="detalle-titulo-@Model.Clave">@Model.Titulo</h2>
        <p class="detalle-panel__meta">@string.Join(" · ", new[] { Model.Empresa, Model.UbicacionVisible, Model.PublicadaTexto }.Where(t => !string.IsNullOrEmpty(t)))</p>
        <div class="lista-tags">
            @if (!string.IsNullOrEmpty(Model.Modalidad)) { <span class="tag tag--borde tag--lg">@Model.Modalidad</span> }
            @if (!string.IsNullOrEmpty(Model.Tipo_Contrato)) { <span class="tag tag--borde tag--lg">@Model.Tipo_Contrato</span> }
            @if (!Model.EsExterna && Model.Cantidad_Puestos > 1) { <span class="tag tag--borde tag--lg">@Model.Cantidad_Puestos vacantes</span> }
        </div>
    </header>

    @if (Model.SalarioVisible != null)
    {
        <div class="cajas-dato">
            <div class="caja-dato">
                <span class="caja-dato__etiqueta">Salario</span>
                <strong class="caja-dato__valor">@Model.SalarioVisible</strong>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
    {
        <section class="detalle-panel__seccion">
            <h3 class="detalle-panel__subtitulo">Sobre el puesto</h3>
            <p class="texto-con-saltos">@Textos.Recortar(Model.Descripcion, 700)</p>
        </section>
    }

    <div class="detalle-panel__acciones">
        <partial name="_AccionesOferta" model="Model" />
        <a class="boton boton--contorno boton--lg" href="@urlDetalle">Ver oferta completa</a>
    </div>
</article>
