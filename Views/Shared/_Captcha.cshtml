@* El token de la imagen viaja en la dirección del formulario (asp-route-CaptchaToken). *@
<div class="form-field @Html.ClaseError(Captcha.CampoRespuesta)">
    <label class="form-label" for="captcha-respuesta">Escribí las letras de la imagen</label>
    <img class="captcha-imagen" src="@Model.Imagen" alt="Letras para comprobar que sos una persona">
    <input class="form-control" id="captcha-respuesta" name="@Captcha.CampoRespuesta" type="text" autocomplete="off" required placeholder="Ej.: K7P3Q">
    <p class="form-text">No distingue mayúsculas de minúsculas. ¿No se entiende? Recargá la página para ver otra.</p>
    <p class="error-texto">@Html.MensajeError(Captcha.CampoRespuesta, "Escribí las letras de la imagen")</p>
</div>
