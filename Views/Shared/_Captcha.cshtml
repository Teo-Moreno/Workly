<div class="campo captcha @Html.ClaseError(Captcha.CampoRespuesta)" data-captcha data-captcha-url="@Url.Action("NuevoCaptcha", "Cuenta")">
    <label class="campo-etiqueta" for="captcha-respuesta">Escribí las letras de la imagen</label>
    <div class="captcha-fila">
        <img class="captcha-imagen" src="@Model.Imagen" width="200" height="64" alt="Letras para comprobar que sos una persona" data-captcha-imagen />
        <button class="boton boton-contorno boton-sm" type="button" data-captcha-otra><icono nombre="refresh" />Otra imagen</button>
    </div>
    <input type="hidden" name="@Captcha.CampoToken" value="@Model.Token" data-captcha-token />
    <input class="campo-control captcha-entrada" id="captcha-respuesta" name="@Captcha.CampoRespuesta" autocomplete="off" autocapitalize="characters"
           spellcheck="false" maxlength="10" required placeholder="Ej.: K7P3Q" />
    <span class="campo-ayuda">No distingue mayúsculas de minúsculas.</span>
    <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError(Captcha.CampoRespuesta, "Escribí las letras de la imagen")</span>
</div>
