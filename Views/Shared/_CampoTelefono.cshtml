<div class="campo @ViewBag.Errores.Clase(Model.Nombre)">
    <label class="form-label" for="@Model.Id">Teléfono <span class="campo-opcional">(opcional)</span></label>
    <div class="control-con-prefijo">
        <span class="control-prefijo" data-prefijo-telefono>@Model.Prefijo</span>
        <input class="form-control" id="@Model.Id" name="@Model.Nombre" value="@Model.Valor" type="tel" inputmode="numeric" autocomplete="tel-national"
               placeholder="11 5555-1234" maxlength="12" pattern="[0-9]{2,4} [0-9]{2,4}-[0-9]{4}"
               data-telefono data-codigos-area="@string.Join(",", Telefonos.CodigosDeArea3)" />
    </div>
    <span class="form-text">Código de área y número, sin el 0 ni el 15. Los espacios y el guion se ponen solos.</span>
    <span class="invalid-feedback"><icono nombre="warning" />@ViewBag.Errores.Mensaje(Model.Nombre, "Ingresá el código de área y el número: 10 números")</span>
</div>
