<div class="form-field @Html.ClaseError((string)Model.Nombre)">
    <label class="form-label" for="@Model.Id">Teléfono <span class="opcional">(opcional, @Model.Prefijo)</span></label>
    <input class="form-control" id="@Model.Id" name="@Model.Nombre" value="@Model.Valor" type="text" autocomplete="tel-national" placeholder="11 5555-1234">
    <p class="form-text">Código de área y número, sin el 0 ni el 15.</p>
    <p class="error-texto">@Html.MensajeError((string)Model.Nombre, "Ingresá el código de área y el número: 10 números")</p>
</div>
