@if (ViewBag.Proveedores != null && ViewBag.Proveedores.Count > 0)
{
    <div class="pila-chica">
        @if (ViewBag.Proveedores.Contains("Google"))
        {
            <a class="btn btn-ancho" href="@Model.UrlGoogle" data-logo="google">
                @Model.Texto con Google
            </a>
        }
        @if (ViewBag.Proveedores.Contains("LinkedIn"))
        {
            <a class="btn btn-ancho" href="@Model.UrlLinkedIn" data-logo="linkedin">
                @Model.Texto con LinkedIn
            </a>
        }
    </div>
    <div class="separador"><span>o con tu email</span></div>
}
else if (ViewBag.EsDesarrollo)
{
    <div class="recuadro-punteado-gris" data-icono="warning-outline">
        <div class="recuadro-punteado-gris-textos">
            <p>Para mostrar "@Model.Texto con Google" y "con LinkedIn" faltan sus claves en esta compu. Desde la carpeta del proyecto, ejecutá:</p>
            <pre class="recuadro-punteado-gris-codigo">dotnet user-secrets set "Authentication:Google:ClientId" "..."
dotnet user-secrets set "Authentication:Google:ClientSecret" "..."</pre>
            <p>Para LinkedIn, lo mismo con <code>Authentication:LinkedIn</code>. Este aviso solo se ve mientras se desarrolla.</p>
        </div>
    </div>
}
