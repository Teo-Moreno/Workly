@model (string Texto, string? Tipo, string? ReturnUrl)
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Entorno
@{
    var proveedores = ViewBag.Proveedores as List<string> ?? new();
}
@if (proveedores.Count > 0)
{
    <div class="botones-externos">
        @if (proveedores.Contains("Google"))
        {
            <a class="boton boton--contorno boton--bloque boton-externo" asp-controller="Cuenta" asp-action="Externo"
               asp-route-proveedor="Google" asp-route-tipo="@Model.Tipo" asp-route-returnUrl="@Model.ReturnUrl">
                <svg class="boton-externo__logo" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.9 6.2C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.6c0-1.6-.1-3.1-.4-4.6H24v9h12.4c-.5 2.9-2.2 5.3-4.6 7l7.4 5.7c4.3-4 6.9-9.9 6.9-17.1z"/><path fill="#FBBC05" d="M10.5 28.5c-.5-1.4-.8-2.9-.8-4.5s.3-3.1.8-4.5l-7.9-6.2C.9 16.6 0 20.2 0 24s.9 7.4 2.6 10.7l7.9-6.2z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.4-5.7c-2.1 1.4-4.8 2.3-8.5 2.3-6.3 0-11.6-4.2-13.5-9.9l-7.9 6.2C6.6 42.6 14.6 48 24 48z"/></svg>
                @Model.Texto con Google
            </a>
        }
        @if (proveedores.Contains("LinkedIn"))
        {
            <a class="boton boton--contorno boton--bloque boton-externo" asp-controller="Cuenta" asp-action="Externo"
               asp-route-proveedor="LinkedIn" asp-route-tipo="@Model.Tipo" asp-route-returnUrl="@Model.ReturnUrl">
                <svg class="boton-externo__logo" viewBox="0 0 24 24" aria-hidden="true"><path fill="#0A66C2" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"/></svg>
                @Model.Texto con LinkedIn
            </a>
        }
    </div>
    <div class="separador"><span>o con tu email</span></div>
}
else if (Entorno.IsDevelopment())
{
    <p class="aviso-desarrollo"><icono nombre="warning-outline" tamano="18" />Para mostrar "@Model.Texto con Google / LinkedIn" cargá sus claves desde la carpeta del proyecto con <code>dotnet user-secrets set "Authentication:Google:ClientId" "..."</code> y <code>"Authentication:Google:ClientSecret"</code> (lo mismo con LinkedIn). Este aviso solo se ve mientras se desarrolla.</p>
}
