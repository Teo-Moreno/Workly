@if (!Model.EsExterna)
{
    if (User.EsPropia((int?)Model.IDUsuario_Publicador))
    {
        <a class="btn btn-lg" asp-controller="Publicaciones" asp-action="Detalle" asp-route-id="@Model.ID">Ver postulantes</a>
    }
    else if (Model.YaPostulado)
    {
        <a class="btn btn-outline-lg" asp-controller="Postulaciones" asp-action="Index"><icono nombre="circle-check" />Ya te postulaste</a>
    }
    else if (Model.EstaCerrada)
    {
        <span class="badge badge-error">Esta búsqueda ya cerró</span>
    }
    else if (!User.EstaLogueado())
    {
        <a class="btn btn-lg" href="@Url.Action("IniciarSesion", "Cuenta", new { returnUrl = ViewContext.Volver() })">Iniciá sesión para postularte</a>
    }
    else if (User.EsPersona())
    {
        <form asp-controller="Empleos" asp-action="Postular" asp-route-id="@Model.ID" method="post">
            <input type="hidden" name="volver" value="@ViewContext.Volver()" />
            <button class="btn btn-lg" type="submit">Postularme</button>
        </form>
    }
}
else
{
    if (!string.IsNullOrEmpty(Model.Link_Postulacion))
    {
        <a class="btn btn-lg" href="@Model.Link_Postulacion" target="_blank" rel="noopener noreferrer">Postularme en @Model.Fuente<icono nombre="external-link" /></a>
    }
    if (Model.YaPostulado)
    {
        <a class="btn btn-outline-lg" asp-controller="Postulaciones" asp-action="Index"><icono nombre="circle-check" />Está en tu tablero</a>
    }
    else if (User.EsPersona())
    {
        <form asp-controller="Empleos" asp-action="RegistrarExterna" asp-route-id="@Model.ID" method="post">
            <input type="hidden" name="volver" value="@ViewContext.Volver()" />
            <button class="btn btn-outline-lg" type="submit" title="Sumala a tu tablero para hacerle el seguimiento">Ya me postulé</button>
        </form>
    }
}
