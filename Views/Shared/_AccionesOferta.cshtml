@if (!Model.EsExterna)
{
    if (User.EsPropia((int?)Model.IDUsuario_Publicador))
    {
        <a class="btn-solid theme-primary boton" asp-controller="Publicaciones" asp-action="Detalle" asp-route-id="@Model.ID">Ver postulantes</a>
    }
    else if (Model.YaPostulado)
    {
        <a class="btn-outline theme-primary boton" asp-controller="Postulaciones" asp-action="Index">✓ Ya te postulaste</a>
    }
    else if (Model.EstaCerrada)
    {
        <span class="badge etiqueta etiqueta-error">Esta búsqueda ya cerró</span>
    }
    else if (!User.EstaLogueado())
    {
        <a class="btn-solid theme-primary boton" asp-controller="Cuenta" asp-action="IniciarSesion" asp-route-returnUrl="@ViewContext.Volver()">Iniciá sesión para postularte</a>
    }
    else if (User.EsPersona())
    {
        <form asp-controller="Empleos" asp-action="Postular" asp-route-id="@Model.ID" asp-route-volver="@ViewContext.Volver()" method="post">
            <button class="btn-solid theme-primary boton" type="submit">Postularme</button>
        </form>
    }
}
else
{
    if (!string.IsNullOrEmpty(Model.Link_Postulacion))
    {
        <a class="btn-solid theme-primary boton" href="@Model.Link_Postulacion" target="_blank" rel="noopener noreferrer">Postularme en @Model.Fuente ↗</a>
    }
    if (Model.YaPostulado)
    {
        <a class="btn-outline theme-primary boton" asp-controller="Postulaciones" asp-action="Index">✓ Está en tu tablero</a>
    }
    else if (User.EsPersona())
    {
        <form asp-controller="Empleos" asp-action="RegistrarExterna" asp-route-id="@Model.ID" asp-route-volver="@ViewContext.Volver()" method="post">
            <button class="btn-outline theme-primary boton" type="submit" title="Sumala a tu tablero para hacerle el seguimiento">Ya me postulé</button>
        </form>
    }
}
