@if (!Model.EsExterna)
{
    if (ViewBag.EsPropia)
    {
        <a class="btn btn-lg" href="/Publicaciones/Detalle/@Model.ID">Ver postulantes</a>
    }
    else if (Model.YaPostulado)
    {
        <a class="btn btn-outline-lg" href="/Postulaciones" data-icono="circle-check">Ya te postulaste</a>
    }
    else if (Model.EstaCerrada)
    {
        <span class="badge badge-error">Esta búsqueda ya cerró</span>
    }
    else if (!User.EstaLogueado())
    {
        <a class="btn btn-lg" href="@ViewBag.UrlIngresar">Iniciá sesión para postularte</a>
    }
    else if (User.EsPersona())
    {
        <form action="/Empleos/Postular/@Model.ID" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="volver" value="@ViewBag.Volver" />
            <button class="btn btn-lg" type="submit">Postularme</button>
        </form>
    }
}
else
{
    if (!string.IsNullOrEmpty(Model.Link_Postulacion))
    {
        <a class="btn btn-lg" href="@Model.Link_Postulacion" target="_blank" rel="noopener noreferrer" data-icono-fin="external-link">Postularme en @Model.Fuente</a>
    }
    if (Model.YaPostulado)
    {
        <a class="btn btn-outline-lg" href="/Postulaciones" data-icono="circle-check">Está en tu tablero</a>
    }
    else if (User.EsPersona())
    {
        <form action="/Empleos/RegistrarExterna/@Model.ID" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="volver" value="@ViewBag.Volver" />
            <button class="btn btn-outline-lg" type="submit" title="Sumala a tu tablero para hacerle el seguimiento">Ya me postulé</button>
        </form>
    }
}
