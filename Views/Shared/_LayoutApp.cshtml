<!DOCTYPE html>
<html lang="es-AR">
<head>
    <partial name="_Head" />
    <link rel="stylesheet" href="/css/estilo.css" />
</head>
<body>
    <a class="oculto-hasta-foco" href="#contenido">Saltar al contenido</a>

    <header class="navbar navbar-app" data-navbar>
        <div class="container navbar-interior">
            <a class="navbar-brand logo" href="@ViewBag.Inicio" aria-label="Workly, ir a tu inicio">
                <span class="logo-isotipo" aria-hidden="true">W<span class="logo-acento"></span></span>
                <span class="logo-texto">Workly</span>
            </a>

            <nav class="navbar-nav" aria-label="Principal">
                <partial name="_LinksApp" />
            </nav>

            <div class="navbar-acciones">
                @if (User.EstaLogueado())
                {
                <div class="dropdown">
                    <button class="pildora" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" aria-controls="menu-usuario">
                        <span class="circulo" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(User.Foto()))
                            {
                                <img src="@User.Foto()" alt="" />
                            }
                            else
                            {
                                @(User.EsEmpresa() ? Textos.Iniciales(User.NombreCompleto()) : User.Iniciales())
                            }
                        </span>
                        <span class="pildora-textos">
                            <span class="pildora-fuerte">@User.NombreCompleto()</span>
                            <span class="pildora-suave">@(User.Ubicacion() ?? "Mi cuenta")</span>
                        </span>
                        <icono nombre="chevron-down" />
                        <span class="visually-hidden">Abrir menú de cuenta</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end" id="menu-usuario">
                        <div class="dropdown-header">
                            <strong class="pildora-fuerte">@User.NombreCompleto()</strong>
                            <span class="pildora-suave">@User.Email()</span>
                        </div>
                        <ul role="list">
                            @if (User.EsEmpresa())
                            {
                                <li><a class="dropdown-item" href="/Perfil"><icono nombre="building" />Perfil de la empresa</a></li>
                                <li><a class="dropdown-item" href="/Publicaciones/Nueva"><icono nombre="plus" />Publicar una búsqueda</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" href="/Perfil"><icono nombre="user-square" />Mi perfil</a></li>
                                <li><a class="dropdown-item" href="/Perfil/Configuracion#busqueda"><icono nombre="slider-03" />Qué estoy buscando</a></li>
                                <li><a class="dropdown-item" href="/Publicaciones/Nueva"><icono nombre="plus" />Publicar un trabajo</a></li>
                            }
                            <li><a class="dropdown-item" href="/Perfil/Configuracion"><icono nombre="settings" />Configuración</a></li>
                            <li><a class="dropdown-item" href="/Perfil/Ayuda"><icono nombre="help-circle-outline" />Ayuda</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form action="/Cuenta/CerrarSesion" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="dropdown-item text-danger" type="submit"><icono nombre="log-out" />Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
                }
                else
                {
                    <a class="btn btn-outline-primary" href="/Cuenta/IniciarSesion">Iniciar sesión</a>
                    <a class="btn btn-primary" href="/Cuenta/CrearCuenta">Crear cuenta</a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu-movil" aria-expanded="false" aria-controls="menu-movil" data-menu-movil>
                    <icono nombre="menu" etiqueta="Abrir menú" />
                </button>
            </div>
        </div>

        <nav class="collapse navbar-movil" id="menu-movil" aria-label="Menú móvil">
            <partial name="_LinksApp" />
            @if (User.EstaLogueado())
            {
                <a class="nav-link" href="/Perfil/Configuracion">Configuración</a>
                <form class="navbar-movil-final" action="/Cuenta/CerrarSesion" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger" type="submit"><icono nombre="log-out" />Cerrar sesión</button>
                </form>
            }
            else
            {
                <div class="navbar-movil-acciones">
                    <a class="btn btn-outline-primary" href="/Cuenta/IniciarSesion">Iniciar sesión</a>
                    <a class="btn btn-primary" href="/Cuenta/CrearCuenta">Crear cuenta</a>
                </div>
            }
        </nav>
    </header>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="fondo-claro">
        <div class="container fila-separada">
            <a class="logo logo-chico" href="@ViewBag.Inicio" aria-label="Workly, ir a tu inicio">
                <span class="logo-isotipo" aria-hidden="true">W<span class="logo-acento"></span></span>
                <span class="logo-texto">Workly</span>
            </a>
            <p class="texto-tenue">© @DateTime.Today.Year Workly · Hecho en Buenos Aires, Argentina</p>
            <nav class="fila-espaciada" aria-label="Legales y ayuda">
                <a href="/Home/Terminos">Términos</a>
                <a href="/Home/Privacy">Privacidad</a>
                <a href="/Home/Cookies">Cookies</a>
                <a href="/Perfil/Ayuda">Ayuda</a>
            </nav>
        </div>
    </footer>

    <partial name="_AvisoCookies" />
    <div class="toast-container" aria-live="polite" data-snackbars data-mensaje="@TempData["Mensaje"]" data-mensaje-tipo="@TempData["MensajeTipo"]"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="/js/site.js"></script>
</body>
</html>
