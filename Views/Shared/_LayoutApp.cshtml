@{
    var logueado = User.EstaLogueado();
    var esEmpresa = User.EsEmpresa();
    var esModerador = User.EsModerador();
    var foto = User.Foto();
    var pendientes = esModerador ? BD.ContarOfertasPendientes() : 0;
    var tienePublicaciones = logueado && !esEmpresa && BD.TieneOfertasPublicadas(User.IdUsuario());
    var inicio = !logueado ? Url.Action("Index", "Home") : esEmpresa ? Url.Action("Index", "Publicaciones") : Url.Action("Index", "Panel");
}
@functions {
    private string? Actual(string controlador) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controlador, StringComparison.OrdinalIgnoreCase)
            ? "page"
            : null;

    private string Activo(string controlador) => Actual(controlador) != null ? "esta-activo" : "";

    private string? ActualAccion(string controlador, string accion) =>
        Actual(controlador) != null && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), accion, StringComparison.OrdinalIgnoreCase)
            ? "page"
            : null;
}
<!DOCTYPE html>
<html lang="es-AR">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="es-app @ViewData["ClaseBody"]">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <header class="navbar navbar--app" data-navbar>
        <div class="contenedor navbar__interior">
            <a class="logo" href="@inicio" aria-label="Workly, ir a tu inicio">
                <span class="logo__isotipo" aria-hidden="true">W<span class="logo__acento"></span></span>
                <span class="logo__texto">Workly</span>
            </a>

            <nav class="navbar__links" aria-label="Principal">
                <partial name="_LinksApp" model="(tienePublicaciones, pendientes)" />
            </nav>

            <div class="navbar__acciones">
                @if (logueado)
                {
                <div class="desplegable" data-desplegable>
                    <button class="boton-usuario" type="button" aria-expanded="false" aria-controls="menu-usuario" data-desplegable-boton>
                        <span class="avatar" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(foto))
                            {
                                <img src="@foto" alt="" />
                            }
                            else
                            {
                                @(esEmpresa ? Textos.Iniciales(User.NombreCompleto()) : User.Iniciales())
                            }
                        </span>
                        <span class="boton-usuario__datos">
                            <span class="boton-usuario__nombre">@User.NombreCompleto()</span>
                            <span class="boton-usuario__rol">@(User.Ubicacion() ?? "Mi cuenta")</span>
                        </span>
                        <icono nombre="chevron-down" />
                        <span class="solo-lectores">Abrir menú de cuenta</span>
                    </button>
                    <div class="desplegable__panel" id="menu-usuario" data-desplegable-panel>
                        <div class="menu__cabecera">
                            <strong class="boton-usuario__nombre">@User.NombreCompleto()</strong>
                            <span class="boton-usuario__rol">@User.Email()</span>
                        </div>
                        <ul class="menu" role="list">
                            @if (esEmpresa)
                            {
                                <li><a class="menu__item" asp-controller="Perfil" asp-action="Index"><icono nombre="building" />Perfil de la empresa</a></li>
                                <li><a class="menu__item" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar una búsqueda</a></li>
                            }
                            else
                            {
                                <li><a class="menu__item" asp-controller="Perfil" asp-action="Index"><icono nombre="user-square" />Mi perfil</a></li>
                                <li><a class="menu__item" asp-controller="Perfil" asp-action="Configuracion" asp-fragment="busqueda"><icono nombre="slider-03" />Qué estoy buscando</a></li>
                                <li><a class="menu__item" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar un trabajo</a></li>
                            }
                            <li><a class="menu__item" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="settings" />Configuración</a></li>
                            <li><a class="menu__item" asp-controller="Perfil" asp-action="Ayuda"><icono nombre="help-circle-outline" />Ayuda</a></li>
                            <li class="menu__separador" role="separator"></li>
                            <li>
                                <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                                    <button class="menu__item menu__item--peligro" type="submit"><icono nombre="log-out" />Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
                }
                else
                {
                    <a class="boton boton--contorno" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                    <a class="boton" asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a>
                }

                <button class="navbar__hamburguesa" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-movil>
                    <icono nombre="menu" etiqueta="Abrir menú" />
                </button>
            </div>
        </div>

        <nav class="navbar__movil" id="menu-movil" aria-label="Menú móvil">
            <partial name="_LinksApp" model="(tienePublicaciones, pendientes)" />
            @if (logueado)
            {
                <a class="navbar__link" asp-controller="Perfil" asp-action="Configuracion">Configuración</a>
                <form class="navbar__movil-salir" asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                    <button class="boton boton--contorno boton--peligro boton--bloque" type="submit"><icono nombre="log-out" />Cerrar sesión</button>
                </form>
            }
            else
            {
                <div class="navbar__movil-acciones">
                    <a class="boton boton--contorno" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                    <a class="boton" asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a>
                </div>
            }
        </nav>
    </header>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="pie pie--app">
        <div class="contenedor pie__interior">
            <a class="logo logo--chico" href="@inicio" aria-label="Workly, ir a tu inicio">
                <span class="logo__isotipo" aria-hidden="true">W<span class="logo__acento"></span></span>
                <span class="logo__texto">Workly</span>
            </a>
            <p class="pie__copy">© @DateTime.Today.Year Workly · Hecho en Buenos Aires, Argentina</p>
            <nav class="pie__links" aria-label="Legales y ayuda">
                <a asp-controller="Home" asp-action="Terminos">Términos</a>
                <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                <a asp-controller="Home" asp-action="Cookies">Cookies</a>
                <a asp-controller="Perfil" asp-action="Ayuda">Ayuda</a>
            </nav>
        </div>
    </footer>

    <partial name="_AvisoCookies" />
    <div class="snackbars" aria-live="polite" data-snackbars data-mensaje="@TempData["Mensaje"]" data-mensaje-tipo="@TempData["MensajeTipo"]"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
