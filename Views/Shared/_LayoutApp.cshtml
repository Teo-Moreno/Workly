<!DOCTYPE html>
<html lang="es-AR">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="es-app @ViewData["ClaseBody"]">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <header class="navbar navbar-app" data-navbar>
        <div class="container navbar-interior">
            <a class="navbar-brand logo" href="@Url.Inicio(User)" aria-label="Workly, ir a tu inicio">
                <span class="logo-isotipo" aria-hidden="true">W<span class="logo-acento"></span></span>
                <span class="logo-texto">Workly</span>
            </a>

            <nav class="navbar-nav" aria-label="Principal">
                <partial name="_LinksApp" />
            </nav>

            <div class="navbar-acciones">
                @if (User.EstaLogueado())
                {
                <div class="dropdown">
                    <button class="boton-usuario" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" aria-controls="menu-usuario">
                        <span class="avatar" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(User.Foto()))
                            {
                                <img src="@User.Foto()" alt="" />
                            }
                            else
                            {
                                @(User.EsEmpresa() ? Textos.Iniciales(User.NombreCompleto()) : User.Iniciales())
                            }
                        </span>
                        <span class="boton-usuario-datos">
                            <span class="boton-usuario-nombre">@User.NombreCompleto()</span>
                            <span class="boton-usuario-rol">@(User.Ubicacion() ?? "Mi cuenta")</span>
                        </span>
                        <icono nombre="chevron-down" />
                        <span class="visually-hidden">Abrir menú de cuenta</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end" id="menu-usuario">
                        <div class="dropdown-header">
                            <strong class="boton-usuario-nombre">@User.NombreCompleto()</strong>
                            <span class="boton-usuario-rol">@User.Email()</span>
                        </div>
                        <ul role="list">
                            @if (User.EsEmpresa())
                            {
                                <li><a class="dropdown-item" asp-controller="Perfil" asp-action="Index"><icono nombre="building" />Perfil de la empresa</a></li>
                                <li><a class="dropdown-item" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar una búsqueda</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="Perfil" asp-action="Index"><icono nombre="user-square" />Mi perfil</a></li>
                                <li><a class="dropdown-item" asp-controller="Perfil" asp-action="Configuracion" asp-fragment="busqueda"><icono nombre="slider-03" />Qué estoy buscando</a></li>
                                <li><a class="dropdown-item" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar un trabajo</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="settings" />Configuración</a></li>
                            <li><a class="dropdown-item" asp-controller="Perfil" asp-action="Ayuda"><icono nombre="help-circle-outline" />Ayuda</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                                    <button class="dropdown-item text-danger" type="submit"><icono nombre="log-out" />Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
                }
                else
                {
                    <a class="btn btn-outline-primary" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                    <a class="btn btn-primary" asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu-movil" aria-expanded="false" aria-controls="menu-movil" data-menu-movil>
                    <icono nombre="menu" etiqueta="Abrir menú" />
                </button>
            </div>
        </div>

        <nav class="collapse navbar-movil" id="menu-movil" aria-label="Menú móvil">
            <partial name="_LinksApp" />
            @if (User.EstaLogueado())
            {
                <a class="nav-link" asp-controller="Perfil" asp-action="Configuracion">Configuración</a>
                <form class="navbar-movil-salir" asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                    <button class="btn btn-outline-danger" type="submit"><icono nombre="log-out" />Cerrar sesión</button>
                </form>
            }
            else
            {
                <div class="navbar-movil-acciones">
                    <a class="btn btn-outline-primary" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                    <a class="btn btn-primary" asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a>
                </div>
            }
        </nav>
    </header>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="pie pie-app">
        <div class="container pie-interior">
            <a class="logo logo-chico" href="@Url.Inicio(User)" aria-label="Workly, ir a tu inicio">
                <span class="logo-isotipo" aria-hidden="true">W<span class="logo-acento"></span></span>
                <span class="logo-texto">Workly</span>
            </a>
            <p class="pie-copy">© @DateTime.Today.Year Workly · Hecho en Buenos Aires, Argentina</p>
            <nav class="pie-links" aria-label="Legales y ayuda">
                <a asp-controller="Home" asp-action="Terminos">Términos</a>
                <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                <a asp-controller="Home" asp-action="Cookies">Cookies</a>
                <a asp-controller="Perfil" asp-action="Ayuda">Ayuda</a>
            </nav>
        </div>
    </footer>

    <partial name="_AvisoCookies" />
    <div class="toast-container" aria-live="polite" data-snackbars data-mensaje="@TempData["Mensaje"]" data-mensaje-tipo="@TempData["MensajeTipo"]"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
