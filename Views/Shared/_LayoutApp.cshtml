<!DOCTYPE html>
<html lang="es-AR">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="es-app @ViewData["ClaseBody"]">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <header class="navbar navbar-app" data-navbar>
        <div class="contenedor navbar-interior">
            <a class="logo" href="@Url.Inicio(User)" aria-label="Workly, ir a tu inicio">
                <span class="logo-isotipo" aria-hidden="true">W<span class="logo-acento"></span></span>
                <span class="logo-texto">Workly</span>
            </a>

            <nav class="navbar-links" aria-label="Principal">
                <partial name="_LinksApp" />
            </nav>

            <div class="navbar-acciones">
                @if (User.EstaLogueado())
                {
                <div class="desplegable" data-desplegable>
                    <button class="boton-usuario" type="button" aria-expanded="false" aria-controls="menu-usuario" data-desplegable-boton>
                        <span class="avatar" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(User.Foto()))
                            {
                                <img src="@User.Foto()" alt="" />
                            }
                            else
                            {
                                @(User.EsEmpresa() ? Textos.Iniciales(User.NombreCompleto()) : User.Iniciales())
                            }
                        </span>
                        <span class="boton-usuario-datos">
                            <span class="boton-usuario-nombre">@User.NombreCompleto()</span>
                            <span class="boton-usuario-rol">@(User.Ubicacion() ?? "Mi cuenta")</span>
                        </span>
                        <icono nombre="chevron-down" />
                        <span class="solo-lectores">Abrir menú de cuenta</span>
                    </button>
                    <div class="desplegable-panel" id="menu-usuario" data-desplegable-panel>
                        <div class="menu-cabecera">
                            <strong class="boton-usuario-nombre">@User.NombreCompleto()</strong>
                            <span class="boton-usuario-rol">@User.Email()</span>
                        </div>
                        <ul class="menu" role="list">
                            @if (User.EsEmpresa())
                            {
                                <li><a class="menu-item" asp-controller="Perfil" asp-action="Index"><icono nombre="building" />Perfil de la empresa</a></li>
                                <li><a class="menu-item" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar una búsqueda</a></li>
                            }
                            else
                            {
                                <li><a class="menu-item" asp-controller="Perfil" asp-action="Index"><icono nombre="user-square" />Mi perfil</a></li>
                                <li><a class="menu-item" asp-controller="Perfil" asp-action="Configuracion" asp-fragment="busqueda"><icono nombre="slider-03" />Qué estoy buscando</a></li>
                                <li><a class="menu-item" asp-controller="Publicaciones" asp-action="Nueva"><icono nombre="plus" />Publicar un trabajo</a></li>
                            }
                            <li><a class="menu-item" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="settings" />Configuración</a></li>
                            <li><a class="menu-item" asp-controller="Perfil" asp-action="Ayuda"><icono nombre="help-circle-outline" />Ayuda</a></li>
                            <li class="menu-separador" role="separator"></li>
                            <li>
                                <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                                    <button class="menu-item menu-item-peligro" type="submit"><icono nombre="log-out" />Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
                }
                else
                {
                    <a class="boton boton-contorno" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                    <a class="boton" asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a>
                }

                <button class="navbar-hamburguesa" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-movil>
                    <icono nombre="menu" etiqueta="Abrir menú" />
                </button>
            </div>
        </div>

        <nav class="navbar-movil" id="menu-movil" aria-label="Menú móvil">
            <partial name="_LinksApp" />
            @if (User.EstaLogueado())
            {
                <a class="navbar-link" asp-controller="Perfil" asp-action="Configuracion">Configuración</a>
                <form class="navbar-movil-salir" asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                    <button class="boton boton-contorno boton-peligro boton-bloque" type="submit"><icono nombre="log-out" />Cerrar sesión</button>
                </form>
            }
            else
            {
                <div class="navbar-movil-acciones">
                    <a class="boton boton-contorno" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                    <a class="boton" asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a>
                </div>
            }
        </nav>
    </header>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="pie pie-app">
        <div class="contenedor pie-interior">
            <a class="logo logo-chico" href="@Url.Inicio(User)" aria-label="Workly, ir a tu inicio">
                <span class="logo-isotipo" aria-hidden="true">W<span class="logo-acento"></span></span>
                <span class="logo-texto">Workly</span>
            </a>
            <p class="pie-copy">© @DateTime.Today.Year Workly · Hecho en Buenos Aires, Argentina</p>
            <nav class="pie-links" aria-label="Legales y ayuda">
                <a asp-controller="Home" asp-action="Terminos">Términos</a>
                <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                <a asp-controller="Home" asp-action="Cookies">Cookies</a>
                <a asp-controller="Perfil" asp-action="Ayuda">Ayuda</a>
            </nav>
        </div>
    </footer>

    <partial name="_AvisoCookies" />
    <div class="snackbars" aria-live="polite" data-snackbars data-mensaje="@TempData["Mensaje"]" data-mensaje-tipo="@TempData["MensajeTipo"]"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
