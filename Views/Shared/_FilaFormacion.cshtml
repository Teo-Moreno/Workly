@model FormacionEnviada
<div class="fila-cargar">
    <div class="row g-4">
        <div class="md:col-6">
            <label class="form-label">Título o curso <input class="form-control" name="ForTitulo" value="@Model.Titulo" type="text" placeholder="Ej.: Bachiller en Economía"></label>
        </div>
        <div class="md:col-6">
            <label class="form-label">Institución <input class="form-control" name="ForInstitucion" value="@Model.Institucion" type="text" placeholder="Escuela, universidad o academia"></label>
        </div>
        <div class="col-6">
            <label class="form-label">Inicio <input class="form-control" name="ForInicio" value="@Model.Inicio" type="text" placeholder="MM/AAAA"></label>
        </div>
        <div class="col-6">
            <label class="form-label">Fin (vacío si cursás) <input class="form-control" name="ForFin" value="@Model.Fin" type="text" placeholder="MM/AAAA"></label>
        </div>
    </div>
</div>
