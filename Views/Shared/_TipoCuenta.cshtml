@model string
<div class="tipo-cuenta" role="group" aria-label="¿Qué cuenta querés crear?">
    <a class="tipo-cuenta__opcion @(Model == "persona" ? "esta-activa" : "")" asp-controller="Cuenta" asp-action="CrearCuenta" asp-route-tipo="persona"
       aria-current="@(Model == "persona" ? "page" : null)">
        <span class="caja-icono caja-icono--sm"><icono nombre="user-square" /></span>
        <span><strong>Persona</strong><span>Busco trabajo</span></span>
    </a>
    <a class="tipo-cuenta__opcion @(Model == "empresa" ? "esta-activa" : "")" asp-controller="Cuenta" asp-action="CrearCuenta" asp-route-tipo="empresa"
       aria-current="@(Model == "empresa" ? "page" : null)">
        <span class="caja-icono caja-icono--sm"><icono nombre="building" /></span>
        <span><strong>Empresa</strong><span>Quiero publicar búsquedas</span></span>
    </a>
</div>
