<article class="tarjeta" data-oferta="@Model.Clave">
    <div class="tarjeta-fila">
        <partial name="_LogoEmpresa" model='new LogoEmpresa(Model.Logo, Model.Empresa, Model.EsExterna ? "" : "cuadro-principal")' />
        <div class="tarjeta-textos">
            <h3 class="tarjeta-titulo">
                <a href="@(ViewData["Enlace"] as string ?? Model.Enlace)" data-oferta-enlace>@Model.Titulo</a>
            </h3>
            <p class="tarjeta-texto">@Model.Empresa@(Model.UbicacionVisible != null ? " · " + Model.UbicacionVisible : "")</p>
        </div>
        @if (Model.YaPostulado)
        {
            <span class="badge badge-exito"><icono nombre="circle-check" tamano="16" />Postulado</span>
        }
        else if (Model.Guardada)
        {
            <span class="badge badge-principal"><icono nombre="bookmark-fill" tamano="16" />Guardada</span>
        }
    </div>
    <div class="fila-chapitas">
        <partial name="_SelloOficial" model="Model" />
        @if (!string.IsNullOrEmpty(Model.Modalidad)) { <span class="badge chapita-borde">@Model.Modalidad</span> }
        @if (!string.IsNullOrEmpty(Model.Tipo_Contrato)) { <span class="badge chapita-borde">@Model.Tipo_Contrato</span> }
        <span class="badge @(Model.EsExterna ? "chapita" : "chapita-principal")">@(Model.EsExterna ? "Vía " + Model.Fuente : "En Workly")</span>
    </div>
    <div class="tarjeta-fila-entre">
        <span class="texto-fuerte">@(Model.SalarioVisible ?? "")</span>
        <span class="texto-chico">@Model.PublicadaTexto</span>
    </div>
</article>
