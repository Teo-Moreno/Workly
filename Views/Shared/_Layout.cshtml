<!doctype html>
<html lang="es">
<head>
    <partial name="_Head" />
</head>
<body>
    <header>
        <nav class="navbar md:navbar-expand menu-workly">
            <div class="container">
                <a class="navbar-brand logo" href="@Url.Inicio(User)"><span class="logo-letra">W</span>Workly</a>
                <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon" aria-hidden="true"></span>
                </button>
                <dialog class="drawer drawer-end" tabindex="-1" id="menu" aria-labelledby="menu-titulo">
                    <div class="drawer-header">
                        <h5 class="drawer-title" id="menu-titulo">Workly</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Cerrar"></button>
                    </div>
                    <div class="drawer-body">
                        <ul class="navbar-nav">
                            <partial name="_LinksApp" />
                            @if (User.EstaLogueado())
                            {
                                <li class="nav-item">
                                    <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                                        <button class="nav-link boton-salir" type="submit">Cerrar sesión</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn-solid theme-primary boton boton-acento" asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a>
                                </li>
                            }
                        </ul>
                    </div>
                </dialog>
            </div>
        </nav>
    </header>

    <main>
        <partial name="_Avisos" />
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="md:col-6">
                    <p class="logo logo-claro"><span class="logo-letra">W</span>Workly</p>
                    <p>Encontrá el trabajo que encaja con vos.</p>
                </div>
                <div class="col-6 md:col-3">
                    <h4>Workly</h4>
                    <a asp-controller="Empleos" asp-action="Index">Buscar trabajo</a>
                    <a asp-controller="Empresas" asp-action="Index">Empresas</a>
                    <a asp-controller="Perfil" asp-action="Ayuda">Ayuda</a>
                </div>
                <div class="col-6 md:col-3">
                    <h4>Legales</h4>
                    <a asp-controller="Home" asp-action="Terminos">Términos</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                    <a asp-controller="Home" asp-action="Cookies">Cookies</a>
                </div>
            </div>
            <p class="copy">© @DateTime.Today.Year Workly · Hecho en Buenos Aires, Argentina</p>
        </div>
    </footer>

    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
</body>
</html>
