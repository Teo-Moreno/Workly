<details class="accordion-item agregar" open="@Model.Abierto">
    <summary class="accordion-header">+ Agregar formación</summary>
    <form class="accordion-body" asp-controller="Perfil" asp-action="AgregarFormacion" method="post">
        <p class="texto-suave">Sumá tus estudios: secundario, terciario, universidad o cursos.</p>
        <div class="row g-4">
            <div class="md:col-6">
                <div class="form-field @(Model.Abierto ? Html.ClaseError("Titulo") : "")">
                    <label class="form-label" for="for-titulo">Título o curso</label>
                    <input class="form-control" id="for-titulo" name="Titulo" value="@Model.Valores.Titulo" type="text" required placeholder="Ej.: Bachiller en Economía">
                    <p class="error-texto">@Html.MensajeError("Titulo", "Completá el título o curso")</p>
                </div>
            </div>
            <div class="md:col-6">
                <div class="form-field @(Model.Abierto ? Html.ClaseError("Institucion") : "")">
                    <label class="form-label" for="for-institucion">Institución</label>
                    <input class="form-control" id="for-institucion" name="Institucion" value="@Model.Valores.Institucion" type="text" required placeholder="Escuela, universidad o academia">
                    <p class="error-texto">@Html.MensajeError("Institucion", "Completá la institución")</p>
                </div>
            </div>
            <div class="md:col-6">
                <partial name="_CampoMes" model='new CampoMes { Nombre = "Inicio", Id = "for-inicio", Etiqueta = "Inicio", Valor = Model.Valores.Inicio, Requerido = true, Error = Model.Abierto && Html.ClaseError("Inicio").Length > 0 ? Html.MensajeError("Inicio", "") : null }' />
            </div>
            <div class="md:col-6">
                <partial name="_CampoMes" model='new CampoMes { Nombre = "Fin", Id = "for-fin", Etiqueta = "Finalización (vacío si la cursás)", Valor = Model.Valores.Fin, Requerido = false, Error = Model.Abierto && Html.ClaseError("Fin").Length > 0 ? Html.MensajeError("Fin", "") : null }' />
            </div>
        </div>
        <label class="casilla">
            <input type="checkbox" id="for-en-curso" name="EnCurso" value="true" checked="@Model.Valores.EnCurso">
            La estoy cursando
        </label>
        <button class="btn-solid theme-primary boton" type="submit">Agregar</button>
    </form>
</details>
