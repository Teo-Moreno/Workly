<div class="modal fade" tabindex="-1" aria-hidden="true" id="modal-formacion" aria-labelledby="modal-formacion-titulo" data-abrir-al-cargar="@(Model.Abierto ? "true" : null)"><div class="modal-dialog"><div class="modal-content">
    <form class="modal-body formulario" method="@(Model.EnServidor ? "post" : "dialog")" novalidate
          action="@(Model.EnServidor ? Url.Action("AgregarFormacion", "Perfil") : null)"
          data-modal-local="@(Model.EnServidor ? null : "formacion")" data-formulario-real="@(Model.EnServidor ? "" : null)">
        @if (Model.EnServidor)
        {
            @Html.AntiForgeryToken()
        }
        <div class="modal-header">
            <h2 class="modal-title" id="modal-formacion-titulo">Agregar formación</h2>
            <button class="modal-cerrar" type="button" value="cancelar" aria-label="Cerrar" data-bs-dismiss="modal"><icono nombre="close-big" /></button>
        </div>
        <p class="modal-descripcion">Sumá tus estudios: secundario, terciario, universidad o cursos.</p>

        <div class="campo @(Model.Abierto ? Html.ClaseError("Titulo") : "")">
            <label class="form-label" for="for-titulo">Título o curso</label>
            <input class="form-control" id="for-titulo" name="Titulo" value="@Model.Valores.Titulo" maxlength="150" required placeholder="Ej.: Bachiller en Economía, Técnico en Programación" />
            <span class="invalid-feedback"><icono nombre="warning" />@(Model.Abierto ? Html.MensajeError("Titulo", "Completá el título o curso") : "Completá el título o curso")</span>
        </div>
        <div class="campo @(Model.Abierto ? Html.ClaseError("Institucion") : "")">
            <label class="form-label" for="for-institucion">Institución</label>
            <input class="form-control" id="for-institucion" name="Institucion" value="@Model.Valores.Institucion" maxlength="150" required list="lista-instituciones" placeholder="Escuela, universidad o academia" />
            <datalist id="lista-instituciones">
                @foreach (string institucion in Model.Instituciones)
                {
                    <option value="@institucion"></option>
                }
            </datalist>
            <span class="invalid-feedback"><icono nombre="warning" />@(Model.Abierto ? Html.MensajeError("Institucion", "Completá la institución") : "Completá la institución")</span>
        </div>

        <div class="formulario-fila">
            <partial name="_CampoMes" model='new CampoMes { Nombre = "Inicio", Id = "for-inicio", Etiqueta = "Inicio", Valor = Model.Valores.Inicio, Requerido = true, Error = Model.Abierto && Html.ClaseError("Inicio").Length > 0 ? Html.MensajeError("Inicio", "") : null }' />
            <div data-fin-de="for-en-curso" hidden="@Model.Valores.EnCurso">
                <partial name="_CampoMes" model='new CampoMes { Nombre = "Fin", Id = "for-fin", Etiqueta = "Finalización", Valor = Model.Valores.Fin, Requerido = !Model.Valores.EnCurso, PermitirFuturo = true, Error = Model.Abierto && Html.ClaseError("Fin").Length > 0 ? Html.MensajeError("Fin", "") : null }' />
            </div>
        </div>

        <label class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="for-en-curso" name="EnCurso" value="true" checked="@Model.Valores.EnCurso" data-alternar-fin />
            <span class="form-check-label">La estoy cursando</span>
        </label>

        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" value="cancelar" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-primary" type="submit">Agregar</button>
        </div>
    </form>
</div></div></div>
