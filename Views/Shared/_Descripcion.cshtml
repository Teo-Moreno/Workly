<div class="parrafos">
    @foreach (BloqueDescripcion bloque in Descripciones.Armar(Model))
    {
        if (bloque.EsTitulo)
        {
            <h3 class="parrafos-titulo">@bloque.Texto</h3>
        }
        else if (bloque.EsLista)
        {
            <ul class="parrafos-lista">
                @foreach (var item in bloque.Items)
                {
                    <li>@item</li>
                }
            </ul>
        }
        else
        {
            <p>@bloque.Texto</p>
        }
    }
</div>
