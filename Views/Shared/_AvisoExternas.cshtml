@inject JSearch Busqueda
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Entorno
@* Aviso cuando no se pudieron traer las ofertas de otros sitios (JSearch) *@
@if (!Busqueda.Configurada && Entorno.IsDevelopment())
{
    <p class="aviso-desarrollo"><icono nombre="warning-outline" tamano="18" />
        Falta la clave de JSearch en esta compu, por eso no aparecen las ofertas de otros sitios. Desde la carpeta del proyecto ejecutá
        <code>dotnet user-secrets set "JSearch:ApiKey" "&lt;la clave&gt;"</code> y volvé a correr el proyecto. Este aviso solo se ve mientras se desarrolla.</p>
}
else
{
    <p class="aviso aviso--advertencia"><icono nombre="warning-outline" />No pudimos traer las ofertas de otros sitios en este momento. Probá de nuevo en unos minutos.</p>
}
