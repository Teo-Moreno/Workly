@model Oferta
<div class="lista-tags">
    @foreach (var habilidad in Model.HabilidadesCumplidas)
    {
        <span class="tag tag--ok tag--lg"><icono nombre="check" />@habilidad</span>
    }
    @if (!string.IsNullOrEmpty(Model.HabilidadFaltante))
    {
        <span class="tag tag--falta tag--lg"><icono nombre="warning-outline" />Te falta: @Model.HabilidadFaltante</span>
    }
</div>
