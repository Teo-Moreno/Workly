@model Empresa
@* Tarjeta de empresa (Figma › Media · WF 04 › Grilla de empresas): solo datos que cargó la empresa *@
<article class="empresa-tarjeta">
    <div class="empresa-tarjeta__cabecera">
        <partial name="_LogoEmpresa" model='(Model.Logo, Model.Nombre, "logo-empresa--md")' />
        <div class="empresa-tarjeta__datos">
            <h3 class="empresa-tarjeta__nombre">
                <a asp-controller="Empresas" asp-action="Detalle" asp-route-id="@Model.ID">@Model.Nombre</a>
            </h3>
            <p class="empresa-tarjeta__industria">@string.Join(" · ", new[] { Model.Rubro, Model.Provincia }.Where(t => !string.IsNullOrEmpty(t)))</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
    {
        <p class="empresa-tarjeta__descripcion">@Textos.Recortar(Model.Descripcion, 160)</p>
    }

    <div class="empresa-tarjeta__pie">
        <a class="enlace" asp-controller="Empresas" asp-action="Detalle" asp-route-id="@Model.ID" asp-fragment="ofertas">
            @(Model.BusquedasActivas == 0 ? "Sin búsquedas abiertas" : Model.BusquedasActivas == 1 ? "Ver 1 búsqueda abierta →" : $"Ver {Model.BusquedasActivas} búsquedas abiertas →")
        </a>
    </div>
</article>
