<article class="tarjeta-alta">
    <div class="tarjeta-alta-fila">
        <partial name="_LogoEmpresa" model='new LogoEmpresa(Model.Logo, Model.Nombre, "cuadro-md")' />
        <div class="flexible">
            <h3 class="tarjeta-alta-titulo">
                <a asp-controller="Empresas" asp-action="Detalle" asp-route-id="@Model.ID">@Model.Nombre</a>
            </h3>
            <p class="texto-chico">@Model.Resumen</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
    {
        <p class="tarjeta-alta-parrafo">@Textos.Recortar(Model.Descripcion, 160)</p>
    }

    <div class="tarjeta-alta-fila-entre">
        <a class="resaltado" asp-controller="Empresas" asp-action="Detalle" asp-route-id="@Model.ID" asp-fragment="ofertas">
            @(Model.BusquedasActivas == 0 ? "Sin búsquedas abiertas" : Model.BusquedasActivas == 1 ? "Ver 1 búsqueda abierta →" : $"Ver {Model.BusquedasActivas} búsquedas abiertas →")
        </a>
    </div>
</article>
