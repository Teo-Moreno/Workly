<div class="card tarjeta">
    <div class="tarjeta-fila">
        <partial name="_LogoEmpresa" model='new LogoEmpresa(Model.Logo, Model.Nombre, "logo-empresa")' />
        <div>
            <h3 class="tarjeta-titulo">
                <a asp-controller="Empresas" asp-action="Detalle" asp-route-id="@Model.ID">@Model.Nombre</a>
            </h3>
            <p class="texto-suave">@Model.Resumen</p>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
    {
        <p>@Textos.Recortar(Model.Descripcion, 160)</p>
    }
    <a asp-controller="Empresas" asp-action="Detalle" asp-route-id="@Model.ID" asp-fragment="ofertas">
        @(Model.BusquedasActivas == 0 ? "Sin búsquedas abiertas" : Model.BusquedasActivas == 1 ? "Ver 1 búsqueda abierta →" : $"Ver {Model.BusquedasActivas} búsquedas abiertas →")
    </a>
</div>
