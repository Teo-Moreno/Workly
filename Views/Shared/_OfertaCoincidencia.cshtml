@model Oferta
@* Tarjeta "Oferta" de la landing Alta (bloque "Tus mejores coincidencias hoy") *@
<article class="oferta-mini">
    <div class="oferta-mini__cabecera">
        <span class="logo-empresa" aria-hidden="true">@Model.Iniciales</span>
        <div class="oferta-mini__datos">
            <h3 class="oferta-mini__puesto">@Model.Puesto</h3>
            <p class="oferta-mini__meta"><icono nombre="near-me" tamano="14" />@Model.Empresa · @Model.UbicacionCorta</p>
        </div>
        <span class="match @(Model.Match < 80 ? "match--media" : "")"><icono nombre="circle-check" />@Model.Match% match</span>
    </div>
    <div class="lista-tags">
        @foreach (var tecnologia in Model.Tecnologias.Take(2))
        {
            <span class="tag">@tecnologia</span>
        }
        <span class="tag">@Model.Nivel</span>
    </div>
    <div class="oferta-mini__pie">
        <span class="oferta-mini__salario">@Model.Salario</span>
        <a class="enlace" asp-controller="Empleos" asp-action="Detalle" asp-route-id="@Model.Id">Ver oferta →<span class="solo-lectores"> @Model.Puesto en @Model.Empresa</span></a>
    </div>
</article>
