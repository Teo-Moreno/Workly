@if (!User.EstaLogueado())
{
    <a class="btn-outline theme-primary boton" asp-controller="Cuenta" asp-action="IniciarSesion" asp-route-returnUrl="@ViewContext.Volver()">Guardar</a>
}
else if (User.EsPersona() && !User.EsPropia((int?)Model.IDUsuario_Publicador))
{
    <form asp-controller="Guardadas" asp-action="@(Model.Guardada ? "Quitar" : "Guardar")" asp-route-id="@Model.ID" asp-route-externa="@(Model.EsExterna ? "true" : "false")" asp-route-volver="@ViewContext.Volver()" method="post">
        <button class="@(Model.Guardada ? "btn-solid theme-primary boton boton-guardada" : "btn-outline theme-primary boton")" type="submit"
                title="@(Model.Guardada ? "Sacar de Guardadas" : "Guardar para verla después")">
            @(Model.Guardada ? "★ Guardada" : "☆ Guardar")
        </button>
    </form>
}
