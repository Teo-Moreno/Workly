@if (!User.EstaLogueado())
{
    <a class="btn btn-outline-lg" href="@ViewBag.UrlIngresar" data-icono="bookmark">Guardar</a>
}
else if (User.EsPersona() && !ViewBag.EsPropia)
{
    <form action="/Guardadas/@(Model.Guardada ? "Quitar" : "Guardar")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.ID" />
        <input type="hidden" name="externa" value="@(Model.EsExterna ? "true" : "false")" />
        <input type="hidden" name="volver" value="@ViewBag.Volver" />
        <button class="@(Model.Guardada ? "btn btn-turquesa" : "btn btn-outline-lg")" type="submit" aria-pressed="@(Model.Guardada ? "true" : "false")"
                title="@(Model.Guardada ? "Sacar de Guardadas" : "Guardar para verla después")" data-icono="@(Model.Guardada ? "bookmark-fill" : "bookmark")">
            @(Model.Guardada ? "Guardada" : "Guardar")
        </button>
    </form>
}
