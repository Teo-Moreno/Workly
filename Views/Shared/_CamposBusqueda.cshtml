@model CamposBusqueda
@if (Model.IncluirEstado)
{
    <div class="form-field @Html.ClaseError("EstadoBusqueda")">
        <p class="form-label">¿Estás buscando trabajo?</p>
        <div class="opciones">
            @foreach (var estado in Catalogos.EstadosBusqueda)
            {
                <label class="opcion">
                    <input type="radio" name="EstadoBusqueda" value="@estado" checked="@(Model.EstadoBusqueda == estado)">
                    @estado
                </label>
            }
        </div>
        <p class="error-texto">@Html.MensajeError("EstadoBusqueda", "Elegí una opción")</p>
    </div>
}

<div class="row g-4">
    <div class="md:col-6">
        <div class="form-field @Html.ClaseError("PuestoBuscado")">
            <label class="form-label" for="@(Model.Prefijo)-puesto">Puesto que buscás <span class="opcional">(opcional)</span></label>
            <input class="form-control" id="@(Model.Prefijo)-puesto" name="PuestoBuscado" value="@Model.PuestoBuscado" type="text" placeholder="Ej.: Administrativo/a, Desarrollador/a">
            <p class="form-text">Lo usamos para mostrarte ofertas en tu inicio.</p>
            <p class="error-texto">@Html.MensajeError("PuestoBuscado", "Usá hasta 100 caracteres")</p>
        </div>
    </div>
    <div class="md:col-6">
        <div class="form-field">
            <label class="form-label" for="@(Model.Prefijo)-disponibilidad">Disponibilidad <span class="opcional">(opcional)</span></label>
            <select class="form-control" id="@(Model.Prefijo)-disponibilidad" name="Disponibilidad">
                <partial name="_Opciones" model='new OpcionesSelect(Model.Disponibilidad, Catalogos.Disponibilidades, "Elegí una opción")' />
            </select>
        </div>
    </div>
</div>

<div class="form-field">
    <p class="form-label">Nivel de experiencia <span class="opcional">(podés elegir más de uno)</span></p>
    <div class="opciones">
        @foreach (var nivel in Catalogos.Niveles)
        {
            <label class="opcion"><input type="checkbox" name="Niveles" value="@nivel" checked="@Model.Niveles.Contains(nivel)"> @nivel</label>
        }
    </div>
</div>

<div class="form-field">
    <p class="form-label">Modalidad <span class="opcional">(podés elegir más de una)</span></p>
    <div class="opciones">
        @foreach (var modalidad in Catalogos.Modalidades)
        {
            <label class="opcion"><input type="checkbox" name="Modalidades" value="@modalidad" checked="@Model.Modalidades.Contains(modalidad)"> @modalidad</label>
        }
    </div>
</div>

<div class="row g-4">
    <div class="md:col-6">
        <div class="form-field">
            <label class="form-label" for="@(Model.Prefijo)-jornada">Jornada <span class="opcional">(opcional)</span></label>
            <select class="form-control" id="@(Model.Prefijo)-jornada" name="Jornada">
                <partial name="_Opciones" model='new OpcionesSelect(Model.Jornada, Catalogos.Jornadas, "Elegí una opción")' />
            </select>
        </div>
    </div>
    <div class="md:col-6">
        <div class="form-field">
            <label class="form-label" for="@(Model.Prefijo)-contratacion">Contratación <span class="opcional">(opcional)</span></label>
            <select class="form-control" id="@(Model.Prefijo)-contratacion" name="Contratacion">
                <partial name="_Opciones" model='new OpcionesSelect(Model.Contratacion, Catalogos.Contrataciones, "Elegí una opción")' />
            </select>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="md:col-6">
        <div class="form-field">
            <label class="form-label" for="@(Model.Prefijo)-donde">¿Dónde querés trabajar?</label>
            <select class="form-control" id="@(Model.Prefijo)-donde" name="IDProvinciaPreferida">
                @foreach (Provincia provincia in Model.ProvinciasDelPais)
                {
                    if (provincia.ID == Model.IDProvinciaPreferida)
                    {
                        <option value="@provincia.ID">@provincia.Nombre</option>
                    }
                }
                <option value="">Todo el país</option>
                @foreach (Provincia provincia in Model.ProvinciasDelPais)
                {
                    if (provincia.ID != Model.IDProvinciaPreferida)
                    {
                        <option value="@provincia.ID">@provincia.Nombre</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="md:col-6">
        <div class="form-field @(Html.ClaseError("SalarioMaximo") != "" ? "campo-error" : Html.ClaseError("SalarioMinimo"))">
            <p class="form-label">Expectativa salarial bruta por mes <span class="opcional">(opcional)</span></p>
            <div class="rango">
                <input class="form-control" name="SalarioMinimo" value="@Model.SalarioMinimo" type="number" min="0" step="1000" placeholder="Mínimo" aria-label="Salario mínimo">
                <span>–</span>
                <input class="form-control" name="SalarioMaximo" value="@Model.SalarioMaximo" type="number" min="0" step="1000" placeholder="Máximo" aria-label="Salario máximo">
            </div>
            <p class="error-texto">@Html.MensajeError("SalarioMaximo", Html.MensajeError("SalarioMinimo", "Revisá los montos"))</p>
        </div>
    </div>
</div>

<div class="form-field @Html.ClaseError("Habilidades")">
    <p class="form-label">Habilidades <span class="opcional">(abrí un sector y marcá las que tengas)</span></p>
    @if (Model.HabilidadesPropias.Count > 0)
    {
        <div class="opciones">
            @foreach (string habilidad in Model.HabilidadesPropias)
            {
                <label class="opcion"><input type="checkbox" name="Habilidades" value="@habilidad" checked> @habilidad</label>
            }
        </div>
    }
    <div class="accordion sectores">
        @foreach (var sector in Model.Sectores)
        {
            <details class="accordion-item" name="sectores-@Model.Prefijo">
                <summary class="accordion-header">@sector.Sector</summary>
                <div class="accordion-body opciones">
                    @foreach (Habilidad habilidad in Model.CatalogoHabilidades)
                    {
                        if (habilidad.IDSector == sector.IDSector)
                        {
                            <label class="opcion"><input type="checkbox" name="Habilidades" value="@habilidad.Nombre" checked="@Model.Elegida(habilidad.Nombre)"> @habilidad.Nombre</label>
                        }
                    }
                </div>
            </details>
        }
    </div>
    <label class="form-label" for="@(Model.Prefijo)-nueva-habilidad">¿No está la tuya? Escribila acá</label>
    <input class="form-control" id="@(Model.Prefijo)-nueva-habilidad" name="Habilidades" type="text" placeholder="Ej.: Atención al cliente">
    <p class="form-text">Las que agregás vos solo aparecen en tu perfil.</p>
    <p class="error-texto">@Html.MensajeError("Habilidades", "Revisá las habilidades")</p>
</div>

<div class="form-field @Html.ClaseError("Idiomas")">
    <p class="form-label">Idiomas <span class="opcional">(opcional)</span></p>
    @foreach (var fila in Model.Idiomas)
    {
        <div class="fila-idioma">
            <select class="form-control" name="IdiomaIds" aria-label="Idioma">
                @foreach (Idioma idioma in Model.CatalogoIdiomas)
                {
                    if (idioma.ID == fila.IDIdioma)
                    {
                        <option value="@idioma.ID">@idioma.Nombre</option>
                    }
                }
                <option value="0">Quitar este idioma</option>
                @foreach (Idioma idioma in Model.CatalogoIdiomas)
                {
                    if (idioma.ID != fila.IDIdioma)
                    {
                        <option value="@idioma.ID">@idioma.Nombre</option>
                    }
                }
            </select>
            <select class="form-control" name="IdiomaNiveles" aria-label="Nivel">
                <partial name="_Opciones" model="new OpcionesSelect(fila.Nivel, Catalogos.NivelesIdioma)" />
            </select>
        </div>
    }
    <div class="fila-idioma">
        <select class="form-control" name="IdiomaIds" aria-label="Agregar idioma">
            <option value="0">Agregar un idioma</option>
            @foreach (Idioma idioma in Model.CatalogoIdiomas)
            {
                <option value="@idioma.ID">@idioma.Nombre</option>
            }
        </select>
        <select class="form-control" name="IdiomaNiveles" aria-label="Nivel">
            <partial name="_Opciones" model="new OpcionesSelect(null, Catalogos.NivelesIdioma)" />
        </select>
    </div>
    <p class="form-text">Para sumar otro idioma, guardá y vas a ver una fila nueva.</p>
    <p class="error-texto">@Html.MensajeError("Idiomas", "Elegí el idioma y el nivel de cada fila")</p>
</div>
