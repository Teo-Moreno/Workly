@* Sin "selected": la opción guardada va primera, así el navegador la muestra elegida. *@
<div class="row g-4">
    <div class="md:col-6">
        <div class="form-field @Html.ClaseError((string)Model.NombrePais)">
            <label class="form-label" for="@Model.IdPais">País</label>
            <select class="form-control" id="@Model.IdPais" name="@Model.NombrePais" required="@Model.Requerido">
                @foreach (Pais pais in Model.Paises)
                {
                    if (pais.ID == Model.IDPais)
                    {
                        <option value="@pais.ID">@pais.Nombre</option>
                    }
                }
                @if (Model.Paises.Count != 1)
                {
                    <option value="">Elegí el país</option>
                }
                @foreach (Pais pais in Model.Paises)
                {
                    if (pais.ID != Model.IDPais)
                    {
                        <option value="@pais.ID">@pais.Nombre</option>
                    }
                }
            </select>
            <p class="error-texto">@Html.MensajeError((string)Model.NombrePais, "Elegí el país")</p>
        </div>
    </div>
    <div class="md:col-6">
        <div class="form-field @Html.ClaseError((string)Model.NombreProvincia)">
            <label class="form-label" for="@Model.IdProvincia">@Model.EtiquetaProvincia</label>
            <select class="form-control" id="@Model.IdProvincia" name="@Model.NombreProvincia" required="@(Model.Requerido && !Model.TodoElPais)">
                @foreach (Provincia provincia in Model.Provincias)
                {
                    if (provincia.ID == Model.IDProvincia)
                    {
                        <option value="@provincia.ID">@provincia.Nombre</option>
                    }
                }
                <option value="">@(Model.TodoElPais ? "Todo el país" : "Elegí la provincia")</option>
                @foreach (Provincia provincia in Model.Provincias)
                {
                    if (provincia.ID != Model.IDProvincia)
                    {
                        <option value="@provincia.ID">@provincia.Nombre</option>
                    }
                }
            </select>
            <p class="error-texto">@Html.MensajeError((string)Model.NombreProvincia, "Elegí la provincia")</p>
        </div>
    </div>
</div>
