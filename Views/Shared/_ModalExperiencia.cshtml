<details class="accordion-item agregar" open="@Model.Abierto">
    <summary class="accordion-header">+ Agregar experiencia</summary>
    <form class="accordion-body" asp-controller="Perfil" asp-action="AgregarExperiencia" method="post">
        <p class="texto-suave">Sumá tus trabajos, pasantías o proyectos freelance.</p>
        <div class="row g-4">
            <div class="md:col-6">
                <div class="form-field @(Model.Abierto ? Html.ClaseError("Puesto") : "")">
                    <label class="form-label" for="exp-puesto">Puesto</label>
                    <input class="form-control" id="exp-puesto" name="Puesto" value="@Model.Valores.Puesto" type="text" required placeholder="Ej.: Cajero/a, Analista contable">
                    <p class="error-texto">@Html.MensajeError("Puesto", "Completá el puesto")</p>
                </div>
            </div>
            <div class="md:col-6">
                <div class="form-field @(Model.Abierto ? Html.ClaseError("Empresa") : "")">
                    <label class="form-label" for="exp-empresa">Empresa</label>
                    <input class="form-control" id="exp-empresa" name="Empresa" value="@Model.Valores.Empresa" type="text" required placeholder="Nombre de la empresa">
                    <p class="error-texto">@Html.MensajeError("Empresa", "Completá la empresa")</p>
                </div>
            </div>
            <div class="md:col-6">
                <partial name="_CampoMes" model='new CampoMes { Nombre = "Inicio", Id = "exp-inicio", Etiqueta = "Inicio", Valor = Model.Valores.Inicio, Requerido = true, Error = Model.Abierto && Html.ClaseError("Inicio").Length > 0 ? Html.MensajeError("Inicio", "") : null }' />
            </div>
            <div class="md:col-6">
                <partial name="_CampoMes" model='new CampoMes { Nombre = "Fin", Id = "exp-fin", Etiqueta = "Finalización (vacío si seguís ahí)", Valor = Model.Valores.Fin, Requerido = false, Error = Model.Abierto && Html.ClaseError("Fin").Length > 0 ? Html.MensajeError("Fin", "") : null }' />
            </div>
        </div>
        <label class="casilla">
            <input type="checkbox" id="exp-actual" name="Actual" value="true" checked="@Model.Valores.Actual">
            Trabajo actualmente acá
        </label>
        <div class="form-field @(Model.Abierto ? Html.ClaseError("Descripcion") : "")">
            <label class="form-label" for="exp-descripcion">Qué hacías <span class="opcional">(opcional)</span></label>
            <textarea class="form-control" id="exp-descripcion" name="Descripcion" rows="3" placeholder="Tus tareas y logros principales.">@Model.Valores.Descripcion</textarea>
            <p class="error-texto">@Html.MensajeError("Descripcion", "Usá hasta 500 caracteres")</p>
        </div>
        <button class="btn-solid theme-primary boton" type="submit">Agregar</button>
    </form>
</details>
