<dialog class="modal" id="modal-experiencia" aria-labelledby="modal-experiencia-titulo" data-abrir-al-cargar="@(Model.Abierto ? "true" : null)">
    <form class="modal-contenido formulario" method="@(Model.EnServidor ? "post" : "dialog")" novalidate
          action="@(Model.EnServidor ? Url.Action("AgregarExperiencia", "Perfil") : null)"
          data-modal-local="@(Model.EnServidor ? null : "experiencia")" data-formulario-real="@(Model.EnServidor ? "" : null)">
        @if (Model.EnServidor)
        {
            @Html.AntiForgeryToken()
        }
        <div class="modal-cabecera">
            <h2 class="modal-titulo" id="modal-experiencia-titulo">Agregar experiencia</h2>
            <button class="modal-cerrar" type="button" value="cancelar" aria-label="Cerrar" data-modal-cerrar><icono nombre="close-big" /></button>
        </div>
        <p class="modal-descripcion">Sumá tus trabajos, pasantías o proyectos freelance.</p>

        <div class="campo @(Model.Abierto ? Html.ClaseError("Puesto") : "")">
            <label class="campo-etiqueta" for="exp-puesto">Puesto</label>
            <input class="campo-control" id="exp-puesto" name="Puesto" value="@Model.Valores.Puesto" maxlength="100" required placeholder="Ej.: Cajero/a, Analista contable" />
            <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@(Model.Abierto ? Html.MensajeError("Puesto", "Completá el puesto") : "Completá el puesto")</span>
        </div>
        <div class="campo @(Model.Abierto ? Html.ClaseError("Empresa") : "")">
            <label class="campo-etiqueta" for="exp-empresa">Empresa</label>
            <input class="campo-control" id="exp-empresa" name="Empresa" value="@Model.Valores.Empresa" maxlength="100" required placeholder="Nombre de la empresa" />
            <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@(Model.Abierto ? Html.MensajeError("Empresa", "Completá la empresa") : "Completá la empresa")</span>
        </div>

        <div class="formulario-fila">
            <partial name="_CampoMes" model='new CampoMes { Nombre = "Inicio", Id = "exp-inicio", Etiqueta = "Inicio", Valor = Model.Valores.Inicio, Requerido = true, Error = Model.Abierto && Html.ClaseError("Inicio").Length > 0 ? Html.MensajeError("Inicio", "") : null }' />
            <div data-fin-de="exp-actual" hidden="@Model.Valores.Actual">
                <partial name="_CampoMes" model='new CampoMes { Nombre = "Fin", Id = "exp-fin", Etiqueta = "Finalización", Valor = Model.Valores.Fin, Requerido = !Model.Valores.Actual, Error = Model.Abierto && Html.ClaseError("Fin").Length > 0 ? Html.MensajeError("Fin", "") : null }' />
            </div>
        </div>

        <label class="interruptor interruptor-etiqueta">
            <input type="checkbox" id="exp-actual" name="Actual" value="true" checked="@Model.Valores.Actual" data-alternar-fin />
            <span class="interruptor-pista"></span>
            Trabajo actualmente acá
        </label>

        <div class="campo @(Model.Abierto ? Html.ClaseError("Descripcion") : "")">
            <label class="campo-etiqueta" for="exp-descripcion">Qué hacías <span class="campo-opcional">(opcional)</span></label>
            <textarea class="campo-control" id="exp-descripcion" name="Descripcion" rows="3" maxlength="500" placeholder="Tus tareas y logros principales.">@Model.Valores.Descripcion</textarea>
            <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@(Model.Abierto ? Html.MensajeError("Descripcion", "Usá hasta 500 caracteres") : "Usá hasta 500 caracteres")</span>
        </div>

        <div class="modal-acciones">
            <button class="boton boton-gris" type="button" value="cancelar" data-modal-cerrar>Cancelar</button>
            <button class="boton" type="submit">Agregar</button>
        </div>
    </form>
</dialog>
