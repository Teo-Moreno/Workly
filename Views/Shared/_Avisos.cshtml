@if (TempData["Mensaje"] is string mensaje && mensaje.Length > 0)
{
    <div class="container">
        <p class="mensaje mensaje-@(TempData["MensajeTipo"] as string ?? "info")" role="status">@mensaje</p>
    </div>
}
@if (!Context.Request.Cookies.ContainsKey("Workly.Cookies"))
{
    <div class="aviso-cookies">
        <div class="container">
            <p>
                Workly usa solo las cookies necesarias para que funcione: mantener tu sesión, proteger los formularios y mostrarte los avisos después de cada acción.
                <a asp-controller="Home" asp-action="Cookies">Ver la política de cookies</a>
            </p>
            <form asp-controller="Home" asp-action="AceptarCookies" asp-route-volver="@ViewContext.AquiMismo()" method="post">
                <button class="btn-solid theme-primary boton btn-sm" type="submit">Entendido</button>
            </form>
        </div>
    </div>
}
