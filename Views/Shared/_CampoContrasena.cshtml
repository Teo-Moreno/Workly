<div class="form-field @Html.ClaseError("Contrasena")">
    <label class="form-label" for="Contrasena">Contraseña</label>
    <input class="form-control" id="Contrasena" name="Contrasena" type="password" value="" autocomplete="new-password" placeholder="Mínimo 8 caracteres" required>
    <p class="form-text">Al menos 8 caracteres, con letras y números.</p>
    <p class="error-texto">@Html.MensajeError("Contrasena", "Usá al menos 8 caracteres, con una letra y un número")</p>
</div>
