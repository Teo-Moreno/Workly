<div class="campo" aria-invalid="@(ViewBag.Errores.Tiene("Contrasena") ? "true" : null)">
    <label class="form-label" for="Contrasena">Contraseña</label>
    <div class="control-con-icono" data-icono="lock">
        <input class="form-control" id="Contrasena" name="Contrasena" type="password" value="" autocomplete="new-password" placeholder="Mínimo 8 caracteres"
               minlength="8" maxlength="100" pattern="(?=.*[A-Za-zÁÉÍÓÚÜÑáéíóúüñ])(?=.*\d).{8,}" required />
        <button class="control-icono-derecha" type="button" aria-label="Mostrar contraseña" aria-pressed="false" data-ver-clave data-icono="eye"></button>
    </div>
    <span class="form-text">Al menos 8 caracteres, con letras y números.</span>
    <span class="invalid-feedback" data-icono="warning">@ViewBag.Errores.Mensaje("Contrasena", "Usá al menos 8 caracteres, con una letra y un número")</span>
</div>
