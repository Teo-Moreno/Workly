<table class="table datos">
    <tbody>
        @foreach (var etapa in Catalogos.EstadosPostulacion)
        {
            <tr>
                <th scope="row"><span class="punto punto-@etapa.Color"></span>@etapa.Estado</th>
                <td>@Model.CantidadEnEstado(etapa.Estado)</td>
            </tr>
        }
    </tbody>
</table>
