<div class="form-field @Html.ClaseError("AceptaTerminos")">
    <label class="casilla">
        <input id="AceptaTerminos" name="AceptaTerminos" value="true" checked="@ViewBag.Formulario.AceptaTerminos" type="checkbox" required>
        Acepto los <a asp-controller="Home" asp-action="Terminos" target="_blank">Términos</a> y la <a asp-controller="Home" asp-action="Privacy" target="_blank">Política de privacidad</a>
    </label>
    <p class="error-texto">@Html.MensajeError("AceptaTerminos", "Tenés que aceptar los términos para continuar")</p>
</div>
