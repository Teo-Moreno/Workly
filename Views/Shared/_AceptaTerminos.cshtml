<div class="campo @Html.ClaseError("AceptaTerminos")">
    <label class="casilla casilla-sm">
        <input id="AceptaTerminos" name="AceptaTerminos" value="true" checked="@ViewBag.Formulario.AceptaTerminos" type="checkbox" required />
        <span class="casilla-caja"><icono nombre="check" /></span>
        <span>Acepto los <a class="enlace" asp-controller="Home" asp-action="Terminos" target="_blank">Términos</a> y la <a class="enlace" asp-controller="Home" asp-action="Privacy" target="_blank">Política de privacidad</a></span>
    </label>
    <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError("AceptaTerminos", "Tenés que aceptar los términos para continuar")</span>
</div>
