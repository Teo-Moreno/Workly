<!DOCTYPE html>
<html lang="es-AR">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="es-blanco">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <div class="cuenta">
        <aside class="cuenta-marca">
            <a class="logo logo-claro" asp-controller="Home" asp-action="Index" aria-label="Workly, ir al inicio">
                <span class="logo-isotipo" aria-hidden="true">W<span class="logo-acento"></span></span>
                <span class="logo-texto">Workly</span>
            </a>

            <div class="cuenta-mensaje">
                <span class="badge badge-acento">Por qué Workly</span>
                <p class="cuenta-titulo">Tu próximo trabajo no debería ser una <span class="text-warning">aguja en un pajar.</span></p>
                <ul class="cuenta-lista" role="list">
                    <li>
                        <span class="caja-icono-sm caja-icono-secundario"><icono nombre="circle-check-outline" /></span>
                        <span><strong>Todo en un lugar.</strong> Ofertas de Workly y de otros sitios en una sola búsqueda.</span>
                    </li>
                    <li>
                        <span class="caja-icono-sm caja-icono-secundario"><icono nombre="settings" /></span>
                        <span><strong>Tu perfil, tus reglas.</strong> Contá qué buscás y te mostramos ofertas acordes.</span>
                    </li>
                    <li>
                        <span class="caja-icono-sm caja-icono-secundario"><icono nombre="checkbox-checked" /></span>
                        <span><strong>Más organizado.</strong> Seguí todas tus postulaciones desde un solo tablero.</span>
                    </li>
                </ul>
            </div>

        </aside>

        <main class="cuenta-contenido" id="contenido">
            <div class="cuenta-barra">
                <a class="enlace enlace-principal" asp-controller="Home" asp-action="Index"><icono nombre="arrow-left" tamano="18" />Volver al inicio</a>
                @await RenderSectionAsync("Barra", required: false)
            </div>
            <div class="cuenta-formulario">
                @RenderBody()
            </div>
        </main>
    </div>

    <partial name="_AvisoCookies" />
    <div class="toast-container" aria-live="polite" data-snackbars data-mensaje="@TempData["Mensaje"]" data-mensaje-tipo="@TempData["MensajeTipo"]"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
