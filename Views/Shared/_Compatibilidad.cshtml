@model Oferta
<section class="compatibilidad" aria-label="Compatibilidad con tu perfil">
    <div class="compatibilidad__cabecera">
        <strong class="compatibilidad__titulo">@Model.Match% de compatibilidad</strong>
        <span class="etiqueta @(Model.Match >= 90 ? "" : Model.Match >= 80 ? "etiqueta--principal" : "etiqueta--advertencia")">@Model.MatchNivel</span>
    </div>
    <div class="progreso" role="progressbar" aria-valuenow="@Model.Match" aria-valuemin="0" aria-valuemax="100" aria-label="Compatibilidad">
        <span class="progreso__barra" style="--valor: @(Model.Match)%"></span>
    </div>
    <p class="compatibilidad__texto">@Model.MatchResumen</p>
</section>
