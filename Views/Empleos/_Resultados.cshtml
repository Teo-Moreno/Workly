@if (ViewBag.Busqueda.Ofertas.Count == 0)
{
    <div class="vacio">
        @if (ViewBag.Busqueda.BuscoAlgo)
        {
            <h3>No encontramos ningún puesto con ese nombre</h3>
            <p>Revisá cómo lo escribiste, probá con otra palabra@(ViewBag.Busqueda.HayFiltros ? ", sacá algún filtro o buscá en todo el país" : " o con un puesto más general").</p>
            @if (ViewBag.Busqueda.HayFiltros)
            {
                <a class="btn-outline theme-primary boton" asp-controller="Empleos" asp-action="Index" asp-route-Q="@ViewBag.Busqueda.Q">Buscar sin filtros</a>
            }
        }
        else
        {
            <h3>No encontramos ofertas@(ViewBag.Busqueda.HayFiltros ? " con esos filtros" : "")</h3>
            <p>Escribí arriba el puesto que buscás@(ViewBag.Busqueda.HayFiltros ? ", sacá algún filtro o buscá en todo el país" : "").</p>
        }
    </div>
}
else
{
    <div class="grilla-ofertas">
        @foreach (Oferta oferta in ViewBag.Busqueda.Ofertas)
        {
            <partial name="_OfertaTarjeta" model="oferta" />
        }
    </div>
    <div class="paginas">
        @if (ViewBag.Busqueda.Pagina > 1)
        {
            <a class="btn-outline theme-primary boton" href="@ViewBag.Busqueda.UrlPagina(ViewBag.Busqueda.Pagina - 1)">← Anterior</a>
        }
        @if (ViewBag.Busqueda.HayMas)
        {
            <a class="btn-outline theme-primary boton" href="@ViewBag.Busqueda.UrlPagina(ViewBag.Busqueda.Pagina + 1)">Ver más →</a>
        }
    </div>
}
