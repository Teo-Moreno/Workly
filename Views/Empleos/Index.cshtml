@{
    ViewData["Title"] = "Buscar trabajo";
}

<div class="container seccion-app">
    <header class="encabezado-pagina">
        <h1 class="encabezado-pagina-titulo">Buscar trabajo</h1>
        <p class="encabezado-pagina-bajada">Buscamos en las búsquedas publicadas en Workly y en otros sitios de empleo a la vez.</p>
    </header>

    <form class="buscador buscador-app" id="form-buscar" asp-controller="Empleos" asp-action="Index" method="get" role="search" data-cargando="#resultados-busqueda">
        <label class="buscador-campo">
            <icono nombre="search" />
            <span class="buscador-textos">
                <span class="buscador-etiqueta">Puesto o palabra clave</span>
                <input class="buscador-input" type="search" name="Q" value="@ViewBag.Busqueda.Q" autocomplete="off" placeholder="¿Qué trabajo buscás?" maxlength="100" />
            </span>
        </label>
        <span class="buscador-divisor" aria-hidden="true"></span>
        <div class="buscador-campo" data-ubicacion>
            <icono nombre="near-me" />
            <span class="buscador-textos">
                <label class="buscador-etiqueta" for="buscar-pais">País</label>
                <select class="buscador-select" id="buscar-pais" name="IDPais" data-selector-pais data-seleccion>
                    @foreach (Pais pais in ViewBag.Busqueda.Paises)
                    {
                        <option value="@pais.ID" selected="@(pais.ID == ViewBag.Busqueda.IDPais)">@pais.Nombre</option>
                    }
                </select>
            </span>
        </div>
        <span class="buscador-divisor" aria-hidden="true"></span>
        <div class="buscador-campo">
            <icono nombre="building" />
            <span class="buscador-textos">
                <label class="buscador-etiqueta" for="buscar-provincia">Provincia</label>
                <select class="buscador-select" id="buscar-provincia" name="IDProvincia" data-selector-provincia data-seleccion>
                    <option value="">Todo el país</option>
                    @foreach (Provincia provincia in ViewBag.Busqueda.Provincias)
                    {
                        <option value="@provincia.ID" data-pais="@provincia.IDPais" selected="@(provincia.ID == ViewBag.Busqueda.IDProvincia)">@provincia.Nombre</option>
                    }
                </select>
            </span>
        </div>
        <button class="btn buscador-boton" type="submit"><icono nombre="search" />Buscar</button>
    </form>

    <div class="buscar">
        <button class="btn buscar-ver-filtros" type="button" data-bs-toggle="collapse" data-bs-target="#filtros" aria-expanded="false" aria-controls="filtros">
            <icono nombre="filter-outline" />Filtros@(ViewBag.Busqueda.CantidadFiltros > 0 ? $" ({ViewBag.Busqueda.CantidadFiltros})" : "")
        </button>

        <aside class="filtros collapse" id="filtros" aria-label="Filtros de búsqueda">
            <div class="filtros-cabecera">
                <h2 class="filtros-titulo">Filtros</h2>
                @if (ViewBag.Busqueda.CantidadFiltros > 0)
                {
                    <a class="btn btn-link" asp-controller="Empleos" asp-action="Index" asp-route-Q="@ViewBag.Busqueda.Q" asp-route-IDPais="@ViewBag.Busqueda.IDPais" asp-route-IDProvincia="@ViewBag.Busqueda.IDProvincia" data-cargando="#resultados-busqueda">Limpiar</a>
                }
            </div>

            <fieldset class="filtros-grupo">
                <legend class="filtros-subtitulo">Modalidad</legend>
                @foreach (var modalidad in Catalogos.Modalidades)
                {
                    <label class="filtros-opcion">
                        <span class="form-check">
                            <input class="form-check-input" type="checkbox" form="form-buscar" name="Modalidad" value="@modalidad" checked="@ViewBag.Busqueda.Modalidad.Contains(modalidad)" data-enviar-al-cambiar />
                            <span class="form-check-label">@modalidad</span>
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="filtros-grupo">
                <legend class="filtros-subtitulo">Tipo de empleo</legend>
                @foreach (var (tipo, _) in Catalogos.TiposEmpleo)
                {
                    <label class="filtros-opcion">
                        <span class="form-check">
                            <input class="form-check-input" type="checkbox" form="form-buscar" name="Tipo" value="@tipo" checked="@ViewBag.Busqueda.Tipo.Contains(tipo)" data-enviar-al-cambiar />
                            <span class="form-check-label">@tipo</span>
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="filtros-grupo">
                <legend class="filtros-subtitulo">Fecha de publicación</legend>
                <label class="filtros-opcion">
                    <span class="form-check">
                        <input class="form-check-input" type="radio" form="form-buscar" name="Fecha" value="" checked="@(ViewBag.Busqueda.Fecha == null)" data-enviar-al-cambiar />
                        <span class="form-check-label">Cualquier fecha</span>
                    </span>
                </label>
                @foreach (var (valor, texto, _) in Catalogos.FechasPublicacion)
                {
                    <label class="filtros-opcion">
                        <span class="form-check">
                            <input class="form-check-input" type="radio" form="form-buscar" name="Fecha" value="@valor" checked="@(ViewBag.Busqueda.Fecha == valor)" data-enviar-al-cambiar />
                            <span class="form-check-label">@texto</span>
                        </span>
                    </label>
                }
            </fieldset>

            <noscript><button class="btn btn-block" type="submit" form="form-buscar">Aplicar filtros</button></noscript>
        </aside>

        <section class="resultados esta-buscando" id="resultados-busqueda" aria-labelledby="resultados-titulo" aria-busy="true" data-resultados-url="@ViewBag.UrlResultados" data-resultados-detalles="#detalles-busqueda">
            <div class="resultados-cabecera">
                <h2 class="resultados-titulo" id="resultados-titulo" data-resultados-titulo>@ViewBag.Busqueda.TituloCargando</h2>
                <div class="ordenar">
                    <label for="buscar-orden">Ordenar por:</label>
                    <select class="form-select form-select-sm" id="buscar-orden" form="form-buscar" name="Orden" data-enviar-al-cambiar data-seleccion="seleccion-derecha">
                        @foreach (var (valor, texto) in Catalogos.Ordenes)
                        {
                            <option value="@valor" selected="@(ViewBag.Busqueda.Orden == valor)">@texto</option>
                        }
                    </select>
                </div>
            </div>

            <partial name="_CargandoResultados" model='"Buscando ofertas…"' />
            <div data-resultados-contenido></div>
        </section>

        <div class="buscar-detalle" id="detalles-busqueda" data-detalles hidden></div>
    </div>
</div>
