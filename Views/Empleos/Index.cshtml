@{
    ViewData["Title"] = "Buscar trabajo";
}

<div class="container seccion">
    <h1 class="titulo">Buscar trabajo</h1>
    <p class="texto-suave">Te mostramos las búsquedas publicadas en Workly y las ofertas de otros sitios de empleo.</p>

    <form asp-controller="Empleos" asp-action="Index" method="get">
        <div class="buscador buscador-app">
            <div class="form-field">
                <label class="form-label" for="buscar-q">Puesto o palabra clave</label>
                <input class="form-control" id="buscar-q" type="text" name="Q" value="@ViewBag.Busqueda.Q" autocomplete="off" placeholder="¿Qué trabajo buscás?">
            </div>
            <div class="form-field">
                <label class="form-label" for="buscar-provincia">Provincia</label>
                <select class="form-control" id="buscar-provincia" name="IDProvincia">
                    @foreach (Provincia provincia in ViewBag.Busqueda.Provincias)
                    {
                        if (provincia.ID == ViewBag.Busqueda.IDProvincia)
                        {
                            <option value="@provincia.ID">@provincia.Nombre</option>
                        }
                    }
                    <option value="">Todo el país</option>
                    @foreach (Provincia provincia in ViewBag.Busqueda.Provincias)
                    {
                        if (provincia.ID != ViewBag.Busqueda.IDProvincia)
                        {
                            <option value="@provincia.ID">@provincia.Nombre</option>
                        }
                    }
                </select>
            </div>
            <button class="btn-solid theme-primary boton boton-acento" type="submit">Buscar</button>
        </div>

        <div class="buscar">
            <div>
                <details class="accordion-item filtros" open>
                    <summary class="accordion-header">Filtros@(ViewBag.Busqueda.CantidadFiltros > 0 ? $" ({ViewBag.Busqueda.CantidadFiltros})" : "")</summary>
                    <div class="accordion-body">
                        <p class="form-label">Modalidad</p>
                        @foreach (var modalidad in Catalogos.Modalidades)
                        {
                            <label class="casilla"><input type="checkbox" name="Modalidad" value="@modalidad" checked="@ViewBag.Busqueda.Modalidad.Contains(modalidad)"> @modalidad</label>
                        }

                        <p class="form-label">Tipo de empleo</p>
                        @foreach (var (tipo, _) in Catalogos.TiposEmpleo)
                        {
                            <label class="casilla"><input type="checkbox" name="Tipo" value="@tipo" checked="@ViewBag.Busqueda.Tipo.Contains(tipo)"> @tipo</label>
                        }

                        <p class="form-label">Fecha de publicación</p>
                        <label class="casilla"><input type="radio" name="Fecha" value="" checked="@(ViewBag.Busqueda.Fecha == null)"> Cualquier fecha</label>
                        @foreach (var (valor, texto, _) in Catalogos.FechasPublicacion)
                        {
                            <label class="casilla"><input type="radio" name="Fecha" value="@valor" checked="@(ViewBag.Busqueda.Fecha == valor)"> @texto</label>
                        }

                        <p class="form-label">Ordenar por</p>
                        @foreach (var (valor, texto) in Catalogos.Ordenes)
                        {
                            <label class="casilla"><input type="radio" name="Orden" value="@valor" checked="@(ViewBag.Busqueda.Orden == valor)"> @texto</label>
                        }

                        <button class="btn-solid theme-primary boton w-100" type="submit">Aplicar filtros</button>
                        @if (ViewBag.Busqueda.CantidadFiltros > 0)
                        {
                            <a class="boton-link" asp-controller="Empleos" asp-action="Index" asp-route-Q="@ViewBag.Busqueda.Q" asp-route-IDProvincia="@ViewBag.Busqueda.IDProvincia">Limpiar filtros</a>
                        }
                    </div>
                </details>
            </div>

            <section>
                <h2 class="subtitulo">@ViewBag.Busqueda.Titulo</h2>
                <partial name="_Resultados" />
            </section>
        </div>
    </form>
</div>
