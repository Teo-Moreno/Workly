@{
    ViewData["Title"] = "Buscar trabajo";
}

<div class="container espacio-abajo">
    <header class="bloque-titulo">
        <h1 class="titulo">Buscar trabajo</h1>
        <p class="subtitulo">Te mostramos las búsquedas publicadas en Workly y las ofertas de otros sitios de empleo.</p>
    </header>

    <form class="barra-sombra-borde" id="form-buscar" action="/Empleos" method="get" role="search">
        <label class="barra-sombra-campo">
            <icono nombre="search" />
            <span class="barra-sombra-textos">
                <span class="barra-sombra-rotulo">Puesto o palabra clave</span>
                <input class="control-plano" type="search" name="Q" value="@ViewBag.Busqueda.Q" autocomplete="off" placeholder="¿Qué trabajo buscás?" maxlength="100" />
            </span>
        </label>
        <span class="barra-sombra-divisor" aria-hidden="true"></span>
        <div class="barra-sombra-campo" data-ubicacion>
            <icono nombre="near-me" />
            <span class="barra-sombra-textos">
                <label class="barra-sombra-rotulo" for="buscar-pais">País</label>
                <select class="control-plano-flecha" id="buscar-pais" name="IDPais" data-selector-pais data-seleccion>
                    @foreach (Pais pais in ViewBag.Busqueda.Paises)
                    {
                        <option value="@pais.ID" selected="@(pais.ID == ViewBag.Busqueda.IDPais)">@pais.Nombre</option>
                    }
                </select>
            </span>
        </div>
        <span class="barra-sombra-divisor" aria-hidden="true"></span>
        <div class="barra-sombra-campo">
            <icono nombre="building" />
            <span class="barra-sombra-textos">
                <label class="barra-sombra-rotulo" for="buscar-provincia">Provincia</label>
                <select class="control-plano-flecha" id="buscar-provincia" name="IDProvincia" data-selector-provincia data-seleccion>
                    <option value="">Todo el país</option>
                    @foreach (Provincia provincia in ViewBag.Busqueda.Provincias)
                    {
                        <option value="@provincia.ID" data-pais="@provincia.IDPais" selected="@(provincia.ID == ViewBag.Busqueda.IDProvincia)">@provincia.Nombre</option>
                    }
                </select>
            </span>
        </div>
        <button class="btn btn-fijo" type="submit"><icono nombre="search" />Buscar</button>
    </form>

    <div class="grilla-lateral">
        <button class="btn btn-solo-celu" type="button" data-bs-toggle="collapse" data-bs-target="#filtros" aria-expanded="false" aria-controls="filtros">
            <icono nombre="filter-outline" />Filtros@(ViewBag.Busqueda.CantidadFiltros > 0 ? $" ({ViewBag.Busqueda.CantidadFiltros})" : "")
        </button>

        <aside class="panel-lateral collapse" id="filtros" aria-label="Filtros de búsqueda">
            <div class="panel-lateral-fila">
                <h2 class="subtitulo-chico">Filtros</h2>
                @if (ViewBag.Busqueda.CantidadFiltros > 0)
                {
                    <a class="btn btn-link" href="@ViewBag.UrlLimpiar">Limpiar</a>
                }
            </div>

            <fieldset class="panel-lateral-grupo">
                <legend class="panel-lateral-subtitulo">Modalidad</legend>
                @foreach (var modalidad in Catalogos.Modalidades)
                {
                    <label class="panel-lateral-opcion">
                        <span class="form-check">
                            <input class="form-check-input" type="checkbox" form="form-buscar" name="Modalidad" value="@modalidad" checked="@ViewBag.Busqueda.Modalidad.Contains(modalidad)" data-enviar-al-cambiar />
                            <span class="form-check-label">@modalidad</span>
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="panel-lateral-grupo">
                <legend class="panel-lateral-subtitulo">Tipo de empleo</legend>
                @foreach (var (tipo, _) in Catalogos.TiposEmpleo)
                {
                    <label class="panel-lateral-opcion">
                        <span class="form-check">
                            <input class="form-check-input" type="checkbox" form="form-buscar" name="Tipo" value="@tipo" checked="@ViewBag.Busqueda.Tipo.Contains(tipo)" data-enviar-al-cambiar />
                            <span class="form-check-label">@tipo</span>
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="panel-lateral-grupo">
                <legend class="panel-lateral-subtitulo">Fecha de publicación</legend>
                <label class="panel-lateral-opcion">
                    <span class="form-check">
                        <input class="form-check-input" type="radio" form="form-buscar" name="Fecha" value="" checked="@(ViewBag.Busqueda.Fecha == null)" data-enviar-al-cambiar />
                        <span class="form-check-label">Cualquier fecha</span>
                    </span>
                </label>
                @foreach (var (valor, texto, _) in Catalogos.FechasPublicacion)
                {
                    <label class="panel-lateral-opcion">
                        <span class="form-check">
                            <input class="form-check-input" type="radio" form="form-buscar" name="Fecha" value="@valor" checked="@(ViewBag.Busqueda.Fecha == valor)" data-enviar-al-cambiar />
                            <span class="form-check-label">@texto</span>
                        </span>
                    </label>
                }
            </fieldset>

            <noscript><button class="btn btn-block" type="submit" form="form-buscar">Aplicar filtros</button></noscript>
        </aside>

        <section class="zona-resultados" id="resultados-busqueda" aria-labelledby="resultados-titulo">
            <div class="fila-entre-chica">
                <h2 class="titulo-oscuro" id="resultados-titulo">@ViewBag.Busqueda.Titulo</h2>
                <div class="fila-gris">
                    <label for="buscar-orden">Ordenar por:</label>
                    <select class="form-select form-select-sm" id="buscar-orden" form="form-buscar" name="Orden" data-enviar-al-cambiar data-seleccion="seleccion-derecha">
                        @foreach (var (valor, texto) in Catalogos.Ordenes)
                        {
                            <option value="@valor" selected="@(ViewBag.Busqueda.Orden == valor)">@texto</option>
                        }
                    </select>
                </div>
            </div>

            @if (ViewBag.Busqueda.Ofertas.Count == 0)
            {
                <div class="recuadro-punteado">
                    <span class="caja-icono-lg"><icono nombre="search" /></span>
                    @if (ViewBag.Busqueda.BuscoAlgo)
                    {
                        <h3 class="recuadro-punteado-titulo">No encontramos ningún puesto con ese nombre</h3>
                        <p>Revisá cómo lo escribiste, probá con otra palabra@(ViewBag.Busqueda.HayFiltros ? ", sacá algún filtro o buscá en todo el país" : " o con un puesto más general").</p>
                        @if (ViewBag.Busqueda.HayFiltros)
                        {
                            <a class="btn btn-outline-primary" href="@ViewBag.UrlSinFiltros">Buscar sin filtros</a>
                        }
                    }
                    else
                    {
                        <h3 class="recuadro-punteado-titulo">No encontramos ofertas@(ViewBag.Busqueda.HayFiltros ? " con esos filtros" : "")</h3>
                        <p>Escribí arriba el puesto que buscás@(ViewBag.Busqueda.HayFiltros ? ", sacá algún filtro o buscá en todo el país" : "").</p>
                    }
                </div>
            }
            else
            {
                <div class="grilla-tres">
                    @foreach (Oferta oferta in ViewBag.Busqueda.Ofertas)
                    {
                        <partial name="_OfertaTarjeta" model="oferta" />
                    }
                </div>
                @if (ViewBag.Busqueda.Pagina > 1 || ViewBag.Busqueda.HayMas)
                {
                    <nav class="fila-centrada-separada" aria-label="Páginas de resultados">
                        @if (ViewBag.Busqueda.Pagina > 1)
                        {
                            <a class="btn btn-outline-primary" href="@ViewBag.Busqueda.UrlPagina(ViewBag.Busqueda.Pagina - 1)"><icono nombre="arrow-left" />Anterior</a>
                        }
                        @if (ViewBag.Busqueda.HayMas)
                        {
                            <a class="btn btn-primary" href="@ViewBag.Busqueda.UrlPagina(ViewBag.Busqueda.Pagina + 1)">Siguiente<icono nombre="arrow-right" /></a>
                        }
                    </nav>
                }
            }
        </section>
    </div>
</div>
