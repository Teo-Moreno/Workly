@model BuscarTrabajoViewModel
@{
    ViewData["Title"] = "Buscar trabajo";
    // URL actual sin la oferta elegida, para armar los enlaces de las tarjetas y volver después de postularse
    var consulta = Context.Request.Query.Where(q => q.Key != "id").SelectMany(q => q.Value.Select(v => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(v ?? "")}")).ToList();
    string ConOferta(string clave) => Url.Action("Index", "Empleos") + "?" + string.Join("&", consulta.Append("id=" + clave));
    var volver = Context.Request.Path + Context.Request.QueryString;
    var titulo = Model.Ofertas.Count == 0 ? "Sin resultados"
        : $"{Model.Ofertas.Count} {(Model.Ofertas.Count == 1 ? "oferta" : "ofertas")}" + (Model.BuscoAlgo ? $" para “{Model.Q}”" : "");
}
@* Buscar trabajo (Figma › Media · WF 02 · Buscar trabajo): búsquedas de Workly + de otros sitios (JSearch) *@

<div class="contenedor seccion-app">
    <header class="encabezado-pagina">
        <h1 class="encabezado-pagina__titulo">Buscar trabajo</h1>
        <p class="encabezado-pagina__bajada">Buscamos en las búsquedas publicadas en Workly y en otros sitios de empleo a la vez.</p>
    </header>

    <form class="buscador buscador--app" id="form-buscar" asp-controller="Empleos" asp-action="Index" method="get" role="search">
        <label class="buscador__campo">
            <icono nombre="search" />
            <span class="buscador__textos">
                <span class="buscador__etiqueta">Puesto o palabra clave</span>
                <input class="buscador__input" type="search" name="Q" value="@Model.Q" autocomplete="off" placeholder="¿Qué trabajo buscás?" maxlength="100" />
            </span>
        </label>
        <span class="buscador__divisor" aria-hidden="true"></span>
        <div class="buscador__campo" data-ubicacion>
            <icono nombre="near-me" />
            <span class="buscador__textos">
                <label class="buscador__etiqueta" for="buscar-pais">País</label>
                <select class="buscador__input buscador__select" id="buscar-pais" name="IDPais" data-selector-pais>
                    @foreach (var pais in Model.Paises)
                    {
                        <option value="@pais.ID" selected="@(pais.ID == Model.IDPais)">@pais.Nombre</option>
                    }
                </select>
            </span>
        </div>
        <span class="buscador__divisor" aria-hidden="true"></span>
        <label class="buscador__campo">
            <icono nombre="building" />
            <span class="buscador__textos">
                <span class="buscador__etiqueta">Provincia</span>
                <select class="buscador__input buscador__select" name="IDProvincia" data-selector-provincia>
                    <option value="">Todo el país</option>
                    @foreach (var provincia in Model.Provincias)
                    {
                        <option value="@provincia.ID" data-pais="@provincia.IDPais" selected="@(provincia.ID == Model.IDProvincia)">@provincia.Nombre</option>
                    }
                </select>
            </span>
        </label>
        <button class="boton boton--lg buscador__boton" type="submit"><icono nombre="search" />Buscar</button>
    </form>

    <div class="buscar">
        <button class="boton boton--contorno buscar__ver-filtros" type="button" aria-expanded="false" aria-controls="filtros" data-alternar="filtros">
            <icono nombre="filter-outline" />Filtros@(Model.CantidadFiltros > 0 ? $" ({Model.CantidadFiltros})" : "")
        </button>

        <aside class="filtros" id="filtros" aria-label="Filtros de búsqueda">
            <div class="filtros__cabecera">
                <h2 class="filtros__titulo">Filtros</h2>
                @if (Model.CantidadFiltros > 0)
                {
                    <a class="boton boton--texto" asp-controller="Empleos" asp-action="Index" asp-route-Q="@Model.Q" asp-route-IDPais="@Model.IDPais" asp-route-IDProvincia="@Model.IDProvincia">Limpiar</a>
                }
            </div>

            <fieldset class="filtros__grupo">
                <legend class="filtros__subtitulo">Modalidad</legend>
                @foreach (var modalidad in Catalogos.Modalidades)
                {
                    <label class="filtros__opcion">
                        <span class="casilla casilla--sm">
                            <input type="checkbox" form="form-buscar" name="Modalidad" value="@modalidad" checked="@Model.Modalidad.Contains(modalidad)" data-enviar-al-cambiar />
                            <span class="casilla__caja"><icono nombre="check" /></span>
                            @modalidad
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="filtros__grupo">
                <legend class="filtros__subtitulo">Tipo de empleo</legend>
                @foreach (var (tipo, _) in Catalogos.TiposEmpleo)
                {
                    <label class="filtros__opcion">
                        <span class="casilla casilla--sm">
                            <input type="checkbox" form="form-buscar" name="Tipo" value="@tipo" checked="@Model.Tipo.Contains(tipo)" data-enviar-al-cambiar />
                            <span class="casilla__caja"><icono nombre="check" /></span>
                            @tipo
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="filtros__grupo">
                <legend class="filtros__subtitulo">Fecha de publicación</legend>
                <label class="filtros__opcion">
                    <span class="opcion opcion--sm">
                        <input type="radio" form="form-buscar" name="Fecha" value="" checked="@(Model.Fecha == null)" data-enviar-al-cambiar />
                        <span class="opcion__circulo"></span>
                        Cualquier fecha
                    </span>
                </label>
                @foreach (var (valor, texto, _) in Catalogos.FechasPublicacion)
                {
                    <label class="filtros__opcion">
                        <span class="opcion opcion--sm">
                            <input type="radio" form="form-buscar" name="Fecha" value="@valor" checked="@(Model.Fecha == valor)" data-enviar-al-cambiar />
                            <span class="opcion__circulo"></span>
                            @texto
                        </span>
                    </label>
                }
            </fieldset>

            <noscript><button class="boton boton--bloque" type="submit" form="form-buscar">Aplicar filtros</button></noscript>
        </aside>

        <section class="resultados" aria-labelledby="resultados-titulo">
            <div class="resultados__cabecera">
                <h2 class="resultados__titulo" id="resultados-titulo">@titulo</h2>
                <div class="ordenar">
                    <label for="buscar-orden">Ordenar por:</label>
                    <select class="campo__control campo__control--sm" id="buscar-orden" form="form-buscar" name="Orden" data-enviar-al-cambiar>
                        @foreach (var (valor, texto) in Catalogos.Ordenes)
                        {
                            <option value="@valor" selected="@(Model.Orden == valor)">@texto</option>
                        }
                    </select>
                </div>
            </div>

            @if (Model.ErrorExternas)
            {
                <partial name="_AvisoExternas" />
            }
            @if (!Model.BuscoAlgo && Model.Ofertas.Count > 0)
            {
                <p class="texto-chico texto-suave">Estas son las búsquedas publicadas en Workly. Escribí un puesto para buscar también en otros sitios.</p>
            }

            @if (Model.Ofertas.Count == 0)
            {
                <div class="estado-vacio">
                    <span class="caja-icono caja-icono--lg"><icono nombre="search" /></span>
                    @if (Model.BuscoAlgo)
                    {
                        <h3 class="estado-vacio__titulo">No encontramos ningún puesto con ese nombre</h3>
                        <p>Revisá cómo lo escribiste, probá con otra palabra@(Model.CantidadFiltros > 0 || Model.IDProvincia != null ? ", sacá algún filtro o buscá en todo el país" : " o con un puesto más general").</p>
                        @if (Model.CantidadFiltros > 0 || Model.IDProvincia != null)
                        {
                            <a class="boton boton--contorno" asp-controller="Empleos" asp-action="Index" asp-route-Q="@Model.Q">Buscar sin filtros</a>
                        }
                    }
                    else
                    {
                        <h3 class="estado-vacio__titulo">Todavía no hay búsquedas publicadas en Workly@(Model.CantidadFiltros > 0 || Model.IDProvincia != null ? " con esos filtros" : "")</h3>
                        <p>Escribí arriba el puesto que buscás y te mostramos también las ofertas de otros sitios.</p>
                    }
                </div>
            }
            else
            {
                <div class="resultados__lista" data-resultados>
                    @foreach (var oferta in Model.Ofertas)
                    {
                        <partial name="_OfertaTarjeta" model="oferta" view-data='new ViewDataDictionary(ViewData) { { "Seleccionada", oferta == Model.Seleccionada } }' />
                    }
                </div>
                @if (Model.CursorSiguiente != null)
                {
                    <div class="resultados__mas">
                        <a class="boton boton--contorno" href="@(Url.Action("Index", "Empleos") + "?" + string.Join("&", consulta.Where(c => !c.StartsWith("Cursor=")).Append("Cursor=" + Uri.EscapeDataString(Model.CursorSiguiente))))">Ver más ofertas de otros sitios</a>
                    </div>
                }
            }
        </section>

        @if (Model.Ofertas.Count > 0)
        {
            <div class="buscar__detalle" data-detalles>
                @foreach (var oferta in Model.Ofertas)
                {
                    <partial name="_OfertaDetallePanel" model="oferta" view-data='new ViewDataDictionary(ViewData) { { "Visible", oferta == Model.Seleccionada }, { "Volver", ConOferta(oferta.Clave) } }' />
                }
            </div>
        }
    </div>
</div>
