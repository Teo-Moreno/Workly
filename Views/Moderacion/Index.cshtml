@model ModeracionViewModel
@{
    ViewData["Title"] = "Moderación";
    var es = new System.Globalization.CultureInfo("es-AR");
}

<div class="contenedor seccion-app">
    <header class="encabezado-pagina">
        <h1 class="encabezado-pagina__titulo">Moderación</h1>
        <p class="encabezado-pagina__bajada">Revisá las búsquedas que publicaron las personas. Si la aceptás se publica con las demás; si la rechazás, quien la publicó ve el motivo.</p>
    </header>

    <section aria-labelledby="pendientes-titulo">
        <h2 class="texto-titulo-4" id="pendientes-titulo">Para revisar (@Model.Pendientes.Count)</h2>
        @if (Model.Pendientes.Count == 0)
        {
            <div class="estado-vacio estado-vacio--chico"><p>No hay búsquedas esperando revisión.</p></div>
        }
        else
        {
            <ul class="lista-publicaciones" role="list">
                @foreach (var oferta in Model.Pendientes)
                {
                    <li class="publicacion">
                        <div class="publicacion__datos">
                            <h3 class="publicacion__titulo"><a asp-controller="Moderacion" asp-action="Revisar" asp-route-id="@oferta.ID">@oferta.Titulo</a></h3>
                            <p class="publicacion__meta">@oferta.Empresa@(oferta.UbicacionVisible != null ? " · " + oferta.UbicacionVisible : "") · enviada el @oferta.Fecha_Publicacion?.ToString("d 'de' MMMM", es)</p>
                        </div>
                        <a class="boton boton--sm" asp-controller="Moderacion" asp-action="Revisar" asp-route-id="@oferta.ID">Revisar</a>
                    </li>
                }
            </ul>
        }
    </section>

    @if (Model.Revisadas.Count > 0)
    {
        <section aria-labelledby="revisadas-titulo">
            <h2 class="texto-titulo-4" id="revisadas-titulo">Revisadas hace poco</h2>
            <ul class="lista-publicaciones" role="list">
                @foreach (var oferta in Model.Revisadas)
                {
                    <li class="publicacion">
                        <div class="publicacion__datos">
                            <h3 class="publicacion__titulo"><a asp-controller="Moderacion" asp-action="Revisar" asp-route-id="@oferta.ID">@oferta.Titulo</a></h3>
                            <p class="publicacion__meta">@oferta.Empresa</p>
                            @if (oferta.Estado_Publicacion == "Rechazada") { <p class="publicacion__motivo"><strong>Motivo:</strong> @oferta.Motivo_Rechazo</p> }
                        </div>
                        <span class="etiqueta etiqueta--@(oferta.Estado_Publicacion == "Aprobada" ? "exito" : "error")">@(oferta.Estado_Publicacion == "Aprobada" ? "Aceptada" : "Rechazada")</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>
