@{
    ViewData["Title"] = "Mis postulaciones";
}

<div class="container espacio-abajo">
    <header class="bloque-titulo">
        <div class="fila-titulo">
            <div>
                <h1 class="titulo">Mis postulaciones</h1>
                <p class="subtitulo">Mové cada tarjeta a medida que avanza el proceso: arrastrala a otra columna o elegí la etapa en la tarjeta.</p>
            </div>
            <div class="acciones">
                <a class="btn btn-primary" href="/Empleos"><icono nombre="search" />Buscar trabajo</a>
            </div>
        </div>
    </header>

    @if (!ViewBag.HayPostulaciones)
    {
        <div class="recuadro-punteado">
            <span class="caja-icono-lg"><icono nombre="send" /></span>
            <h2 class="recuadro-punteado-titulo">Todavía no tenés postulaciones</h2>
            <p>Cuando te postules a una búsqueda de Workly, o toques "Ya me postulé" en una de otro sitio, aparece acá para que le hagas el seguimiento.</p>
            <a class="btn btn-primary" href="/Empleos"><icono nombre="search" />Buscar trabajo</a>
        </div>
    }
    else
    {
        <div class="columnas-scroll" data-tablero data-url-estado="/Postulaciones/CambiarEstado">
            @Html.AntiForgeryToken()
            @foreach (ColumnaTablero columna in ViewBag.Columnas)
            {
                <section class="columna-gris" data-columna="@columna.Estado" aria-labelledby="columna-@columna.Color">
                    <header class="columna-gris-fila">
                        <span class="punto-@columna.Color" aria-hidden="true"></span>
                        <h2 class="columna-gris-titulo" id="columna-@columna.Color" data-columna-nombre>@columna.Nombre</h2>
                        <span class="contador" data-columna-contador>@columna.Tarjetas.Count</span>
                    </header>
                    <div class="columna-gris-lista" data-columna-lista>
                        @foreach (PostulacionItem postulacion in columna.Tarjetas)
                        {
                            <partial name="_PostulacionTarjeta" model="postulacion" />
                        }
                        <p class="columna-gris-vacio" hidden="@(columna.Tarjetas.Count == 0 ? null : "hidden")">Arrastrá una tarjeta acá</p>
                    </div>
                </section>
            }
        </div>
    }
</div>
