@{
    ViewData["Title"] = "Mis postulaciones";
}

<div class="container seccion">
    <div class="encabezado">
        <div>
            <h1 class="titulo">Mis postulaciones</h1>
            <p class="texto-suave">A medida que avanza cada proceso, elegí la etapa en la tarjeta y tocá "Mover".</p>
        </div>
        <a class="btn-solid theme-primary boton" asp-controller="Empleos" asp-action="Index">Buscar trabajo</a>
    </div>

    @if (!ViewBag.HayPostulaciones)
    {
        <div class="vacio">
            <h2>Todavía no tenés postulaciones</h2>
            <p>Cuando te postules a una búsqueda de Workly, o toques "Ya me postulé" en una de otro sitio, aparece acá para que le hagas el seguimiento.</p>
            <a class="btn-solid theme-primary boton" asp-controller="Empleos" asp-action="Index">Buscar trabajo</a>
        </div>
    }
    else
    {
        <div class="tablero">
            @foreach (ColumnaTablero columna in ViewBag.Columnas)
            {
                <section class="tablero-columna">
                    <h2 class="tablero-titulo"><span class="punto punto-@columna.Color"></span>@columna.Nombre <span class="badge contador">@columna.Tarjetas.Count</span></h2>
                    <ul class="list-group">
                        @foreach (PostulacionItem postulacion in columna.Tarjetas)
                        {
                            <partial name="_PostulacionTarjeta" model="postulacion" />
                        }
                    </ul>
                    @if (columna.Tarjetas.Count == 0)
                    {
                        <p class="texto-suave">No hay postulaciones en esta etapa.</p>
                    }
                </section>
            }
        </div>
    }
</div>
