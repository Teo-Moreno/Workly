@model List<PostulacionItem>
@{
    ViewData["Title"] = "Mis postulaciones";
}
@* Mis postulaciones (Figma › Media · WF 03 · Postulaciones): tablero que mueve la persona *@

<div class="contenedor seccion-app">
    <header class="encabezado-pagina">
        <div class="encabezado-pagina__fila">
            <div>
                <h1 class="encabezado-pagina__titulo">Mis postulaciones</h1>
                <p class="encabezado-pagina__bajada">Mové cada tarjeta a medida que avanza el proceso: arrastrala a otra columna o elegí la etapa en la tarjeta.</p>
            </div>
            <div class="encabezado-pagina__acciones">
                <a class="boton" asp-controller="Empleos" asp-action="Index"><icono nombre="search" />Buscar trabajo</a>
            </div>
        </div>
    </header>

    @if (Model.Count == 0)
    {
        <div class="estado-vacio">
            <span class="caja-icono caja-icono--lg"><icono nombre="send" /></span>
            <h2 class="estado-vacio__titulo">Todavía no tenés postulaciones</h2>
            <p>Cuando te postules a una búsqueda de Workly, o toques "Ya me postulé" en una de otro sitio, aparece acá para que le hagas el seguimiento.</p>
            <a class="boton" asp-controller="Empleos" asp-action="Index"><icono nombre="search" />Buscar trabajo</a>
        </div>
    }
    else
    {
        <div class="tablero" data-tablero data-url-estado="@Url.Action("CambiarEstado", "Postulaciones")">
            @Html.AntiForgeryToken()
            @foreach (var (estado, columna, color) in Catalogos.EstadosPostulacion)
            {
                var tarjetas = Model.Where(p => p.Estado == estado).ToList();
                <section class="tablero__columna @(tarjetas.Count == 0 ? "esta-vacia" : "")" data-columna="@estado" aria-labelledby="columna-@color">
                    <header class="tablero__cabecera">
                        <span class="punto punto--@color" aria-hidden="true"></span>
                        <h2 class="tablero__titulo" id="columna-@color" data-columna-nombre>@columna</h2>
                        <span class="tablero__contador" data-columna-contador>@tarjetas.Count</span>
                    </header>
                    <div class="tablero__lista" data-columna-lista>
                        @foreach (var postulacion in tarjetas)
                        {
                            <partial name="_PostulacionTarjeta" model="postulacion" />
                        }
                        <p class="tablero__vacio">Arrastrá una tarjeta acá</p>
                    </div>
                </section>
            }
        </div>
    }
</div>
