@{
    ViewData["Title"] = "Configuración";
}

<div class="container seccion angosto">
    <nav aria-label="Estás en">
        <ol class="migas">
            <li>
                    @if (ViewBag.EsEmpresa && ViewBag.Perfil.Empresa != null)
                    {
                        <a asp-controller="Empresas" asp-action="Detalle" asp-route-id="@ViewBag.Perfil.Empresa.ID">@ViewBag.Perfil.Empresa.Nombre</a>
                    }
                    else
                    {
                        <a asp-controller="Perfil" asp-action="Index">Mi perfil</a>
                    }
            </li>
            <li aria-current="page">Configuración</li>
        </ol>
    </nav>
    <h1 class="titulo">Configuración</h1>
    <p class="texto-suave">@(ViewBag.EsEmpresa ? "Actualizá los datos de la empresa y de tu cuenta." : "Actualizá tus datos, lo que estás buscando y tu contraseña.")</p>

    <div class="configuracion">
        <ul class="nav nav-tabs pestanas" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(ViewBag.Activa == "cuenta" ? "active" : "")" id="tab-cuenta" data-bs-toggle="tab" data-bs-target="#panel-cuenta" type="button" role="tab" aria-controls="panel-cuenta" aria-selected="@(ViewBag.Activa == "cuenta" ? "true" : "false")">@(ViewBag.EsEmpresa ? "Empresa" : "Cuenta")</button>
            </li>
            @if (!ViewBag.EsEmpresa)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ViewBag.Activa == "busqueda" ? "active" : "")" id="tab-busqueda" data-bs-toggle="tab" data-bs-target="#panel-busqueda" type="button" role="tab" aria-controls="panel-busqueda" aria-selected="@(ViewBag.Activa == "busqueda" ? "true" : "false")">Qué busco</button>
                </li>
            }
            <li class="nav-item" role="presentation">
                <button class="nav-link @(ViewBag.Activa == "seguridad" ? "active" : "")" id="tab-seguridad" data-bs-toggle="tab" data-bs-target="#panel-seguridad" type="button" role="tab" aria-controls="panel-seguridad" aria-selected="@(ViewBag.Activa == "seguridad" ? "true" : "false")">Seguridad</button>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Perfil" asp-action="Ayuda">Ayuda</a>
            </li>
        </ul>

        <div class="tab-content">
        <section class="tab-pane @(ViewBag.Activa == "cuenta" ? "show active" : "")" id="panel-cuenta" role="tabpanel" aria-labelledby="tab-cuenta" tabindex="0">
            @if (!ViewBag.EsEmpresa)
            {
                <form class="formulario card tarjeta" asp-controller="Perfil" asp-action="GuardarCuenta" method="post" enctype="multipart/form-data">
                    <div>
                        <h2 class="subtitulo" id="titulo-cuenta">Datos personales</h2>
                        <p class="texto-suave">Estos datos los ven quienes publican una búsqueda cuando te postulás.</p>
                    </div>

                    <div class="form-field @Html.ClaseError("Foto")">
                        <label class="form-label" for="cfg-foto">Foto de perfil <span class="opcional">(JPG, PNG o WEBP de hasta 5 MB)</span></label>
                        @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto))
                        {
                            <img class="foto-perfil foto-perfil-xl" src="@ViewBag.Perfil.Perfil.Foto" alt="Tu foto actual">
                        }
                        <input class="form-control" id="cfg-foto" type="file" name="Foto">
                        <p class="error-texto">@Html.MensajeError("Foto", "Subí una imagen JPG, PNG o WEBP de hasta 5 MB")</p>
                    </div>

                    <div class="dos-columnas">
                        <div class="form-field @Html.ClaseError("Nombre")">
                            <label class="form-label" for="cfg-nombre">Nombre</label>
                            <input class="form-control" id="cfg-nombre" name="Nombre" value="@(ViewBag.FormularioCuenta?.Nombre ?? ViewBag.Perfil.Usuario.Nombre)" required autocomplete="given-name">
                            <p class="error-texto">@Html.MensajeError("Nombre", "Completá tu nombre")</p>
                        </div>
                        <div class="form-field @Html.ClaseError("Apellido")">
                            <label class="form-label" for="cfg-apellido">Apellido</label>
                            <input class="form-control" id="cfg-apellido" name="Apellido" value="@(ViewBag.FormularioCuenta?.Apellido ?? ViewBag.Perfil.Usuario.Apellido)" required autocomplete="family-name">
                            <p class="error-texto">@Html.MensajeError("Apellido", "Completá tu apellido")</p>
                        </div>
                    </div>

                    <div class="dos-columnas">
                        <div class="form-field @Html.ClaseError("Email")">
                            <label class="form-label" for="cfg-email">Email</label>
                            <input class="form-control" id="cfg-email" name="Email" type="email" value="@(ViewBag.FormularioCuenta?.Email ?? ViewBag.Perfil.Usuario.Email)" required autocomplete="email">
                            <p class="error-texto">@Html.MensajeError("Email", "Ingresá un email válido")</p>
                        </div>
                        <partial name="_CampoTelefono" model='new CampoTelefono { Id = "cfg-telefono", Valor = ViewBag.FormularioCuenta?.Telefono ?? Telefonos.ParteLocal(ViewBag.Perfil.Perfil.Telefono, ViewBag.Perfil.Perfil.Codigo_Telefono), Prefijo = ViewBag.CodigoPais }' />
                    </div>

                    <partial name="_CampoUbicacion" model='new CampoUbicacion { Prefijo = "cfg-", Paises = ViewBag.Perfil.Paises, Provincias = ViewBag.Perfil.Provincias, IDPais = ViewBag.IDPais, IDProvincia = ViewBag.FormularioCuenta?.IDProvincia ?? ViewBag.Perfil.Perfil.IDProvincia, EtiquetaProvincia = "Provincia donde vivís" }' />

                    <div class="form-field @Html.ClaseError("SitioWeb")">
                        <label class="form-label" for="cfg-web">Sitio web, portfolio o LinkedIn <span class="opcional">(opcional)</span></label>
                        <input class="form-control" id="cfg-web" name="SitioWeb" value="@(ViewBag.FormularioCuenta?.SitioWeb ?? ViewBag.Perfil.CV?.Sitio_Web)" placeholder="linkedin.com/in/tu-nombre">
                        <p class="error-texto">@Html.MensajeError("SitioWeb", "Usá hasta 200 caracteres")</p>
                    </div>

                    <div class="form-field @Html.ClaseError("ArchivoCV")">
                        <label class="form-label" for="cfg-cv">CV <span class="opcional">(PDF, DOC o DOCX de hasta 5 MB)</span></label>
                        @if (ViewBag.Perfil.TieneCV)
                        {
                            <p class="texto-suave">Tu CV actual: <a asp-controller="Perfil" asp-action="DescargarCV">@ViewBag.Perfil.CV.NombreOriginal</a>. Si elegís otro, lo reemplaza.</p>
                        }
                        <input class="form-control" id="cfg-cv" type="file" name="ArchivoCV">
                        <p class="error-texto">@Html.MensajeError("ArchivoCV", "Subí un archivo PDF, DOC o DOCX de hasta 5 MB")</p>
                    </div>

                    <div class="acciones">
                        <button class="btn-solid theme-primary boton" type="submit">Guardar cambios</button>
                    </div>
                </form>
            }
            else if (ViewBag.Perfil.Empresa != null)
            {
                <form class="formulario card tarjeta" asp-controller="Perfil" asp-action="GuardarEmpresa" method="post" enctype="multipart/form-data">
                    <div>
                        <h2 class="subtitulo" id="titulo-cuenta">Datos de la empresa</h2>
                        <p class="texto-suave">Se muestran en la página de la empresa y en sus búsquedas. El CUIT (@VerificacionEmpresa.Formatear(ViewBag.Perfil.Empresa.CUIT ?? "")) y la razón social (@ViewBag.Perfil.Empresa.Razon_Social) no se pueden cambiar.</p>
                    </div>

                    <div class="form-field @Html.ClaseError("Logo")">
                        <label class="form-label" for="cfg-logo">Logo <span class="opcional">(JPG, PNG o WEBP de hasta 5 MB)</span></label>
                        <partial name="_LogoEmpresa" model='new LogoEmpresa(ViewBag.Perfil.Empresa.Logo, ViewBag.Perfil.Empresa.Nombre, "logo-empresa-lg")' />
                        <input class="form-control" id="cfg-logo" type="file" name="Logo">
                        <p class="error-texto">@Html.MensajeError("Logo", "Subí una imagen JPG, PNG o WEBP de hasta 5 MB")</p>
                    </div>

                    <div class="dos-columnas">
                        <div class="form-field @Html.ClaseError("NombreEmpresa")">
                            <label class="form-label" for="cfg-empresa">Nombre de la empresa</label>
                            <input class="form-control" id="cfg-empresa" name="NombreEmpresa" value="@(ViewBag.FormularioEmpresa?.NombreEmpresa ?? ViewBag.Perfil.Empresa.Nombre)" required>
                            <p class="error-texto">@Html.MensajeError("NombreEmpresa", "Completá el nombre de la empresa")</p>
                        </div>
                        <div class="form-field @Html.ClaseError("Rubro")">
                            <label class="form-label" for="cfg-rubro">Rubro</label>
                            <select class="form-control" id="cfg-rubro" name="Rubro" required>
                                <partial name="_Opciones" model='new OpcionesSelect((string?)(ViewBag.FormularioEmpresa?.Rubro ?? ViewBag.Perfil.Empresa.Rubro), Catalogos.Rubros, "Elegí el rubro")' />
                            </select>
                            <p class="error-texto">@Html.MensajeError("Rubro", "Elegí el rubro")</p>
                        </div>
                    </div>

                    <div class="form-field @Html.ClaseError("SitioWeb")">
                        <label class="form-label" for="cfg-web">Sitio web</label>
                        <input class="form-control" id="cfg-web" name="SitioWeb" value="@(ViewBag.FormularioEmpresa?.SitioWeb ?? ViewBag.Perfil.Empresa.Sitio_Web)" required>
                        <p class="form-text">Tiene que ser del dominio de tu email (@VerificacionEmpresa.DominioDelEmail(ViewBag.Perfil.Usuario.Email)).</p>
                        <p class="error-texto">@Html.MensajeError("SitioWeb", "Ingresá el sitio web de la empresa")</p>
                    </div>

                    <partial name="_CampoUbicacion" model='new CampoUbicacion { Prefijo = "cfg-", Paises = ViewBag.Perfil.Paises, Provincias = ViewBag.Perfil.Provincias, IDPais = ViewBag.IDPais, IDProvincia = ViewBag.FormularioEmpresa?.IDProvincia ?? ViewBag.Perfil.Empresa.IDProvincia, EtiquetaProvincia = "Provincia de la sede" }' />

                    <div class="dos-columnas">
                        <div class="form-field @Html.ClaseError("Ubicacion")">
                            <label class="form-label" for="cfg-ubicacion">Localidad o dirección <span class="opcional">(opcional)</span></label>
                            <input class="form-control" id="cfg-ubicacion" name="Ubicacion" value="@(ViewBag.FormularioEmpresa?.Ubicacion ?? ViewBag.Perfil.Empresa.Ubicacion)" placeholder="Ej.: Palermo, CABA">
                            <p class="error-texto">@Html.MensajeError("Ubicacion", "Usá hasta 100 caracteres")</p>
                        </div>
                        <partial name="_CampoTelefono" model='new CampoTelefono { Id = "cfg-telefono", Valor = ViewBag.FormularioEmpresa?.Telefono ?? Telefonos.ParteLocal(ViewBag.Perfil.Empresa.Telefono, ViewBag.CodigoGuardado), Prefijo = ViewBag.CodigoPais }' />
                    </div>

                    <div class="form-field @Html.ClaseError("Descripcion")">
                        <label class="form-label" for="cfg-descripcion">¿Qué hace la empresa?</label>
                        <textarea class="form-control" id="cfg-descripcion" name="Descripcion" rows="4" required>@(ViewBag.FormularioEmpresa?.Descripcion ?? ViewBag.Perfil.Empresa.Descripcion)</textarea>
                        <p class="error-texto">@Html.MensajeError("Descripcion", "Contá en pocas líneas qué hace la empresa")</p>
                    </div>

                    <h3 class="form-label">Quién maneja la cuenta</h3>
                    <div class="dos-columnas">
                        <div class="form-field @Html.ClaseError("Nombre")">
                            <label class="form-label" for="cfg-nombre">Tu nombre</label>
                            <input class="form-control" id="cfg-nombre" name="Nombre" value="@(ViewBag.FormularioEmpresa?.Nombre ?? ViewBag.Perfil.Usuario.Nombre)" required>
                            <p class="error-texto">@Html.MensajeError("Nombre", "Completá tu nombre")</p>
                        </div>
                        <div class="form-field @Html.ClaseError("Apellido")">
                            <label class="form-label" for="cfg-apellido">Tu apellido</label>
                            <input class="form-control" id="cfg-apellido" name="Apellido" value="@(ViewBag.FormularioEmpresa?.Apellido ?? ViewBag.Perfil.Usuario.Apellido)" required>
                            <p class="error-texto">@Html.MensajeError("Apellido", "Completá tu apellido")</p>
                        </div>
                    </div>
                    <p class="texto-suave">Email de la cuenta: @ViewBag.Perfil.Usuario.Email (es el que verifica la empresa, no se puede cambiar).</p>

                    <div class="acciones">
                        <button class="btn-solid theme-primary boton" type="submit">Guardar cambios</button>
                    </div>
                </form>
            }
        </section>

        @if (!ViewBag.EsEmpresa)
        {
            <section class="tab-pane @(ViewBag.Activa == "busqueda" ? "show active" : "")" id="panel-busqueda" role="tabpanel" aria-labelledby="tab-busqueda" tabindex="0">
                <form class="formulario card tarjeta" asp-controller="Perfil" asp-action="GuardarBusqueda" method="post">
                    <div>
                        <h2 class="subtitulo" id="titulo-busqueda">Qué busco</h2>
                        <p class="texto-suave">Con esto armamos las ofertas de tu inicio. Completá solo lo que tengas claro.</p>
                    </div>
                    <partial name="_CamposBusqueda" model="ViewBag.CamposBusqueda" />
                    <div class="acciones">
                        <button class="btn-solid theme-primary boton" type="submit">Guardar</button>
                    </div>
                </form>
            </section>
        }

        <section class="tab-pane @(ViewBag.Activa == "seguridad" ? "show active" : "")" id="panel-seguridad" role="tabpanel" aria-labelledby="tab-seguridad" tabindex="0">
            <form class="formulario card tarjeta" asp-controller="Perfil" asp-action="CambiarClave" method="post">
                <div>
                    <h2 class="subtitulo" id="titulo-seguridad">@(ViewBag.Perfil.Usuario.TieneContrasena ? "Cambiar contraseña" : "Crear una contraseña")</h2>
                    @if (!ViewBag.Perfil.Usuario.TieneContrasena)
                    {
                        <p class="texto-suave">Entrás con @string.Join(" y ", ViewBag.Perfil.ProveedoresVinculados). Si creás una contraseña, también vas a poder entrar con tu email.</p>
                    }
                    else if (ViewBag.Perfil.ProveedoresVinculados.Count > 0)
                    {
                        <p class="texto-suave">También podés entrar con @string.Join(" y ", ViewBag.Perfil.ProveedoresVinculados).</p>
                    }
                </div>

                @if (ViewBag.Perfil.Usuario.TieneContrasena)
                {
                    <div class="form-field @Html.ClaseError("Actual")">
                        <label class="form-label" for="clave-actual">Contraseña actual</label>
                        <input class="form-control" id="clave-actual" name="Actual" type="password" autocomplete="current-password" required>
                        <p class="error-texto">@Html.MensajeError("Actual", "Ingresá tu contraseña actual")</p>
                    </div>
                }
                <div class="dos-columnas">
                    <div class="form-field @Html.ClaseError("Nueva")">
                        <label class="form-label" for="clave-nueva">Contraseña nueva</label>
                        <input class="form-control" id="clave-nueva" name="Nueva" type="password" autocomplete="new-password"
                                   required>
                        <p class="form-text">Al menos 8 caracteres, con letras y números.</p>
                        <p class="error-texto">@Html.MensajeError("Nueva", "Usá al menos 8 caracteres, con una letra y un número")</p>
                    </div>
                    <div class="form-field @Html.ClaseError("Repetir")">
                        <label class="form-label" for="clave-repetir">Repetí la contraseña nueva</label>
                        <input class="form-control" id="clave-repetir" name="Repetir" type="password" autocomplete="new-password" required>
                        <p class="error-texto">@Html.MensajeError("Repetir", "Las contraseñas no coinciden")</p>
                    </div>
                </div>
                <div class="acciones">
                    <button class="btn-solid theme-primary boton" type="submit">@(ViewBag.Perfil.Usuario.TieneContrasena ? "Cambiar contraseña" : "Crear contraseña")</button>
                </div>
            </form>

            <form class="formulario card tarjeta peligro" asp-controller="Perfil" asp-action="EliminarCuenta" method="post">
                <div>
                    <h2 class="subtitulo">Eliminar la cuenta</h2>
                    <p class="texto-suave">
                        @(ViewBag.EsEmpresa
                            ? "Se borran tu cuenta, las búsquedas de la empresa y sus postulaciones. No se puede deshacer."
                            : "Se borran tu perfil, tu CV, tus postulaciones y las búsquedas que publicaste. No se puede deshacer.")
                    </p>
                </div>
                <div class="form-field">
                    <label class="form-label" for="confirmar-eliminar">Para confirmar, escribí ELIMINAR</label>
                    <input class="form-control" id="confirmar-eliminar" name="confirmacion" autocomplete="off" required>
                    <p class="error-texto">Escribí ELIMINAR en mayúsculas</p>
                </div>
                <div class="acciones">
                    <button class="btn-solid theme-primary boton boton-peligro" type="submit">Eliminar mi cuenta</button>
                </div>
            </form>
        </section>
        </div>
    </div>
</div>
