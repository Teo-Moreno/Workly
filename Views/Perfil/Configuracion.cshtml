@model MiPerfilViewModel
@{
    ViewData["Title"] = "Configuración";
    var usuario = Model.Usuario;
    var perfil = Model.Perfil;
    var empresa = Model.Empresa;
    var esEmpresa = usuario.EsEmpresa;
    var pestanas = esEmpresa ? new[] { "cuenta", "seguridad" } : new[] { "cuenta", "busqueda", "seguridad" };
    var pedida = ViewBag.Pestana as string ?? Context.Request.Query["pestana"].ToString();
    var activa = pestanas.Contains(pedida) ? pedida : "cuenta";

    var fCuenta = ViewBag.Formulario as CuentaFormulario;
    var fEmpresa = ViewBag.Formulario as EmpresaFormulario;
    var fBusqueda = ViewBag.Formulario as BusquedaFormulario;

    var idPais = fCuenta?.IDPais ?? fEmpresa?.IDPais ?? (esEmpresa ? empresa?.IDPais : perfil.IDPais) ?? Model.Paises.FirstOrDefault()?.ID;
    var codigoPais = Model.Paises.FirstOrDefault(p => p.ID == idPais)?.Codigo_Telefono ?? "+54";
    var codigoGuardado = Model.Paises.FirstOrDefault(p => p.ID == (esEmpresa ? empresa?.IDPais : perfil.IDPais))?.Codigo_Telefono;
    var vinculados = Model.ProveedoresVinculados;
}

<div class="contenedor seccion-app">
    <header class="encabezado-pagina">
        <nav class="migas migas--chica" aria-label="Estás en">
            @if (esEmpresa && empresa != null)
            {
                <a asp-controller="Empresas" asp-action="Detalle" asp-route-id="@empresa.ID">@empresa.Nombre</a>
            }
            else
            {
                <a asp-controller="Perfil" asp-action="Index">Mi perfil</a>
            }
            <icono nombre="chevron-right" />
            <span aria-current="page">Configuración</span>
        </nav>
        <h1 class="encabezado-pagina__titulo">Configuración</h1>
        <p class="encabezado-pagina__bajada">@(esEmpresa ? "Actualizá los datos de la empresa y de tu cuenta." : "Actualizá tus datos, lo que estás buscando y tu contraseña.")</p>
    </header>

    <div class="configuracion" data-pestanas data-pestanas-hash>
        <nav class="configuracion__menu" aria-label="Secciones de configuración">
            <a class="configuracion__opcion @(activa == "cuenta" ? "esta-activa" : "")" href="#cuenta" data-pestana="cuenta" aria-current="@(activa == "cuenta" ? "true" : null)"><icono nombre="@(esEmpresa ? "building" : "user-square")" />@(esEmpresa ? "Empresa" : "Cuenta")</a>
            @if (!esEmpresa)
            {
                <a class="configuracion__opcion @(activa == "busqueda" ? "esta-activa" : "")" href="#busqueda" data-pestana="busqueda" aria-current="@(activa == "busqueda" ? "true" : null)"><icono nombre="briefcase" />Qué busco</a>
            }
            <a class="configuracion__opcion @(activa == "seguridad" ? "esta-activa" : "")" href="#seguridad" data-pestana="seguridad" aria-current="@(activa == "seguridad" ? "true" : null)"><icono nombre="lock" />Seguridad</a>
            <a class="configuracion__opcion" asp-controller="Perfil" asp-action="Ayuda"><icono nombre="help-circle-outline" />Ayuda y soporte</a>
        </nav>

        <section class="configuracion__panel" data-panel="cuenta" aria-labelledby="titulo-cuenta" hidden="@(activa != "cuenta")">
            @if (!esEmpresa)
            {
                <form class="formulario" asp-controller="Perfil" asp-action="GuardarCuenta" method="post" enctype="multipart/form-data" novalidate data-formulario-real>
                    <div class="configuracion__cabecera">
                        <h2 class="formulario__subtitulo" id="titulo-cuenta">Datos personales</h2>
                        <p class="texto-suave">Estos datos los ven quienes publican una búsqueda cuando te postulás.</p>
                    </div>

                    <div class="campo @Html.ClaseError("Foto")">
                        <div class="configuracion__foto">
                            <span class="avatar avatar--xl" data-vista-foto aria-hidden="true">
                                @if (!string.IsNullOrEmpty(perfil.Foto))
                                {
                                    <img src="@perfil.Foto" alt="" />
                                }
                                else
                                {
                                    @UsuarioActual.Iniciales(usuario.Nombre, usuario.Apellido)
                                }
                            </span>
                            <div class="pila" style="--pila-espacio: 8px">
                                <strong>Foto de perfil</strong>
                                <span class="texto-chico texto-suave">JPG, PNG o WEBP de hasta 5 MB. Se ve mejor si es cuadrada.</span>
                                <label class="boton boton--contorno boton--sm boton--archivo"><icono nombre="upload" />@(string.IsNullOrEmpty(perfil.Foto) ? "Elegir foto" : "Cambiar foto")
                                    <input type="file" name="Foto" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-foto-entrada
                                           data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí una imagen JPG, PNG o WEBP" />
                                </label>
                            </div>
                        </div>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Foto", "Subí una imagen JPG, PNG o WEBP de hasta 5 MB")</span>
                    </div>

                    <div class="formulario__fila">
                        <div class="campo @Html.ClaseError("Nombre")">
                            <label class="campo__etiqueta" for="cfg-nombre">Nombre</label>
                            <input class="campo__control" id="cfg-nombre" name="Nombre" value="@(fCuenta?.Nombre ?? usuario.Nombre)" maxlength="50" required autocomplete="given-name" />
                            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Nombre", "Completá tu nombre")</span>
                        </div>
                        <div class="campo @Html.ClaseError("Apellido")">
                            <label class="campo__etiqueta" for="cfg-apellido">Apellido</label>
                            <input class="campo__control" id="cfg-apellido" name="Apellido" value="@(fCuenta?.Apellido ?? usuario.Apellido)" maxlength="50" required autocomplete="family-name" />
                            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Apellido", "Completá tu apellido")</span>
                        </div>
                    </div>

                    <div class="formulario__fila">
                        <div class="campo @Html.ClaseError("Email")">
                            <label class="campo__etiqueta" for="cfg-email">Email</label>
                            <div class="control-con-icono">
                                <icono nombre="mail" />
                                <input class="campo__control" id="cfg-email" name="Email" type="email" value="@(fCuenta?.Email ?? usuario.Email)" maxlength="100" required autocomplete="email" />
                            </div>
                            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Email", "Ingresá un email válido")</span>
                        </div>
                        <partial name="_CampoTelefono" model='new CampoTelefono { Id = "cfg-telefono", Valor = fCuenta?.Telefono ?? Telefonos.ParteLocal(perfil.Telefono, perfil.Codigo_Telefono), Prefijo = codigoPais }' />
                    </div>

                    <partial name="_CampoUbicacion" model='new CampoUbicacion { Prefijo = "cfg-", Paises = Model.Paises, Provincias = Model.Provincias, IDPais = idPais, IDProvincia = fCuenta?.IDProvincia ?? perfil.IDProvincia, EtiquetaProvincia = "Provincia donde vivís" }' />

                    <div class="campo @Html.ClaseError("SitioWeb")">
                        <label class="campo__etiqueta" for="cfg-web">Sitio web, portfolio o LinkedIn <span class="campo__opcional">(opcional)</span></label>
                        <div class="control-con-icono">
                            <icono nombre="globe" />
                            <input class="campo__control" id="cfg-web" name="SitioWeb" value="@(fCuenta?.SitioWeb ?? Model.CV?.Sitio_Web)" inputmode="url" maxlength="200" placeholder="linkedin.com/in/tu-nombre" />
                        </div>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("SitioWeb", "Usá hasta 200 caracteres")</span>
                    </div>

                    <div class="campo @Html.ClaseError("ArchivoCV")">
                        <span class="campo__etiqueta">CV</span>
                        @if (Model.TieneCV)
                        {
                            <p class="texto-chico">Tu CV actual: <a class="enlace" asp-controller="Perfil" asp-action="DescargarCV">@Model.CV!.NombreOriginal</a>. Si elegís otro, lo reemplaza.</p>
                        }
                        <label class="zona-archivo" data-zona-archivo>
                            <span class="caja-icono"><icono nombre="upload" /></span>
                            <strong class="zona-archivo__nombre" data-zona-archivo-nombre>@(Model.TieneCV ? "Elegí otro CV" : "Arrastrá tu CV acá o hacé clic para subirlo")</strong>
                            <span class="texto-chico">PDF, DOC o DOCX de hasta 5 MB</span>
                            <input type="file" name="ArchivoCV" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                                   data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí un archivo PDF, DOC o DOCX" />
                        </label>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("ArchivoCV", "Subí un archivo PDF, DOC o DOCX de hasta 5 MB")</span>
                    </div>

                    <div class="formulario__acciones">
                        <button class="boton" type="submit">Guardar cambios</button>
                    </div>
                </form>
            }
            else if (empresa != null)
            {
                <form class="formulario" asp-controller="Perfil" asp-action="GuardarEmpresa" method="post" enctype="multipart/form-data" novalidate data-formulario-real>
                    <div class="configuracion__cabecera">
                        <h2 class="formulario__subtitulo" id="titulo-cuenta">Datos de la empresa</h2>
                        <p class="texto-suave">Se muestran en la página de la empresa y en sus búsquedas. El CUIT (@VerificacionEmpresa.Formatear(empresa.CUIT ?? "")) y la razón social (@empresa.Razon_Social) no se pueden cambiar.</p>
                    </div>

                    <div class="campo @Html.ClaseError("Logo")">
                        <div class="configuracion__foto">
                            <span class="logo-empresa logo-empresa--lg" data-vista-foto aria-hidden="true">
                                @if (!string.IsNullOrEmpty(empresa.Logo))
                                {
                                    <img src="@empresa.Logo" alt="" />
                                }
                                else
                                {
                                    @empresa.Iniciales
                                }
                            </span>
                            <div class="pila" style="--pila-espacio: 8px">
                                <strong>Logo</strong>
                                <span class="texto-chico texto-suave">JPG, PNG o WEBP de hasta 5 MB.</span>
                                <label class="boton boton--contorno boton--sm boton--archivo"><icono nombre="upload" />@(string.IsNullOrEmpty(empresa.Logo) ? "Elegir logo" : "Cambiar logo")
                                    <input type="file" name="Logo" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-foto-entrada
                                           data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí una imagen JPG, PNG o WEBP" />
                                </label>
                            </div>
                        </div>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Logo", "Subí una imagen JPG, PNG o WEBP de hasta 5 MB")</span>
                    </div>

                    <div class="formulario__fila">
                        <div class="campo @Html.ClaseError("NombreEmpresa")">
                            <label class="campo__etiqueta" for="cfg-empresa">Nombre de la empresa</label>
                            <input class="campo__control" id="cfg-empresa" name="NombreEmpresa" value="@(fEmpresa?.NombreEmpresa ?? empresa.Nombre)" maxlength="100" required />
                            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("NombreEmpresa", "Completá el nombre de la empresa")</span>
                        </div>
                        <div class="campo @Html.ClaseError("Rubro")">
                            <label class="campo__etiqueta" for="cfg-rubro">Rubro</label>
                            <select class="campo__control" id="cfg-rubro" name="Rubro" required>
                                <option value="">Elegí el rubro</option>
                                @foreach (var rubro in Catalogos.Rubros)
                                {
                                    <option selected="@((fEmpresa?.Rubro ?? empresa.Rubro) == rubro)">@rubro</option>
                                }
                            </select>
                            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Rubro", "Elegí el rubro")</span>
                        </div>
                    </div>

                    <div class="campo @Html.ClaseError("SitioWeb")">
                        <label class="campo__etiqueta" for="cfg-web">Sitio web</label>
                        <div class="control-con-icono">
                            <icono nombre="globe" />
                            <input class="campo__control" id="cfg-web" name="SitioWeb" value="@(fEmpresa?.SitioWeb ?? empresa.Sitio_Web)" inputmode="url" maxlength="200" required />
                        </div>
                        <span class="campo__ayuda">Tiene que ser del dominio de tu email (@VerificacionEmpresa.DominioDelEmail(usuario.Email)).</span>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("SitioWeb", "Ingresá el sitio web de la empresa")</span>
                    </div>

                    <partial name="_CampoUbicacion" model='new CampoUbicacion { Prefijo = "cfg-", Paises = Model.Paises, Provincias = Model.Provincias, IDPais = idPais, IDProvincia = fEmpresa?.IDProvincia ?? empresa.IDProvincia, EtiquetaProvincia = "Provincia de la sede" }' />

                    <div class="formulario__fila">
                        <div class="campo @Html.ClaseError("Ubicacion")">
                            <label class="campo__etiqueta" for="cfg-ubicacion">Localidad o dirección <span class="campo__opcional">(opcional)</span></label>
                            <input class="campo__control" id="cfg-ubicacion" name="Ubicacion" value="@(fEmpresa?.Ubicacion ?? empresa.Ubicacion)" maxlength="100" placeholder="Ej.: Palermo, CABA" />
                            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Ubicacion", "Usá hasta 100 caracteres")</span>
                        </div>
                        <partial name="_CampoTelefono" model='new CampoTelefono { Id = "cfg-telefono", Valor = fEmpresa?.Telefono ?? Telefonos.ParteLocal(empresa.Telefono, codigoGuardado), Prefijo = codigoPais }' />
                    </div>

                    <div class="campo @Html.ClaseError("Descripcion")">
                        <label class="campo__etiqueta" for="cfg-descripcion">¿Qué hace la empresa?</label>
                        <textarea class="campo__control" id="cfg-descripcion" name="Descripcion" rows="4" maxlength="500" required>@(fEmpresa?.Descripcion ?? empresa.Descripcion)</textarea>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Descripcion", "Contá en pocas líneas qué hace la empresa")</span>
                    </div>

                    <h3 class="formulario__subtitulo">Quién maneja la cuenta</h3>
                    <div class="formulario__fila">
                        <div class="campo @Html.ClaseError("Nombre")">
                            <label class="campo__etiqueta" for="cfg-nombre">Tu nombre</label>
                            <input class="campo__control" id="cfg-nombre" name="Nombre" value="@(fEmpresa?.Nombre ?? usuario.Nombre)" maxlength="50" required />
                            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Nombre", "Completá tu nombre")</span>
                        </div>
                        <div class="campo @Html.ClaseError("Apellido")">
                            <label class="campo__etiqueta" for="cfg-apellido">Tu apellido</label>
                            <input class="campo__control" id="cfg-apellido" name="Apellido" value="@(fEmpresa?.Apellido ?? usuario.Apellido)" maxlength="50" required />
                            <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Apellido", "Completá tu apellido")</span>
                        </div>
                    </div>
                    <p class="texto-chico texto-suave">Email de la cuenta: @usuario.Email (es el que verifica la empresa, no se puede cambiar).</p>

                    <div class="formulario__acciones">
                        <button class="boton" type="submit">Guardar cambios</button>
                    </div>
                </form>
            }
        </section>

        @if (!esEmpresa)
        {
            <section class="configuracion__panel" data-panel="busqueda" aria-labelledby="titulo-busqueda" hidden="@(activa != "busqueda")">
                <form class="formulario" asp-controller="Perfil" asp-action="GuardarBusqueda" method="post" novalidate data-formulario-real>
                    <div class="configuracion__cabecera">
                        <h2 class="formulario__subtitulo" id="titulo-busqueda">Qué busco</h2>
                        <p class="texto-suave">Con esto armamos las ofertas de tu inicio. Completá solo lo que tengas claro.</p>
                    </div>
                    <partial name="_CamposBusqueda" model="CamposBusqueda.Desde(Model, fBusqueda)" />
                    <div class="formulario__acciones">
                        <button class="boton" type="submit">Guardar</button>
                    </div>
                </form>
            </section>
        }

        <section class="configuracion__panel" data-panel="seguridad" aria-labelledby="titulo-seguridad" hidden="@(activa != "seguridad")">
            <form class="formulario" asp-controller="Perfil" asp-action="CambiarClave" method="post" novalidate data-formulario-real>
                <div class="configuracion__cabecera">
                    <h2 class="formulario__subtitulo" id="titulo-seguridad">@(usuario.TieneContrasena ? "Cambiar contraseña" : "Crear una contraseña")</h2>
                    @if (!usuario.TieneContrasena)
                    {
                        <p class="texto-suave">Entrás con @string.Join(" y ", vinculados). Si creás una contraseña, también vas a poder entrar con tu email.</p>
                    }
                    else if (vinculados.Count > 0)
                    {
                        <p class="texto-suave">También podés entrar con @string.Join(" y ", vinculados).</p>
                    }
                </div>

                @if (usuario.TieneContrasena)
                {
                    <div class="campo @Html.ClaseError("Actual")">
                        <label class="campo__etiqueta" for="clave-actual">Contraseña actual</label>
                        <div class="control-con-icono">
                            <icono nombre="lock" />
                            <input class="campo__control" id="clave-actual" name="Actual" type="password" autocomplete="current-password" required />
                            <button class="control-con-icono__boton" type="button" aria-label="Mostrar contraseña" aria-pressed="false" data-ver-clave><icono nombre="eye" /></button>
                        </div>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Actual", "Ingresá tu contraseña actual")</span>
                    </div>
                }
                <div class="formulario__fila">
                    <div class="campo @Html.ClaseError("Nueva")">
                        <label class="campo__etiqueta" for="clave-nueva">Contraseña nueva</label>
                        <div class="control-con-icono">
                            <icono nombre="lock" />
                            <input class="campo__control" id="clave-nueva" name="Nueva" type="password" autocomplete="new-password" minlength="8" maxlength="100"
                                   pattern="(?=.*[A-Za-zÁÉÍÓÚÜÑáéíóúüñ])(?=.*\d).{8,}" required />
                            <button class="control-con-icono__boton" type="button" aria-label="Mostrar contraseña" aria-pressed="false" data-ver-clave><icono nombre="eye" /></button>
                        </div>
                        <span class="campo__ayuda">Al menos 8 caracteres, con letras y números.</span>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Nueva", "Usá al menos 8 caracteres, con una letra y un número")</span>
                    </div>
                    <div class="campo @Html.ClaseError("Repetir")">
                        <label class="campo__etiqueta" for="clave-repetir">Repetí la contraseña nueva</label>
                        <div class="control-con-icono">
                            <icono nombre="lock" />
                            <input class="campo__control" id="clave-repetir" name="Repetir" type="password" autocomplete="new-password" required data-igual-a="clave-nueva" />
                        </div>
                        <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />@Html.MensajeError("Repetir", "Las contraseñas no coinciden")</span>
                    </div>
                </div>
                <div class="formulario__acciones">
                    <button class="boton" type="submit">@(usuario.TieneContrasena ? "Cambiar contraseña" : "Crear contraseña")</button>
                </div>
            </form>

            <form class="formulario zona-peligro" asp-controller="Perfil" asp-action="EliminarCuenta" method="post" novalidate>
                <div class="configuracion__cabecera">
                    <h2 class="formulario__subtitulo">Eliminar la cuenta</h2>
                    <p class="texto-suave">
                        @(esEmpresa
                            ? "Se borran tu cuenta, las búsquedas de la empresa y sus postulaciones. No se puede deshacer."
                            : "Se borran tu perfil, tu CV, tus postulaciones y las búsquedas que publicaste. No se puede deshacer.")
                    </p>
                </div>
                <div class="campo">
                    <label class="campo__etiqueta" for="confirmar-eliminar">Para confirmar, escribí ELIMINAR</label>
                    <input class="campo__control" id="confirmar-eliminar" name="confirmacion" autocomplete="off" required pattern="ELIMINAR" />
                    <span class="campo__mensaje campo__mensaje--error"><icono nombre="warning" />Escribí ELIMINAR en mayúsculas</span>
                </div>
                <div class="formulario__acciones">
                    <button class="boton boton--peligro-lleno" type="submit">Eliminar mi cuenta</button>
                </div>
            </form>
        </section>
    </div>
</div>
