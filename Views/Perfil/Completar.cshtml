@{
    ViewData["Title"] = "Completar perfil";
}

<div class="contenedor seccion-app">
    <div class="completar-perfil">
        <header class="encabezado-pagina">
            <nav class="migas migas-chica" aria-label="Estás en">
                <a asp-controller="Perfil" asp-action="Index">Mi perfil</a>
                <icono nombre="chevron-right" />
                <span aria-current="page">Completar perfil</span>
            </nav>
            <h1 class="encabezado-pagina-titulo">Completá tu perfil</h1>
            <p class="encabezado-pagina-bajada">Paso <strong data-paso-actual>1</strong> de @CompletarPerfilViewModel.Pasos.Length. Todo es opcional y lo podés cambiar cuando quieras.</p>
        </header>

        <ol class="pasos registro-pasos" aria-label="Progreso">
            @for (var i = 0; i < CompletarPerfilViewModel.Pasos.Length; i++)
            {
                <li class="pasos-item @(i == 0 ? "esta-actual" : "")" data-paso-indicador>
                    <span class="pasos-circulo"><span class="pasos-numero">@(i + 1)</span><icono nombre="check" /></span>
                    @CompletarPerfilViewModel.Pasos[i]
                </li>
            }
        </ol>

        <partial name="_ErroresFormulario" />

        <form class="registro" asp-controller="Perfil" asp-action="Completar" method="post" enctype="multipart/form-data" novalidate data-pasos-form data-formulario-real>
        <fieldset class="formulario registro-paso" data-paso>
            <legend class="solo-lectores">Paso 1: tus datos</legend>

            <div class="campo @Html.ClaseError("Foto")">
                <span class="campo-etiqueta">Foto de perfil <span class="campo-opcional">(opcional)</span></span>
                <div class="subir-foto">
                    <span class="avatar avatar-xl subir-foto-vista" data-vista-foto aria-hidden="true">
                        @if (!string.IsNullOrEmpty(ViewBag.Completar.FotoActual))
                        {
                            <img src="@ViewBag.Completar.FotoActual" alt="" />
                        }
                        else
                        {
                            <icono nombre="user" tamano="40" />
                        }
                    </span>
                    <div class="pila" style="--pila-espacio: 8px">
                        <label class="boton boton-contorno boton-sm boton-archivo">
                            <icono nombre="upload" />@(string.IsNullOrEmpty(ViewBag.Completar.FotoActual) ? "Elegir foto" : "Cambiar foto")
                            <input id="Foto" name="Foto" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-foto-entrada
                                   data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí una imagen JPG, PNG o WEBP" />
                        </label>
                        <span class="texto-chico texto-suave">JPG, PNG o WEBP de hasta 5 MB.</span>
                    </div>
                </div>
                <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError("Foto", "Subí una imagen JPG, PNG o WEBP")</span>
            </div>

            <partial name="_CampoUbicacion" model='new CampoUbicacion { Prefijo = "cmp-", Paises = ViewBag.Completar.Paises, Provincias = ViewBag.Completar.Provincias, IDPais = ViewBag.Completar.IDPais, IDProvincia = ViewBag.Completar.IDProvincia, EtiquetaProvincia = "Provincia donde vivís", Requerido = false }' />
            <partial name="_CampoTelefono" model='new CampoTelefono { Valor = ViewBag.Completar.Telefono, Prefijo = ViewBag.Completar.PrefijoTelefono }' />

            <fieldset class="formulario-grupo campo @Html.ClaseError("EstadoBusqueda")">
                <legend class="campo-etiqueta">¿Estás buscando trabajo? <span class="campo-opcional">(opcional)</span></legend>
                <div class="opciones-tarjeta">
                    @foreach (var estado in Catalogos.EstadosBusqueda)
                    {
                        <label class="opcion-tarjeta">
                            <input type="radio" name="EstadoBusqueda" value="@estado" checked="@(ViewBag.Completar.EstadoBusqueda == estado)" />
                            <span><span class="opcion-tarjeta-titulo">@estado</span></span>
                        </label>
                    }
                </div>
                <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError("EstadoBusqueda", "Elegí una opción")</span>
            </fieldset>

            <div class="campo @Html.ClaseError("Descripcion")">
                <label class="campo-etiqueta" for="Descripcion">Contanos sobre vos <span class="campo-opcional">(opcional)</span></label>
                <textarea class="campo-control" id="Descripcion" name="Descripcion" rows="4" maxlength="500" placeholder="Qué hacés, qué te gusta y qué tipo de trabajo estás buscando.">@ViewBag.Completar.Descripcion</textarea>
                <span class="campo-ayuda">Aparece en la sección "Sobre mí" de tu perfil. Hasta 500 caracteres.</span>
                <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError("Descripcion", "Usá hasta 500 caracteres")</span>
            </div>

            <div class="registro-acciones">
                <a class="boton boton-texto boton-lg" asp-controller="Panel" asp-action="Index">Lo completo después</a>
                <button class="boton boton-lg" type="button" data-paso-siguiente>Siguiente<icono nombre="arrow-right" /></button>
            </div>
        </fieldset>

        <fieldset class="formulario registro-paso" data-paso hidden>
            <legend class="solo-lectores">Paso 2: qué buscás</legend>
            <p class="texto-suave">Todo es opcional: completá lo que tengas claro.</p>
            <partial name="_CamposBusqueda" model="CamposBusqueda.Desde(ViewBag.Completar)" />
            <div class="registro-acciones">
                <button class="boton boton-contorno boton-lg" type="button" data-paso-anterior><icono nombre="arrow-left" />Atrás</button>
                <button class="boton boton-lg" type="button" data-paso-siguiente>Siguiente<icono nombre="arrow-right" /></button>
            </div>
        </fieldset>

        <fieldset class="formulario registro-paso" data-paso hidden>
            <legend class="solo-lectores">Paso 3: experiencia y formación</legend>
            <p class="texto-suave">Opcional: podés sumarlas ahora o más adelante desde tu perfil.</p>

            <section class="lista-local campo @Html.ClaseError("Experiencias")" aria-labelledby="titulo-exp">
                <div class="lista-local-cabecera">
                    <h2 class="formulario-subtitulo" id="titulo-exp">Experiencia laboral</h2>
                    <button class="boton boton-contorno boton-sm" type="button" data-modal-abrir="modal-experiencia"><icono nombre="plus" />Agregar experiencia</button>
                </div>
                @if (ViewBag.Completar.ExperienciasCargadas.Count > 0)
                {
                    <ul class="lista-local-items" role="list">
                        @foreach (ExperienciaItem x in ViewBag.Completar.ExperienciasCargadas)
                        {
                            <li class="item-local"><div><strong>@x.Puesto</strong><span>@x.Empresa · @x.Periodo</span></div></li>
                        }
                    </ul>
                    <p class="texto-chico texto-suave">Para editar o borrar las que ya cargaste, andá a <a class="enlace" asp-controller="Perfil" asp-action="Index">tu perfil</a>.</p>
                }
                <ul class="lista-local-items" role="list" data-lista-local="experiencia" data-vacio="@(ViewBag.Completar.ExperienciasCargadas.Count > 0 ? "" : "Todavía no agregaste experiencias.")">
                    @foreach (ExperienciaEnviada x in ViewBag.Completar.ExperienciasEnviadas)
                    {
                        <li class="item-local" data-item-local>
                            <div><strong>@x.Puesto</strong><span>@x.Empresa · @x.Inicio – @x.FinTexto</span></div>
                            <input type="hidden" name="ExpPuesto" value="@x.Puesto" /><input type="hidden" name="ExpEmpresa" value="@x.Empresa" />
                            <input type="hidden" name="ExpInicio" value="@x.Inicio" /><input type="hidden" name="ExpFin" value="@x.Fin" />
                            <input type="hidden" name="ExpDescripcion" value="@x.Descripcion" />
                            <button class="boton boton-texto" type="button" data-quitar-item>Quitar</button>
                        </li>
                    }
                </ul>
                <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError("Experiencias", "Revisá las experiencias")</span>
            </section>

            <section class="lista-local campo @Html.ClaseError("Formaciones")" aria-labelledby="titulo-for">
                <div class="lista-local-cabecera">
                    <h2 class="formulario-subtitulo" id="titulo-for">Formación</h2>
                    <button class="boton boton-contorno boton-sm" type="button" data-modal-abrir="modal-formacion"><icono nombre="plus" />Agregar formación</button>
                </div>
                @if (ViewBag.Completar.FormacionesCargadas.Count > 0)
                {
                    <ul class="lista-local-items" role="list">
                        @foreach (FormacionItem f in ViewBag.Completar.FormacionesCargadas)
                        {
                            <li class="item-local"><div><strong>@f.Titulo</strong><span>@f.Institucion · @f.Periodo</span></div></li>
                        }
                    </ul>
                }
                <ul class="lista-local-items" role="list" data-lista-local="formacion" data-vacio="@(ViewBag.Completar.FormacionesCargadas.Count > 0 ? "" : "Todavía no agregaste estudios.")">
                    @foreach (FormacionEnviada f in ViewBag.Completar.FormacionesEnviadas)
                    {
                        <li class="item-local" data-item-local>
                            <div><strong>@f.Titulo</strong><span>@f.Institucion · @f.Inicio – @f.FinTexto</span></div>
                            <input type="hidden" name="ForTitulo" value="@f.Titulo" /><input type="hidden" name="ForInstitucion" value="@f.Institucion" />
                            <input type="hidden" name="ForInicio" value="@f.Inicio" /><input type="hidden" name="ForFin" value="@f.Fin" />
                            <button class="boton boton-texto" type="button" data-quitar-item>Quitar</button>
                        </li>
                    }
                </ul>
                <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError("Formaciones", "Revisá la formación")</span>
            </section>

            <div class="registro-acciones">
                <button class="boton boton-contorno boton-lg" type="button" data-paso-anterior><icono nombre="arrow-left" />Atrás</button>
                <button class="boton boton-lg" type="button" data-paso-siguiente>Siguiente<icono nombre="arrow-right" /></button>
            </div>
        </fieldset>

        <fieldset class="formulario registro-paso" data-paso hidden>
            <legend class="solo-lectores">Paso 4: tu CV</legend>

            <div class="campo @Html.ClaseError("ArchivoCV")">
                <span class="campo-etiqueta">CV <span class="campo-opcional">(opcional, lo podés subir después)</span></span>
                @if (ViewBag.Completar.CVActual != null)
                {
                    <span class="campo-ayuda">Ya subiste: @ViewBag.Completar.CVActual. Si elegís otro, lo reemplazamos.</span>
                }
                <label class="zona-archivo" data-zona-archivo>
                    <span class="caja-icono"><icono nombre="upload" /></span>
                    <strong class="zona-archivo-nombre" data-zona-archivo-nombre>Arrastrá tu CV acá o hacé clic para subirlo</strong>
                    <span class="texto-chico">PDF, DOC o DOCX de hasta 5 MB</span>
                    <input id="ArchivoCV" name="ArchivoCV" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                           data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí un archivo PDF, DOC o DOCX" />
                </label>
                <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError("ArchivoCV", "Subí un archivo PDF, DOC o DOCX")</span>
            </div>

            <div class="campo @Html.ClaseError("SitioWeb")">
                <label class="campo-etiqueta" for="SitioWeb">Sitio web, portfolio o LinkedIn <span class="campo-opcional">(opcional)</span></label>
                <div class="control-con-icono">
                    <icono nombre="globe" />
                    <input class="campo-control" id="SitioWeb" name="SitioWeb" value="@ViewBag.Completar.SitioWeb" type="text" inputmode="url" autocomplete="url" placeholder="linkedin.com/in/tu-nombre" maxlength="200" />
                </div>
                <span class="campo-mensaje campo-mensaje-error"><icono nombre="warning" />@Html.MensajeError("SitioWeb", "Usá hasta 200 caracteres")</span>
            </div>

            @if (ViewBag.Completar.Foto != null || ViewBag.Completar.ArchivoCV != null)
            {
                <p class="texto-chico texto-suave">Por seguridad, si hubo un error tenés que volver a elegir la foto y el CV.</p>
            }

            <div class="registro-acciones">
                <button class="boton boton-contorno boton-lg" type="button" data-paso-anterior><icono nombre="arrow-left" />Atrás</button>
                <button class="boton boton-acento boton-lg" type="submit">Guardar perfil</button>
            </div>
        </fieldset>
        </form>
    </div>
</div>

<partial name="_ModalExperiencia" model="new ModalExperiencia(false, null, null)" />
<partial name="_ModalFormacion" model="new ModalFormacion(false, null, ViewBag.Completar.Instituciones, null)" />
