@{
    ViewData["Title"] = "Completar perfil";
}

<div class="container seccion angosto">
    <nav aria-label="Estás en">
        <ol class="migas">
            <li><a asp-controller="Perfil" asp-action="Index">Mi perfil</a></li>
            <li aria-current="page">Completar perfil</li>
        </ol>
    </nav>
    <h1 class="titulo">Completá tu perfil</h1>
    <p class="texto-suave">Todo es opcional y lo podés cambiar cuando quieras.</p>

    <partial name="_ErroresFormulario" />

    <form class="formulario" asp-controller="Perfil" asp-action="Completar" method="post" enctype="multipart/form-data">
        <section class="card tarjeta">
            <h2 class="subtitulo">1. Tus datos</h2>

            <div class="form-field @Html.ClaseError("Foto")">
                <label class="form-label" for="Foto">Foto de perfil <span class="opcional">(opcional)</span></label>
                @if (!string.IsNullOrEmpty(ViewBag.Completar.FotoActual))
                {
                    <img class="foto-perfil foto-perfil-xl" src="@ViewBag.Completar.FotoActual" alt="Tu foto actual">
                }
                <input class="form-control" id="Foto" name="Foto" type="file">
                <p class="form-text">JPG, PNG o WEBP de hasta 5 MB.</p>
                <p class="error-texto">@Html.MensajeError("Foto", "Subí una imagen JPG, PNG o WEBP")</p>
            </div>

            <partial name="_CampoUbicacion" model='new CampoUbicacion { Prefijo = "cmp-", Paises = ViewBag.Completar.Paises, Provincias = ViewBag.Completar.Provincias, IDPais = ViewBag.Completar.IDPais, IDProvincia = ViewBag.Completar.IDProvincia, EtiquetaProvincia = "Provincia donde vivís", Requerido = false }' />
            <partial name="_CampoTelefono" model='new CampoTelefono { Valor = ViewBag.Completar.Telefono, Prefijo = ViewBag.Completar.PrefijoTelefono }' />

            <div class="form-field @Html.ClaseError("Descripcion")">
                <label class="form-label" for="Descripcion">Contanos sobre vos <span class="opcional">(opcional)</span></label>
                <textarea class="form-control" id="Descripcion" name="Descripcion" rows="4" placeholder="Qué hacés, qué te gusta y qué tipo de trabajo estás buscando.">@ViewBag.Completar.Descripcion</textarea>
                <p class="form-text">Aparece en la sección "Sobre mí" de tu perfil. Hasta 500 caracteres.</p>
                <p class="error-texto">@Html.MensajeError("Descripcion", "Usá hasta 500 caracteres")</p>
            </div>
        </section>

        <section class="card tarjeta">
            <h2 class="subtitulo">2. Qué buscás</h2>
            <partial name="_CamposBusqueda" model="CamposBusqueda.Desde(ViewBag.Completar)" />
        </section>

        <section class="card tarjeta @Html.ClaseError("Experiencias")">
            <h2 class="subtitulo">3. Experiencia laboral</h2>
            @if (ViewBag.Completar.ExperienciasCargadas.Count > 0)
            {
                <ul class="list-group linea">
                    @foreach (ExperienciaItem x in ViewBag.Completar.ExperienciasCargadas)
                    {
                        <li class="list-group-item"><span class="negrita">@x.Puesto</span> · @x.Empresa · @x.Periodo</li>
                    }
                </ul>
                <p class="texto-suave">Para editar o borrar las que ya cargaste, andá a <a asp-controller="Perfil" asp-action="Index">tu perfil</a>.</p>
            }
            <p class="texto-suave">Dejá la fila vacía si no querés sumar ninguna. Podés agregar más después desde tu perfil.</p>
            @foreach (ExperienciaEnviada x in ViewBag.Completar.ExperienciasEnviadas)
            {
                <partial name="_FilaExperiencia" model="x" />
            }
            <partial name="_FilaExperiencia" model='new ExperienciaEnviada("", "", "", "", "")' />
            <p class="error-texto">@Html.MensajeError("Experiencias", "Revisá las experiencias")</p>
        </section>

        <section class="card tarjeta @Html.ClaseError("Formaciones")">
            <h2 class="subtitulo">4. Formación</h2>
            @if (ViewBag.Completar.FormacionesCargadas.Count > 0)
            {
                <ul class="list-group linea">
                    @foreach (FormacionItem f in ViewBag.Completar.FormacionesCargadas)
                    {
                        <li class="list-group-item"><span class="negrita">@f.Titulo</span> · @f.Institucion · @f.Periodo</li>
                    }
                </ul>
            }
            <p class="texto-suave">Dejá la fila vacía si no querés sumar ninguna.</p>
            @foreach (FormacionEnviada f in ViewBag.Completar.FormacionesEnviadas)
            {
                <partial name="_FilaFormacion" model="f" />
            }
            <partial name="_FilaFormacion" model='new FormacionEnviada("", "", "", "")' />
            <p class="error-texto">@Html.MensajeError("Formaciones", "Revisá la formación")</p>
        </section>

        <section class="card tarjeta">
            <h2 class="subtitulo">5. Tu CV</h2>
            <div class="form-field @Html.ClaseError("ArchivoCV")">
                <label class="form-label" for="ArchivoCV">CV <span class="opcional">(opcional, lo podés subir después)</span></label>
                @if (ViewBag.Completar.CVActual != null)
                {
                    <p class="form-text">Ya subiste: @ViewBag.Completar.CVActual. Si elegís otro, lo reemplazamos.</p>
                }
                <input class="form-control" id="ArchivoCV" name="ArchivoCV" type="file">
                <p class="form-text">PDF, DOC o DOCX de hasta 5 MB.</p>
                <p class="error-texto">@Html.MensajeError("ArchivoCV", "Subí un archivo PDF, DOC o DOCX")</p>
            </div>

            <div class="form-field @Html.ClaseError("SitioWeb")">
                <label class="form-label" for="SitioWeb">Sitio web, portfolio o LinkedIn <span class="opcional">(opcional)</span></label>
                <input class="form-control" id="SitioWeb" name="SitioWeb" value="@ViewBag.Completar.SitioWeb" type="text" autocomplete="url" placeholder="linkedin.com/in/tu-nombre">
                <p class="error-texto">@Html.MensajeError("SitioWeb", "Usá hasta 200 caracteres")</p>
            </div>

            @if (ViewBag.Completar.Foto != null || ViewBag.Completar.ArchivoCV != null)
            {
                <p class="texto-suave">Por seguridad, si hubo un error tenés que volver a elegir la foto y el CV.</p>
            }
        </section>

        <div class="acciones">
            <a class="boton-link" asp-controller="Panel" asp-action="Index">Lo completo después</a>
            <button class="btn-solid theme-primary boton boton-acento" type="submit">Guardar perfil</button>
        </div>
    </form>
</div>
