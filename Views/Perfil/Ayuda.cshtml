@{
    ViewData["Title"] = "Ayuda y soporte";
}

<section class="hero hero-chico">
    <div class="container">
        <span class="badge etiqueta etiqueta-acento">Centro de ayuda</span>
        <h1 class="hero-titulo">¿En qué te podemos ayudar?</h1>
    </div>
</section>

<div class="container seccion">
    <ul class="categorias">
        @foreach (var categoria in Ayuda.Categorias)
        {
            <li>
                <a class="card tarjeta" href="#@categoria.Id">
                    <span class="negrita">@categoria.Nombre</span>
                    <span class="texto-suave">@categoria.Texto</span>
                </a>
            </li>
        }
    </ul>

    <h2 class="subtitulo">Preguntas frecuentes</h2>
    @foreach (var categoria in Ayuda.Categorias)
    {
        <h3 class="grupo-preguntas" id="@categoria.Id">@categoria.Nombre</h3>
        <div class="accordion info">
            @foreach (var item in Ayuda.PreguntasDe(categoria.Id))
            {
                <details class="accordion-item" name="@categoria.Id">
                    <summary class="accordion-header">
                        @item.Pregunta
                        <svg class="accordion-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m2 5 6 6 6-6"/></svg>
                    </summary>
                    <div class="accordion-body">@item.Respuesta</div>
                </details>
            }
        </div>
    }
</div>
