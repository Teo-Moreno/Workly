@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container seccion">
    <div class="perfil-cabecera">
        <span class="foto-perfil foto-perfil-xl" aria-hidden="true">
            @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto))
            {
                <img src="@ViewBag.Perfil.Perfil.Foto" alt="">
            }
            else
            {
                @ViewBag.Perfil.Iniciales
            }
        </span>

        <div class="perfil-cabecera-datos">
            <h1 class="titulo">@ViewBag.Perfil.Usuario.NombreCompleto</h1>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Preferencia.Puesto_Buscado))
            {
                <p>Busca trabajo de @ViewBag.Perfil.Preferencia.Puesto_Buscado</p>
            }
            <ul class="contacto">
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Ubicacion)) { <li>@ViewBag.Perfil.Perfil.Ubicacion</li> }
                <li><a href="mailto:@ViewBag.Perfil.Usuario.Email">@ViewBag.Perfil.Usuario.Email</a></li>
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Telefono)) { <li><a href="tel:@ViewBag.Perfil.Perfil.TelefonoLink">@ViewBag.Perfil.Perfil.Telefono</a></li> }
                @if (ViewBag.Perfil.EnlaceSitio != null) { <li><a href="@ViewBag.Perfil.EnlaceSitio" target="_blank" rel="noopener noreferrer">@ViewBag.Perfil.CV.Sitio_Web</a></li> }
            </ul>

            <form class="estado-busqueda" asp-controller="Perfil" asp-action="GuardarEstado" method="post">
                <label class="form-label" for="estado-busqueda">Estado</label>
                <select class="form-control" id="estado-busqueda" name="estado">
                    <partial name="_Opciones" model='new OpcionesSelect((string?)ViewBag.Perfil.Perfil.Estado_Busqueda, Catalogos.EstadosBusqueda, ViewBag.Perfil.Perfil.Estado_Busqueda == null ? "Elegí tu estado" : null)' />
                </select>
                <button class="btn-outline theme-primary boton btn-sm" type="submit">Guardar</button>
            </form>
        </div>

        <div class="acciones">
            @if (ViewBag.Perfil.TieneCV)
            {
                <a class="btn-outline theme-primary boton" asp-controller="Perfil" asp-action="DescargarCV">Descargar CV</a>
            }
            <a class="btn-solid theme-primary boton" asp-controller="Perfil" asp-action="Configuracion">Editar perfil</a>
        </div>
    </div>

    @if (ViewBag.Perfil.SiguientePaso != null)
    {
        <section class="card tarjeta onboarding">
            <span class="badge etiqueta etiqueta-acento">Tu perfil está al @ViewBag.Perfil.PorcentajeCompleto%</span>
            <h2 class="subtitulo">@(ViewBag.Perfil.PorcentajeCompleto == 0 ? "Empezá a armar tu perfil" : "Seguí completando tu perfil")</h2>
            <p>Las empresas y personas que publican búsquedas en Workly ven tu perfil y tu CV cuando te postulás. Te falta: <span class="negrita">@ViewBag.Perfil.SiguientePaso.Texto.ToLower(Vistas.Cultura)</span>.</p>
            @if (ViewBag.Perfil.OtrosPendientes.Count > 0)
            {
                <p class="texto-suave">También te falta:
                    @foreach (ItemPerfil item in ViewBag.Perfil.OtrosPendientes)
                    {
                        <span class="badge etiqueta etiqueta-borde">@item.Texto</span>
                    }
                </p>
            }
            <a class="btn-solid theme-primary boton boton-acento" asp-controller="Perfil" asp-action="Completar">Completar mi perfil →</a>
        </section>
    }

    <div class="row g-4">
        <div class="lg:col-5">
            <section class="card tarjeta">
                <div class="tarjeta-cabecera">
                    <h2 class="card-title">Qué busco</h2>
                    <a asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda">Editar</a>
                </div>
                @if (ViewBag.Perfil.Preferencia.TieneDatos || ViewBag.Perfil.Preferencia.Provincia != null)
                {
                    <partial name="_Preferencia" model="ViewBag.Perfil.Preferencia" />
                }
                else
                {
                    <div class="vacio">
                        <p>Contanos qué puesto buscás, en qué modalidad y tu expectativa salarial. Con eso armamos las ofertas de tu inicio.</p>
                        <a class="btn-outline theme-primary boton btn-sm" asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda">+ Completar qué busco</a>
                    </div>
                }
            </section>

            <section class="card tarjeta">
                <div class="tarjeta-cabecera">
                    <h2 class="card-title">Mis postulaciones</h2>
                    @if (ViewBag.Perfil.TotalPostulaciones > 0)
                    {
                        <a asp-controller="Postulaciones" asp-action="Index">Ver tablero</a>
                    }
                </div>
                @if (ViewBag.Perfil.TotalPostulaciones == 0)
                {
                    <div class="vacio">
                        <p>Todavía no te postulaste a ninguna búsqueda.</p>
                        <a class="btn-outline theme-primary boton btn-sm" asp-controller="Empleos" asp-action="Index">Buscar trabajo</a>
                    </div>
                }
                else
                {
                    <partial name="_Estados" model="ViewBag.Perfil" />
                }
            </section>

            <section class="card tarjeta" id="cv">
                <h2 class="card-title">CV</h2>
                @if (ViewBag.Perfil.TieneCV)
                {
                    <p><a asp-controller="Perfil" asp-action="DescargarCV">@ViewBag.Perfil.CV.NombreOriginal</a></p>
                    <p class="texto-suave">Actualizado el @ViewBag.Perfil.FechaCV</p>
                    <form asp-controller="Perfil" asp-action="QuitarCV" method="post">
                        <button class="boton-link" type="submit">Quitar CV</button>
                    </form>
                }
                else
                {
                    <p class="texto-suave">Subí tu CV para poder postularte a las búsquedas de Workly.</p>
                }
                <details class="accordion-item agregar">
                    <summary class="accordion-header">@(ViewBag.Perfil.TieneCV ? "Cambiar CV" : "+ Subir CV")</summary>
                    <form class="accordion-body" asp-controller="Perfil" asp-action="SubirCV" asp-route-volver="@Url.Action("Index", "Perfil")" method="post" enctype="multipart/form-data">
                        <div class="form-field">
                            <label class="form-label" for="archivo-cv">Archivo</label>
                            <input class="form-control" id="archivo-cv" type="file" name="archivo" required>
                            <p class="form-text">PDF, DOC o DOCX de hasta 5 MB.</p>
                        </div>
                        <button class="btn-solid theme-primary boton" type="submit">Subir CV</button>
                    </form>
                </details>
            </section>

            <section class="card tarjeta">
                <h2 class="card-title">Foto de perfil</h2>
                <details class="accordion-item agregar">
                    <summary class="accordion-header">@(string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto) ? "+ Subir foto" : "Cambiar foto")</summary>
                    <form class="accordion-body" asp-controller="Perfil" asp-action="SubirFoto" asp-route-volver="@Url.Action("Index", "Perfil")" method="post" enctype="multipart/form-data">
                        <div class="form-field">
                            <label class="form-label" for="archivo-foto">Imagen</label>
                            <input class="form-control" id="archivo-foto" type="file" name="foto" required>
                            <p class="form-text">JPG, PNG o WEBP de hasta 5 MB.</p>
                        </div>
                        <button class="btn-solid theme-primary boton" type="submit">Guardar foto</button>
                    </form>
                </details>
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto))
                {
                    <form asp-controller="Perfil" asp-action="QuitarFoto" asp-route-volver="@Url.Action("Index", "Perfil")" method="post">
                        <button class="boton-link" type="submit">Quitar la foto</button>
                    </form>
                }
            </section>
        </div>

        <div class="lg:col-7">
            <section class="card tarjeta">
                <h2 class="card-title">Sobre mí</h2>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Perfil.Descripcion))
                {
                    <p class="texto-con-saltos">@ViewBag.Perfil.Perfil.Descripcion</p>
                }
                else
                {
                    <p class="texto-suave">Todavía no contaste nada sobre vos. Sumá unas líneas sobre qué hacés y qué estás buscando.</p>
                }
                <details class="accordion-item agregar">
                    <summary class="accordion-header">@(string.IsNullOrWhiteSpace(ViewBag.Perfil.Perfil.Descripcion) ? "+ Escribir sobre mí" : "Editar")</summary>
                    <form class="accordion-body" asp-controller="Perfil" asp-action="GuardarSobreMi" method="post">
                        <div class="form-field">
                            <label class="form-label" for="campo-sobre-mi">Contá en pocas líneas qué hacés, qué te gusta y qué estás buscando.</label>
                            <textarea class="form-control" id="campo-sobre-mi" name="descripcion" rows="6">@ViewBag.Perfil.Perfil.Descripcion</textarea>
                            <p class="form-text">Hasta 500 caracteres.</p>
                        </div>
                        <button class="btn-solid theme-primary boton" type="submit">Guardar</button>
                    </form>
                </details>
            </section>

            <section class="card tarjeta" id="experiencia">
                <h2 class="card-title">Experiencia</h2>
                @if (ViewBag.Perfil.Experiencias.Count == 0)
                {
                    <p class="texto-suave">Todavía no cargaste experiencia laboral. Sumá trabajos, pasantías o proyectos freelance.</p>
                }
                else
                {
                    <ol class="list-group linea">
                        @foreach (ExperienciaItem experiencia in ViewBag.Perfil.Experiencias)
                        {
                            <li class="list-group-item">
                                <h3 class="tarjeta-titulo">@experiencia.Puesto</h3>
                                <p>@experiencia.Empresa</p>
                                <p class="texto-suave">@experiencia.Periodo</p>
                                @if (!string.IsNullOrWhiteSpace(experiencia.Descripcion))
                                {
                                    <p class="texto-con-saltos">@experiencia.Descripcion</p>
                                }
                                <form asp-controller="Perfil" asp-action="EliminarExperiencia" asp-route-id="@experiencia.ID" method="post">
                                    <button class="boton-link" type="submit">Borrar</button>
                                </form>
                            </li>
                        }
                    </ol>
                }
                <partial name="_ModalExperiencia" model="new ModalExperiencia(true, ViewBag.Formulario as ExperienciaFormulario, ViewBag.ModalAbierto as string)" />
            </section>

            <section class="card tarjeta" id="formacion">
                <h2 class="card-title">Formación</h2>
                @if (ViewBag.Perfil.Formaciones.Count == 0)
                {
                    <p class="texto-suave">Todavía no cargaste tu formación. Sumá tus estudios y cursos.</p>
                }
                else
                {
                    <ol class="list-group linea">
                        @foreach (FormacionItem formacion in ViewBag.Perfil.Formaciones)
                        {
                            <li class="list-group-item">
                                <h3 class="tarjeta-titulo">@formacion.Titulo</h3>
                                <p>@formacion.Institucion</p>
                                <p class="texto-suave">@formacion.Periodo</p>
                                <form asp-controller="Perfil" asp-action="EliminarFormacion" asp-route-id="@formacion.ID" method="post">
                                    <button class="boton-link" type="submit">Borrar</button>
                                </form>
                            </li>
                        }
                    </ol>
                }
                <partial name="_ModalFormacion" model="new ModalFormacion(true, ViewBag.Formulario as FormacionFormulario, ViewBag.Perfil.Instituciones, ViewBag.ModalAbierto as string)" />
            </section>

            <partial name="_PerfilDatos" model="ViewBag.Perfil" />
            <a asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda">Editar habilidades e idiomas →</a>
        </div>
    </div>
</div>
