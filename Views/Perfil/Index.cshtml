@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container seccion-app">
    <section class="perfil-cabecera" aria-label="Datos principales">
        <button class="perfil-cabecera-avatar" type="button" data-bs-toggle="modal" data-bs-target="#modal-foto">
            <span class="avatar-xl" aria-hidden="true">
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto))
                {
                    <img src="@ViewBag.Perfil.Perfil.Foto" alt="" />
                }
                else
                {
                    @ViewBag.Perfil.Iniciales
                }
            </span>
            <span class="perfil-cabecera-camara"><icono nombre="image" tamano="18" /></span>
            <span class="visually-hidden">@(string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto) ? "Subir foto de perfil" : "Cambiar foto de perfil")</span>
        </button>

        <div class="perfil-cabecera-datos">
            <h1 class="perfil-cabecera-nombre">@ViewBag.Perfil.Usuario.NombreCompleto</h1>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Preferencia.Puesto_Buscado))
            {
                <p class="perfil-cabecera-rol">Busca trabajo de @ViewBag.Perfil.Preferencia.Puesto_Buscado</p>
            }
            <ul class="perfil-cabecera-contacto" role="list">
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Ubicacion))
                {
                    <li><icono nombre="near-me" tamano="18" />@ViewBag.Perfil.Perfil.Ubicacion</li>
                }
                <li><icono nombre="mail" tamano="18" /><a href="mailto:@ViewBag.Perfil.Usuario.Email">@ViewBag.Perfil.Usuario.Email</a></li>
                @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Telefono))
                {
                    <li><icono nombre="message-writing" tamano="18" /><a href="tel:@ViewBag.Perfil.Perfil.TelefonoLink">@ViewBag.Perfil.Perfil.Telefono</a></li>
                }
                @if (ViewBag.Perfil.EnlaceSitio != null)
                {
                    <li><icono nombre="globe" tamano="18" /><a href="@ViewBag.Perfil.EnlaceSitio" target="_blank" rel="noopener noreferrer">@ViewBag.Perfil.CV.Sitio_Web</a></li>
                }
            </ul>

            <form class="estado-busqueda" asp-controller="Perfil" asp-action="GuardarEstado" method="post" data-enviar-al-cambiar>
                <label class="estado-busqueda-etiqueta" for="estado-busqueda">Estado</label>
                <select class="form-select @(ViewBag.Perfil.Perfil.Estado_Busqueda == "Buscando activamente" ? "estado-busqueda-activo" : "estado-busqueda-control")" id="estado-busqueda" name="estado">
                    @if (ViewBag.Perfil.Perfil.Estado_Busqueda == null)
                    {
                        <option value="" selected>Elegí tu estado</option>
                    }
                    @foreach (var estado in Catalogos.EstadosBusqueda)
                    {
                        <option selected="@(ViewBag.Perfil.Perfil.Estado_Busqueda == estado)">@estado</option>
                    }
                </select>
                <noscript><button class="btn btn-sm" type="submit">Guardar</button></noscript>
            </form>
        </div>

        <div class="perfil-cabecera-acciones">
            @if (ViewBag.Perfil.TieneCV)
            {
                <a class="btn btn-outline-primary" asp-controller="Perfil" asp-action="DescargarCV"><icono nombre="download" />Descargar CV</a>
            }
            else
            {
                <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#modal-cv"><icono nombre="upload" />Subir CV</button>
            }
            <a class="btn btn-primary" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="pen" />Editar perfil</a>
        </div>
    </section>

    @if (ViewBag.Perfil.SiguientePaso != null)
    {
        <section class="onboarding" aria-labelledby="onboarding-titulo">
            <div class="onboarding-principal">
                <span class="badge badge-acento">Tu perfil está al @ViewBag.Perfil.PorcentajeCompleto%</span>
                <h2 class="onboarding-titulo" id="onboarding-titulo">
                    @(ViewBag.Perfil.PorcentajeCompleto == 0 ? "Empezá a armar tu perfil" : "Seguí completando tu perfil")
                </h2>
                <p class="onboarding-texto">Las empresas y personas que publican búsquedas en Workly ven tu perfil y tu CV cuando te postulás. Te falta: <strong>@ViewBag.Perfil.SiguientePaso.Texto.ToLower(Vistas.Cultura)</strong>.</p>
                <div class="progress onboarding-progreso" role="progressbar" aria-valuenow="@ViewBag.Perfil.PorcentajeCompleto" aria-valuemin="0" aria-valuemax="100" aria-label="Perfil completo">
                    <div class="progress-bar" style="width: @(ViewBag.Perfil.PorcentajeCompleto)%"></div>
                </div>
                <div class="onboarding-acciones">
                    @if (ViewBag.Perfil.SiguientePaso.Modal != null)
                    {
                        <button class="btn btn-warning-lg" type="button" data-bs-toggle="modal" data-bs-target="#@ViewBag.Perfil.SiguientePaso.Modal">@ViewBag.Perfil.SiguientePaso.Accion<icono nombre="arrow-right" /></button>
                    }
                    else
                    {
                        <a class="btn btn-warning-lg" href="@ViewBag.Perfil.SiguientePaso.Enlace">@ViewBag.Perfil.SiguientePaso.Accion<icono nombre="arrow-right" /></a>
                    }
                    <a class="btn btn-outline-lg" asp-controller="Perfil" asp-action="Completar">Completar todo</a>
                </div>
            </div>
            @if (ViewBag.Perfil.OtrosPendientes.Count > 0)
            {
                <div class="onboarding-resto">
                    <h3 class="onboarding-subtitulo">También te falta</h3>
                    <ul class="onboarding-lista" role="list">
                        @foreach (ItemPerfil item in ViewBag.Perfil.OtrosPendientes)
                        {
                            <li>
                                @if (item.Modal != null)
                                {
                                    <button class="onboarding-item" type="button" data-bs-toggle="modal" data-bs-target="#@item.Modal"><icono nombre="circle-check-outline" tamano="20" />@item.Texto<icono nombre="chevron-right" tamano="18" /></button>
                                }
                                else
                                {
                                    <a class="onboarding-item" href="@item.Enlace"><icono nombre="circle-check-outline" tamano="20" />@item.Texto<icono nombre="chevron-right" tamano="18" /></a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>
    }

    <div class="perfil-cuerpo">
        <div class="perfil-columna">
            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">Qué busco</h2>
                    <a class="enlace" asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda"><icono nombre="pen" tamano="16" />Editar</a>
                </div>
                @if (ViewBag.Perfil.Preferencia.TieneDatos || ViewBag.Perfil.Preferencia.Provincia != null)
                {
                    <dl class="lista-clave-valor lista-clave-valor-perfil">
                        @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Preferencia.Puesto_Buscado)) { <div><dt>Puesto</dt><dd>@ViewBag.Perfil.Preferencia.Puesto_Buscado</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.ListaNiveles.Count > 0) { <div><dt>Nivel</dt><dd>@string.Join(", ", ViewBag.Perfil.Preferencia.ListaNiveles)</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.ListaModalidades.Count > 0) { <div><dt>Modalidad</dt><dd>@string.Join(", ", ViewBag.Perfil.Preferencia.ListaModalidades)</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Jornada != null) { <div><dt>Jornada</dt><dd>@ViewBag.Perfil.Preferencia.Jornada</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Contratacion != null) { <div><dt>Contratación</dt><dd>@ViewBag.Perfil.Preferencia.Contratacion</dd></div> }
                        <div><dt>Dónde</dt><dd>@(ViewBag.Perfil.Preferencia.Provincia ?? "Todo el país")</dd></div>
                        @if (ViewBag.Perfil.Preferencia.Salario_Minimo != null || ViewBag.Perfil.Preferencia.Salario_Maximo != null) { <div><dt>Salario bruto</dt><dd>@ViewBag.Perfil.Preferencia.SalarioTexto</dd></div> }
                        @if (ViewBag.Perfil.Preferencia.Disponibilidad != null) { <div><dt>Disponibilidad</dt><dd>@ViewBag.Perfil.Preferencia.Disponibilidad</dd></div> }
                    </dl>
                }
                else
                {
                    <div class="estado-vacio estado-vacio-chico">
                        <p>Contanos qué puesto buscás, en qué modalidad y tu expectativa salarial. Con eso armamos las ofertas de tu inicio.</p>
                        <a class="btn btn-outline-sm" asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda"><icono nombre="plus" />Completar qué busco</a>
                    </div>
                }
            </section>

            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">Mis postulaciones</h2>
                    @if (ViewBag.Perfil.TotalPostulaciones > 0)
                    {
                        <a class="enlace" asp-controller="Postulaciones" asp-action="Index">Ver tablero</a>
                    }
                </div>
                @if (ViewBag.Perfil.TotalPostulaciones == 0)
                {
                    <div class="estado-vacio estado-vacio-chico">
                        <p>Todavía no te postulaste a ninguna búsqueda.</p>
                        <a class="btn btn-outline-sm" asp-controller="Empleos" asp-action="Index"><icono nombre="search" />Buscar trabajo</a>
                    </div>
                }
                else
                {
                    <ul class="actividad-estados" role="list">
                        @foreach (var etapa in Catalogos.EstadosPostulacion)
                        {
                            <li class="actividad-estados-item actividad-estados-item-@etapa.Color">
                                <strong>@ViewBag.Perfil.CantidadEnEstado(etapa.Estado)</strong><span>@etapa.Estado</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">CV</h2>
                </div>
                @if (ViewBag.Perfil.TieneCV)
                {
                    <div class="archivo-cv">
                        <span class="caja-icono-sm"><icono nombre="file-blank" /></span>
                        <div class="archivo-cv-datos">
                            <a class="enlace" asp-controller="Perfil" asp-action="DescargarCV">@ViewBag.Perfil.CV.NombreOriginal</a>
                            <span class="small text-body-secondary">Actualizado el @ViewBag.Perfil.FechaCV</span>
                        </div>
                    </div>
                    <div class="fila fila-envolver">
                        <button class="btn btn-outline-sm" type="button" data-bs-toggle="modal" data-bs-target="#modal-cv"><icono nombre="upload" />Cambiar</button>
                        <form asp-controller="Perfil" asp-action="QuitarCV" method="post" data-confirmar="¿Quitamos tu CV?">
                            <button class="btn btn-link-sm" type="submit">Quitar</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="estado-vacio estado-vacio-chico">
                        <p>Subí tu CV para poder postularte a las búsquedas de Workly.</p>
                        <button class="btn btn-outline-sm" type="button" data-bs-toggle="modal" data-bs-target="#modal-cv"><icono nombre="upload" />Subir CV</button>
                    </div>
                }
            </section>
        </div>

        <div class="perfil-columna">
            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">Sobre mí</h2>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Perfil.Descripcion))
                    {
                        <button class="enlace" type="button" data-bs-toggle="modal" data-bs-target="#modal-sobre-mi"><icono nombre="pen" tamano="16" />Editar</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Perfil.Perfil.Descripcion))
                {
                    <p class="perfil-texto">@ViewBag.Perfil.Perfil.Descripcion</p>
                }
                else
                {
                    <div class="estado-vacio estado-vacio-chico">
                        <p>Todavía no contaste nada sobre vos. Sumá unas líneas sobre qué hacés y qué estás buscando.</p>
                        <button class="btn btn-outline-sm" type="button" data-bs-toggle="modal" data-bs-target="#modal-sobre-mi"><icono nombre="pen" />Escribir sobre mí</button>
                    </div>
                }
            </section>

            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">Experiencia</h2>
                    @if (ViewBag.Perfil.Experiencias.Count > 0)
                    {
                        <button class="enlace" type="button" data-bs-toggle="modal" data-bs-target="#modal-experiencia"><icono nombre="plus" tamano="16" />Agregar</button>
                    }
                </div>
                @if (ViewBag.Perfil.Experiencias.Count == 0)
                {
                    <div class="estado-vacio estado-vacio-chico">
                        <p>Todavía no cargaste experiencia laboral. Sumá trabajos, pasantías o proyectos freelance.</p>
                        <button class="btn btn-outline-sm" type="button" data-bs-toggle="modal" data-bs-target="#modal-experiencia"><icono nombre="plus" />Agregar experiencia</button>
                    </div>
                }
                else
                {
                    <ol class="linea-tiempo" role="list">
                        @foreach (ExperienciaItem experiencia in ViewBag.Perfil.Experiencias)
                        {
                            <li class="linea-tiempo-item">
                                <span class="logo-empresa-md logo-empresa-principal" aria-hidden="true">@Textos.Iniciales(experiencia.Empresa)</span>
                                <div class="linea-tiempo-contenido">
                                    <h3 class="linea-tiempo-titulo">@experiencia.Puesto</h3>
                                    <p class="linea-tiempo-lugar">@experiencia.Empresa</p>
                                    <p class="linea-tiempo-fecha">@experiencia.Periodo</p>
                                    @if (!string.IsNullOrWhiteSpace(experiencia.Descripcion))
                                    {
                                        <p class="linea-tiempo-texto">@experiencia.Descripcion</p>
                                    }
                                </div>
                                <form asp-controller="Perfil" asp-action="EliminarExperiencia" asp-route-id="@experiencia.ID" method="post" data-confirmar="¿Borramos esta experiencia?">
                                    <button class="btn btn-icono-borde" type="submit"><icono nombre="trash-full" etiqueta="Borrar experiencia" /></button>
                                </form>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">Formación</h2>
                    @if (ViewBag.Perfil.Formaciones.Count > 0)
                    {
                        <button class="enlace" type="button" data-bs-toggle="modal" data-bs-target="#modal-formacion"><icono nombre="plus" tamano="16" />Agregar</button>
                    }
                </div>
                @if (ViewBag.Perfil.Formaciones.Count == 0)
                {
                    <div class="estado-vacio estado-vacio-chico">
                        <p>Todavía no cargaste tu formación. Sumá tus estudios y cursos.</p>
                        <button class="btn btn-outline-sm" type="button" data-bs-toggle="modal" data-bs-target="#modal-formacion"><icono nombre="plus" />Agregar formación</button>
                    </div>
                }
                else
                {
                    <ol class="linea-tiempo" role="list">
                        @foreach (FormacionItem formacion in ViewBag.Perfil.Formaciones)
                        {
                            <li class="linea-tiempo-item">
                                <span class="logo-empresa-md" aria-hidden="true"><icono nombre="book" /></span>
                                <div class="linea-tiempo-contenido">
                                    <h3 class="linea-tiempo-titulo">@formacion.Titulo</h3>
                                    <p class="linea-tiempo-lugar">@formacion.Institucion</p>
                                    <p class="linea-tiempo-fecha">@formacion.Periodo</p>
                                </div>
                                <form asp-controller="Perfil" asp-action="EliminarFormacion" asp-route-id="@formacion.ID" method="post" data-confirmar="¿Borramos esta formación?">
                                    <button class="btn btn-icono-borde" type="submit"><icono nombre="trash-full" etiqueta="Borrar formación" /></button>
                                </form>
                            </li>
                        }
                    </ol>
                }
            </section>

            <div class="perfil-dupla">
                <section class="card">
                    <div class="card-header">
                        <h2 class="card-title">Habilidades</h2>
                        <a class="enlace" asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda"><icono nombre="pen" tamano="16" />@(ViewBag.Perfil.Habilidades.Count > 0 ? "Editar" : "Agregar")</a>
                    </div>
                    @if (ViewBag.Perfil.Habilidades.Count == 0)
                    {
                        <p class="perfil-vacio">Todavía no cargaste habilidades. Sumá las herramientas y tareas que manejás.</p>
                    }
                    else
                    {
                        <ul class="lista-tags" role="list">
                            @foreach (string habilidad in ViewBag.Perfil.Habilidades)
                            {
                                <li class="badge tag">@habilidad</li>
                            }
                        </ul>
                    }
                </section>

                <section class="card">
                    <div class="card-header">
                        <h2 class="card-title">Idiomas</h2>
                        <a class="enlace" asp-controller="Perfil" asp-action="Configuracion" asp-route-pestana="busqueda"><icono nombre="pen" tamano="16" />@(ViewBag.Perfil.Idiomas.Count > 0 ? "Editar" : "Agregar")</a>
                    </div>
                    @if (ViewBag.Perfil.Idiomas.Count == 0)
                    {
                        <p class="perfil-vacio">Todavía no cargaste idiomas. Sumá los que hablás y tu nivel.</p>
                    }
                    else
                    {
                        <dl class="lista-clave-valor">
                            @foreach (IdiomaElegido idioma in ViewBag.Perfil.Idiomas)
                            {
                                <div><dt>@idioma.Idioma</dt><dd>@idioma.Nivel</dd></div>
                            }
                        </dl>
                    }
                </section>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" aria-hidden="true" id="modal-foto" aria-labelledby="modal-foto-titulo"><div class="modal-dialog modal-sm"><div class="modal-content">
    <div class="modal-body">
        <form class="formulario" asp-controller="Perfil" asp-action="SubirFoto" method="post" enctype="multipart/form-data" novalidate data-formulario-real>
            <input type="hidden" name="volver" value="@Url.Action("Index", "Perfil")" />
            <div class="modal-header">
                <h2 class="modal-title" id="modal-foto-titulo">@(string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto) ? "Subí tu foto de perfil" : "Cambiá tu foto de perfil")</h2>
                <button class="modal-cerrar" type="button" aria-label="Cerrar" data-bs-dismiss="modal"><icono nombre="close-big" /></button>
            </div>
            <div class="recorte-foto">
                <span class="recorte-foto-imagen" data-vista-foto>
                    @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto))
                    {
                        <img src="@ViewBag.Perfil.Perfil.Foto" alt="" />
                    }
                    else
                    {
                        @ViewBag.Perfil.Iniciales
                    }
                </span>
            </div>
            <div class="campo">
                <label class="btn btn-archivo-block">
                    <icono nombre="upload" />Elegir foto
                    <input type="file" name="foto" required accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-foto-entrada
                           data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí una imagen JPG, PNG o WEBP" />
                </label>
                <span class="form-text text-center">JPG, PNG o WEBP de hasta 5 MB.</span>
                <span class="invalid-feedback"><icono nombre="warning" />Elegí una imagen JPG, PNG o WEBP de hasta 5 MB</span>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" type="submit">Guardar foto</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(ViewBag.Perfil.Perfil.Foto))
        {
            <form class="modal-pie" asp-controller="Perfil" asp-action="QuitarFoto" method="post">
                <input type="hidden" name="volver" value="@Url.Action("Index", "Perfil")" />
                <button class="btn btn-link-sm" type="submit"><icono nombre="trash-full" />Quitar la foto</button>
            </form>
        }
    </div>
</div></div></div>

<div class="modal fade" tabindex="-1" aria-hidden="true" id="modal-sobre-mi" aria-labelledby="modal-sobre-mi-titulo"><div class="modal-dialog"><div class="modal-content">
    <form class="modal-body formulario" asp-controller="Perfil" asp-action="GuardarSobreMi" method="post" novalidate data-formulario-real>
        <div class="modal-header">
            <h2 class="modal-title" id="modal-sobre-mi-titulo">Sobre mí</h2>
            <button class="modal-cerrar" type="button" aria-label="Cerrar" data-bs-dismiss="modal"><icono nombre="close-big" /></button>
        </div>
        <p class="modal-descripcion">Contá en pocas líneas qué hacés, qué te gusta y qué estás buscando.</p>
        <div class="campo">
            <label class="form-label" for="campo-sobre-mi">Sobre mí</label>
            <textarea class="form-control" id="campo-sobre-mi" name="descripcion" rows="6" maxlength="500">@ViewBag.Perfil.Perfil.Descripcion</textarea>
            <span class="form-text">Hasta 500 caracteres.</span>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-primary" type="submit">Guardar</button>
        </div>
    </form>
</div></div></div>

<div class="modal fade" tabindex="-1" aria-hidden="true" id="modal-cv" aria-labelledby="modal-cv-titulo"><div class="modal-dialog"><div class="modal-content">
    <form class="modal-body formulario" asp-controller="Perfil" asp-action="SubirCV" method="post" enctype="multipart/form-data" novalidate data-formulario-real>
        <input type="hidden" name="volver" value="@Url.Action("Index", "Perfil")" />
        <div class="modal-header">
            <h2 class="modal-title" id="modal-cv-titulo">@(ViewBag.Perfil.TieneCV ? "Cambiar tu CV" : "Subir tu CV")</h2>
            <button class="modal-cerrar" type="button" aria-label="Cerrar" data-bs-dismiss="modal"><icono nombre="close-big" /></button>
        </div>
        <div class="campo">
            <label class="zona-archivo" data-zona-archivo>
                <span class="caja-icono"><icono nombre="upload" /></span>
                <strong class="zona-archivo-nombre" data-zona-archivo-nombre>Arrastrá tu CV acá o hacé clic para subirlo</strong>
                <span class="small">PDF, DOC o DOCX de hasta 5 MB</span>
                <input type="file" name="archivo" required accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                       data-tamano-maximo="@Archivos.TamanoMaximo" data-error-formato="Subí un archivo PDF, DOC o DOCX" />
            </label>
            <span class="invalid-feedback"><icono nombre="warning" />Elegí un archivo PDF, DOC o DOCX de hasta 5 MB</span>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-primary" type="submit">Subir CV</button>
        </div>
    </form>
</div></div></div>

<partial name="_ModalExperiencia" model="new ModalExperiencia(true, ViewBag.Formulario as ExperienciaFormulario, ViewBag.ModalAbierto as string)" />
<partial name="_ModalFormacion" model="new ModalFormacion(true, ViewBag.Formulario as FormacionFormulario, ViewBag.Perfil.Instituciones, ViewBag.ModalAbierto as string)" />
