@{
    ViewData["Title"] = "Mi perfil";
    var niveles = new[] { "Básico", "Intermedio", "Avanzado", "Fluido", "Nativo" };
    var idiomas = new[]
    {
        (Idioma: "Español", Detalle: "Nativo", Nivel: 4),
        (Idioma: "Inglés", Detalle: "B2 · First Certificate", Nivel: 2),
        (Idioma: "Portugués", Detalle: "A2 · Básico", Nivel: 0)
    };
    var checklist = new[]
    {
        (Texto: "Datos personales", Listo: true),
        (Texto: "Experiencia laboral", Listo: true),
        (Texto: "Formación", Listo: true),
        (Texto: "Habilidades", Listo: true),
        (Texto: "Proyecto destacado", Listo: false),
        (Texto: "Referencias", Listo: false)
    };
    var habilidades = new[] { "React", "TypeScript", "JavaScript (ES6+)", "HTML5", "CSS / BEM", "Sass", "Git & GitHub", "Figma", "Storybook", "APIs REST", "Node.js (básico)" };
}
@* Mi perfil (Figma › Media · WF 05 · Perfil) *@

<div class="contenedor seccion-app">
    <section class="perfil-cabecera" aria-label="Datos principales">
        <button class="perfil-cabecera__avatar" type="button" data-modal-abrir="modal-foto">
            <span class="avatar avatar--xl" aria-hidden="true">SM</span>
            <span class="perfil-cabecera__camara"><icono nombre="image" tamano="18" /></span>
            <span class="solo-lectores">Cambiar foto de perfil</span>
        </button>

        <div class="perfil-cabecera__datos">
            <div class="fila fila--envolver">
                <h1 class="perfil-cabecera__nombre">Sofía Martínez</h1>
                <span class="etiqueta etiqueta--exito"><span class="punto"></span>Buscando activamente</span>
            </div>
            <p class="perfil-cabecera__rol">Desarrolladora Frontend Jr · React &amp; TypeScript</p>
            <ul class="perfil-cabecera__contacto" role="list">
                <li><icono nombre="near-me" tamano="18" />Palermo, CABA</li>
                <li><icono nombre="mail" tamano="18" /><a href="mailto:sofia.martinez@mail.com">sofia.martinez@mail.com</a></li>
                <li><icono nombre="globe" tamano="18" /><a href="#">sofiamartinez.dev</a></li>
                <li><icono nombre="code" tamano="18" /><a href="#">github.com/sofimartinez</a></li>
            </ul>
        </div>

        <div class="perfil-cabecera__acciones">
            <button class="boton boton--contorno" type="button" data-confirmar-accion="Descargamos tu CV en PDF."><icono nombre="download" />Descargar CV</button>
            <a class="boton" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="pen" />Editar perfil</a>
        </div>
    </section>

    <div class="perfil-cuerpo">
        <div class="perfil-columna">
            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Perfil completo al 85%</h2>
                    <span class="etiqueta etiqueta--acento">+2 pasos</span>
                </div>
                <div class="progreso progreso--principal" role="progressbar" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100" aria-label="Perfil completo">
                    <span class="progreso__barra" style="--valor: 85%"></span>
                </div>
                <p class="perfil-ayuda">Sumá un proyecto destacado y tus referencias para llegar al 100% y aparecer primero en las búsquedas.</p>
                <ul class="checklist" role="list">
                    @foreach (var item in checklist)
                    {
                        <li class="checklist__item @(item.Listo ? "esta-listo" : "")">
                            <icono nombre="@(item.Listo ? "circle-check" : "circle-check-outline")" tamano="20" />
                            @item.Texto
                            @if (!item.Listo)
                            {
                                <a class="enlace checklist__accion" asp-controller="Perfil" asp-action="Configuracion">Agregar</a>
                            }
                        </li>
                    }
                </ul>
            </section>

            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Preferencias laborales</h2>
                    <a class="enlace" asp-controller="Perfil" asp-action="Configuracion" asp-fragment="preferencias"><icono nombre="pen" tamano="16" />Editar</a>
                </div>
                <dl class="lista-clave-valor lista-clave-valor--perfil">
                    <div><dt>Puesto buscado</dt><dd>Frontend Developer</dd></div>
                    <div><dt>Nivel</dt><dd>Junior / Semi Senior</dd></div>
                    <div><dt>Modalidad</dt><dd>Híbrida o remota</dd></div>
                    <div><dt>Ubicación</dt><dd>CABA y GBA Norte</dd></div>
                    <div><dt>Jornada</dt><dd>Full-time</dd></div>
                    <div><dt>Contratación</dt><dd>Relación de dependencia</dd></div>
                    <div><dt>Expectativa salarial</dt><dd>$1.400.000 – $1.800.000</dd></div>
                    <div><dt>Disponibilidad</dt><dd>Inmediata</dd></div>
                </dl>
            </section>

            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Actividad</h2>
                    <span class="texto-mini texto-suave">Últimos 30 días</span>
                </div>
                <div class="actividad">
                    <div><strong>11</strong><span>postulaciones</span></div>
                    <div><strong>2</strong><span>entrevistas</span></div>
                    <div><strong>38</strong><span>vistas del perfil</span></div>
                </div>
            </section>
        </div>

        <div class="perfil-columna">
            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Sobre mí</h2>
                    <button class="enlace" type="button" data-modal-abrir="modal-sobre-mi"><icono nombre="pen" tamano="16" />Editar</button>
                </div>
                <p class="perfil-texto" id="texto-sobre-mi">
                    Soy desarrolladora frontend con foco en React y TypeScript. Me gusta construir interfaces accesibles y prolijas,
                    trabajar cerca de diseño y escribir CSS mantenible con BEM. Busco un equipo donde seguir creciendo hacia un rol
                    Semi Senior, idealmente en productos digitales con impacto real.
                </p>
            </section>

            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Experiencia</h2>
                    <button class="enlace" type="button" data-modal-abrir="modal-experiencia"><icono nombre="plus" tamano="16" />Agregar</button>
                </div>
                <ol class="linea-tiempo" role="list">
                    <li class="linea-tiempo__item">
                        <span class="logo-empresa logo-empresa--md logo-empresa--principal" aria-hidden="true">A</span>
                        <div class="linea-tiempo__contenido">
                            <h3 class="linea-tiempo__titulo">Frontend Developer Trainee</h3>
                            <p class="linea-tiempo__lugar">Accenture Argentina · Híbrido</p>
                            <p class="linea-tiempo__fecha">Mar 2025 – Actualidad · 1 año 7 meses</p>
                            <p class="linea-tiempo__texto">Desarrollo de componentes en React y TypeScript para un portal de clientes de un banco. Mantenimiento de la librería de componentes en Storybook junto al equipo de diseño.</p>
                            <div class="lista-tags">
                                <span class="tag tag--borde tag--lg">React</span>
                                <span class="tag tag--borde tag--lg">TypeScript</span>
                                <span class="tag tag--borde tag--lg">Storybook</span>
                            </div>
                        </div>
                    </li>
                    <li class="linea-tiempo__item">
                        <span class="logo-empresa logo-empresa--md logo-empresa--acento" aria-hidden="true">SM</span>
                        <div class="linea-tiempo__contenido">
                            <h3 class="linea-tiempo__titulo">Desarrolladora web freelance</h3>
                            <p class="linea-tiempo__lugar">Independiente · Remoto</p>
                            <p class="linea-tiempo__fecha">Ene 2024 – Feb 2025 · 1 año 2 meses</p>
                            <p class="linea-tiempo__texto">Landing pages y tiendas online para comercios de CABA con HTML, CSS (BEM) y JavaScript. Integración con Tiendanube y Mercado Pago.</p>
                            <div class="lista-tags">
                                <span class="tag tag--borde tag--lg">HTML</span>
                                <span class="tag tag--borde tag--lg">CSS / BEM</span>
                                <span class="tag tag--borde tag--lg">JavaScript</span>
                            </div>
                        </div>
                    </li>
                </ol>
            </section>

            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Formación</h2>
                    <button class="enlace" type="button" data-modal-abrir="modal-experiencia"><icono nombre="plus" tamano="16" />Agregar</button>
                </div>
                <ol class="linea-tiempo" role="list">
                    <li class="linea-tiempo__item">
                        <span class="logo-empresa logo-empresa--md" aria-hidden="true">UTN</span>
                        <div class="linea-tiempo__contenido">
                            <h3 class="linea-tiempo__titulo">Tecnicatura Superior en Programación</h3>
                            <p class="linea-tiempo__lugar">UTN — Facultad Regional Buenos Aires</p>
                            <p class="linea-tiempo__fecha">2023 – 2025 · Finalizada</p>
                        </div>
                    </li>
                    <li class="linea-tiempo__item">
                        <span class="logo-empresa logo-empresa--md" aria-hidden="true">CH</span>
                        <div class="linea-tiempo__contenido">
                            <h3 class="linea-tiempo__titulo">Desarrollo Web y JavaScript</h3>
                            <p class="linea-tiempo__lugar">Coderhouse</p>
                            <p class="linea-tiempo__fecha">2023 · Certificado</p>
                        </div>
                    </li>
                </ol>
            </section>

            <div class="perfil-dupla">
                <section class="tarjeta">
                    <div class="tarjeta__encabezado">
                        <h2 class="tarjeta__titulo">Habilidades</h2>
                        <a class="enlace" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="pen" tamano="16" />Editar</a>
                    </div>
                    <div class="lista-tags lista-tags--holgada">
                        @foreach (var habilidad in habilidades)
                        {
                            <span class="chip">@habilidad</span>
                        }
                    </div>
                </section>

                <section class="tarjeta">
                    <div class="tarjeta__encabezado">
                        <h2 class="tarjeta__titulo">Idiomas</h2>
                        <a class="enlace" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="pen" tamano="16" />Editar</a>
                    </div>
                    <ul class="idiomas" role="list">
                        @foreach (var idioma in idiomas)
                        {
                            <li class="idioma">
                                <div class="idioma__cabecera">
                                    <strong>@idioma.Idioma</strong>
                                    <span>@idioma.Detalle</span>
                                </div>
                                <div class="valoracion" style="--nivel: @idioma.Nivel" role="img" aria-label="Nivel @niveles[idioma.Nivel].ToLowerInvariant()">
                                    @for (var i = 0; i < niveles.Length; i++)
                                    {
                                        <span class="valoracion__punto @(i < idioma.Nivel ? "esta-lleno" : "") @(i == idioma.Nivel ? "esta-actual" : "")" title="@niveles[i]"></span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            </div>
        </div>
    </div>
</div>

@* Pop up "Actualizá tu foto de perfil" (Figma › Guidelines › 07. Notificaciones) *@
<dialog class="modal modal--chico" id="modal-foto" aria-labelledby="modal-foto-titulo" data-snackbar-al-confirmar="Actualizamos tu foto de perfil.">
    <form class="modal__contenido" method="dialog">
        <div class="modal__cabecera">
            <h2 class="modal__titulo" id="modal-foto-titulo">Actualizá tu foto de perfil</h2>
            <button class="modal__cerrar" value="cancelar" aria-label="Cerrar"><icono nombre="close-big" /></button>
        </div>
        <div class="recorte-foto">
            <span class="recorte-foto__imagen" id="foto-recorte">SM</span>
        </div>
        <label class="recorte-foto__zoom">
            <icono nombre="image" tamano="14" />
            <span class="solo-lectores">Zoom</span>
            <input class="deslizador" type="range" min="80" max="140" value="110" data-zoom-foto="foto-recorte" />
            <icono nombre="image" tamano="24" />
        </label>
        <label class="boton boton--contorno boton--sm boton--bloque boton--archivo">
            <icono nombre="upload" />Subir otra foto
            <input type="file" accept="image/*" />
        </label>
        <div class="modal__acciones modal__acciones--centro">
            <button class="boton boton--gris" value="cancelar">Cancelar</button>
            <button class="boton" value="confirmar">Guardar foto</button>
        </div>
    </form>
</dialog>

<dialog class="modal" id="modal-sobre-mi" aria-labelledby="modal-sobre-mi-titulo" data-snackbar-al-confirmar="Guardamos los cambios de tu perfil.">
    <form class="modal__contenido" method="dialog">
        <div class="modal__cabecera">
            <h2 class="modal__titulo" id="modal-sobre-mi-titulo">Editar "Sobre mí"</h2>
            <button class="modal__cerrar" value="cancelar" aria-label="Cerrar"><icono nombre="close-big" /></button>
        </div>
        <p class="modal__descripcion">Contá en pocas líneas qué hacés, qué te gusta y qué estás buscando.</p>
        <div class="campo">
            <label class="campo__etiqueta" for="campo-sobre-mi">Sobre mí</label>
            <textarea class="campo__control" id="campo-sobre-mi" rows="6" maxlength="600">Soy desarrolladora frontend con foco en React y TypeScript. Me gusta construir interfaces accesibles y prolijas, trabajar cerca de diseño y escribir CSS mantenible con BEM. Busco un equipo donde seguir creciendo hacia un rol Semi Senior, idealmente en productos digitales con impacto real.</textarea>
            <span class="campo__ayuda">Máximo 600 caracteres.</span>
        </div>
        <div class="modal__acciones">
            <button class="boton boton--gris" value="cancelar">Cancelar</button>
            <button class="boton" value="confirmar">Guardar</button>
        </div>
    </form>
</dialog>

@* Pop up con campos (Figma › Guidelines › 07. Notificaciones › Pop up) *@
<dialog class="modal" id="modal-experiencia" aria-labelledby="modal-experiencia-titulo" data-snackbar-al-confirmar="Sumamos la experiencia a tu perfil.">
    <form class="modal__contenido" method="dialog">
        <div class="modal__cabecera">
            <h2 class="modal__titulo" id="modal-experiencia-titulo">Agregar experiencia</h2>
            <button class="modal__cerrar" value="cancelar" aria-label="Cerrar"><icono nombre="close-big" /></button>
        </div>
        <p class="modal__descripcion">Sumá tus trabajos, pasantías o proyectos freelance.</p>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="exp-puesto">Puesto</label>
            <input class="campo__control" id="exp-puesto" type="text" placeholder="Escribí acá" />
        </div>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="exp-empresa">Empresa</label>
            <input class="campo__control" id="exp-empresa" type="text" placeholder="Escribí acá" />
        </div>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="exp-modalidad">Modalidad</label>
            <select class="campo__control" id="exp-modalidad">
                <option>Escribí acá</option>
                <option>Presencial</option>
                <option>Híbrido</option>
                <option>Remoto</option>
            </select>
        </div>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="exp-inicio">Inicio</label>
            <div class="control-con-icono control-con-icono--derecha">
                <input class="campo__control" id="exp-inicio" type="month" />
            </div>
        </div>
        <label class="interruptor">
            <input type="checkbox" checked />
            <span class="interruptor__pista"></span>
            Trabajo actualmente acá
        </label>
        <div class="modal__acciones">
            <button class="boton boton--gris" value="cancelar">Cancelar</button>
            <button class="boton" value="confirmar">Agregar</button>
        </div>
    </form>
</dialog>
