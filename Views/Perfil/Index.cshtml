@model MiPerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
    var usuario = Model.Usuario;
    var perfil = Model.Perfil;
    var iniciales = UsuarioActual.Iniciales(usuario.Nombre, usuario.Apellido);
    var faltan = Model.Checklist.Count(i => !i.Listo);
    var sitioWeb = Model.CV?.Sitio_Web;
    var enlaceSitio = string.IsNullOrEmpty(sitioWeb) ? null : (sitioWeb.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? sitioWeb : "https://" + sitioWeb);
    var tieneCV = !string.IsNullOrEmpty(Model.CV?.Nombre_Archivo);
}
@* Mi perfil (Figma › Media · WF 05 · Perfil) *@

<div class="contenedor seccion-app">
    <section class="perfil-cabecera" aria-label="Datos principales">
        <button class="perfil-cabecera__avatar" type="button" data-modal-abrir="modal-foto">
            <span class="avatar avatar--xl" aria-hidden="true">
                @if (!string.IsNullOrEmpty(perfil.Foto))
                {
                    <img src="@perfil.Foto" alt="" />
                }
                else
                {
                    @iniciales
                }
            </span>
            <span class="perfil-cabecera__camara"><icono nombre="image" tamano="18" /></span>
            <span class="solo-lectores">Cambiar foto de perfil</span>
        </button>

        <div class="perfil-cabecera__datos">
            <div class="fila fila--envolver">
                <h1 class="perfil-cabecera__nombre">@usuario.NombreCompleto</h1>
            </div>
            <p class="perfil-cabecera__rol">En Workly desde @usuario.Fecha_Registro.ToString("MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-AR"))</p>
            <ul class="perfil-cabecera__contacto" role="list">
                @if (!string.IsNullOrEmpty(perfil.Ubicacion))
                {
                    <li><icono nombre="near-me" tamano="18" />@perfil.Ubicacion</li>
                }
                <li><icono nombre="mail" tamano="18" /><a href="mailto:@usuario.Email">@usuario.Email</a></li>
                @if (!string.IsNullOrEmpty(perfil.Telefono))
                {
                    <li><icono nombre="message-writing" tamano="18" /><a href="tel:@perfil.Telefono.Replace(" ", "")">@perfil.Telefono</a></li>
                }
                @if (enlaceSitio != null)
                {
                    <li><icono nombre="globe" tamano="18" /><a href="@enlaceSitio" target="_blank" rel="noopener noreferrer">@sitioWeb</a></li>
                }
            </ul>
        </div>

        <div class="perfil-cabecera__acciones">
            @if (tieneCV)
            {
                <a class="boton boton--contorno" asp-controller="Perfil" asp-action="DescargarCV"><icono nombre="download" />Descargar CV</a>
            }
            else
            {
                <a class="boton boton--contorno" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="upload" />Subir CV</a>
            }
            <a class="boton" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="pen" />Editar perfil</a>
        </div>
    </section>

    <div class="perfil-cuerpo">
        <div class="perfil-columna">
            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Perfil completo al @Model.PorcentajeCompleto%</h2>
                    @if (faltan > 0)
                    {
                        <span class="etiqueta etiqueta--acento">+@faltan @(faltan == 1 ? "paso" : "pasos")</span>
                    }
                </div>
                <div class="progreso progreso--principal" role="progressbar" aria-valuenow="@Model.PorcentajeCompleto" aria-valuemin="0" aria-valuemax="100" aria-label="Perfil completo">
                    <span class="progreso__barra" style="--valor: @(Model.PorcentajeCompleto)%"></span>
                </div>
                <p class="perfil-ayuda">
                    @(faltan == 0
                        ? "¡Tu perfil está completo! Vas a aparecer primero en las búsquedas de las empresas."
                        : "Completá lo que falta para aparecer primero en las búsquedas de las empresas.")
                </p>
                <ul class="checklist" role="list">
                    @foreach (var item in Model.Checklist)
                    {
                        <li class="checklist__item @(item.Listo ? "esta-listo" : "")">
                            <icono nombre="@(item.Listo ? "circle-check" : "circle-check-outline")" tamano="20" />
                            @item.Texto
                            @if (!item.Listo)
                            {
                                <a class="enlace checklist__accion" asp-controller="Perfil" asp-action="Configuracion">Agregar</a>
                            }
                        </li>
                    }
                </ul>
            </section>

            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Preferencias laborales</h2>
                    <a class="enlace" asp-controller="Perfil" asp-action="Configuracion" asp-fragment="preferencias"><icono nombre="pen" tamano="16" />Editar</a>
                </div>
                @if (!string.IsNullOrEmpty(perfil.Provincia))
                {
                    <dl class="lista-clave-valor lista-clave-valor--perfil">
                        <div><dt>Ubicación</dt><dd>@perfil.Provincia</dd></div>
                    </dl>
                }
                <p class="perfil-vacio">Contanos qué puesto buscás, en qué modalidad y jornada, y tu expectativa salarial.
                    <a class="enlace" asp-controller="Perfil" asp-action="Configuracion" asp-fragment="preferencias">Completar</a></p>
            </section>

            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Actividad</h2>
                </div>
                <div class="actividad actividad--dos">
                    <div><strong>@Model.CantidadPostulaciones</strong><span>@(Model.CantidadPostulaciones == 1 ? "postulación" : "postulaciones")</span></div>
                    <div><strong>@Model.CantidadGuardadas</strong><span>@(Model.CantidadGuardadas == 1 ? "oferta guardada" : "ofertas guardadas")</span></div>
                </div>
            </section>
        </div>

        <div class="perfil-columna">
            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Sobre mí</h2>
                    <button class="enlace" type="button" data-modal-abrir="modal-sobre-mi"><icono nombre="pen" tamano="16" />Editar</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(perfil.Descripcion))
                {
                    <p class="perfil-texto" id="texto-sobre-mi">@perfil.Descripcion</p>
                }
                else
                {
                    <p class="perfil-vacio">Todavía no contaste nada sobre vos. Sumá unas líneas sobre qué hacés y qué estás buscando.</p>
                }
            </section>

            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Experiencia</h2>
                    <button class="enlace" type="button" data-modal-abrir="modal-experiencia"><icono nombre="plus" tamano="16" />Agregar</button>
                </div>
                @if (Model.Experiencias.Count == 0)
                {
                    <p class="perfil-vacio">Todavía no cargaste experiencia laboral. Sumá trabajos, pasantías o proyectos freelance.</p>
                }
                else
                {
                    <ol class="linea-tiempo" role="list">
                        @foreach (var experiencia in Model.Experiencias)
                        {
                            <li class="linea-tiempo__item">
                                <span class="logo-empresa logo-empresa--md logo-empresa--principal" aria-hidden="true">@(experiencia.Empresa.Length > 0 ? experiencia.Empresa.Substring(0, 1) : "")</span>
                                <div class="linea-tiempo__contenido">
                                    <h3 class="linea-tiempo__titulo">@experiencia.Puesto</h3>
                                    <p class="linea-tiempo__lugar">@experiencia.Empresa</p>
                                    <p class="linea-tiempo__fecha">@experiencia.Periodo</p>
                                    @if (!string.IsNullOrWhiteSpace(experiencia.Descripcion))
                                    {
                                        <p class="linea-tiempo__texto">@experiencia.Descripcion</p>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="tarjeta">
                <div class="tarjeta__encabezado">
                    <h2 class="tarjeta__titulo">Formación</h2>
                    <button class="enlace" type="button" data-modal-abrir="modal-experiencia"><icono nombre="plus" tamano="16" />Agregar</button>
                </div>
                @if (Model.Formaciones.Count == 0)
                {
                    <p class="perfil-vacio">Todavía no cargaste tu formación. Sumá tus estudios y cursos.</p>
                }
                else
                {
                    <ol class="linea-tiempo" role="list">
                        @foreach (var formacion in Model.Formaciones)
                        {
                            <li class="linea-tiempo__item">
                                <span class="logo-empresa logo-empresa--md" aria-hidden="true"><icono nombre="book" /></span>
                                <div class="linea-tiempo__contenido">
                                    <h3 class="linea-tiempo__titulo">@formacion.Titulo</h3>
                                    <p class="linea-tiempo__lugar">@formacion.Institucion</p>
                                    <p class="linea-tiempo__fecha">@formacion.Periodo</p>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>

            <div class="perfil-dupla">
                <section class="tarjeta">
                    <div class="tarjeta__encabezado">
                        <h2 class="tarjeta__titulo">Habilidades</h2>
                        <a class="enlace" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="pen" tamano="16" />Editar</a>
                    </div>
                    <p class="perfil-vacio">Todavía no cargaste habilidades. Sumá las herramientas y tecnologías que manejás.</p>
                </section>

                <section class="tarjeta">
                    <div class="tarjeta__encabezado">
                        <h2 class="tarjeta__titulo">Idiomas</h2>
                        <a class="enlace" asp-controller="Perfil" asp-action="Configuracion"><icono nombre="pen" tamano="16" />Editar</a>
                    </div>
                    <p class="perfil-vacio">Todavía no cargaste idiomas. Sumá los que hablás y tu nivel.</p>
                </section>
            </div>
        </div>
    </div>
</div>

@* Pop up "Actualizá tu foto de perfil" (Figma › Guidelines › 07. Notificaciones) *@
<dialog class="modal modal--chico" id="modal-foto" aria-labelledby="modal-foto-titulo" data-snackbar-al-confirmar="Actualizamos tu foto de perfil.">
    <form class="modal__contenido" method="dialog">
        <div class="modal__cabecera">
            <h2 class="modal__titulo" id="modal-foto-titulo">Actualizá tu foto de perfil</h2>
            <button class="modal__cerrar" value="cancelar" aria-label="Cerrar"><icono nombre="close-big" /></button>
        </div>
        <div class="recorte-foto">
            <span class="recorte-foto__imagen" id="foto-recorte">@iniciales</span>
        </div>
        <label class="recorte-foto__zoom">
            <icono nombre="image" tamano="14" />
            <span class="solo-lectores">Zoom</span>
            <input class="deslizador" type="range" min="80" max="140" value="110" data-zoom-foto="foto-recorte" />
            <icono nombre="image" tamano="24" />
        </label>
        <label class="boton boton--contorno boton--sm boton--bloque boton--archivo">
            <icono nombre="upload" />Subir otra foto
            <input type="file" accept="image/*" />
        </label>
        <div class="modal__acciones modal__acciones--centro">
            <button class="boton boton--gris" value="cancelar">Cancelar</button>
            <button class="boton" value="confirmar">Guardar foto</button>
        </div>
    </form>
</dialog>

<dialog class="modal" id="modal-sobre-mi" aria-labelledby="modal-sobre-mi-titulo" data-snackbar-al-confirmar="Guardamos los cambios de tu perfil.">
    <form class="modal__contenido" method="dialog">
        <div class="modal__cabecera">
            <h2 class="modal__titulo" id="modal-sobre-mi-titulo">Editar "Sobre mí"</h2>
            <button class="modal__cerrar" value="cancelar" aria-label="Cerrar"><icono nombre="close-big" /></button>
        </div>
        <p class="modal__descripcion">Contá en pocas líneas qué hacés, qué te gusta y qué estás buscando.</p>
        <div class="campo">
            <label class="campo__etiqueta" for="campo-sobre-mi">Sobre mí</label>
            <textarea class="campo__control" id="campo-sobre-mi" rows="6" maxlength="500">@perfil.Descripcion</textarea>
            <span class="campo__ayuda">Máximo 500 caracteres.</span>
        </div>
        <div class="modal__acciones">
            <button class="boton boton--gris" value="cancelar">Cancelar</button>
            <button class="boton" value="confirmar">Guardar</button>
        </div>
    </form>
</dialog>

@* Pop up con campos (Figma › Guidelines › 07. Notificaciones › Pop up) *@
<dialog class="modal" id="modal-experiencia" aria-labelledby="modal-experiencia-titulo" data-snackbar-al-confirmar="Sumamos la experiencia a tu perfil.">
    <form class="modal__contenido" method="dialog">
        <div class="modal__cabecera">
            <h2 class="modal__titulo" id="modal-experiencia-titulo">Agregar experiencia</h2>
            <button class="modal__cerrar" value="cancelar" aria-label="Cerrar"><icono nombre="close-big" /></button>
        </div>
        <p class="modal__descripcion">Sumá tus trabajos, pasantías o proyectos freelance.</p>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="exp-puesto">Puesto</label>
            <input class="campo__control" id="exp-puesto" type="text" placeholder="Escribí acá" />
        </div>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="exp-empresa">Empresa</label>
            <input class="campo__control" id="exp-empresa" type="text" placeholder="Escribí acá" />
        </div>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="exp-modalidad">Modalidad</label>
            <select class="campo__control" id="exp-modalidad">
                <option>Escribí acá</option>
                <option>Presencial</option>
                <option>Híbrido</option>
                <option>Remoto</option>
            </select>
        </div>
        <div class="campo campo--horizontal">
            <label class="campo__etiqueta" for="exp-inicio">Inicio</label>
            <div class="control-con-icono control-con-icono--derecha">
                <input class="campo__control" id="exp-inicio" type="month" />
            </div>
        </div>
        <label class="interruptor">
            <input type="checkbox" checked />
            <span class="interruptor__pista"></span>
            Trabajo actualmente acá
        </label>
        <div class="modal__acciones">
            <button class="boton boton--gris" value="cancelar">Cancelar</button>
            <button class="boton" value="confirmar">Agregar</button>
        </div>
    </form>
</dialog>
